  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.forge.displayname
    lastText: "\uB0A0\uC774 \uC544\uB2C8\uB77C \uBC84\uB987\uC744 \uAC04\uB2E4"
  - propertyPath: narrative
    key: data.randomeventdata.forge.narrative
    lastText: "\uBB34\uAE30 \uC815\uBE44\uC2E4\uC5D0\uC11C \uB9DD\uCE58 \uC18C\uB9AC\uAC00
      \uB4E4\uB9B0\uB2E4.\r\n\r\n\uC7A5\uC778\uC774 \uB0B4 \uC7A5\uBE44\uB97C \uBCF4\uB354\uB2C8
      \uBC29\uD328\uC758 \uCC0C\uADF8\uB7EC\uC9C4 \uBD80\uBD84\uC744 \uAC00\uB9AC\uD0A8\uB2E4.\r\n\r\n\uADF8\uAC74
      \uAE08\uBC29 \uD3B4\uC9C0\uC9C0. \uC2F8\uC6B0\uB294 \uC790\uC138\uB3C4 \uBD10
      \uC904 \uC218 \uC788\uACE0."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.forge.options.0.title
    lastText: "\uC775\uC219\uD55C \uAE30\uC220\uC744 \uBCBC\uB9B0\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.forge.options.0.description
    lastText: "30\uACE8\uB4DC \uC18C\uBAA8. \uBCF4\uC720 \uB2A5\uB825 \uD558\uB098\uB97C
      \uAC15\uD654."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.forge.options.1.title
    lastText: "\uD558\uB098\uB97C \uBC84\uB9AC\uACE0 \uB450 \uAC1C\uB97C \uBC30\uC6B4\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.forge.options.1.description
    lastText: "\uBCF4\uC720 \uB2A5\uB825 \uD558\uB098 \uC81C\uAC70 \uD6C4 \uC0C8
      \uB2A5\uB825 \uB450 \uBC88 \uC120\uD0DD."
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.forge.options.2.title
    lastText: "\uBC29\uD328\uC758 \uCC0C\uADF8\uB7EC\uC9C4 \uACF3\uB9CC \uD3B8\uB2E4"
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.forge.options.2.description
    lastText: "\uCD5C\uB300 \uAC00\uB4DC\uAC8C\uC774\uC9C0 +3. \uB2A5\uB825\uC740
      \uBC14\uB00C\uC9C0 \uC54A\uB294\uB2E4."
