    lastText: 
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.magicteacherfirst.options.0.resulttext
    lastText: "\uADF8\uB300\uB85C \uC790\uB9AC\uB97C \uB5A0\uB0AC\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.magicteacherfirst.pages.0.narrative
    lastText: "\uBE48 \uAC15\uC758\uC2E4\uC5D0\uC11C \uB178\uC778\uC774 \uBCBD\uC5D0
      \uBB34\uC5B8\uAC00\uB97C \uC801\uACE0 \uC788\uB2E4.\r\n\r\n\uC606\uBB38 \uB4A4\uC5D0\uC11C
      \uAD34\uBB3C\uC774 \uAE30\uC5B4 \uB098\uC624\uB294\uB370\uB3C4 \uB208\uCE58\uCC44\uC9C0
      \uBABB\uD55C \uBAA8\uC591\uC774\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.magicteacherfirst.pages.0.options.0.title
    lastText: "\uB178\uC778\uC744 \uB36E\uCE58\uB824\uB294 \uAD34\uBB3C\uC744 \uB9C9\uB294\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
    key: data.randomeventdata.magicteacherfirst.pages.0.options.0.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[0].resultText
    key: data.randomeventdata.magicteacherfirst.pages.0.options.0.resulttext
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[1].title
    key: data.randomeventdata.magicteacherfirst.pages.0.options.1.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
    key: data.randomeventdata.magicteacherfirst.pages.0.options.1.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: data.randomeventdata.magicteacherfirst.pages.0.options.1.resulttext
    lastText: "\uAC15\uC758\uC2E4\uC5D0\uC11C \uBA40\uC5B4\uC9C0\uC790 \uB4A4\uB2A6\uAC8C
      \uB178\uC778\uC758 \uD638\uD1B5\uACFC \uD3ED\uBC1C\uC74C\uC774 \uB4E4\uB838\uB2E4."
  - propertyPath: pages.Array.data[1].narrative
    key: data.randomeventdata.magicteacherfirst.pages.1.narrative
    lastText: "\uAD34\uBB3C\uC744 \uBC00\uC5B4\uB0B4\uC790 \uB178\uC778\uC774 \uB4A4\uB97C
      \uB3CC\uC544\uBCF8\uB2E4.\r\n\r\n\uC544, \uACE0\uB9D9\uC2B5\uB2C8\uB2E4. \uC124\uBA85\uD560
      \uBD80\uBD84\uB9CC \uC0DD\uAC01\uD558\uB2E4 \uBCF4\uBA74 \uC8FC\uBCC0\uC744
      \uC798 \uBABB \uBCF4\uAC70\uB4E0\uC694.\r\n\r\n\uACE0\uC804\uD559\uD30C\uC5D0\uC11C
      \uB9C8\uBC95\uC744 \uAC00\uB974\uCCE4\uB2E4\uACE0 \uD55C\uB2E4. \uC9C0\uAE08\uC740
      \uC131\uC5D0 \uB0A8\uC740 \uAE30\uB85D\uC744 \uC870\uC0AC\uD558\uACE0 \uC788\uB2E4\uB294
      \uBAA8\uC591\uC774\uB2E4.\r\n\r\n\uB9C8\uBC95\uC5D0\uB294 \uAD00\uC2EC \uC5C6\uC73C\uC138\uC694?
      \uB3C4\uC640\uC8FC\uC2E0 \uBCF4\uB2F5\uC740 \uD558\uACE0 \uC2F6\uC740\uB370."
  - propertyPath: pages.Array.data[1].options.Array.data[0].title
    key: data.randomeventdata.magicteacherfirst.pages.1.options.0.title
    lastText: "\uBC30\uC6CC \uBCF4\uACE0 \uC2F6\uB2E4\uACE0 \uD55C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].description
    key: data.randomeventdata.magicteacherfirst.pages.1.options.0.description
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[0].resultText
    key: data.randomeventdata.magicteacherfirst.pages.1.options.0.resulttext
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[1].title
    key: data.randomeventdata.magicteacherfirst.pages.1.options.1.title
    lastText: "\uB9C8\uBC95\uBCF4\uB2E4\uB294 \uC5EC\uBE44\uAC00 \uD544\uC694\uD558\uB2E4\uACE0
      \uD55C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].description
    key: data.randomeventdata.magicteacherfirst.pages.1.options.1.description
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[1].resultText
    key: data.randomeventdata.magicteacherfirst.pages.1.options.1.resulttext
    lastText: "\uADF8\uB807\uB2E4\uBA74 \uC774\uAC78 \uBC1B\uC73C\uC138\uC694. \uB2E4\uC74C\uC5D0\uB294
      \uB4A4\uB3C4 \uC880 \uBCF4\uBA74\uC11C \uB2E4\uB2C8\uACA0\uC2B5\uB2C8\uB2E4."
  - propertyPath: pages.Array.data[2].narrative
    key: data.randomeventdata.magicteacherfirst.pages.2.narrative
    lastText: "\uB178\uC778\uC740 \uB0A1\uC740 \uCC45 \uBA87 \uAD8C\uC744 \uCC45\uC0C1
      \uC704\uC5D0 \uD3BC\uCE5C\uB2E4.\n\n\uBD88\uAF43\uC744 \uB2E4\uB8E8\uB294 \uBC95\uB9CC
      \uC788\uB294 \uAC74 \uC544\uB2D9\uB2C8\uB2E4. \uC801\uC758 \uBC1C\uC744 \uBB36\uAC70\uB098
      \uBAB8\uC5D0 \uB0A8\uC740 \uD574\uB85C\uC6B4 \uB9C8\uB825\uC744 \uAC77\uC5B4
      \uB0B4\uB294 \uC8FC\uBB38\uB3C4 \uC788\uC9C0\uC694.\n\n\uC9C0\uAE08 \uAC00\uB974\uCE60
      \uC218 \uC788\uB294 \uAC83\uB4E4\uC744 \uBCF4\uC5EC \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.
      \uB9C8\uC74C\uC774 \uAC00\uB294 \uCABD\uC744 \uACE8\uB77C \uBCF4\uC138\uC694."
  - propertyPath: pages.Array.data[2].options.Array.data[0].title
    key: data.randomeventdata.magicteacherfirst.pages.2.options.0.title
    lastText: "\uBC30\uC6B8 \uC8FC\uBB38\uC744 \uACE0\uB978\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].description
    key: data.randomeventdata.magicteacherfirst.pages.2.options.0.description
    lastText: "\uB178\uC778\uC774 \uBCF4\uC5EC \uC8FC\uB294 \uAE30\uCD08 \uC8FC\uBB38
      \uC138 \uAC00\uC9C0 \uC911 \uD558\uB098\uB97C \uBC30\uC6B4\uB2E4."
