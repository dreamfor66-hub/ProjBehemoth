    key: data.randomeventdata.contract.pages.1.options.1.resulttext
    lastText: "\uD589\uC0C1\uC740 \uBE48 \uC11C\uBA85\uB780\uC744 \uD655\uC778\uD558\uACE0
      \uB3C8\uC744 \uAC74\uB138\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[2].title
    key: data.randomeventdata.contract.pages.1.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[2].description
    key: data.randomeventdata.contract.pages.1.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[2].resultText
    key: data.randomeventdata.contract.pages.1.options.2.resulttext
    lastText: "\uADF8\uB300\uB85C \uC790\uB9AC\uB97C \uB5A0\uB0AC\uB2E4."
  - propertyPath: pages.Array.data[2].narrative
    key: data.randomeventdata.contract.pages.2.narrative
    lastText: "\uB0A8\uC740 \uC218\uBA85\uC758 \uC77C\uBD80\uC785\uB2C8\uB2E4. \uB2E4\uCE5C
      \uC0C1\uCC98\uCC98\uB7FC \uB2E4\uC2DC \uCC44\uC6B8 \uC218 \uC788\uB294 \uAC74
      \uC544\uB2C8\uACE0\uC694."
  - propertyPath: pages.Array.data[2].options.Array.data[0].title
    key: data.randomeventdata.contract.pages.2.options.0.title
    lastText: "\uD6A8\uACFC\uB97C \uD655\uC778\uD560 \uC218 \uC788\uB294\uC9C0 \uBB3B\uB294\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].description
    key: data.randomeventdata.contract.pages.2.options.0.description
    lastText: 
  - propertyPath: pages.Array.data[2].options.Array.data[0].resultText
    key: data.randomeventdata.contract.pages.2.options.0.resulttext
    lastText: 
  - propertyPath: pages.Array.data[2].options.Array.data[1].title
    key: data.randomeventdata.contract.pages.2.options.1.title
    lastText: "\uC11C\uBA85\uD55C\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[1].description
    key: data.randomeventdata.contract.pages.2.options.1.description
    lastText: "\uBD89\uC740 \uACC4\uC57D\uC11C \uD68D\uB4DD"
  - propertyPath: pages.Array.data[2].options.Array.data[1].resultText
    key: data.randomeventdata.contract.pages.2.options.1.resulttext
    lastText: "\uC11C\uBA85\uC744 \uB9C8\uCE58\uC790 \uC228\uC774 \uC7A0\uC2DC \uB9C9\uD614\uB2E4.
      \uBAB8\uC744 \uC77C\uC73C\uD0A4\uB2C8 \uC774\uC804\uBCF4\uB2E4 \uBB34\uAE30\uAC00
      \uAC00\uBCCD\uAC8C \uB290\uAEF4\uC9C4\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[2].title
    key: data.randomeventdata.contract.pages.2.options.2.title
    lastText: "\uACC4\uC57D\uC11C\uB97C \uD310\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[2].description
    key: data.randomeventdata.contract.pages.2.options.2.description
    lastText: "\uACE8\uB4DC +25"
  - propertyPath: pages.Array.data[2].options.Array.data[2].resultText
    key: data.randomeventdata.contract.pages.2.options.2.resulttext
    lastText: "\uD589\uC0C1\uC740 \uBE48 \uC11C\uBA85\uB780\uC744 \uD655\uC778\uD558\uACE0
      \uB3C8\uC744 \uAC74\uB138\uB2E4."
  - propertyPath: pages.Array.data[3].narrative
    key: data.randomeventdata.contract.pages.3.narrative
    lastText: "\uD589\uC0C1\uC774 \uC791\uC740 \uCD94\uB97C \uACC4\uC57D\uC11C \uC704\uC5D0
      \uC62C\uB9B0\uB2E4.\r\n\r\n\uBD09\uC778\uC5D0\uC11C \uBED7\uC740 \uBD89\uC740
      \uBE5B\uC774 \uCD94\uB97C \uAC10\uC2F8\uC790, \uBB34\uAC70\uC6B4 \uC1F3\uB369\uC774\uAC00
      \uC190\uC27D\uAC8C \uB4E4\uC5B4 \uC62C\uB824\uC9C4\uB2E4.\r\n\r\n\uC0AC\uB78C\uC5D0\uAC8C
      \uC4F0\uBA74 \uC218\uBA85\uC774 \uBE60\uC838\uB098\uAC11\uB2C8\uB2E4. \uACB0\uC815\uD558\uC2DC\uC8E0."
  - propertyPath: pages.Array.data[3].options.Array.data[0].title
    key: data.randomeventdata.contract.pages.3.options.0.title
    lastText: "\uC11C\uBA85\uD55C\uB2E4."
  - propertyPath: pages.Array.data[3].options.Array.data[0].description
    key: data.randomeventdata.contract.pages.3.options.0.description
    lastText: "\uBD89\uC740 \uACC4\uC57D\uC11C \uD68D\uB4DD"
  - propertyPath: pages.Array.data[3].options.Array.data[0].resultText
    key: data.randomeventdata.contract.pages.3.options.0.resulttext
    lastText: "\uC11C\uBA85\uC744 \uB9C8\uCE58\uC790 \uC228\uC774 \uC7A0\uC2DC \uB9C9\uD614\uB2E4.
