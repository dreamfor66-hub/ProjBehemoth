    key: data.randomeventdata.contract.pages.0.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].description
    key: data.randomeventdata.contract.pages.0.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: data.randomeventdata.contract.pages.0.options.2.resulttext
    lastText: "\uADF8\uB300\uB85C \uC790\uB9AC\uB97C \uB5A0\uB0AC\uB2E4."
  - propertyPath: pages.Array.data[1].narrative
    key: data.randomeventdata.contract.pages.1.narrative
    lastText: "\uC11C\uBA85\uD558\uBA74 \uD798\uC744 \uC5BB\uC2B5\uB2C8\uB2E4. \uC774
      \uC131\uC5D0\uC11C \uC624\uB798 \uBC84\uD2F0\uACE0 \uC2F6\uC73C\uBA74 \uC4F8
      \uB9CC\uD558\uC8E0."
  - propertyPath: pages.Array.data[1].options.Array.data[0].title
    key: data.randomeventdata.contract.pages.1.options.0.title
    lastText: "\uB300\uAC00\uB97C \uBB3B\uB294\uB2E4."
