  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.contract.pages.0.narrative
    lastText: "\uBB34\uB108\uC9C4 \uC9D1\uBB34\uC2E4\uC5D0\uC11C \uD589\uC0C1\uC774
      \uBB38\uC11C\uB4E4\uC744 \uACE8\uB77C \uB2F4\uACE0 \uC788\uB2E4.\r\n\r\n\uBC1C\uBC11\uC5D0
      \uB5A8\uC5B4\uC9C4 \uBD89\uC740 \uACC4\uC57D\uC11C\uB97C \uC8FC\uC6B0\uB2C8
      \uD589\uC0C1\uC774 \uC190\uC744 \uB0B4\uBBFC\uB2E4.\r\n\r\n\uC11C\uBA85 \uC548
      \uB41C \uAC70\uAD70\uC694. \uADF8\uAC74 \uC81C\uAC00 \uC0AC\uACA0\uC2B5\uB2C8\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
