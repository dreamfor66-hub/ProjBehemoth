  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: "Data_Event_\uC5B4\uB514\uAE4C\uC9C0_\uD480_\uAC83\uC778\uAC00"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.training.displayname
    lastText: "\uC5B4\uB514\uAE4C\uC9C0 \uD480 \uAC83\uC778\uAC00"
  - propertyPath: narrative
    key: data.randomeventdata.training.narrative
    lastText: "\uB0A1\uC740 \uC6B4\uBC18 \uC7A5\uBE44 \uC0AC\uC774\uC5D0 \uD6C8\uB828
      \uC778\uD615 \uD558\uB098\uAC00 \uBB36\uC5EC \uC788\uB2E4. \uD68C\uC0C9 \uBAB8\uCCB4\uC758
      \uC8FC\uD669\uC0C9 \uB760\uB294 \uC5EC\uB7EC \uBC88 \uC0C8\uB85C \uAC10\uC740
      \uD754\uC801\uC774 \uC788\uB2E4.\n\n\uC6D0\uC815 \uBCF4\uAE09\uD488\uC5D0 \uC4F0\uB294
      \uC218\uB0A9\uD568\uC774 \uC6B4\uBC18\uD2C0 \uC544\uB798 \uBD99\uC5B4 \uC788\uB2E4.\n\n\u201C\uAD6C\uC18D\uC744
      \uB9CE\uC774 \uD480\uC218\uB85D \uAC15\uD558\uAC8C \uC6C0\uC9C1\uC784. \uB3C4\uC804
      \uBCF4\uC0C1\uC740 \uB0B4\uBD80 \uC218\uB0A9\uD568\uC5D0 \uBCF4\uAD00.\u201D\n\n\uBA38\uB9AC\uAC00
      \uC6C0\uC9C1\uC778\uB2E4. \uAC80\uACFC \uB465\uADFC \uBC29\uD328\uAC00 \uB048\uC744
      \uB2F9\uAE30\uBA70 \uB35C\uCEE5\uAC70\uB9B0\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.training.options.0.title
    lastText: "\uB048\uC744 \uD47C\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.training.options.0.description
    lastText: "\uC5F0\uC2B5 \uC778\uD615 \uCCB4\uB825 75. \uC2B9\uB9AC \uD6C4 \uD3EC\uC158
      1\uAC1C. \uD3EC\uC158\uC774 \uAC00\uB4DD\uD558\uBA74 \uCCB4\uB825 8 \uD68C\uBCF5."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.training.options.1.title
    lastText: "\uCCA0\uC0AC\uB97C \uB04A\uB294\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.training.options.1.description
    lastText: "\uC5F0\uC2B5 \uC778\uD615 \uCCB4\uB825 140. \uC2B9\uB9AC \uD6C4 \uBCF4\uC720
      \uB2A5\uB825\uC744 \uB450 \uBC88 \uAC15\uD654."
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.training.options.2.title
    lastText: "\uC0AC\uC2AC\uC744 \uD47C\uB2E4"
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.training.options.2.description
    lastText: "\uC5F0\uC2B5 \uC778\uD615 \uCCB4\uB825 240. \uC2B9\uB9AC \uD6C4 \uACF5\uC6A9
      \uC720\uBB3C \uD558\uB098 \uC120\uD0DD."
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.training.options.0.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.training.options.1.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: options.Array.data[2].resultText
    key: data.randomeventdata.training.options.2.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.training.pages.0.narrative
    lastText: "\uB0A1\uC740 \uC6B4\uBC18 \uC7A5\uBE44 \uC0AC\uC774\uC5D0 \uD6C8\uB828
      \uC778\uD615 \uD558\uB098\uAC00 \uBB36\uC5EC \uC788\uB2E4. \uD68C\uC0C9 \uBAB8\uCCB4\uC758
      \uC8FC\uD669\uC0C9 \uB760\uB294 \uC5EC\uB7EC \uBC88 \uC0C8\uB85C \uAC10\uC740
      \uD754\uC801\uC774 \uC788\uB2E4.\n\n\uC6D0\uC815 \uBCF4\uAE09\uD488\uC5D0 \uC4F0\uB294
      \uC218\uB0A9\uD568\uC774 \uC6B4\uBC18\uD2C0 \uC544\uB798 \uBD99\uC5B4 \uC788\uB2E4.\n\n\u201C\uAD6C\uC18D\uC744
      \uB9CE\uC774 \uD480\uC218\uB85D \uAC15\uD558\uAC8C \uC6C0\uC9C1\uC784. \uB3C4\uC804
      \uBCF4\uC0C1\uC740 \uB0B4\uBD80 \uC218\uB0A9\uD568\uC5D0 \uBCF4\uAD00.\u201D\n\n\uBA38\uB9AC\uAC00
      \uC6C0\uC9C1\uC778\uB2E4. \uAC80\uACFC \uB465\uADFC \uBC29\uD328\uAC00 \uB048\uC744
      \uB2F9\uAE30\uBA70 \uB35C\uCEE5\uAC70\uB9B0\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.training.pages.0.options.0.title
    lastText: "\uB048\uC744 \uD47C\uB2E4"
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
    key: data.randomeventdata.training.pages.0.options.0.description
    lastText: "\uC804\uD22C \xB7 \uD3EC\uC158 1\uAC1C"
  - propertyPath: pages.Array.data[0].options.Array.data[0].resultText
    key: data.randomeventdata.training.pages.0.options.0.resulttext
    lastText: "\uC778\uD615\uC758 \uC6C0\uC9C1\uC784\uC774 \uBA4E\uC5C8\uB2E4. \uC218\uB0A9\uD568\uC5D0\uC11C
      \uBCF4\uC0C1\uC744 \uCC59\uAE30\uC790 \uB0A8\uC740 \uAD6C\uC18D\uAD6C\uB3C4
      \uBC14\uB2E5\uC73C\uB85C \uB5A8\uC5B4\uC84C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].title
    key: data.randomeventdata.training.pages.0.options.1.title
    lastText: "\uCCA0\uC0AC\uB97C \uB04A\uB294\uB2E4"
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
    key: data.randomeventdata.training.pages.0.options.1.description
    lastText: "\uC804\uD22C \xB7 \uBCF4\uC720 \uB2A5\uB825 \uD558\uB098 \uAC15\uD654
      \xB7 \uBCF4\uC720 \uB2A5\uB825 \uD558\uB098 \uAC15\uD654"
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: data.randomeventdata.training.pages.0.options.1.resulttext
    lastText: "\uC778\uD615\uC758 \uC6C0\uC9C1\uC784\uC774 \uBA4E\uC5C8\uB2E4. \uC218\uB0A9\uD568\uC5D0\uC11C
      \uBCF4\uC0C1\uC744 \uCC59\uAE30\uC790 \uB0A8\uC740 \uAD6C\uC18D\uAD6C\uB3C4
