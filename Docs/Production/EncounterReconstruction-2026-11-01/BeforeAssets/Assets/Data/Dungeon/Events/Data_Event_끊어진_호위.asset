  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: "Data_Event_\uB04A\uC5B4\uC9C4_\uD638\uC704"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.shelter.displayname
    lastText: "\uB04A\uC5B4\uC9C4 \uD638\uC704"
  - propertyPath: narrative
    key: data.randomeventdata.shelter.narrative
    lastText: "\uC80A\uC740 \uC6A9\uBCD1\uC774 \uBB34\uB98E\uC744 \uAFC7\uC740 \uCC44
      \uD5C8\uBC85\uC9C0\uC758 \uBD95\uB300\uB97C \uB204\uB974\uACE0 \uC788\uB2E4.
      \uBD80\uB7EC\uC9C4 \uACE0\uC6A9 \uD45C\uC2DD\uACFC \uC798\uB9B0 \uBC27\uC904\uC774
      \uBAA9 \uC544\uB798 \uD754\uB4E4\uB9B0\uB2E4.\n\n\u201C\uC138 \uBC88 \uB2F9\uAE30\uBA74
      \uAC19\uC774 \uB6F0\uAE30\uB85C \uD588\uC5B4\uC694. \uBD84\uBA85\uD788 \uC138
      \uBC88\uC744\u2026\u201D\n\n\uADF8\uB294 \uBC27\uC904 \uB05D\uC744 \uB0B4\uB824\uB2E4\uBCF4\uB2E4
      \uC774\uB97C \uC545\uBB38\uB2E4.\n\n\u201C\uB098\uAC00\uC11C \uBB3C\uC5B4\uBD10\uC57C\uC8E0.
      \uC65C \uCE7C\uB85C \uC798\uB790\uB294\uC9C0.\u201D\n\n\uB0B4\uAC00 \uB2E4\uAC00\uAC00\uC790
      \uC190\uC774 \uAC80\uC790\uB8E8\uB97C \uCC3E\uB294\uB2E4. \uBD95\uB300\uB9CC
      \uB2E4\uC2DC \uBB36\uC73C\uBA74 \uBAB8\uC744 \uC77C\uC73C\uD0AC \uC218 \uC788\uC744
      \uAC83 \uAC19\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.shelter.options.0.title
    lastText: "\uBD88\uC744 \uC9C0\uD0A4\uBA70 \uC270\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.shelter.options.0.description
    lastText: "\uCCB4\uB825 24 \uD68C\uBCF5."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.shelter.options.1.title
    lastText: "\uBC24\uC0C8 \uBAB8\uC744 \uB2E8\uB828\uD55C\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.shelter.options.1.description
    lastText: "\uCD5C\uB300\xB7\uD604\uC7AC \uCCB4\uB825 +5."
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.shelter.options.2.title
    lastText: "\uB108 \uBA3C\uC800 \uC790. \uB2E4\uC74C\uC740 \uB0B4 \uCC28\uB840\uC57C"
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.shelter.options.2.description
    lastText: "\uAC15\uC544\uC9C0\uC640 \uBC88\uAC08\uC544 \uB9DD\uC744 \uBCF8\uB2E4.
      \uCCB4\uB825 28 \uD68C\uBCF5, \uACE8\uB4DC +12."
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.shelter.options.0.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.shelter.options.1.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: options.Array.data[2].resultText
    key: data.randomeventdata.shelter.options.2.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.shelter.pages.0.narrative
    lastText: "\uC80A\uC740 \uC6A9\uBCD1\uC774 \uBB34\uB98E\uC744 \uAFC7\uC740 \uCC44
      \uD5C8\uBC85\uC9C0\uC758 \uBD95\uB300\uB97C \uB204\uB974\uACE0 \uC788\uB2E4.
      \uBD80\uB7EC\uC9C4 \uACE0\uC6A9 \uD45C\uC2DD\uACFC \uC798\uB9B0 \uBC27\uC904\uC774
      \uBAA9 \uC544\uB798 \uD754\uB4E4\uB9B0\uB2E4.\n\n\u201C\uC138 \uBC88 \uB2F9\uAE30\uBA74
      \uAC19\uC774 \uB6F0\uAE30\uB85C \uD588\uC5B4\uC694. \uBD84\uBA85\uD788 \uC138
      \uBC88\uC744\u2026\u201D\n\n\uADF8\uB294 \uBC27\uC904 \uB05D\uC744 \uB0B4\uB824\uB2E4\uBCF4\uB2E4
      \uC774\uB97C \uC545\uBB38\uB2E4.\n\n\u201C\uB098\uAC00\uC11C \uBB3C\uC5B4\uBD10\uC57C\uC8E0.
      \uC65C \uCE7C\uB85C \uC798\uB790\uB294\uC9C0.\u201D\n\n\uB0B4\uAC00 \uB2E4\uAC00\uAC00\uC790
      \uC190\uC774 \uAC80\uC790\uB8E8\uB97C \uCC3E\uB294\uB2E4. \uBD95\uB300\uB9CC
      \uB2E4\uC2DC \uBB36\uC73C\uBA74 \uBAB8\uC744 \uC77C\uC73C\uD0AC \uC218 \uC788\uC744
      \uAC83 \uAC19\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.shelter.pages.0.options.0.title
    lastText: "\uBD95\uB300\uB97C \uBB36\uC5B4 \uC8FC\uACE0 \uC7A0\uC2DC \uB9DD\uC744
      \uBCF8\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
    key: data.randomeventdata.shelter.pages.0.options.0.description
    lastText: "\uCCB4\uB825 +24"
  - propertyPath: pages.Array.data[0].options.Array.data[0].resultText
    key: data.randomeventdata.shelter.pages.0.options.0.resulttext
    lastText: "\uC6A9\uBCD1\uC774 \uBD95\uB300\uB97C \uB2F9\uACA8 \uB9E4\uB294 \uB3D9\uC548
      \uACC1\uC744 \uC9C0\uCF30\uB2E4. \uB0B4 \uC228\uB3C4 \uCC28\uCE30 \uACE0\uB974\uAC8C
      \uB3CC\uC544\uC654\uB2E4. \uADF8\uB294 \uAC80\uC744 \uC9C0\uD321\uC774 \uC0BC\uC544
      \uC77C\uC5B4\uB098 \uB3CC\uC544\uAC08 \uBC29\uD5A5\uC744 \uD655\uC778\uD588\uB2E4.
      \u201C\uC5EC\uAE30\uC11C \uB05D\uB0BC \uC0DD\uAC01\uC740 \uC5C6\uC2B5\uB2C8\uB2E4.\u201D"
  - propertyPath: pages.Array.data[0].options.Array.data[1].title
    key: data.randomeventdata.shelter.pages.0.options.1.title
    lastText: "\uCE7C\uC744 \uBF51\uAE30 \uC804\uC5D0 \uD488\uC0AF\uBD80\uD130 \uBE7C\uC557\uB294\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
    key: data.randomeventdata.shelter.pages.0.options.1.description
    lastText: "\uACE8\uB4DC +22"
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: data.randomeventdata.shelter.pages.0.options.1.resulttext
    lastText: "\uAC80\uC790\uB8E8\uB97C \uB204\uB974\uACE0 \uB0A8\uC740 \uD488\uC0AF\uC744
      \uAEBC\uB0C8\uB2E4. \uC6A9\uBCD1\uC740 \uD53C \uBB3B\uC740 \uBD95\uB300\uB97C
      \uB193\uC9C0 \uBABB\uD55C \uCC44 \uB098\uB97C \uB178\uB824\uBD24\uB2E4. \uB098\uB294
      \uB3C8\uC744 \uCC59\uACA8 \uBE44\uCF1C\uC130\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].title
    key: data.randomeventdata.shelter.pages.0.options.2.title
    lastText: "\uD68C\uC218\uACAC\uACFC \uD568\uAED8 \uB9DD\uC744 \uBD10 \uC900\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].description
    key: data.randomeventdata.shelter.pages.0.options.2.description
    lastText: "\uCCB4\uB825 +28 \xB7 \uACE8\uB4DC +12"
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: data.randomeventdata.shelter.pages.0.options.2.resulttext
    lastText: "\uD68C\uC218\uACAC\uC774 \uADC0\uB97C \uC138\uC6B0\uACE0 \uC8FC\uC704\uB97C
      \uC0B4\uD53C\uB294 \uB3D9\uC548 \uBD95\uB300\uB97C \uC0C8\uB85C \uBB36\uC5C8\uB2E4.
      \uC6A9\uBCD1\uC740 \uB0A8\uC740 \uD488\uC0AF\uC744 \uB0B4\uBC00\uACE0 \uAC80\uC744
      \uC9DA\uC5B4 \uC77C\uC5B4\uB0AC\uB2E4. \u201C\uC774\uBC88\uC5D0\uB294 \uC81C
      \uBC1C\uB85C \uB098\uAC00\uACA0\uC2B5\uB2C8\uB2E4.\u201D"
  - propertyPath: pages.Array.data[0].options.Array.data[3].title
    key: data.randomeventdata.shelter.pages.0.options.3.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[3].description
    key: data.randomeventdata.shelter.pages.0.options.3.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[3].resultText
    key: data.randomeventdata.shelter.pages.0.options.3.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  textOwnerGuid: 3794989680026e142a819014614c80e8
  id: Shelter
  displayName: "\uB04A\uC5B4\uC9C4 \uD638\uC704"
  discovery: 1
  worldObject: {fileID: 11400000, guid: c0efd6cf0fb18ae4395788bc5284c680, type: 2}
  encounterKind: 1
  authoringLore: "\uC0C1\uB2E8\uC758 \uACE0\uC6A9 \uD45C\uC2DD\uC744 \uB2E8 \uC80A\uC740
    \uD638\uC704 \uC6A9\uBCD1. \uAD34\uC218\uC5D0\uAC8C \uCAD3\uAE30\uB2E4 \uC8FC\uC778\uC774
    \uC5F0\uACB0 \uBC27\uC904\uC744 \uB04A\uACE0 \uB3C4\uB9DD\uCCD0 \uBD80\uC0C1\uC744
    \uC785\uC5C8\uB2E4. \uBC30\uC2E0\uC744 \uD655\uC778\uD558\uB824\uACE0 \uC790\uC2E0\uC758
    \uBC1C\uB85C \uB098\uAC08 \uC0DD\uAC01\uC774\uBA70, \uC808\uB9DD\uD574 \uC601\uC8FC\uD558\uB294
    \uC0AC\uB78C\uC774 \uC544\uB2C8\uB2E4. \uBD80\uC0C1\uC73C\uB85C \uBB34\uB98E\uC744
    \uAFC7\uC740 \uC774\uC720\uAC00 \uADF8\uB9BC\uACFC \uD589\uB3D9\uC5D0 \uB4DC\uB7EC\uB09C\uB2E4."
  roomLayout: 0
  roomInteriors:
