  textOwnerGuid: a8a0118921996ec409b5302773362a91
  id: Delivery
  displayName: "\uC608\uC57D\uC790\uC758 \uD45C\uC2DD"
  discovery: 1
  worldObject: {fileID: 11400000, guid: 0f8ce9a71a332a24d9981e26a5247b1d, type: 2}
  encounterKind: 0
  authoringLore: "\uC55E\uC11C \uC120\uBD88 \uC6B4\uC784\uC744 \uBC1B\uC740 \uACC4\uC57D
    \uC9D0\uAFBC\uC774 \uC2E4\uC81C \uBB3C\uD488\uC744 \uB193\uC740 \uBCF4\uAD00\uCE78.
    \uAC19\uC740 \uD45C\uC2DD\uACFC \uD544\uCCB4\uAC00 \uC778\uACFC\uB97C \uC774\uC5B4
    \uC900\uB2E4. \uAFB8\uB7EC\uBBF8 \uC18D \uBB3C\uAC74\uC740 \uC804\uBD80 \uBC1B\uC744
    \uC218 \uC788\uB2E4. \uAE30\uC220 \uD558\uB098\uB97C \uC78A\uC73C\uBA74 \uB3C8\uC774
    \uB098\uC624\uB294 \uAE08\uACE0/\uBC18\uB0A9\uD560 \uC774\uC720 \uC5C6\uB294
    \uC591\uC790\uD0DD\uC77C\uC740 \uD3D0\uAE30\uD55C\uB2E4. \uBCF4\uAD00\uBB3C\uC744
    \uAC74\uB4DC\uB9AC\uC9C0 \uC54A\uC73C\uBA74 \uC608\uC57D\uC740 \uC720\uC9C0\uB41C\uB2E4."
