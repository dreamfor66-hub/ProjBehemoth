  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: "Data_Event_\uC608\uC57D\uC790\uC758_\uD45C\uC2DD"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.delivery.displayname
    lastText: "\uC608\uC57D\uC790\uC758 \uD45C\uC2DD"
  - propertyPath: narrative
    key: data.randomeventdata.delivery.narrative
    lastText: "\uBCBD\uC758 \uBCF4\uAD00\uCE78\uC5D0 \uC6B4\uBC18\uD2C0 \uD558\uB098\uAC00
      \uAE30\uB304 \uCC44 \uB193\uC5EC \uC788\uB2E4. \uADF8 \uC548\uC758 \uAFB8\uB7EC\uBBF8\uC5D0\uB294
      \uB0B4\uAC00 \uC9D0\uAFBC\uC5D0\uAC8C \uB9E1\uAE34 \uD45C\uC2DD\uC774 \uB9E4\uB4ED\uC73C\uB85C
      \uBB36\uC5EC \uC788\uB2E4.\n\n\uB048 \uC544\uB798 \uC811\uD78C \uCABD\uC9C0\uC5D0\uC11C
      \uC775\uC219\uD55C \uD544\uCCB4\uAC00 \uBCF4\uC778\uB2E4.\n\n\u201C\uC57D\uC18D\uD55C
      \uC7A5\uBE44 \uD55C \uC810\uC785\uB2C8\uB2E4. \uC6B4\uC784\uC740 \uBC1B\uC558\uACE0,
      \uB098\uB294 \uB2E4\uC74C \uBCF4\uAD00\uCE78\uC73C\uB85C \uAC11\uB2C8\uB2E4.\u201D\n\n\uAFB8\uB7EC\uBBF8\uB294
      \uBD09\uD574\uC838 \uC788\uACE0, \uB2E4\uB978 \uC0AC\uB78C\uC758 \uD45C\uC2DD\uC740
      \uBD99\uC5B4 \uC788\uC9C0 \uC54A\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.delivery.options.0.title
    lastText: "\uD45C\uC2DD\uC744 \uD655\uC778\uD558\uACE0 \uAFB8\uB7EC\uBBF8\uB97C
      \uD47C\uB2E4."
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.delivery.options.0.description
    lastText: "\uACF5\uC6A9 \uC720\uBB3C 1\uAC1C \uD68D\uB4DD"
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.delivery.options.0.resulttext
    lastText: "\uC6B4\uBC18\uD2C0\uC744 \uB0B4\uB9AC\uACE0 \uB9E4\uB4ED\uC744 \uD480\uC5C8\uB2E4.
      \uD3EC\uC7A5 \uC18D \uC7A5\uBE44\uB97C \uAEBC\uB0B4 \uBAB8\uC5D0 \uB9DE\uCDB0
      \uAC78\uC5C8\uB2E4. \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uB0B4 \uD45C\uC2DD\uC744
      \uB5BC\uC5B4 \uD488\uC5D0 \uB123\uC5C8\uB2E4. \uBE48 \uD3EC\uC7A5\uB9CC \uBCF4\uAD00\uCE78\uC5D0
      \uC811\uC5B4 \uB450\uC5C8\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.delivery.pages.0.narrative
    lastText: "\uBCBD\uC758 \uBCF4\uAD00\uCE78\uC5D0 \uC6B4\uBC18\uD2C0 \uD558\uB098\uAC00
      \uAE30\uB304 \uCC44 \uB193\uC5EC \uC788\uB2E4. \uADF8 \uC548\uC758 \uAFB8\uB7EC\uBBF8\uC5D0\uB294
