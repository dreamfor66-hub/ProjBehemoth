  worldObject: {fileID: 11400000, guid: 9edb47771d177ec48a413ee6f6c008c7, type: 2}
  encounterKind: 0
  authoringLore: "\uAE09\uB8CC\uACE0\uC758 \uBB34\uB108\uC9C4 \uBC30\uC218\uCE35
    \uC704\uC5D0 \uB0A8\uC740 \uCCA0\uC81C \uAE08\uACE0. \uAE30\uC6B8\uC5B4\uC9C4
    \uC11D\uD310\uACFC \uBC8C\uC5B4\uC9C4 \uBC14\uB2E5\uC740 \uD074\uB9AD \uC774\uC804
    \uD658\uACBD\uC5D0\uB3C4 \uBCF4\uC778\uB2E4. \uC811\uADFC\uC758 \uD558\uC911
    \uB54C\uBB38\uC5D0 \uB9C8\uC9C0\uB9C9 \uBC1B\uCE68\uC774 \uC6C0\uC9C1\uC5EC \uAE08\uACE0\uAC00
    \uBBF8\uB044\uB7EC\uC9C4\uB2E4. \uAE08\uD654\uB97C \uBE7C\uB0B4\uB824\uBA74 \uBB34\uB108\uC9C0\uB294
    \uD310\uC744 \uBD99\uB4E4\uC5B4\uC57C \uD558\uACE0, \uBB3C\uB7EC\uC11C\uBA74
    \uAE08\uACE0\uB97C \uC783\uB294\uB2E4. \uC774\uB984\uBFD0\uC778 \uC800\uC8FC/\uB9E4\uB2EC\uB9B0
    \uC8FC\uBA38\uB2C8/\uC54C \uC218 \uC5C6\uB294 \uACBD\uACE0\uBB38\uC740 \uC804\uBD80
    \uD3D0\uAE30\uD55C\uB2E4. \uC5B4\uB290 \uC120\uD0DD\uC774\uB4E0 \uAE08\uACE0\uB294
    \uC544\uB798\uB85C \uB5A8\uC5B4\uC838 \uAC19\uC740 \uB300\uC0C1\uC5D0 \uC7AC\uB3C4\uC804\uD558\uC9C0
    \uBABB\uD55C\uB2E4."
