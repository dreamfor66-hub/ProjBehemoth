  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: "Data_Event_\uBC30\uB2EC\uC9C0\uB294_\uB2E4\uC74C_\uB9C9"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.investment.displayname
    lastText: "\uBC30\uB2EC\uC9C0\uB294 \uB2E4\uC74C \uB9C9"
  - propertyPath: narrative
    key: data.randomeventdata.investment.narrative
    lastText: "\uC6B4\uBC18\uD2C0\uC744 \uBA58 \uC9D0\uAFBC\uC774 \uC5B4\uAE68\uB048\uC744
      \uB2F9\uACA8 \uC870\uC778\uB2E4. \uB048\uC5D0\uB294 \uC11C\uB85C \uB2E4\uB978
      \uC0C1\uC810\uC758 \uB0A9\uD488\uD45C\uAC00 \uACB9\uCCD0 \uB2EC\uB824 \uC788\uB2E4.\n\n\u201C\uB354
      \uB0B4\uB824\uAC00\uC2DC\uC8E0? \uC9C0\uAE08 \uB9E1\uAE30\uC2DC\uBA74 \uC81C\uAC00
      \uBA3C\uC800 \uBB3C\uAC74\uC744 \uB194\uB450\uACA0\uC2B5\uB2C8\uB2E4. \uD45C\uC2DD\uC740
      \uBCF8\uC778\uC774 \uACE0\uB974\uC138\uC694.\u201D\n\n\uC6B4\uBC18\uD2C0 \uD55C\uCABD\uC5D0\uB294
      \uBD89\uAC8C \uC9C0\uC6B4 \uC800\uB2F9 \uD45C\uC2DD\uC774 \uB0A8\uC544 \uC788\uB2E4.
      \uC9D0\uAFBC\uC740 \uB0B4 \uC2DC\uC120\uC744 \uC54C\uC544\uCC44\uACE0 \uC6C3\uB294\uB2E4.\n\n\u201C\uC774\uBC88
      \uC6B4\uC784\uAE4C\uC9C0 \uBC1B\uC73C\uBA74 \uC81C \uAC83\uC774\uAC70\uB4E0\uC694.
      \uB2A6\uAC8C \uC624\uB294 \uC77C\uC740 \uC5C6\uC744 \uAC81\uB2C8\uB2E4.\u201D"
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.investment.options.0.title
    lastText: "\uB3C4\uCC29\uD574\uC11C \uBC1B\uB294\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.investment.options.0.description
    lastText: "25\uACE8\uB4DC \uC18C\uBAA8. \uB2E4\uC74C \uB9C9\uC758 \uBC30\uB2EC
      \uC0AC\uAC74\uC5D0\uC11C \uC720\uBB3C\uACFC \uACE8\uB4DC \uC218\uB839."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.investment.options.1.title
    lastText: "\uC9C0\uAE08 \uC4F8 \uC57D\uC744 \uBC1B\uB294\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.investment.options.1.description
    lastText: "\uD3EC\uC158 1\uAC1C. \uBC30\uB2EC \uC608\uC57D\uC740 \uD558\uC9C0
      \uC54A\uB294\uB2E4."
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.investment.options.0.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.investment.options.1.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.investment.pages.0.narrative
    lastText: "\uC6B4\uBC18\uD2C0\uC744 \uBA58 \uC9D0\uAFBC\uC774 \uC5B4\uAE68\uB048\uC744
      \uB2F9\uACA8 \uC870\uC778\uB2E4. \uB048\uC5D0\uB294 \uC11C\uB85C \uB2E4\uB978
      \uC0C1\uC810\uC758 \uB0A9\uD488\uD45C\uAC00 \uACB9\uCCD0 \uB2EC\uB824 \uC788\uB2E4.\n\n\u201C\uB354
      \uB0B4\uB824\uAC00\uC2DC\uC8E0? \uC9C0\uAE08 \uB9E1\uAE30\uC2DC\uBA74 \uC81C\uAC00
      \uBA3C\uC800 \uBB3C\uAC74\uC744 \uB194\uB450\uACA0\uC2B5\uB2C8\uB2E4. \uD45C\uC2DD\uC740
      \uBCF8\uC778\uC774 \uACE0\uB974\uC138\uC694.\u201D\n\n\uC6B4\uBC18\uD2C0 \uD55C\uCABD\uC5D0\uB294
      \uBD89\uAC8C \uC9C0\uC6B4 \uC800\uB2F9 \uD45C\uC2DD\uC774 \uB0A8\uC544 \uC788\uB2E4.
      \uC9D0\uAFBC\uC740 \uB0B4 \uC2DC\uC120\uC744 \uC54C\uC544\uCC44\uACE0 \uC6C3\uB294\uB2E4.\n\n\u201C\uC774\uBC88
      \uC6B4\uC784\uAE4C\uC9C0 \uBC1B\uC73C\uBA74 \uC81C \uAC83\uC774\uAC70\uB4E0\uC694.
      \uB2A6\uAC8C \uC624\uB294 \uC77C\uC740 \uC5C6\uC744 \uAC81\uB2C8\uB2E4.\u201D"
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.investment.pages.0.options.0.title
    lastText: "\uB3C4\uCC29\uD574\uC11C \uBC1B\uB294\uB2E4"
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
    key: data.randomeventdata.investment.pages.0.options.0.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[0].resultText
    key: data.randomeventdata.investment.pages.0.options.0.resulttext
    lastText: "\uC9D0\uAFBC\uC740 \uB0B4 \uD45C\uC2DD\uC744 \uBC1B\uC544 \uC7A5\uBD80\uC5D0
      \uBD99\uC600\uB2E4. \u201C\uB2E4\uC74C \uAD6C\uC5ED\uC758 \uD1B5\uB85C\uC5D0\uC11C
      \uCC3E\uC544\uBCF4\uC138\uC694.\u201D \uC6B4\uBC18\uD2C0\uC744 \uACE0\uCCD0
      \uBA58 \uADF8\uAC00 \uBA3C\uC800 \uAE38\uC744 \uB5A0\uB0AC\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].title
    key: data.randomeventdata.investment.pages.0.options.1.title
    lastText: "\uC57D \uAFB8\uB7EC\uBBF8\uB97C \uBE7C\uC557\uB294\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
    key: data.randomeventdata.investment.pages.0.options.1.description
    lastText: "\uD68C\uBCF5 \uD3EC\uC158 \uD68D\uB4DD"
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: data.randomeventdata.investment.pages.0.options.1.resulttext
    lastText: "\uC5B4\uAE68\uB048\uC744 \uC7A1\uC544\uB2F9\uACA8 \uC57D \uAFB8\uB7EC\uBBF8\uB97C
      \uB09A\uC544\uCC58\uB2E4. \uBB34\uAC70\uC6B4 \uC6B4\uBC18\uD2C0\uC5D0 \uBC1C\uC774
      \uBB36\uC778 \uC9D0\uAFBC\uC740 \uCAD3\uC544\uC624\uC9C0 \uBABB\uD588\uB2E4.
      \uB04A\uC5B4\uC9C4 \uB048\uC744 \uC954 \uCC44 \uB098\uB97C \uB178\uB824\uBCF4\uB2E4
      \uB2E4\uB978 \uD1B5\uB85C\uB85C \uC0AC\uB77C\uC84C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].title
    key: data.randomeventdata.investment.pages.0.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].description
    key: data.randomeventdata.investment.pages.0.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: data.randomeventdata.investment.pages.0.options.2.resulttext
    lastText: "\uC778\uC0AC\uB97C \uB098\uB204\uACE0 \uBE44\uCF1C\uC130\uB2E4. \uC9D0\uAFBC\uC740
      \uC6B4\uBC18\uD2C0\uC744 \uBA54\uACE0 \uAE38\uC744 \uB5A0\uB0AC\uB2E4."
  textOwnerGuid: 069415c2c79b5f4449a6eae4ccbe75f3
  id: Investment
  displayName: "\uBC30\uB2EC\uC9C0\uB294 \uB2E4\uC74C \uB9C9"
  discovery: 1
  worldObject: {fileID: 11400000, guid: 4a44692d76b58b14bb0ca1036bac1b0d, type: 2}
  encounterKind: 1
  authoringLore: "\uC6D0\uC815\uB300\uC640 \uC131 \uBC16 \uC0C1\uC810 \uC0AC\uC774\uB97C
    \uC624\uAC00\uB294 \uACC4\uC57D \uC9D0\uAFBC. \uC120\uBD88 \uC6B4\uC784\uC73C\uB85C
    \uB2F4\uBCF4 \uC7A1\uD78C \uC6B4\uBC18\uD2C0\uC744 \uB418\uCC3E\uC73C\uB824 \uD55C\uB2E4.
    \uC774\uBBF8 \uC775\uD78C \uC2E4\uC81C \uAE38\uC744 \uB418\uC9DA\uC5B4 \uB2E4\uC74C
    \uAD6C\uC5ED\uC5D0 \uBB3C\uAC74\uC744 \uB193\uB294\uB2E4. \uACF5\uC9DC \uD638\uC758\uAC00
    \uC544\uB2C8\uB77C \uC2E0\uC6A9\uACFC \uB0A9\uD488 \uC2DC\uAC04\uC744 \uC9C0\uD0A4\uB294
    \uC9C1\uC5C5\uC801 \uC120\uD0DD\uC774\uB2E4."
  roomLayout: 0
  roomInteriors:
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
  excludedFromRandomPool: 0
