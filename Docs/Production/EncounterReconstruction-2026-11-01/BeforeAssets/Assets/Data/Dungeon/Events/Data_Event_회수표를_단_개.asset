  pages:
  - narrative: "\uD070 \uD68C\uC0C9 \uAC1C\uAC00 \uC55E\uBC1C\uC744 \uBED7\uACE0
      \uB204\uC6CC \uC788\uB2E4. \uBAA9\uC904\uC758 \uC9E7\uC740 \uC1E0\uC904\uC774
      \uBD80\uB7EC\uC9C4 \uACE0\uB9AC\uC5D0 \uAC78\uB824 \uC788\uB2E4. \uBAB8\uC744
      \uC77C\uC73C\uD0A4\uB824 \uD560 \uB54C\uB9C8\uB2E4 \uC624\uB978 \uC55E\uBC1C\uC774
      \uAEBE\uC778\uB2E4.\n\n\uB0A1\uC740 \uAC00\uC8FD \uBAA9\uC904\uC5D0\uB294 \uD68C\uC218\uB300\uC758
      \uD45C\uC2DD\uC774 \uB2EC\uB824 \uC788\uB2E4. \uAC1C\uB294 \uB0B4 \uC190\uC744
      \uBCF4\uBA70 \uB0AE\uAC8C \uC73C\uB974\uB801\uAC70\uB9B0\uB2E4. \uB3C4\uB9DD\uAC08
      \uAE38\uBD80\uD130 \uC7AC\uB294 \uB208\uC774\uB2E4."
    illustration: {fileID: 21300000, guid: 79f48b6679a5ee84698394050f282e51, type: 3}
