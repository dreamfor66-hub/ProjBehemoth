  textOwnerGuid: 08bea5284c5daf54293c46921b217cb9
  id: Banner
  displayName: "\uAE43\uBC1C\uC744 \uC9C0\uD0A4\uB294 \uC9D0\uC2B9"
  discovery: 0
  worldObject: {fileID: 11400000, guid: 297f092a5c2f1734a888b6661fb477b3, type: 2}
  encounterKind: 3
  authoringLore: "\uAD70\uC6A9 \uBAA9\uC904\uACFC \uB04A\uC5B4\uC9C4 \uACE0\uC090\uB97C
    \uB2E8 \uAC00\uC2DC\uB4F1 \uC9D0\uC2B9\uC774 \uAC19\uC740 \uBB38\uC591\uC758
    \uAE43\uBC1C\uC744 \uC9C0\uD0A8\uB2E4. \uC8FC\uC778\uC758 \uD589\uBC29\uC740
    \uC54C \uC218 \uC5C6\uB2E4. \uAE43\uBC1C\uC744 \uC5BB\uC73C\uB824\uBA74 \uC2E4\uC81C
    \uAC19\uC740 \uC9D0\uC2B9\uACFC \uC2F8\uC6CC\uC57C \uD55C\uB2E4. \uBE44\uCF1C\uAC00\uBA74
    \uC9D0\uC2B9\uC740 \uADF8\uB300\uB85C \uC9C0\uD0A4\uACE0, \uB2E4\uC74C\uC5D0
    \uB2E4\uC2DC \uB300\uCE58\uD560 \uC218 \uC788\uB2E4. \uAE30\uD68C\uAC00 \uC0AC\uB77C\uC9C0\uB294
    \uC774\uC720\uB97C \uC5B5\uC9C0\uB85C \uB9CC\uB4E4\uC9C0 \uC54A\uB294 \uC0DD\uBB3C
    \uC870\uC6B0\uB2E4."
