  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: "Data_Event_\uAE43\uBC1C\uC744_\uC9C0\uD0A4\uB294_\uC9D0\uC2B9"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.banner.displayname
    lastText: "\uAE43\uBC1C\uC744 \uC9C0\uD0A4\uB294 \uC9D0\uC2B9"
  - propertyPath: narrative
    key: data.randomeventdata.banner.narrative
    lastText: "\uAC00\uC2DC \uB3CB\uC740 \uC9D0\uC2B9\uC774 \uAEBE\uC778 \uAE43\uB300
      \uC704\uC5D0 \uC55E\uBC1C\uC744 \uC62C\uB824\uB193\uACE0 \uC788\uB2E4. \uBAA9\uC904\uC5D0\uB294
      \uB04A\uC5B4\uC9C4 \uACE0\uC090\uAC00 \uB9E4\uB2EC\uB824 \uC788\uB2E4. \uB2F3\uC740
      \uAD70\uC6A9 \uD45C\uC2DD\uC758 \uBB38\uC591\uACFC \uAE43\uBC1C\uC758 \uBB38\uC591\uC774
      \uAC19\uB2E4.\n\n\uAE43\uBC1C\uC5D0 \uC190\uC744 \uBED7\uC790 \uC9D0\uC2B9\uC774
      \uC77C\uC5B4\uC120\uB2E4. \uACE0\uC090\uAC00 \uBC14\uB2E5\uC744 \uAE01\uB294\uB2E4.
      \uB4A4\uB85C \uBB3C\uB7EC\uB098\uC790 \uB354 \uCAD3\uC544\uC624\uC9C0\uB294
      \uC54A\uACE0 \uAE43\uB300 \uACC1\uC744 \uB9F4\uB3C8\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.banner.options.0.title
    lastText: "\uC9D0\uC2B9\uC744 \uBB3C\uB9AC\uCE58\uACE0 \uAE43\uBC1C\uC744 \uCC59\uAE34\uB2E4."
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.banner.options.0.description
    lastText: "\uC804\uD22C \xB7 \uC774\uB984 \uC5C6\uB294 \uAE43\uBC1C \uD68D\uB4DD"
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.banner.options.1.title
    lastText: "\uC9D0\uC2B9\uC758 \uC601\uC5ED\uC744 \uD53C\uD574 \uC9C0\uB098\uAC04\uB2E4."
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.banner.options.1.description
    lastText: 
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.banner.options.0.resulttext
    lastText: "\uC9D0\uC2B9\uC774 \uC4F0\uB7EC\uC84C\uB2E4. \uB04A\uC5B4\uC9C4 \uACE0\uC090\uB97C
      \uBC1F\uACE0 \uAE43\uB300\uB97C \uB4E4\uC5B4 \uC62C\uB838\uB2E4. \uB0A0\uC774
      \uB2F3\uC740 \uAD70\uC6A9 \uD45C\uC2DD\uC774 \uAE43\uBC1C\uACFC \uBD80\uB52A\uD614\uB2E4."
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.banner.options.1.resulttext
    lastText: "\uAE43\uBC1C\uC5D0\uC11C \uC190\uC744 \uAC70\uB480\uB2E4. \uC9D0\uC2B9\uC740
      \uAE43\uB300\uB97C \uB2E4\uC2DC \uC55E\uBC1C\uB85C \uB204\uB974\uACE0, \uB0B4\uAC00
      \uBA40\uC5B4\uC9C8 \uB54C\uAE4C\uC9C0 \uC774\uBE68\uC744 \uB4DC\uB7EC\uB0C8\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.banner.pages.0.narrative
    lastText: "\uAC00\uC2DC \uB3CB\uC740 \uC9D0\uC2B9\uC774 \uAEBE\uC778 \uAE43\uB300
      \uC704\uC5D0 \uC55E\uBC1C\uC744 \uC62C\uB824\uB193\uACE0 \uC788\uB2E4. \uBAA9\uC904\uC5D0\uB294
      \uB04A\uC5B4\uC9C4 \uACE0\uC090\uAC00 \uB9E4\uB2EC\uB824 \uC788\uB2E4. \uB2F3\uC740
      \uAD70\uC6A9 \uD45C\uC2DD\uC758 \uBB38\uC591\uACFC \uAE43\uBC1C\uC758 \uBB38\uC591\uC774
      \uAC19\uB2E4.\n\n\uAE43\uBC1C\uC5D0 \uC190\uC744 \uBED7\uC790 \uC9D0\uC2B9\uC774
      \uC77C\uC5B4\uC120\uB2E4. \uACE0\uC090\uAC00 \uBC14\uB2E5\uC744 \uAE01\uB294\uB2E4.
      \uB4A4\uB85C \uBB3C\uB7EC\uB098\uC790 \uB354 \uCAD3\uC544\uC624\uC9C0\uB294
      \uC54A\uACE0 \uAE43\uB300 \uACC1\uC744 \uB9F4\uB3C8\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.banner.pages.0.options.0.title
    lastText: "\uC9D0\uC2B9\uC744 \uBB3C\uB9AC\uCE58\uACE0 \uAE43\uBC1C\uC744 \uCC59\uAE34\uB2E4."
