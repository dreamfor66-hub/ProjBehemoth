  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: "Data_Event_\uBD09\uC778\uB41C_\uAD50\uBC94"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.scholar.displayname
    lastText: "\uBD09\uC778\uB41C \uAD50\uBC94"
  - propertyPath: narrative
    key: data.randomeventdata.scholar.narrative
    lastText: "\uBB36\uC778 \uAE30\uB85D\uB4E4 \uC0AC\uC774\uC5D0\uC11C \uCC45 \uD55C
      \uAD8C\uB9CC \uB5A0 \uC788\uB2E4. \uCC45\uB4F1\uC758 \uAE00\uC528\uB97C \uC0B4\uD53C\uB824
      \uD45C\uC9C0\uB97C \uAC74\uB4DC\uB9AC\uC790 \uC885\uC774\uAC00 \uC190\uBAA9\uC744
      \uD718\uAC10\uB294\uB2E4.\n\n\uC190\uC744 \uB2F9\uAE38\uC218\uB85D \uC885\uC774
      \uB05D\uC774 \uC0B4\uC5D0 \uD30C\uACE0\uB4E0\uB2E4. \uCC45\uB4F1\uC5D0 \uCC0D\uD78C
      \uAE00\uC790\uAC00 \uC190\uB05D\uC5D0\uC11C \uBD89\uC5B4\uC9C4\uB2E4.\n\n\u201C\uD55C
      \uB3C5\uC790\uC5D0\uAC8C \uD55C \uC7A5. \uC789\uD06C\uB97C \uC0B4\uB9AC\uB824\uAC70\uB4E0
      \uD53C\uB97C \uB308 \uAC83.\u201D\n\n\uD3BC\uCCD0\uC9C4 \uB450 \uC7A5\uC5D0\uB294
      \uAC80\uC758 \uADA4\uC801\uACFC \uBE5B\uBC14\uB79C \uC601\uCC3D\uC774 \uBCF4\uC778\uB2E4.
      \uC885\uC774 \uD2C8\uC740 \uBB34\uAE30 \uB05D\uC73C\uB85C \uCC22\uC744 \uC218
      \uC788\uC744 \uB9CC\uD07C \uBC8C\uC5B4\uC838 \uC788\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.scholar.options.0.title
    lastText: "\uBAB8\uC5D0 \uC775\uD78C \uAE30\uC220\uACFC \uAC80\uC220 \uB3C4\uD574\uB97C
      \uB9DE\uCDB0 \uBCF8\uB2E4."
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.scholar.options.0.description
    lastText: "\uBCF4\uC720 \uB2A5\uB825 \uD558\uB098 \uAC15\uD654"
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.scholar.options.1.title
    lastText: "\uD53C\uB97C \uB5A8\uC5B4\uB728\uB824 \uC601\uCC3D\uC744 \uC77D\uB294\uB2E4."
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.scholar.options.1.description
    lastText: "\uCCB4\uB825 9 \uC9C0\uBD88 \xB7 \uC8FC\uBB38 \uD558\uB098 \uC2B5\uB4DD"
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.scholar.options.2.title
    lastText: "\uC885\uC774\uB97C \uCC22\uACE0 \uC190\uC744 \uBE7C\uB0B8\uB2E4."
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.scholar.options.2.description
    lastText: "\uBCF4\uC0C1 \uC5C6\uC774 \uAD50\uBC94 \uD30C\uAD34"
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.scholar.options.0.resulttext
    lastText: "\uC775\uC219\uD55C \uB3D9\uC791\uC744 \uB3C4\uD574\uC640 \uB9DE\uCDB0
      \uB418\uC9DA\uC5C8\uB2E4. \uB9C8\uC9C0\uB9C9 \uADA4\uC801\uC744 \uB530\uB77C\uAC00\uC790
      \uC789\uD06C\uAC00 \uC190\uB4F1\uC73C\uB85C \uC2A4\uBA70\uB4E4\uC5C8\uB2E4.
      \uCC45\uC7A5\uC774 \uBC14\uC2A4\uB7EC\uC9C0\uACE0 \uD45C\uC9C0\uB3C4 \uBB34\uAC8C\uB97C
      \uC783\uC5C8\uB2E4. \uBE48 \uAC00\uC8FD\uB9CC \uC11C\uAC00 \uC544\uB798\uB85C
      \uB5A8\uC5B4\uC84C\uB2E4."
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.scholar.options.1.resulttext
    lastText: "\uC885\uC774\uAC00 \uD54F\uBC29\uC6B8\uC744 \uBE68\uC544\uB4E4\uC600\uB2E4.
      \uBE5B\uBC14\uB79C \uC601\uCC3D\uC774 \uC120\uBA85\uD574\uC9C0\uB294 \uB3D9\uC548
      \uC190\uB05D\uC774 \uCC28\uAC11\uAC8C \uC800\uB838\uB2E4. \uB9C8\uC9C0\uB9C9
      \uC74C\uC808\uC744 \uB418\uB1CC\uC790 \uC885\uC774\uB294 \uAC80\uAC8C \uD0C0\uACE0
      \uD45C\uC9C0\uAC00 \uBC14\uC2A4\uB7EC\uC84C\uB2E4. \uBC30\uC6B4 \uC601\uCC3D\uB9CC
      \uBA38\uB9BF\uC18D\uC5D0 \uB0A8\uC558\uB2E4."
  - propertyPath: options.Array.data[2].resultText
    key: data.randomeventdata.scholar.options.2.resulttext
    lastText: "\uBB34\uAE30 \uB05D\uC744 \uBC8C\uC5B4\uC9C4 \uC885\uC774 \uD2C8\uC5D0
      \uB123\uACE0 \uB3CC\uB838\uB2E4. \uC190\uBAA9\uC744 \uAC10\uC2FC \uC7A5\uB4E4\uC774
      \uCC22\uC5B4\uC84C\uB2E4. \uC885\uC774\uC5D0\uC11C \uC0C8\uC5B4 \uB098\uC628
      \uC789\uD06C\uAC00 \uBC14\uB2E5\uC5D0 \uB2FF\uAE30\uB3C4 \uC804\uC5D0 \uB9D0\uB790\uB2E4.
      \uBE48 \uD45C\uC9C0\uAE4C\uC9C0 \uBC14\uC2A4\uB7EC\uC838 \uC11C\uAC00 \uC544\uB798\uB85C
      \uB5A8\uC5B4\uC84C\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.scholar.pages.0.narrative
    lastText: "\uBB36\uC778 \uAE30\uB85D\uB4E4 \uC0AC\uC774\uC5D0\uC11C \uCC45 \uD55C
      \uAD8C\uB9CC \uB5A0 \uC788\uB2E4. \uCC45\uB4F1\uC758 \uAE00\uC528\uB97C \uC0B4\uD53C\uB824
      \uD45C\uC9C0\uB97C \uAC74\uB4DC\uB9AC\uC790 \uC885\uC774\uAC00 \uC190\uBAA9\uC744
      \uD718\uAC10\uB294\uB2E4.\n\n\uC190\uC744 \uB2F9\uAE38\uC218\uB85D \uC885\uC774
      \uB05D\uC774 \uC0B4\uC5D0 \uD30C\uACE0\uB4E0\uB2E4. \uCC45\uB4F1\uC5D0 \uCC0D\uD78C
      \uAE00\uC790\uAC00 \uC190\uB05D\uC5D0\uC11C \uBD89\uC5B4\uC9C4\uB2E4.\n\n\u201C\uD55C
      \uB3C5\uC790\uC5D0\uAC8C \uD55C \uC7A5. \uC789\uD06C\uB97C \uC0B4\uB9AC\uB824\uAC70\uB4E0
      \uD53C\uB97C \uB308 \uAC83.\u201D\n\n\uD3BC\uCCD0\uC9C4 \uB450 \uC7A5\uC5D0\uB294
      \uAC80\uC758 \uADA4\uC801\uACFC \uBE5B\uBC14\uB79C \uC601\uCC3D\uC774 \uBCF4\uC778\uB2E4.
      \uC885\uC774 \uD2C8\uC740 \uBB34\uAE30 \uB05D\uC73C\uB85C \uCC22\uC744 \uC218
      \uC788\uC744 \uB9CC\uD07C \uBC8C\uC5B4\uC838 \uC788\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.scholar.pages.0.options.0.title
    lastText: "\uBAB8\uC5D0 \uC775\uD78C \uAE30\uC220\uACFC \uAC80\uC220 \uB3C4\uD574\uB97C
      \uB9DE\uCDB0 \uBCF8\uB2E4."
