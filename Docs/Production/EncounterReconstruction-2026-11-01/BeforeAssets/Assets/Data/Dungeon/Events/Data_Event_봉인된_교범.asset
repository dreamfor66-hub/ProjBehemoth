  - propertyPath: pages.Array.data[0].options.Array.data[2].description
    key: "data.randomeventdata.data_event_\uB05D\uAE4C\uC9C0_\uC77D\uB294_\uBC95.pages.0.options.2.description"
    lastText: "\uBCF4\uC0C1 \uC5C6\uC774 \uAD50\uBC94 \uD30C\uAD34"
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: "data.randomeventdata.data_event_\uB05D\uAE4C\uC9C0_\uC77D\uB294_\uBC95.pages.0.options.2.resulttext"
    lastText: "\uBB34\uAE30 \uB05D\uC744 \uBC8C\uC5B4\uC9C4 \uC885\uC774 \uD2C8\uC5D0
      \uB123\uACE0 \uB3CC\uB838\uB2E4. \uC190\uBAA9\uC744 \uAC10\uC2FC \uC7A5\uB4E4\uC774
      \uCC22\uC5B4\uC84C\uB2E4. \uC885\uC774\uC5D0\uC11C \uC0C8\uC5B4 \uB098\uC628
      \uC789\uD06C\uAC00 \uBC14\uB2E5\uC5D0 \uB2FF\uAE30\uB3C4 \uC804\uC5D0 \uB9D0\uB790\uB2E4.
      \uBE48 \uD45C\uC9C0\uAE4C\uC9C0 \uBC14\uC2A4\uB7EC\uC838 \uC11C\uAC00 \uC544\uB798\uB85C
      \uB5A8\uC5B4\uC84C\uB2E4."
  textOwnerGuid: 9b653ceabb7d64a4a85d37c5bbef24fb
  id: Scholar
  displayName: "\uBD09\uC778\uB41C \uAD50\uBC94"
  discovery: 1
  worldObject: {fileID: 11400000, guid: af81332f4cd2de748a5e99cd1612d10e, type: 2}
  encounterKind: 0
  authoringLore: "\uD3D0\uC131 \uC218\uBE44\uB300\uC758 \uBD09\uC778 \uAE30\uB85D\uACE0.
    \uD45C\uC9C0\uB97C \uB9CC\uC9C4 \uB3C5\uC790\uB97C \uB193\uC544\uC8FC\uC9C0 \uC54A\uB294
    \uC77C\uD68C\uC6A9 \uC8FC\uC220 \uAD50\uBC94. \uB3C5\uC790\uAC00 \uD55C \uC7A5\uC744
    \uC77D\uC73C\uBA74 \uC789\uD06C\uAC00 \uBAB8\uC73C\uB85C \uC62E\uACA8\uAC00\uBA70
    \uCC45\uC774 \uC18C\uC9C4\uB418\uACE0, \uB3C5\uC11C\uB97C \uAC70\uBD80\uD558\uB824\uBA74
    \uC190\uC744 \uAC10\uC2FC \uC885\uC774\uB97C \uCC22\uC5B4\uC57C \uD55C\uB2E4.
    \uC2DC\uC791 \uC2DC \uBD99\uC7A1\uD78C \uC190\uACFC \uCC22\uC744 \uC218 \uC788\uB294
    \uC885\uC774\uAC00 \uBA85\uD655\uD558\uB2E4. \uC77D\uC9C0 \uC54A\uACE0 \uB454
    \uC815\uC0C1 \uCC45\uC744 \uC18C\uC9C4 \uCC98\uB9AC\uD558\uB294 \uBAA8\uC21C\uC740
    \uC5C6\uB2E4."
