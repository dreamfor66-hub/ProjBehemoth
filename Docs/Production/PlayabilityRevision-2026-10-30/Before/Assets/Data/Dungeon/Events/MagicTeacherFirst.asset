      \uB4A4\uB3C4 \uC880 \uBCF4\uBA74\uC11C \uB2E4\uB2C8\uACA0\uC2B5\uB2C8\uB2E4."
  - propertyPath: pages.Array.data[4].narrative
    key: data.randomeventdata.magicteacherfirst.pages.4.narrative
    lastText: "\uBA3C\uC800 \uC190\uB05D\uC5D0 \uB9C8\uB825\uC744 \uBAA8\uC544 \uBCF4\uC138\uC694."
