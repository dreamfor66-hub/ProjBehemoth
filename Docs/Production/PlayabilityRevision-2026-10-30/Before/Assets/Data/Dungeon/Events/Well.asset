    lastText: "\uAE08\uACE0\uB97C \uC6D0\uB798 \uC790\uB9AC\uB85C \uB3CC\uB824\uB193\uC790
      \uD314\uC774 \uB2E4\uC2DC \uAC00\uBCBC\uC6CC\uC84C\uB2E4."
