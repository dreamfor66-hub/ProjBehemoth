  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.well.displayname
    lastText: "\uBC11\uBC14\uB2E5\uC758 \uAE08\uACE0"
  - propertyPath: narrative
    key: data.randomeventdata.well.narrative
    lastText: "\uC9C0\uD558 \uC6B0\uBB3C\uBC29\uC5D0 \uB3C8\uC8FC\uBA38\uB2C8\uB97C
      \uB9E4\uB2E8 \uBC27\uC904\uC774 \uAC78\uB824 \uC788\uB2E4.\r\n\r\n\uC6B0\uBB3C
      \uC911\uAC04 \uC120\uBC18\uC5D0 \uC791\uC740 \uC8FC\uBA38\uB2C8\uAC00 \uC788\uACE0,
      \uB354 \uC544\uB798\uC5D0\uB294 \uCEE4\uB2E4\uB780 \uAE08\uACE0\uAC00 \uBCF4\uC778\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.well.options.0.title
    lastText: "\uC120\uBC18\uC758 \uC8FC\uBA38\uB2C8\uB9CC \uAC74\uC9C4\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.well.options.0.description
    lastText: "\uACE8\uB4DC +30."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.well.options.1.title
    lastText: "\uBC14\uB2E5\uC758 \uAE08\uACE0\uAE4C\uC9C0 \uB04C\uC5B4 \uC62C\uB9B0\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.well.options.1.description
    lastText: "\uACE8\uB4DC +150. \uC800\uC8FC \uC720\uBB3C \uD68D\uB4DD: \uCD5C\uB300
      \uAC00\uB4DC\uAC8C\uC774\uC9C0 -8."
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.well.options.0.resulttext
    lastText: 
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.well.options.1.resulttext
    lastText: 
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.well.pages.0.narrative
    lastText: "\uC9C0\uD558 \uC6B0\uBB3C\uBC29\uC5D0 \uB3C8\uC8FC\uBA38\uB2C8\uB97C
      \uB9E4\uB2E8 \uBC27\uC904\uC774 \uAC78\uB824 \uC788\uB2E4.\r\n\r\n\uC6B0\uBB3C
      \uC911\uAC04 \uC120\uBC18\uC5D0 \uC791\uC740 \uC8FC\uBA38\uB2C8\uAC00 \uC788\uACE0,
      \uB354 \uC544\uB798\uC5D0\uB294 \uCEE4\uB2E4\uB780 \uAE08\uACE0\uAC00 \uBCF4\uC778\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.well.pages.0.options.0.title
    lastText: "\uC791\uC740 \uC8FC\uBA38\uB2C8\uB9CC \uAC74\uC9C4\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
    key: data.randomeventdata.well.pages.0.options.0.description
    lastText: "\uACE8\uB4DC +30"
  - propertyPath: pages.Array.data[0].options.Array.data[0].resultText
    key: data.randomeventdata.well.pages.0.options.0.resulttext
    lastText: "\uC7A5\uBE44\uB97C \uCC59\uAE30\uACE0 \uB2E4\uC2DC \uBCF5\uB3C4\uB85C
      \uB098\uC130\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].title
    key: data.randomeventdata.well.pages.0.options.1.title
    lastText: "\uAE08\uACE0\uC758 \uBC27\uC904\uB3C4 \uB2F9\uACA8 \uBCF8\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
    key: data.randomeventdata.well.pages.0.options.1.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: data.randomeventdata.well.pages.0.options.1.resulttext
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[2].title
    key: data.randomeventdata.well.pages.0.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].description
    key: data.randomeventdata.well.pages.0.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: data.randomeventdata.well.pages.0.options.2.resulttext
    lastText: "\uADF8\uB300\uB85C \uC790\uB9AC\uB97C \uB5A0\uB0AC\uB2E4."
  - propertyPath: pages.Array.data[1].narrative
    key: data.randomeventdata.well.pages.1.narrative
    lastText: "\uBC27\uC904\uC744 \uB2F9\uAE30\uC790 \uBC29\uD328\uB97C \uB4E0 \uD314\uC774
      \uAC11\uC790\uAE30 \uBB34\uAC70\uC6CC\uC9C4\uB2E4.\r\n\r\n\uAE08\uACE0\uAC00
      \uC62C\uB77C\uC624\uBA70 \uBCBD\uC744 \uAC00\uB9B0 \uBB3C\uB54C\uAC00 \uBC97\uACA8\uC84C\uB2E4.
      \uADF8 \uC544\uB798\uC5D0 \uACBD\uACE0\uBB38\uC774 \uC788\uB2E4.\r\n\r\n\uAE08\uACE0\uB97C
      \uAC00\uC838\uAC00\uB294 \uC790\uB294 \uADF8 \uBB34\uAC8C\uB3C4 \uD568\uAED8
      \uC9CA\uC5B4\uC9C4\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].title
    key: data.randomeventdata.well.pages.1.options.0.title
    lastText: "\uC800\uC8FC\uB97C \uAC10\uC218\uD558\uACE0 \uAE08\uACE0\uB97C \uAC00\uC838\uAC04\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].description
    key: data.randomeventdata.well.pages.1.options.0.description
    lastText: "\uACE8\uB4DC +150 \xB7 \uC6B0\uBB3C \uBC11\uC758 \uBB34\uAC8C \uD68D\uB4DD"
  - propertyPath: pages.Array.data[1].options.Array.data[0].resultText
    key: data.randomeventdata.well.pages.1.options.0.resulttext
    lastText: "\uC7A5\uBE44\uB97C \uCC59\uAE30\uACE0 \uB2E4\uC2DC \uBCF5\uB3C4\uB85C
      \uB098\uC130\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].title
    key: data.randomeventdata.well.pages.1.options.1.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].description
    key: data.randomeventdata.well.pages.1.options.1.description
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[1].resultText
