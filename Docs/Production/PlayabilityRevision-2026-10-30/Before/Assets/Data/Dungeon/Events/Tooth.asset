  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.tooth.displayname
    lastText: "\uAE08\uBE5B \uC774\uBE68\uC758 \uB0B4\uAE30"
  - propertyPath: narrative
    key: data.randomeventdata.tooth.narrative
    lastText: "\uC61B \uC720\uD76C\uC2E4\uC5D0\uC11C \uAE08\uB2C8\uC758 \uC0C1\uC778\uC774
      \uB098\uB97C \uC54C\uC544\uBCF4\uACE0 \uC790\uB9AC\uB97C \uAD8C\uD55C\uB2E4.\r\n\r\n\uC544\uC9C1
      \uC0B4\uC544 \uACC4\uC168\uAD70\uC694. \uC774\uBC88\uC5D0\uB294 \uC0B4\uC544
      \uB3CC\uC544\uC624\uC2DC\uB294 \uCABD\uC5D0 \uAC78\uACA0\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC0C1\uC778\uC774
      \uC7A5\uBD80\uC5D0 \uB0B4 \uC774\uB984\uC744 \uC801\uACE0, \uB3C8\uC744 \uBCF4\uD0DC\uBA74
      \uC2B9\uB9AC\uD560 \uB54C\uB9C8\uB2E4 \uBC30\uB2F9\uC744 \uC8FC\uACA0\uB2E4\uACE0
      \uD55C\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.tooth.options.0.title
    lastText: "\uB0B4 \uB3C8\uB3C4 \uAC74\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.tooth.options.0.description
    lastText: "40\uACE8\uB4DC \uC18C\uBAA8. \uAE08\uBE5B \uC774\uBE68: \uC804\uD22C
      \uC2B9\uB9AC\uB9C8\uB2E4 \uACE8\uB4DC +10."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.tooth.options.1.title
    lastText: "\uB0B4\uAC00 \uC774\uAE30\uB294\uC9C0 \uC9C1\uC811 \uBCF4\uC2DC\uC9C0"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.tooth.options.1.description
    lastText: "\uCCB4\uB825 -8. \uACE8\uB4DC +65. \uC720\uBB3C\uC740 \uC5BB\uC9C0
      \uC54A\uB294\uB2E4."
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.tooth.options.2.title
    lastText: "\uB0B4\uAE30\uB294 \uB410\uACE0 \uD488\uC0AF\uC774\uB098 \uC8FC\uC2DC\uC624"
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.tooth.options.2.description
    lastText: "\uACE8\uB4DC +8."
