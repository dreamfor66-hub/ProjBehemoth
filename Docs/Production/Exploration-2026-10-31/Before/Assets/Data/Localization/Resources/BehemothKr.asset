  - key: data.playercombatdata.warrior.selectionstory
    kr: "\uC804\uC7A5\uC744 \uB5A0\uB3CC\uB358 \uC6A9\uBCD1.\r\n\uC774\uBC88 \uC758\uB8B0\uB294
      \uC131 \uC548\uC5D0 \uC788\uB2E4."
    source: OutGameShell
  - key: data.playercombatdata.warrior.selectionability
    kr: "\uBC29\uD328\uB85C \uACF5\uACA9\uC744 \uB9C9\uACE0\r\n\uBE48\uD2C8\uC5D0
      \uCC28\uC9C0\uB97C \uAF42\uB294\uB2E4."
    source: OutGameShell
  - key: data.playercombatdata.rogue.selectionstory
    kr: "\uC774\uB984\uB3C4 \uBC1C\uC790\uAD6D\uB3C4 \uB0A8\uAE30\uC9C0 \uC54A\uB294\r\n\uC131\uAC00\uC2E0
      \uBCF4\uBB3C \uC0AC\uB0E5\uAFBC."
    source: OutGameShell
  - key: data.playercombatdata.rogue.selectionability
    kr: "\uC740\uC2E0 \uD6C4 \uAE30\uC2B5\uD558\uAC70\uB098\r\n\uB3C5\uC744 \uC313\uC544
      \uC801\uC744 \uBAB0\uC544\uBD99\uC778\uB2E4."
    source: OutGameShell
  - key: data.playercombatdata.barbarian.selectionstory
    kr: "\uACE0\uD5A5\uC744 \uC0BC\uD0A8 \uC800\uC8FC\uB97C \uC887\uC544\r\n\uD640\uB85C
      \uC131\uBB38\uC744 \uB450\uB4DC\uB9B0 \uC804\uC0AC."
    source: OutGameShell
  - key: data.playercombatdata.barbarian.selectionability
    kr: "\uACA9\uB178\uB97C \uBAA8\uC544 \uBD84\uB178\uD558\uACE0\r\n\uAC70\uC13C
      \uC5F0\uACA9\uC744 \uC3DF\uC544\uB0B8\uB2E4."
    source: OutGameShell
  - key: data.playercombatdata.samurai.selectionstory
    kr: "\uB3CC\uC544\uAC08 \uC8FC\uAD70\uC744 \uC783\uACE0\uB3C4\r\n\uCE7C\uB9CC\uC740
      \uB193\uC9C0 \uBABB\uD55C \uBB34\uC0AC."
    source: OutGameShell
  - key: data.playercombatdata.samurai.selectionability
    kr: "\uB0A9\uB3C4\uB85C \uB54C\uB97C \uAE30\uB2E4\uB838\uB2E4\r\n\uBC1C\uB3C4\uB85C
      \uAE30\uD68C\uB97C \uBCA4\uB2E4."
    source: OutGameShell
  - key: data.playercombatdata.monk.selectionstory
    kr: "\uC0B0\uBB38\uC744 \uB098\uC120 \uAD6C\uB3C4\uC790.\r\n\uB2F5\uC740 \uC8FC\uBA39
      \uB05D\uC5D0\uC11C \uCC3E\uB294\uB2E4."
    source: OutGameShell
  - key: data.playercombatdata.monk.selectionability
    kr: "\uCD08\uC2DD\uC744 \uC774\uC5B4 \uBC1C\uB3D9\uD558\uACE0\r\n\uC0C1\uD669\uC5D0
      \uB9DE\uB294 \uD750\uB984\uC744 \uACE0\uB978\uB2E4."
    source: OutGameShell
  - key: data.playercombatdata.wizard.selectionstory
    kr: "\uC78A\uD78C \uBE44\uC220\uC744 \uCC3E\uC544\uC628\r\n\uACE0\uC9D1 \uC13C
      \uB299\uC740 \uB9C8\uBC95\uC0AC."
    source: OutGameShell
  - key: data.playercombatdata.wizard.selectionability
    kr: "\uAC00\uB4DC \uC911 \uB9C8\uB825\uC744 \uD68C\uBCF5\uD558\uACE0\r\n\uC5EC\uB7EC
      \uC8FC\uBB38\uC744 \uB098\uB220 \uC4F4\uB2E4."
    source: OutGameShell
