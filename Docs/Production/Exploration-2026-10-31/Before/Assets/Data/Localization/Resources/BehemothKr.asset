  - key: ui.camp.used
    kr: "\uC57C\uC601\uD55C\uB2E4 \xB7 \uC0AC\uC6A9\uD568"
    source: Fatigue
  - key: ui.camp.full.detail
    kr: "\uD53C\uB85C\uB3C4 100\uAE4C\uC9C0 \xB7 \uCCB4\uB825 10 \uD68C\uBCF5\n\uB2E4\uC74C
      \uC774\uB3D9\uBD80\uD130 \uD53C\uB85C\uB3C4\uAC00 \uB2E4\uC2DC \uAC10\uC18C\uD55C\uB2E4.\n\uC0B4\uC544
      \uC788\uB294 \uC77C\uBC18 \uBAAC\uC2A4\uD130\uAC00 \uC774\uB3D9\uD560 \uC218
      \uC788\uB2E4."
    source: Fatigue
  - key: ui.camp.full.result
    kr: "\uBAB8\uC744 \uB204\uC774\uACE0 \uCDA9\uBD84\uD788 \uC26C\uC5C8\uB2E4.\n\uD53C\uB85C\uB3C4
      100 \xB7 \uCCB4\uB825 10 \uD68C\uBCF5"
    source: Fatigue
  - key: ui.camp.full.result.moved
    kr: "\uBAB8\uC744 \uB204\uC774\uACE0 \uCDA9\uBD84\uD788 \uC26C\uC5C8\uB2E4.\n\uD53C\uB85C\uB3C4
      100 \xB7 \uCCB4\uB825 10 \uD68C\uBCF5\n\uC26C\uB294 \uC0AC\uC774 \uD1B5\uB85C\uC5D0\uC11C
      \uBC1C\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4."
    source: Fatigue
  - key: ui.camp.short
    kr: "\uC7A0\uAE50 \uC270\uB2E4"
    source: Fatigue
  - key: ui.camp.short.detail
    kr: "\uD53C\uB85C\uB3C4 60\uAE4C\uC9C0 \uD68C\uBCF5"
    source: Fatigue
  - key: ui.camp.short.result
    kr: "\uC7A0\uC2DC \uC228\uC744 \uACE8\uB790\uB2E4.\n\uD53C\uB85C\uB3C4\uAC00
      60\uAE4C\uC9C0 \uD68C\uBCF5\uB418\uC5C8\uB2E4."
