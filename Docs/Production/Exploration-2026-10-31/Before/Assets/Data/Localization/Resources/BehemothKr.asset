  - key: ui.fatigue.death
    kr: "\uB05D\uB0B4 \uBC1C\uAC78\uC74C\uC744 \uC62E\uAE30\uC9C0 \uBABB\uD558\uACE0
      \uC4F0\uB7EC\uC84C\uB2E4.\n\uD53C\uB85C\uB3C4\uAC00 0\uC774 \uB418\uC5C8\uB2E4."
