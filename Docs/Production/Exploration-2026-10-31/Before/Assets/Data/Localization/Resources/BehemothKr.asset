    source: "Assets/Data/Dungeon/Events/Data_Event_\uC816\uC740_\uBC1C\uC790\uAD6D.asset:options.Array.data[1].description"
  - key: data.randomeventdata.straydog.options.2.title
    kr: "\uAE38\uAC00\uC758 \uC57D\uCD08\uB85C \uAC10\uC2F8 \uC900\uB2E4"
    source: "Assets/Data/Dungeon/Events/Data_Event_\uC816\uC740_\uBC1C\uC790\uAD6D.asset:options.Array.data[2].title"
  - key: data.randomeventdata.straydog.options.2.description
    kr: "\uAC15\uC544\uC9C0\uB294 \uC548\uC804\uD55C \uC57C\uC601\uC9C0\uC5D0 \uB0A8\uB294\uB2E4.
      \uB0A8\uC740 \uC57D\uCD08\uB85C \uB0B4 \uCCB4\uB825 8 \uD68C\uBCF5. \uB3D9\uB8CC\uB294
      \uC5BB\uC9C0 \uC54A\uB294\uB2E4."
    source: "Assets/Data/Dungeon/Events/Data_Event_\uC816\uC740_\uBC1C\uC790\uAD6D.asset:options.Array.data[2].description"
  - key: data.randomeventdata.symbiosis.displayname
    kr: "\uB450 \uBC88\uC9F8 \uB9E5\uBC15"
    source: "Assets/Data/Dungeon/Events/Data_Event_\uB450_\uBC88\uC9F8_\uB9E5\uBC15.asset:displayName"
  - key: data.randomeventdata.symbiosis.narrative
    kr: "\uC5F0\uAE08\uC220\uC2E4 \uC2E4\uD5D8\uB300\uC5D0 \uBFCC\uB9AC\uAC00 \uB3CB\uC740
      \uC528\uC557\uC774 \uB193\uC5EC \uC788\uB2E4.\r\n\r\n\uC606\uC758 \uAE30\uB85D\uC5D0\uB294
      \uC219\uC8FC\uC758 \uC0DD\uBA85\uB825\uC744 \uBA39\uACE0 \uADFC\uC721\uC744
      \uAC15\uD654\uD558\uB294 \uC2DD\uBB3C\uC774\uB77C\uACE0 \uC801\uD600 \uC788\uB2E4.\r\n\r\n\uBFCC\uB9AC\uB97C
      \uD0DC\uC6B4 \uC5F0\uAE30\uB294 \uAE30\uC5B5\uC744 \uD750\uB9AC\uAC8C \uD558\uACE0,
      \uAECD\uC9C8\uC740 \uC0C1\uCC98\uC5D0 \uC4F0\uB294 \uC57D\uC7AC\uB77C\uACE0
      \uD55C\uB2E4.\r\n\r\n\uC190\uC744 \uAC00\uAE4C\uC774 \uB300\uC790 \uBFCC\uB9AC\uAC00
      \uB0B4 \uC190\uBAA9\uC744 \uD5A5\uD574 \uC6C0\uC9C1\uC778\uB2E4."
    source: "Assets/Data/Dungeon/Events/Data_Event_\uB450_\uBC88\uC9F8_\uB9E5\uBC15.asset:narrative"
  - key: data.randomeventdata.symbiosis.options.0.title
    kr: "\uBFCC\uB9AC\uB0B4\uB9B4 \uC790\uB9AC\uB97C \uC900\uB2E4"
    source: "Assets/Data/Dungeon/Events/Data_Event_\uB450_\uBC88\uC9F8_\uB9E5\uBC15.asset:options.Array.data[0].title"
  - key: data.randomeventdata.symbiosis.options.0.description
    kr: "\uCD5C\uB300 \uCCB4\uB825 -12. \uACF5\uC0DD\uD558\uB294 \uC528\uC557: \uC77C\uBC18
      \uBB34\uAE30 \uD53C\uD574 +25%, \uCC28\uC9C0 \uD53C\uD574 +20%."
    source: "Assets/Data/Dungeon/Events/Data_Event_\uB450_\uBC88\uC9F8_\uB9E5\uBC15.asset:options.Array.data[0].description"
  - key: data.randomeventdata.symbiosis.options.1.title
    kr: "\uBFCC\uB9AC\uC640 \uD568\uAED8 \uBC84\uB987 \uD558\uB098\uB97C \uD0DC\uC6B4\uB2E4"
    source: "Assets/Data/Dungeon/Events/Data_Event_\uB450_\uBC88\uC9F8_\uB9E5\uBC15.asset:options.Array.data[1].title"
  - key: data.randomeventdata.symbiosis.options.1.description
    kr: "\uBCF4\uC720 \uB2A5\uB825 \uD558\uB098 \uC81C\uAC70 \uD6C4 \uC0C8 \uB2A5\uB825\uC744
      \uC120\uD0DD\uD55C\uB2E4."
    source: "Assets/Data/Dungeon/Events/Data_Event_\uB450_\uBC88\uC9F8_\uB9E5\uBC15.asset:options.Array.data[1].description"
  - key: data.randomeventdata.tooth.displayname
    kr: "\uAE08\uBE5B \uC774\uBE68\uC758 \uB0B4\uAE30"
    source: "Assets/Data/Dungeon/Events/Data_Event_\uAE08\uBE5B_\uC774\uBE68\uC758_\uB0B4\uAE30.asset:displayName"
  - key: data.randomeventdata.tooth.narrative
    kr: "\uC61B \uC720\uD76C\uC2E4\uC5D0\uC11C \uAE08\uB2C8\uC758 \uC0C1\uC778\uC774
      \uB098\uB97C \uC54C\uC544\uBCF4\uACE0 \uC790\uB9AC\uB97C \uAD8C\uD55C\uB2E4.\r\n\r\n\uC544\uC9C1
      \uC0B4\uC544 \uACC4\uC168\uAD70\uC694. \uC774\uBC88\uC5D0\uB294 \uC0B4\uC544
      \uB3CC\uC544\uC624\uC2DC\uB294 \uCABD\uC5D0 \uAC78\uACA0\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC0C1\uC778\uC774
      \uC7A5\uBD80\uC5D0 \uB0B4 \uC774\uB984\uC744 \uC801\uACE0, \uB3C8\uC744 \uBCF4\uD0DC\uBA74
      \uC2B9\uB9AC\uD560 \uB54C\uB9C8\uB2E4 \uBC30\uB2F9\uC744 \uC8FC\uACA0\uB2E4\uACE0
      \uD55C\uB2E4."
    source: "Assets/Data/Dungeon/Events/Data_Event_\uAE08\uBE5B_\uC774\uBE68\uC758_\uB0B4\uAE30.asset:narrative"
  - key: data.randomeventdata.tooth.options.0.title
    kr: "\uB0B4 \uB3C8\uB3C4 \uAC74\uB2E4"
    source: "Assets/Data/Dungeon/Events/Data_Event_\uAE08\uBE5B_\uC774\uBE68\uC758_\uB0B4\uAE30.asset:options.Array.data[0].title"
  - key: data.randomeventdata.tooth.options.0.description
    kr: "40\uACE8\uB4DC \uC18C\uBAA8. \uAE08\uBE5B \uC774\uBE68: \uC804\uD22C \uC2B9\uB9AC\uB9C8\uB2E4
      \uACE8\uB4DC +10."
    source: "Assets/Data/Dungeon/Events/Data_Event_\uAE08\uBE5B_\uC774\uBE68\uC758_\uB0B4\uAE30.asset:options.Array.data[0].description"
  - key: data.randomeventdata.tooth.options.1.title
    kr: "\uB0B4\uAC00 \uC774\uAE30\uB294\uC9C0 \uC9C1\uC811 \uBCF4\uC2DC\uC9C0"
    source: "Assets/Data/Dungeon/Events/Data_Event_\uAE08\uBE5B_\uC774\uBE68\uC758_\uB0B4\uAE30.asset:options.Array.data[1].title"
  - key: data.randomeventdata.tooth.options.1.description
    kr: "\uCCB4\uB825 -8. \uACE8\uB4DC +65. \uC720\uBB3C\uC740 \uC5BB\uC9C0 \uC54A\uB294\uB2E4."
    source: "Assets/Data/Dungeon/Events/Data_Event_\uAE08\uBE5B_\uC774\uBE68\uC758_\uB0B4\uAE30.asset:options.Array.data[1].description"
  - key: data.randomeventdata.training.displayname
    kr: "\uC624\uB298\uC758 \uC0C1\uB300\uB97C \uACE0\uB974\uC2DC\uC624"
    source: "Assets/Data/Dungeon/Events/Data_Event_\uC624\uB298\uC758_\uC0C1\uB300\uB97C_\uACE0\uB974\uC2DC\uC624.asset:displayName"
  - key: data.randomeventdata.training.narrative
    kr: "\uD6C8\uB828\uC7A5\uC5D0 \uB4E4\uC5B4\uC11C\uC790 \uB098\uBB34 \uC778\uD615
      \uC138 \uAC1C\uAC00 \uB3D9\uC2DC\uC5D0 \uACE0\uAC1C\uB97C \uB3CC\uB9B0\uB2E4.\r\n\r\n\uCCAB\uC9F8\uB294
      \uB048, \uB458\uC9F8\uB294 \uCCA0\uC0AC, \uC14B\uC9F8\uB294 \uAD75\uC740 \uC0AC\uC2AC\uB85C
      \uBB36\uC5EC \uC788\uB2E4.\r\n\r\n\uBCBD\uC758 \uC548\uB0B4\uD310\uC5D0\uB294
      \uAC01 \uC778\uD615\uC758 \uC704\uD5D8\uB3C4\uC640 \uBCF4\uC0C1\uC774 \uC801\uD600
      \uC788\uB2E4.\r\n\r\n\uB3C4\uC804\uD560 \uC0C1\uB300\uC758 \uAD6C\uC18D\uC744
      \uD480\uC5B4 \uC8FC\uC2ED\uC2DC\uC624."
    source: "Assets/Data/Dungeon/Events/Data_Event_\uC624\uB298\uC758_\uC0C1\uB300\uB97C_\uACE0\uB974\uC2DC\uC624.asset:narrative"
  - key: data.randomeventdata.training.options.0.title
    kr: "\uB048\uC744 \uD47C\uB2E4"
    source: "Assets/Data/Dungeon/Events/Data_Event_\uC624\uB298\uC758_\uC0C1\uB300\uB97C_\uACE0\uB974\uC2DC\uC624.asset:options.Array.data[0].title"
  - key: data.randomeventdata.training.options.0.description
    kr: "\uC5F0\uC2B5 \uC778\uD615 \uCCB4\uB825 75. \uC2B9\uB9AC \uD6C4 \uD3EC\uC158
