    source: "Assets/Data/Dungeon/Events/Data_Event_\uBD88\uCE68\uBC88\uC744_\uC815\uD558\uC790.asset:options.Array.data[1].description"
  - key: data.randomeventdata.shelter.options.2.title
    kr: "\uB108 \uBA3C\uC800 \uC790. \uB2E4\uC74C\uC740 \uB0B4 \uCC28\uB840\uC57C"
    source: "Assets/Data/Dungeon/Events/Data_Event_\uBD88\uCE68\uBC88\uC744_\uC815\uD558\uC790.asset:options.Array.data[2].title"
  - key: data.randomeventdata.shelter.options.2.description
    kr: "\uAC15\uC544\uC9C0\uC640 \uBC88\uAC08\uC544 \uB9DD\uC744 \uBCF8\uB2E4. \uCCB4\uB825
      28 \uD68C\uBCF5, \uACE8\uB4DC +12."
    source: "Assets/Data/Dungeon/Events/Data_Event_\uBD88\uCE68\uBC88\uC744_\uC815\uD558\uC790.asset:options.Array.data[2].description"
  - key: data.randomeventdata.stormbottle.displayname
    kr: "\uBC88\uAC1C\uB97C \uD30C\uB294 \uD589\uC0C1"
    source: "Assets/Data/Dungeon/Events/Data_Event_\uBC88\uAC1C\uB97C_\uD30C\uB294_\uD589\uC0C1.asset:displayName"
  - key: data.randomeventdata.stormbottle.narrative
    kr: "\uBCF5\uB3C4 \uBCBD\uAC10\uC5D0\uC11C \uC791\uC740 \uCC9C\uB465\uC18C\uB9AC\uAC00
      \uB09C\uB2E4.\r\n\r\n\uD589\uC0C1\uC774 \uBD88\uBE5B\uC774 \uBC88\uCA4D\uC774\uB294
      \uBCD1\uC744 \uB4E4\uACE0 \uB098\uB97C \uBD80\uB978\uB2E4.\r\n\r\n\uBB34\uAE30\uC5D0
      \uC4F8 \uBC88\uAC1C \uD544\uC694\uD558\uC2ED\uB2C8\uAE4C? \uC601\uCC3D\uC744
      \uBAB0\uB77C\uB3C4 \uB429\uB2C8\uB2E4.\r\n\r\n\uBCD1\uC744 \uAE30\uC6B8\uC774\uC790
      \uBC88\uAC1C\uAC00 \uC720\uB9AC\uBCBD\uC744 \uB530\uB77C \uC6C0\uC9C1\uC778\uB2E4.\r\n\r\n\uC9C1\uC811
      \uC8FC\uBB38\uC744 \uC4F0\uACE0 \uC2F6\uC73C\uC2DC\uBA74 \uC606 \uCC45\uC744
      \uBCF4\uC138\uC694. \uBE48 \uBCD1\uC744 \uBAA8\uC544 \uC8FC\uC2DC\uBA74 \uD488\uC0AF\uB3C4
      \uB4DC\uB9AC\uACE0\uC694."
    source: "Assets/Data/Dungeon/Events/Data_Event_\uBC88\uAC1C\uB97C_\uD30C\uB294_\uD589\uC0C1.asset:narrative"
  - key: data.randomeventdata.stormbottle.options.0.title
    kr: "\uD3ED\uD48D \uD55C \uBCD1"
    source: "Assets/Data/Dungeon/Events/Data_Event_\uBC88\uAC1C\uB97C_\uD30C\uB294_\uD589\uC0C1.asset:options.Array.data[0].title"
  - key: data.randomeventdata.stormbottle.options.0.description
    kr: "45\uACE8\uB4DC \uC18C\uBAA8. \uCC28\uC9C0 \uC801\uC911\uC5D0 \uBC88\uAC1C
      \uD53C\uD574 8\uC744 \uB354\uD558\uB294 \uC720\uBB3C \uD68D\uB4DD."
