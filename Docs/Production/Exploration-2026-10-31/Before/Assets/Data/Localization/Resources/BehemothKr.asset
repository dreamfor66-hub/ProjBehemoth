    source: "Assets/Data/Dungeon/Events/Data_Event_\uBC88\uAC1C\uB97C_\uD30C\uB294_\uD589\uC0C1.asset:options.Array.data[1].description"
  - key: data.randomeventdata.stormbottle.options.2.title
    kr: "\uBE48 \uBCD1 \uC218\uAC70\uB97C \uB3D5\uB294\uB2E4"
    source: "Assets/Data/Dungeon/Events/Data_Event_\uBC88\uAC1C\uB97C_\uD30C\uB294_\uD589\uC0C1.asset:options.Array.data[2].title"
  - key: data.randomeventdata.stormbottle.options.2.description
    kr: "\uACE8\uB4DC +12. \uC720\uBB3C\uACFC \uC8FC\uBB38\uC740 \uC0AC\uC9C0 \uC54A\uB294\uB2E4."
    source: "Assets/Data/Dungeon/Events/Data_Event_\uBC88\uAC1C\uB97C_\uD30C\uB294_\uD589\uC0C1.asset:options.Array.data[2].description"
  - key: data.randomeventdata.straydog.displayname
    kr: "\uC816\uC740 \uBC1C\uC790\uAD6D"
    source: "Assets/Data/Dungeon/Events/Data_Event_\uC816\uC740_\uBC1C\uC790\uAD6D.asset:displayName"
  - key: data.randomeventdata.straydog.narrative
    kr: "\uAD6C\uC11D\uC5D0 \uB2E4\uCE5C \uAC15\uC544\uC9C0\uAC00 \uBD88\uC30D\uD55C
      \uB208\uC73C\uB85C \uB098\uB97C \uCCD0\uB2E4\uBCF4\uACE0 \uC788\uB2E4.\r\n\r\n\uAC15\uC544\uC9C0\uB294
      \uAD76\uACE0 \uC788\uC9C0\uB9CC \uBAA9\uC904 \uB54C\uBB38\uC5D0 \uC6C0\uC9C1\uC77C
      \uC218 \uC5C6\uC5B4 \uBCF4\uC778\uB2E4.\r\n\r\n\uBAA9\uC904\uC744 \uD480\uC5B4
      \uC904\uAE4C?"
    source: "Assets/Data/Dungeon/Events/Data_Event_\uC816\uC740_\uBC1C\uC790\uAD6D.asset:narrative"
