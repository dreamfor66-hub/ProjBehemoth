  - key: ui.selection.ability.stats
    kr: "HP {0:0}   MP {1:0}\n\uAC00\uB4DC \uAC8C\uC774\uC9C0 {2:0}\n\n\uC77C\uBC18
      \uACF5\uACA9 \uD53C\uD574 {3:0.#}\n\uCC28\uC9C0 \uACF5\uACA9 \uD53C\uD574 {4:0.#}\n\uACF5\uACA9
      \uCFE8\uD0C0\uC784 {5:0.##}\uCD08"
    source: Selection readability
