    source: "Assets/Data/Dungeon/Encounters/Data_Encounter_\uD30C\uACC4\uAE30\uB9C8\uC218.asset:displayName"
  - key: data.encounterdata.soulknight.hint
    kr: "\uB113\uAC8C \uB4DC\uB7EC\uB09C \uC57D\uC810\uC744 \uCC28\uB840\uB85C \uB04A\uC5B4
      \uAC15\uD0C0\uB97C \uCDE8\uC18C\uD558\uC790."
    source: "Assets/Data/Dungeon/Encounters/Data_Encounter_\uD30C\uACC4\uAE30\uB9C8\uC218.asset:hint"
  - key: data.encounterdata.stormmatriarch.displayname
    kr: "\uD3ED\uD48D\uC758 \uB300\uBD95 \xB7 \uD3ED\uD48D \uD574\uD30C\uB9AC"
    source: "Assets/Data/Dungeon/Encounters/Data_Encounter_\uD3ED\uD48D\uC758\uB300\uBD95_\uD3ED\uD48D\uD574\uD30C\uB9AC.asset:displayName"
  - key: data.encounterdata.stormmatriarch.hint
    kr: "\uACF5\uC804\uD558\uB294 \uD3ED\uD48D \uD574\uD30C\uB9AC\uC640 \uBCF8\uCCB4\uC758
      \uACF5\uACA9 \uC2DC\uCC28\uC5D0 \uC8FC\uC758\uD558\uC790.\n\uBCF8\uCCB4 \uC8FC\uC704\uB97C
      \uACF5\uC804\uD558\uBA70 \uACF5\uACA9\uD55C\uB2E4."
    source: "Assets/Data/Dungeon/Encounters/Data_Encounter_\uD3ED\uD48D\uC758\uB300\uBD95_\uD3ED\uD48D\uD574\uD30C\uB9AC.asset:hint"
  - key: data.encounterdata.trial.displayname
