  - key: data.randomeventdata.magicteacherreturn.pages.0.options.1.resulttext
    kr: "\uB178\uC778\uC5D0\uAC8C \uC131 \uC548\uC758 \uB9C9\uD78C \uD1B5\uB85C\uC640
      \uC61B \uAC15\uC758\uC2E4 \uC774\uC57C\uAE30\uB97C \uB4E4\uC5C8\uB2E4. \uD5E4\uC5B4\uC9C8
      \uB54C\uAE4C\uC9C0 \uC218\uC5C5 \uC774\uC57C\uAE30\uB294 \uB2E4\uC2DC \uB098\uC624\uC9C0
      \uC54A\uC558\uB2E4."
    source: "Assets/Data/Dungeon/Events/Data_Event_\uC131\uC7A5\uD55C_\uC81C\uC790.asset:pages.Array.data[0].options.Array.data[1].resultText"
  - key: data.randomeventdata.magicteacherreturn.pages.1.narrative
    kr: "\uC9C0\uB09C\uBC88 \uC8FC\uBB38\uC744 \uC190\uC5D0 \uC775\uD614\uB2E4\uBA74,
      \uC774\uC81C \uB2E4\uB978 \uC4F0\uC784\uC0C8\uB3C4 \uC0B4\uD3B4\uBD05\uC2DC\uB2E4.\n\n\uD55C
      \uC8FC\uBB38\uC744 \uAE4A\uC774 \uD30C\uACE0\uB4E4\uC5B4\uB3C4 \uC88B\uACE0,
      \uBE48\uD2C8\uC744 \uBA54\uC6CC \uC904 \uAE30\uCD08\uB97C \uB354 \uBC30\uC6CC\uB3C4
      \uB429\uB2C8\uB2E4."
    source: "Assets/Data/Dungeon/Events/Data_Event_\uC131\uC7A5\uD55C_\uC81C\uC790.asset:pages.Array.data[1].narrative"
