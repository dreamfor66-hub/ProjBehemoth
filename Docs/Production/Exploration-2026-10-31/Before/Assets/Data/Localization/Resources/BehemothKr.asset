  - key: data.playercombatdata.barbarian.displayname
    kr: "\uBC14\uBC14\uB9AC\uC548"
    source: "Assets/Data/Characters/Data_Character_\uBC14\uBC14\uB9AC\uC548.asset:displayName"
  - key: data.playercombatdata.barbarian.description
    kr: "\uB3D9\uBB3C\uC801 \uBCF8\uB2A5\uACFC \uC6D0\uCD08\uC801\uC778 \uD798, \uC2DD\uC744
      \uC904 \uBAA8\uB974\uB294 \uBD84\uB178\uB97C \uAC70\uCE68\uC5C6\uC774 \uBC1C\uC0B0\uD558\uB294
      \uC57C\uC131\uC801\uC778 \uC804\uC0AC\uC785\uB2C8\uB2E4."
    source: "Assets/Data/Characters/Data_Character_\uBC14\uBC14\uB9AC\uC548.asset:description"
  - key: data.playercombatdata.monk.displayname
    kr: "\uBABD\uD06C"
    source: "Assets/Data/Characters/Data_Character_\uBABD\uD06C.asset:displayName"
  - key: data.playercombatdata.monk.description
    kr: "\uC5EC\uB7EC \uACF5\uACA9\uC744 \uD558\uB098\uC758 \uACF5\uACA9 \uCC98\uB7FC
      \uBB3C \uD750\uB974\uB4EF \uC5F0\uACB0\uD558\uB294 \uB0A0\uB835\uD55C \uBAB8\uB180\uB9BC\uC758
      \uBB34\uC608\uAC00 \uC785\uB2C8\uB2E4."
    source: "Assets/Data/Characters/Data_Character_\uBABD\uD06C.asset:description"
  - key: data.playercombatdata.rogue.displayname
    kr: "\uB85C\uADF8"
    source: "Assets/Data/Characters/Data_Character_\uB85C\uADF8.asset:displayName"
  - key: data.playercombatdata.rogue.description
    kr: "\uC740\uC2E0 \uB2A5\uB825\uACFC \uB3C5, \uB6F0\uC5B4\uB09C \uBC18\uC0AC
      \uC2E0\uACBD\uC744 \uD65C\uC6A9\uD574 \uB300\uBD80\uBD84\uC758 \uC0C1\uD669\uC5D0\uC11C
      \uC6B0\uC704\uB97C \uC810\uD560 \uC218 \uC788\uB294 \uB2E4\uC7AC\uB2E4\uB2A5\uD55C
      \uC874\uC7AC\uC785\uB2C8\uB2E4."
    source: "Assets/Data/Characters/Data_Character_\uB85C\uADF8.asset:description"
  - key: data.playercombatdata.samurai.displayname
    kr: "\uC0AC\uBB34\uB77C\uC774"
    source: "Assets/Data/Characters/Data_Character_\uC0AC\uBB34\uB77C\uC774.asset:displayName"
  - key: data.playercombatdata.samurai.description
    kr: "\uC804\uD22C \uC18D\uC5D0\uC11C\uB3C4 \uD56D\uC0C1 \uCE68\uCC29\uD568\uC744
      \uC783\uC9C0 \uC54A\uB294 \uB3D9\uBC29\uC758 \uBB34\uC0AC\uC785\uB2C8\uB2E4.
      \uACF5\uACA9\uC744 \uD295\uACA8\uB0B4\uACE0 \uCE58\uBA85\uC801\uC778 \uD53C\uD574\uB85C
      \uC5F0\uACB0\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    source: "Assets/Data/Characters/Data_Character_\uC0AC\uBB34\uB77C\uC774.asset:description"
  - key: data.playercombatdata.warrior.displayname
    kr: "\uC6CC\uB9AC\uC5B4"
    source: "Assets/Data/Characters/Data_Character_\uC6CC\uB9AC\uC5B4.asset:displayName"
  - key: data.playercombatdata.warrior.description
    kr: "\uBC29\uD328\uC640 \uD55C\uC190\uAC80\uC744 \uC8FC \uBB34\uAE30\uB85C \uAC01\uC885
      \uC804\uC7C1\uC5D0 \uCC38\uC5EC\uD558\uBA70 \uC6A9\uBCD1\uC774\uB098 \uBAA8\uD5D8\uAC00
      \uC77C\uC744 \uD574 \uC628 \uC804\uD22C\uC758 \uB2EC\uC778\uC785\uB2C8\uB2E4."
    source: "Assets/Data/Characters/Data_Character_\uC6CC\uB9AC\uC5B4.asset:description"
  - key: data.playercombatdata.wizard.displayname
    kr: "\uC704\uC790\uB4DC"
    source: "Assets/Data/Characters/Data_Character_\uC704\uC790\uB4DC.asset:displayName"
  - key: data.playercombatdata.wizard.description
    kr: "\uD638\uAE30\uC2EC\uC5D0 \uC758\uD574 \uBBF8\uAD81\uC5D0 \uBC1C\uC744 \uB4E4\uC778
      \uD0D1\uC758 \uB9C8\uBC95\uC0AC. \uD0C0\uACE0\uB09C \uB9C8\uB825 \uC6B4\uC6A9\uC73C\uB85C
      \uB2E4\uC591\uD55C \uC8FC\uBB38\uC744 \uC27D\uAC8C \uB2E4\uB8F0 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    source: "Assets/Data/Characters/Data_Character_\uC704\uC790\uB4DC.asset:description"
  - key: data.encounterdata.ashcrow.displayname
    kr: "\uC7AC \uAC00\uACE0\uC77C"
    source: "Assets/Data/Dungeon/Encounters/Data_Encounter_\uC7AC\uAC00\uACE0\uC77C.asset:displayName"
  - key: data.encounterdata.ashcrow.hint
    kr: "\uC9E7\uC740 \uC900\uBE44 \uB4A4 \uB0A0\uCE74\uB86D\uAC8C \uACF5\uACA9\uD55C\uB2E4.
      \uC2DC\uCC28\uB97C \uBCF4\uACE0 \uAC00\uB4DC\uD558\uC790."
    source: "Assets/Data/Dungeon/Encounters/Data_Encounter_\uC7AC\uAC00\uACE0\uC77C.asset:hint"
  - key: data.encounterdata.ashgeneral.displayname
    kr: "\uC7BF\uBD88 \uC655"
    source: "Assets/Data/Dungeon/Encounters/Data_Encounter_\uC7BF\uBD88\uC655.asset:displayName"
  - key: data.encounterdata.ashgeneral.hint
    kr: "\uC18C\uD658 \uAC15\uD0C0\uB97C \uB04A\uC9C0 \uBABB\uD558\uBA74 \uD5A5\uB85C
      \uB9DD\uB839\uC774 \uD569\uB958\uD55C\uB2E4. \uC18C\uD658\uACFC \uD6C4\uC18D
      \uAC15\uD0C0\uB97C \uBC88\uAC08\uC544 \uB300\uBE44\uD558\uC790."
    source: "Assets/Data/Dungeon/Encounters/Data_Encounter_\uC7BF\uBD88\uC655.asset:hint"
  - key: data.encounterdata.ashhound.displayname
    kr: "\uC22F\uBD88 \uB3C4\uB871\uB1FD"
    source: "Assets/Data/Dungeon/Encounters/Data_Encounter_\uC22F\uBD88\uB3C4\uB871\uB1FD.asset:displayName"
  - key: data.encounterdata.ashhound.hint
    kr: "\uBAB8\uC744 \uC6C5\uD06C\uB9B0 \uB4A4 \uB36E\uCE5C\uB2E4. \uAC15\uD0C0
      \uC57D\uC810\uC744 \uBA3C\uC800 \uB04A\uC790."
    source: "Assets/Data/Dungeon/Encounters/Data_Encounter_\uC22F\uBD88\uB3C4\uB871\uB1FD.asset:hint"
  - key: data.encounterdata.ashlamps.displayname
    kr: "\uD5A5\uB85C \uB9DD\uB839 \xB7 \uC22F\uBD88 \uB3C4\uB871\uB1FD"
    source: "Assets/Data/Dungeon/Encounters/Data_Encounter_\uD5A5\uB85C\uB9DD\uB839_\uC22F\uBD88\uB3C4\uB871\uB1FD.asset:displayName"
  - key: data.encounterdata.ashlamps.hint
    kr: "\uB2E4\uB978 \uC801 \uB4A4\uC5D0\uC11C \uACF5\uACA9\uD55C\uB2E4. \uC5F4\uB9B0
      \uD5A5\uB85C\uC758 \uC57D\uC810\uC744 \uB04A\uC790.\n\uBAB8\uC744 \uC6C5\uD06C\uB9B0
      \uB4A4 \uB36E\uCE5C\uB2E4. \uAC15\uD0C0 \uC57D\uC810\uC744 \uBA3C\uC800 \uB04A\uC790."
    source: "Assets/Data/Dungeon/Encounters/Data_Encounter_\uD5A5\uB85C\uB9DD\uB839_\uC22F\uBD88\uB3C4\uB871\uB1FD.asset:hint"
  - key: data.encounterdata.ashmaw.displayname
    kr: "\uACF5\uD5C8\uC758 \uB208 \xB7 \uC7AC \uAC00\uACE0\uC77C"
    source: "Assets/Data/Dungeon/Encounters/Data_Encounter_\uACF5\uD5C8\uC758\uB208_\uC7AC\uAC00\uACE0\uC77C.asset:displayName"
  - key: data.encounterdata.ashmaw.hint
    kr: "\uC911\uC559 \uB208\uC774 \uB4DC\uB7EC\uB098\uBA74 \uC57D\uC810\uC744 \uB04A\uC5B4
      \uC751\uC2DC\uB97C \uCDE8\uC18C\uD558\uC790.\n\uC9E7\uC740 \uC900\uBE44 \uB4A4
      \uB0A0\uCE74\uB86D\uAC8C \uACF5\uACA9\uD55C\uB2E4. \uC2DC\uCC28\uB97C \uBCF4\uACE0
      \uAC00\uB4DC\uD558\uC790."
    source: "Assets/Data/Dungeon/Encounters/Data_Encounter_\uACF5\uD5C8\uC758\uB208_\uC7AC\uAC00\uACE0\uC77C.asset:hint"
  - key: data.encounterdata.ashpair.displayname
