  - key: data.encounterdata.souleater.hint
    kr: "\uB0A0\uAC1C \uC0AC\uC774\uC640 \uBAB8\uD1B5\uC5D0 \uC5F4\uB9B0 \uC57D\uC810\uB4E4\uC744
