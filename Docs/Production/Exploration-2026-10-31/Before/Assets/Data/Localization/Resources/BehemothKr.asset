  - key: data.randomeventdata.scholar.options.1.title
    kr: "\uC774\uBBF8 \uC544\uB294 \uAD6C\uC808\uC744 \uB2E4\uC2DC \uC77D\uB294\uB2E4"
    source: "Assets/Data/Dungeon/Events/Data_Event_\uB05D\uAE4C\uC9C0_\uC77D\uB294_\uBC95.asset:options.Array.data[1].title"
  - key: data.randomeventdata.scholar.options.1.description
    kr: "\uBCF4\uC720 \uB2A5\uB825 \uD558\uB098\uB97C \uAC15\uD654\uD55C\uB2E4."
    source: "Assets/Data/Dungeon/Events/Data_Event_\uB05D\uAE4C\uC9C0_\uC77D\uB294_\uBC95.asset:options.Array.data[1].description"
  - key: data.randomeventdata.scholar.options.2.title
    kr: "\uC57D\uC81C\uBC95 \uD55C \uCABD\uC744 \uBCA0\uB080\uB2E4"
    source: "Assets/Data/Dungeon/Events/Data_Event_\uB05D\uAE4C\uC9C0_\uC77D\uB294_\uBC95.asset:options.Array.data[2].title"
  - key: data.randomeventdata.scholar.options.2.description
    kr: "\uD3EC\uC158 1\uAC1C. \uD3EC\uC158\uC774 \uAC00\uB4DD\uD558\uBA74 \uCCB4\uB825
      8 \uD68C\uBCF5."
    source: "Assets/Data/Dungeon/Events/Data_Event_\uB05D\uAE4C\uC9C0_\uC77D\uB294_\uBC95.asset:options.Array.data[2].description"
  - key: data.randomeventdata.shelter.displayname
    kr: "\uBD88\uCE68\uBC88\uC744 \uC815\uD558\uC790"
    source: "Assets/Data/Dungeon/Events/Data_Event_\uBD88\uCE68\uBC88\uC744_\uC815\uD558\uC790.asset:displayName"
  - key: data.randomeventdata.shelter.narrative
    kr: "\uBCF5\uB3C4 \uD55C\uCABD\uC5D0 \uBC84\uB824\uC9C4 \uACBD\uBE44\uC2E4\uC774
      \uC788\uB2E4.\r\n\r\n\uBB38\uC5D0\uB294 \uC548\uC5D0\uC11C \uAC78 \uC218 \uC788\uB294
      \uD2BC\uD2BC\uD55C \uBE57\uC7A5\uC774 \uB0A8\uC544 \uC788\uB2E4.\r\n\r\n\uB3CC\uB09C\uB85C
      \uC606\uC5D0\uB294 \uB9C8\uB978 \uC7A5\uC791\uC774 \uC313\uC5EC \uC788\uACE0,
      \uBCA4\uCE58\uC5D0\uB294 \uB0A1\uC740 \uB2F4\uC694\uAC00 \uB193\uC5EC \uC788\uB2E4.\r\n\r\n\uBB38\uC744
      \uB2EB\uACE0 \uBD88\uC744 \uD53C\uC6B0\uBA74 \uC7A0\uC2DC \uBAB8\uC744 \uC26C\uAC8C
      \uD560 \uC218 \uC788\uACA0\uB2E4."
    source: "Assets/Data/Dungeon/Events/Data_Event_\uBD88\uCE68\uBC88\uC744_\uC815\uD558\uC790.asset:narrative"
  - key: data.randomeventdata.shelter.options.0.title
    kr: "\uBD88\uC744 \uC9C0\uD0A4\uBA70 \uC270\uB2E4"
    source: "Assets/Data/Dungeon/Events/Data_Event_\uBD88\uCE68\uBC88\uC744_\uC815\uD558\uC790.asset:options.Array.data[0].title"
  - key: data.randomeventdata.shelter.options.0.description
    kr: "\uCCB4\uB825 24 \uD68C\uBCF5."
    source: "Assets/Data/Dungeon/Events/Data_Event_\uBD88\uCE68\uBC88\uC744_\uC815\uD558\uC790.asset:options.Array.data[0].description"
  - key: data.randomeventdata.shelter.options.1.title
