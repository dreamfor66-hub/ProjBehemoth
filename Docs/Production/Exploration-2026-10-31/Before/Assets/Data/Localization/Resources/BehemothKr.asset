  - key: data.randomeventdata.amberseed.pages.0.options.2.resulttext
    kr: "\uADF8\uB300\uB85C \uC790\uB9AC\uB97C \uB5A0\uB0AC\uB2E4."
    source: "Assets/Data/Dungeon/Events/Data_Event_\uB531_\uD558\uB098_\uB0A8\uC740_\uC5F4\uB9E4.asset:pages.Array.data[0].options.Array.data[2].resultText"
  - key: data.randomeventdata.banner.pages.0.narrative
    kr: "\uAC80\uBB38\uC18C\uC758 \uAC11\uC637\uC774 \uCC3D\uC744 \uB0B4\uB824 \uAE38\uC744
      \uB9C9\uB294\uB2E4.\r\n\r\n\uAD50\uB300\uC790. \uC18C\uC18D\uC744 \uBC1D\uD600\uB77C.\r\n\r\n\uD22C\uAD6C
      \uC548\uC740 \uBE44\uC5B4 \uC788\uB2E4. \uC774 \uC131\uC758 \uC218\uBE44\uB300\uAC00
      \uC0AC\uB77C\uC9C4 \uAC83\uB3C4 \uBAA8\uB974\uB294 \uBAA8\uC591\uC774\uB2E4.\r\n\r\n\uAC11\uC637\uC740
      \uB0B4 \uBB34\uC7A5\uC744 \uC0B4\uD53C\uB354\uB2C8 \uC2DC\uD5D8\uC744 \uBC1B\uC544
      \uAD50\uB300\uD560 \uC790\uACA9\uC744 \uC99D\uBA85\uD558\uB77C\uACE0 \uD55C\uB2E4.\r\n\r\n\uC2F8\uC6B8
      \uC0DD\uAC01\uC774 \uC5C6\uB2E4\uBA74 \uAE09\uB8CC\uD568\uB9CC \uBE44\uC6B0\uACE0
      \uAC00\uB77C. \uC544\uC9C1 \uBC1B\uC73C\uB7EC \uC628 \uC0AC\uB78C\uC774 \uC5C6\uB2E4."
    source: "Assets/Data/Dungeon/Events/Data_Event_\uC544\uC9C1_\uAD50\uB300_\uC2DC\uAC04\uC774_\uC544\uB2C8\uB2E4.asset:pages.Array.data[0].narrative"
