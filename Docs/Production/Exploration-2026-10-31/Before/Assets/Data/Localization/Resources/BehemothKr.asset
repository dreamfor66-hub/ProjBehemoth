  - key: ui.tutorial.exploration.title
    kr: "\uBBF8\uAD81 \uD0D0\uD5D8 \uC548\uB0B4"
    source: Scripts/UI/ArcadeHudController.cs
  - key: ui.tutorial.exploration.body
    kr: "\uBB38\uC744 \uB20C\uB7EC \uB2E4\uC74C \uBC29\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4.\n\n[Tab]
      \uC9C0\uB3C4\n\uC9C0\uB098\uC628 \uBC29\uACFC \uAC08 \uC218 \uC788\uB294 \uAE38\uC744
      \uD655\uC778\uD569\uB2C8\uB2E4.\n\n[I] \uBCF4\uC720\uD488\n\uC720\uBB3C\uACFC
      \uD3EC\uC158\uC758 \uD6A8\uACFC\uB97C \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC548\uB0B4\uB97C
      \uB2EB\uC73C\uBA74 \uD0D0\uD5D8\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4."
    source: Scripts/UI/ArcadeHudController.cs
  - key: ui.tutorial.combat.title
    kr: "\uC804\uD22C \uC870\uC791 \uC548\uB0B4"
    source: Scripts/UI/ArcadeHudController.cs
  - key: ui.tutorial.combat.body
    kr: "\uACF5\uACA9\n\uC801\uC744 \uD5A5\uD574 \uBE60\uB974\uAC8C \uADF8\uC73C\uBA74
      \uC77C\uBC18 \uACF5\uACA9\uC785\uB2C8\uB2E4. \uAE38\uAC8C \uB204\uB978 \uB4A4
      \uADF8\uC73C\uBA74 \uCC28\uC9C0 \uACF5\uACA9\uC785\uB2C8\uB2E4.\n\n\uAC00\uB4DC\n\uCE90\uB9AD\uD130
      \uCABD\uC73C\uB85C \uC544\uB798\uB85C \uB2F9\uAE34 \uB4A4 \uB204\uB974\uACE0
      \uC788\uC73C\uBA74 \uAC00\uB4DC\uD569\uB2C8\uB2E4. \uD0A4\uBCF4\uB4DC\uC5D0\uC11C\uB294
      [Space]\uB85C \uAC00\uB4DC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC548\uB0B4\uB97C
      \uC77D\uB294 \uB3D9\uC548 \uC804\uD22C\uB294 \uC9C4\uD589\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uC900\uBE44\uAC00 \uB418\uBA74 \uC544\uB798 \uBC84\uD2BC\uC744 \uB20C\uB7EC
      \uC2DC\uC791\uD558\uC138\uC694."
    source: Scripts/UI/ArcadeHudController.cs
  - key: ui.tutorial.combat.magic
    kr: "\uC8FC\uBB38\n[Shift] \uB610\uB294 \uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD
      \uBC84\uD2BC\uC744 \uB204\uB978 \uCC44 \uAE30\uB2E4\uB9B0 \uB4A4 \uADF8\uC73C\uBA74
      \uC7A5\uCC29\uD55C \uC8FC\uBB38\uC744 \uC0AC\uC6A9\uD569\uB2C8\uB2E4. \uC8FC\uBB38\uC5D0\uB294
      MP\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4."
    source: Scripts/UI/ArcadeHudController.cs
  - key: data.playercombatdata.angular01_barbarian.displayname
    kr: "\uBC14\uBC14\uB9AC\uC548"
    source: "Assets/Data/Presentation/Trials/Data_Character_\uBC14\uBC14\uB9AC\uC548.asset:displayName"
  - key: data.playercombatdata.angular01_barbarian.description
    kr: "\uB3D9\uBB3C\uC801 \uBCF8\uB2A5\uACFC \uC6D0\uCD08\uC801\uC778 \uD798, \uC2DD\uC744
      \uC904 \uBAA8\uB974\uB294 \uBD84\uB178\uB97C \uAC70\uCE68\uC5C6\uC774 \uBC1C\uC0B0\uD558\uB294
      \uC57C\uC131\uC801\uC778 \uC804\uC0AC\uC785\uB2C8\uB2E4."
    source: "Assets/Data/Presentation/Trials/Data_Character_\uBC14\uBC14\uB9AC\uC548.asset:description"
  - key: data.playercombatdata.angular01_monk.displayname
    kr: "\uBABD\uD06C"
    source: "Assets/Data/Presentation/Trials/Data_Character_\uBABD\uD06C.asset:displayName"
  - key: data.playercombatdata.angular01_monk.description
    kr: "\uC5EC\uB7EC \uACF5\uACA9\uC744 \uD558\uB098\uC758 \uACF5\uACA9 \uCC98\uB7FC
      \uBB3C \uD750\uB974\uB4EF \uC5F0\uACB0\uD558\uB294 \uB0A0\uB835\uD55C \uBAB8\uB180\uB9BC\uC758
      \uBB34\uC608\uAC00 \uC785\uB2C8\uB2E4."
    source: "Assets/Data/Presentation/Trials/Data_Character_\uBABD\uD06C.asset:description"
  - key: data.playercombatdata.angular01_rogue.displayname
    kr: "\uB85C\uADF8"
    source: "Assets/Data/Presentation/Trials/Data_Character_\uB85C\uADF8.asset:displayName"
  - key: data.playercombatdata.angular01_rogue.description
    kr: "\uC740\uC2E0 \uB2A5\uB825\uACFC \uB3C5, \uB6F0\uC5B4\uB09C \uBC18\uC0AC
      \uC2E0\uACBD\uC744 \uD65C\uC6A9\uD574 \uB300\uBD80\uBD84\uC758 \uC0C1\uD669\uC5D0\uC11C
      \uC6B0\uC704\uB97C \uC810\uD560 \uC218 \uC788\uB294 \uB2E4\uC7AC\uB2E4\uB2A5\uD55C
      \uC874\uC7AC\uC785\uB2C8\uB2E4."
    source: "Assets/Data/Presentation/Trials/Data_Character_\uB85C\uADF8.asset:description"
  - key: data.playercombatdata.angular01_samurai.displayname
    kr: "\uC0AC\uBB34\uB77C\uC774"
    source: "Assets/Data/Presentation/Trials/Data_Character_\uC0AC\uBB34\uB77C\uC774.asset:displayName"
  - key: data.playercombatdata.angular01_samurai.description
    kr: "\uC804\uD22C \uC18D\uC5D0\uC11C\uB3C4 \uD56D\uC0C1 \uCE68\uCC29\uD568\uC744
      \uC783\uC9C0 \uC54A\uB294 \uB3D9\uBC29\uC758 \uBB34\uC0AC\uC785\uB2C8\uB2E4.
      \uACF5\uACA9\uC744 \uD295\uACA8\uB0B4\uACE0 \uCE58\uBA85\uC801\uC778 \uD53C\uD574\uB85C
      \uC5F0\uACB0\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    source: "Assets/Data/Presentation/Trials/Data_Character_\uC0AC\uBB34\uB77C\uC774.asset:description"
  - key: data.playercombatdata.angular01_warrior.displayname
    kr: "\uC6CC\uB9AC\uC5B4"
    source: "Assets/Data/Presentation/Trials/Data_Character_\uC6CC\uB9AC\uC5B4.asset:displayName"
  - key: data.playercombatdata.angular01_warrior.description
    kr: "\uBC29\uD328\uC640 \uD55C\uC190\uAC80\uC744 \uC8FC \uBB34\uAE30\uB85C \uAC01\uC885
      \uC804\uC7C1\uC5D0 \uCC38\uC5EC\uD558\uBA70 \uC6A9\uBCD1\uC774\uB098 \uBAA8\uD5D8\uAC00
      \uC77C\uC744 \uD574 \uC628 \uC804\uD22C\uC758 \uB2EC\uC778\uC785\uB2C8\uB2E4."
    source: "Assets/Data/Presentation/Trials/Data_Character_\uC6CC\uB9AC\uC5B4.asset:description"
  - key: data.playercombatdata.angular01_wizard.displayname
    kr: "\uC704\uC790\uB4DC"
    source: "Assets/Data/Presentation/Trials/Data_Character_\uC704\uC790\uB4DC.asset:displayName"
  - key: data.playercombatdata.angular01_wizard.description
    kr: "\uD638\uAE30\uC2EC\uC5D0 \uC758\uD574 \uBBF8\uAD81\uC5D0 \uBC1C\uC744 \uB4E4\uC778
      \uD0D1\uC758 \uB9C8\uBC95\uC0AC. \uD0C0\uACE0\uB09C \uB9C8\uB825 \uC6B4\uC6A9\uC73C\uB85C
      \uB2E4\uC591\uD55C \uC8FC\uBB38\uC744 \uC27D\uAC8C \uB2E4\uB8F0 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    source: "Assets/Data/Presentation/Trials/Data_Character_\uC704\uC790\uB4DC.asset:description"
  - key: data.playercombatdata.barbarian_e8e5e81b.displayname
    kr: "\uBC14\uBC14\uB9AC\uC548"
    source: "Assets/Data/Presentation/Trials/Data_Character_\uBC14\uBC14\uB9AC\uC548.asset:displayName"
  - key: data.playercombatdata.barbarian_e8e5e81b.description
    kr: "\uB3D9\uBB3C\uC801 \uBCF8\uB2A5\uACFC \uC6D0\uCD08\uC801\uC778 \uD798, \uC2DD\uC744
      \uC904 \uBAA8\uB974\uB294 \uBD84\uB178\uB97C \uAC70\uCE68\uC5C6\uC774 \uBC1C\uC0B0\uD558\uB294
