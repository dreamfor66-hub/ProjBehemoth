  - key: "data.randomeventdata.data_event_\uC131\uC7A5\uD55C_\uC81C\uC790.pages.5.narrative"
    kr: "\uC5F0\uAD6C\uC2E4 \uC548\uC5D0\uC11C \uC775\uC219\uD55C \uBAA9\uC18C\uB9AC\uAC00
