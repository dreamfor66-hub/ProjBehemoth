  - key: ui.fatigue.potion.name
    kr: "\uAE30\uC6B4 \uD68C\uBCF5 \uD3EC\uC158"
    source: Fatigue
  - key: ui.fatigue.potion.detail
    kr: "\uD53C\uB85C\uB3C4 30 \uD68C\uBCF5"
    source: Fatigue
  - key: data.equipmentdata.fatiguepotion.displayname
    kr: "\uAE30\uC6B4 \uD68C\uBCF5 \uD3EC\uC158"
    source: "Assets/Data/Items/Potions/Data_Potion_\uAE30\uC6B4_\uD68C\uBCF5_\uD3EC\uC158.asset:displayName"
  - key: data.equipmentdata.fatiguepotion.description
    kr: "\uD53C\uB85C\uB3C4 30 \uD68C\uBCF5. 100\uC744 \uB118\uC9C0 \uC54A\uC73C\uBA70
      \uB2E4\uC74C \uC774\uB3D9\uBD80\uD130 \uB2E4\uC2DC \uAC10\uC18C\uD55C\uB2E4."
    source: "Assets/Data/Items/Potions/Data_Potion_\uAE30\uC6B4_\uD68C\uBCF5_\uD3EC\uC158.asset:description"
  - key: ui.camp.marker
    kr: "\uC57C"
    source: Fatigue
  - key: ui.camp.full.summary
    kr: "\uD53C\uB85C\uB3C4 100\uAE4C\uC9C0 \xB7 \uCCB4\uB825 10 \uD68C\uBCF5"
    source: Fatigue
