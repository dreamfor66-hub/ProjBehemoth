  - narrative: "\uC9C0\uB098\uC628 \uCABD\uC744 \uC9DA\uC5B4 \uC8FC\uC790 \uB178\uC778\uC774
      \uC9C0\uB3C4 \uD55C \uADC0\uD241\uC774\uB97C \uC811\uB294\uB2E4.\n\n\u201C\uADF8\uCABD\uC740
      \uC9C0\uC6CC\uC57C\uACA0\uAD70\uC694. \uC774 \uC9C0\uB3C4\uB97C \uBBFF\uACE0
      \uB0B4\uB824\uC62C \uC0AC\uB78C\uC774 \uB610 \uC788\uC744 \uD14C\uB2C8.\u201D\n\n\uADF8\uB294
      \uBD84\uD544\uC744 \uB123\uACE0 \uB0B4 \uC190\uC744 \uC0B4\uD540\uB2E4.\n\n\u201C\uB2F5\uB840\uB294
      \uD574\uC57C\uC9C0\uC694. \uC190\uB05D\uC5D0 \uD798\uC744 \uBAA8\uC544 \uBCF8
      \uC801 \uC788\uC2B5\uB2C8\uAE4C? \uB0B4\uB824\uAC00\uC2E4 \uAC70\uBA74 \uC4F8
      \uB370\uAC00 \uC788\uC744 \uAC81\uB2C8\uB2E4.\u201D"
    illustration: {fileID: 21300000, guid: ca3727e3e5cea34439960899dd65dc58, type: 3}
