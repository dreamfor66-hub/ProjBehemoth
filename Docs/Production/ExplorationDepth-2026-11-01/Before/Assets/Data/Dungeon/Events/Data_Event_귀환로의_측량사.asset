  pages:
  - narrative: "\uB178\uC778\uC774 \uC9C0\uB3C4\uD310 \uC704\uC758 \uB450 \uAC08\uB798
      \uC120\uC744 \uBC88\uAC08\uC544 \uC9DA\uB294\uB2E4. \uAC00\uBC29\uC5D0\uB294
      \uAE38 \uD45C\uC2DC\uC6A9 \uB048\uC774 \uBB36\uC5EC \uC788\uACE0, \uC7A5\uAC11\uC758
      \uC190\uB05D\uC740 \uBD84\uD544 \uAC00\uB8E8\uB85C \uD76C\uB2E4.\n\n\uADF8\uAC00
      \uB098\uCE68\uBC18\uC744 \uB2EB\uACE0 \uB0B4 \uCABD\uC744 \uBCF8\uB2E4.\n\n\u201C\uC9C0\uAE08
      \uC624\uC2E0 \uAE38\uC5D0 \uC138 \uC904\uB85C \uBB36\uC740 \uB048\uC774 \uC788\uB358\uAC00\uC694?
      \uC61B \uC9C0\uB3C4\uC5D0\uB294 \uC591\uCABD \uB2E4 \uADC0\uD658\uB85C\uB77C\uACE0
      \uB418\uC5B4 \uC788\uC5B4\uC11C.\u201D"
    illustration: {fileID: 21300000, guid: ca3727e3e5cea34439960899dd65dc58, type: 3}
    options:
