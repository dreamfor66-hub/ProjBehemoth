    \uAC00\uC8FD \uBAA9\uC904\uACFC \uB2E4\uCE5C \uC55E\uBC1C\uC774 \uB0A8\uC558\uB2E4.
    \uB3C4\uC6C0\uC744 \uC8FC\uBA74 \uBC1C\uACAC \uADF8\uB9BC\uACFC \uAC19\uC740
    \uAC08\uC0C9\xB7\uD770\uC0C9 \uBB34\uB2AC/\uBD95\uB300/\uBAA9\uAC78\uC774\uB97C
    \uC720\uC9C0\uD55C \uB3D9\uB8CC\uB85C \uD569\uB958\uD55C\uB2E4."
