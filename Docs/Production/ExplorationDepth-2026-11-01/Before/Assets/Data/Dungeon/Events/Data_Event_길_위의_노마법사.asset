      supplyCost: 0
      nextPage: -1
      failurePage: -1
      resultText: "\uAC00\uBC29 \uB048\uC744 \uC6C0\uCF1C\uC950\uACE0 \uCC45\uC744
        \uBE7C\uB0C8\uB2E4. \uB178\uC778\uC740 \uB0A8\uC740 \uB450\uB8E8\uB9C8\uB9AC\uB97C
        \uD488\uC5D0 \uB123\uC5C8\uB2E4. \u201C\uC81C \uAE30\uB85D\uC5D0\uB294 \uB2F9\uC2E0
        \uC774\uB984\uC744 \uB0A8\uAE30\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4.\u201D
        \uADF8\uB294 \uB3CC\uC544\uC11C \uAC78\uC5B4\uAC14\uB2E4."
      resultingWorldObject: {fileID: 0}
      removeWorldObject: 1
