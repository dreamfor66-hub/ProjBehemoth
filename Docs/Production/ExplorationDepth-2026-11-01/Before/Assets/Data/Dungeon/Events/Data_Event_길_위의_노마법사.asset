  pages:
  - narrative: "\uB178\uC778\uC774 \uC120 \uCC44\uB85C \uB450\uB8E8\uB9C8\uB9AC\uB97C
      \uB4E4\uC5EC\uB2E4\uBCF8\uB2E4. \uBAA8\uC11C\uB9AC\uC5D0 \uC62E\uACA8\uBD99\uC740
      \uBD88\uC528\uB3C4 \uC54C\uC544\uCC44\uC9C0 \uBABB\uD55C \uCC44 \uAE00\uC904\uC744
      \uC190\uC73C\uB85C \uB530\uB77C\uAC04\uB2E4.\n\n\u201C\uC5EC\uAE30\uC11C \uD558\uB098\uB9CC
      \uB354 \uCC3E\uC73C\uBA74 \uD310\uBCF8\uC774 \uB9DE\uB294\uB370\u2026\u201D\n\n\uAC00\uBC29
      \uBC16\uC73C\uB85C \uB0B4\uBBFC \uC885\uC774\uC5D0\uB294 \uD314\uC544 \uB118\uAE34
      \uAE30\uB85D\uB4E4\uC758 \uC778\uC218 \uB3C4\uC7A5\uC774 \uBE7C\uACE1\uD558\uB2E4.
      \uBD88\uC528\uAC00 \uC190\uAC00\uB77D \uCABD\uC73C\uB85C \uBC88\uC9C4\uB2E4."
    illustration: {fileID: 21300000, guid: ca3727e3e5cea34439960899dd65dc58, type: 3}
