  - narrative: "\uBD88\uC528\uB97C \uD138\uC5B4 \uC8FC\uC790 \uB178\uC778\uC774 \uAE09\uD788
      \uB450\uB8E8\uB9C8\uB9AC\uB97C \uC811\uB294\uB2E4.\n\n\u201C\uC7AC\uBCF4\uB2E4
      \uBA3C\uC800 \uD68C\uC218\uD574\uC57C \uD558\uB294\uB370, \uC81C\uAC00 \uBA3C\uC800
      \uD0DC\uC6B8 \uBED4\uD588\uAD70\uC694.\u201D\n\n\uADF8\uB294 \uB0B4 \uC190\uC744
      \uC7A0\uAE50 \uC0B4\uD540\uB2E4.\n\n\u201C\uB9C8\uBC95\uC744 \uC4F0\uC2E0\uB2E4\uBA74
      \uAE30\uB85D \uD558\uB098\uB9CC \uB0A8\uACA8 \uC8FC\uC138\uC694. \uC2E4\uC81C\uB85C
      \uD1B5\uD588\uB358 \uC8FC\uBB38\uC774 \uD544\uC694\uD569\uB2C8\uB2E4. \uB300\uC2E0
      \uC190\uC5D0 \uB9DE\uAC8C \uAC00\uB974\uCCD0 \uB4DC\uB9AC\uC9C0\uC694.\u201D"
    illustration: {fileID: 21300000, guid: ca3727e3e5cea34439960899dd65dc58, type: 3}
    options:
    - title: "\uBC30\uC6CC \uBCF4\uACE0 \uC2F6\uB2E4\uACE0 \uD55C\uB2E4."
