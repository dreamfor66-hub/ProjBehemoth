  m_Name: "Data_Event_\uBD89\uC740_\uC11C\uBA85"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.contract.displayname
    lastText: "\uBD89\uC740 \uC11C\uBA85"
  - propertyPath: narrative
    key: data.randomeventdata.contract.narrative
    lastText: "\uBD89\uC740 \uBC00\uB78D\uC73C\uB85C \uBD09\uD55C \uB450\uB8E8\uB9C8\uB9AC\uAC00
      \uAE38\uAC00\uC5D0 \uB193\uC5EC \uC788\uB2E4.\n\n\uC190\uC744 \uB300\uC790
      \uC885\uC774\uC5D0\uC11C \uBAA9\uC18C\uB9AC\uAC00 \uD758\uB7EC\uB098\uC628\uB2E4.\n\n\u201C\uC11C\uBA85\uD558\uBA74
      \uD798\uC744 \uC5BB\uB294\uB2E4. \uC6D0\uCE58 \uC54A\uC73C\uBA74 \uAE08\uBC15
      \uBD09\uC778\uB9CC \uAC00\uC838\uAC00\uB3C4 \uC88B\uB2E4.\u201D"
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.contract.options.0.title
    lastText: "\uC9E7\uACE0 \uAD75\uAC8C"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.contract.options.0.description
    lastText: "\uCD5C\uB300 \uCCB4\uB825 -18. \uBD89\uC740 \uACC4\uC57D\uC11C: \uBAA8\uB4E0
      \uD53C\uD574 +25%, \uBC1B\uB294 \uD68C\uBCF5\uB7C9 -40%."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.contract.options.1.title
    lastText: "\uBC31\uC9C0 \uACC4\uC57D\uC11C\uB97C \uB418\uD310\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.contract.options.1.description
    lastText: "\uACE8\uB4DC +25. \uACC4\uC57D\uC758 \uD798\uC740 \uC5BB\uC9C0 \uC54A\uB294\uB2E4."
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.contract.options.0.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.contract.options.1.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.contract.pages.0.narrative
    lastText: "\uBD89\uC740 \uBC00\uB78D\uC73C\uB85C \uBD09\uD55C \uB450\uB8E8\uB9C8\uB9AC\uAC00
      \uAE38\uAC00\uC5D0 \uB193\uC5EC \uC788\uB2E4.\n\n\uC190\uC744 \uB300\uC790
      \uC885\uC774\uC5D0\uC11C \uBAA9\uC18C\uB9AC\uAC00 \uD758\uB7EC\uB098\uC628\uB2E4.\n\n\u201C\uC11C\uBA85\uD558\uBA74
      \uD798\uC744 \uC5BB\uB294\uB2E4. \uC6D0\uCE58 \uC54A\uC73C\uBA74 \uAE08\uBC15
      \uBD09\uC778\uB9CC \uAC00\uC838\uAC00\uB3C4 \uC88B\uB2E4.\u201D"
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.contract.pages.0.options.0.title
    lastText: "\uAE08\uBC15 \uBD09\uC778\uB9CC \uB5BC\uC5B4 \uB0B8\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
    key: data.randomeventdata.contract.pages.0.options.0.description
    lastText: "\uACE8\uB4DC +25"
  - propertyPath: pages.Array.data[0].options.Array.data[0].resultText
    key: data.randomeventdata.contract.pages.0.options.0.resulttext
    lastText: "\uAE08\uBC15\uC744 \uB5BC\uC5B4 \uB0B4\uC790 \uACC4\uC57D\uC11C\uC640
      \uBC1B\uCE68\uD568\uC774 \uD568\uAED8 \uC7AC\uB85C \uBB34\uB108\uC84C\uB2E4.
      \uCC59\uAE34 \uAE08\uBC15\uC740 \uB3C8\uC73C\uB85C \uC4F8 \uC218 \uC788\uACA0\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].title
    key: data.randomeventdata.contract.pages.0.options.1.title
    lastText: "\uBB34\uC2A8 \uACC4\uC57D\uC778\uC9C0 \uBB3B\uB294\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
    key: data.randomeventdata.contract.pages.0.options.1.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: data.randomeventdata.contract.pages.0.options.1.resulttext
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[2].title
    key: data.randomeventdata.contract.pages.0.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].description
    key: data.randomeventdata.contract.pages.0.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: data.randomeventdata.contract.pages.0.options.2.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[1].narrative
    key: data.randomeventdata.contract.pages.1.narrative
    lastText: "\u201C\uC11C\uBA85\uC790\uC758 \uC0DD\uBA85\uC744 \uD798\uC73C\uB85C
      \uBC14\uAFBC\uB2E4. \uC774 \uC131\uC5D0\uC11C \uC624\uB798 \uBC84\uD2F0\uACE0
      \uC2F6\uB2E4\uBA74 \uC4F8 \uB9CC\uD55C \uAC70\uB798\uB2E4.\u201D"
  - propertyPath: pages.Array.data[1].options.Array.data[0].title
    key: data.randomeventdata.contract.pages.1.options.0.title
    lastText: "\uB300\uAC00\uB97C \uBB3B\uB294\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].description
    key: data.randomeventdata.contract.pages.1.options.0.description
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[0].resultText
    key: data.randomeventdata.contract.pages.1.options.0.resulttext
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[1].title
    key: data.randomeventdata.contract.pages.1.options.1.title
    lastText: "\uAE08\uBC15 \uBD09\uC778\uB9CC \uB5BC\uC5B4 \uB0B8\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].description
    key: data.randomeventdata.contract.pages.1.options.1.description
    lastText: "\uACE8\uB4DC +25"
  - propertyPath: pages.Array.data[1].options.Array.data[1].resultText
    key: data.randomeventdata.contract.pages.1.options.1.resulttext
    lastText: "\uAE08\uBC15\uC744 \uB5BC\uC5B4 \uB0B4\uC790 \uACC4\uC57D\uC11C\uC640
      \uBC1B\uCE68\uD568\uC774 \uD568\uAED8 \uC7AC\uB85C \uBB34\uB108\uC84C\uB2E4.
      \uCC59\uAE34 \uAE08\uBC15\uC740 \uB3C8\uC73C\uB85C \uC4F8 \uC218 \uC788\uACA0\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[2].title
    key: data.randomeventdata.contract.pages.1.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[2].description
    key: data.randomeventdata.contract.pages.1.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[2].resultText
    key: data.randomeventdata.contract.pages.1.options.2.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[2].narrative
    key: data.randomeventdata.contract.pages.2.narrative
    lastText: "\u201C\uB0A8\uC740 \uC218\uBA85\uC758 \uC77C\uBD80\uB2E4. \uB2E4\uCE5C
      \uC0C1\uCC98\uCC98\uB7FC \uB2E4\uC2DC \uCC44\uC6B8 \uC218 \uC788\uB294 \uAC83\uC740
      \uC544\uB2C8\uB2E4.\u201D"
  - propertyPath: pages.Array.data[2].options.Array.data[0].title
    key: data.randomeventdata.contract.pages.2.options.0.title
    lastText: "\uD6A8\uACFC\uB97C \uD655\uC778\uD560 \uC218 \uC788\uB294\uC9C0 \uBB3B\uB294\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].description
    key: data.randomeventdata.contract.pages.2.options.0.description
    lastText: 
  - propertyPath: pages.Array.data[2].options.Array.data[0].resultText
    key: data.randomeventdata.contract.pages.2.options.0.resulttext
    lastText: 
  - propertyPath: pages.Array.data[2].options.Array.data[1].title
    key: data.randomeventdata.contract.pages.2.options.1.title
    lastText: "\uC11C\uBA85\uD55C\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[1].description
    key: data.randomeventdata.contract.pages.2.options.1.description
    lastText: "\uBD89\uC740 \uACC4\uC57D\uC11C \uD68D\uB4DD"
  - propertyPath: pages.Array.data[2].options.Array.data[1].resultText
    key: data.randomeventdata.contract.pages.2.options.1.resulttext
    lastText: "\uC11C\uBA85\uC744 \uB9C8\uCE58\uC790 \uC228\uC774 \uC7A0\uC2DC \uB9C9\uD614\uB2E4.
      \uBAB8\uC744 \uC77C\uC73C\uD0A4\uB2C8 \uC774\uC804\uBCF4\uB2E4 \uBB34\uAE30\uAC00
      \uAC00\uBCCD\uB2E4. \uACC4\uC57D\uC11C\uC640 \uBC1B\uCE68\uD568\uC774 \uD568\uAED8
      \uBD89\uC740 \uC7AC\uAC00 \uB418\uC5B4 \uD769\uC5B4\uC84C\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[2].title
    key: data.randomeventdata.contract.pages.2.options.2.title
    lastText: "\uAE08\uBC15 \uBD09\uC778\uB9CC \uB5BC\uC5B4 \uB0B8\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[2].description
    key: data.randomeventdata.contract.pages.2.options.2.description
    lastText: "\uACE8\uB4DC +25"
  - propertyPath: pages.Array.data[2].options.Array.data[2].resultText
    key: data.randomeventdata.contract.pages.2.options.2.resulttext
    lastText: "\uAE08\uBC15\uC744 \uB5BC\uC5B4 \uB0B4\uC790 \uACC4\uC57D\uC11C\uC640
      \uBC1B\uCE68\uD568\uC774 \uD568\uAED8 \uC7AC\uB85C \uBB34\uB108\uC84C\uB2E4.
      \uCC59\uAE34 \uAE08\uBC15\uC740 \uB3C8\uC73C\uB85C \uC4F8 \uC218 \uC788\uACA0\uB2E4."
  - propertyPath: pages.Array.data[3].narrative
    key: data.randomeventdata.contract.pages.3.narrative
    lastText: "\uC885\uC774\uC5D0\uC11C \uBED7\uC740 \uBD89\uC740 \uBE5B\uC774 \uB0B4
      \uBB34\uAE30\uB97C \uAC10\uC2FC\uB2E4. \uC7A0\uAE50\uC774\uB098\uB9C8 \uBB34\uAC70\uC6B4
      \uBB34\uAE30\uAC00 \uAC00\uBCCD\uAC8C \uB4E4\uB9B0\uB2E4.\n\n\u201C\uC11C\uBA85\uD558\uBA74
      \uC774 \uD798\uC774 \uB0A8\uB294\uB2E4. \uC0DD\uBA85\uC774 \uC904\uC5B4\uB4DC\uB294
      \uC77C\uB3C4 \uB418\uB3CC\uB9B4 \uC218 \uC5C6\uB2E4.\u201D"
  - propertyPath: pages.Array.data[3].options.Array.data[0].title
    key: data.randomeventdata.contract.pages.3.options.0.title
    lastText: "\uC11C\uBA85\uD55C\uB2E4."
  - propertyPath: pages.Array.data[3].options.Array.data[0].description
    key: data.randomeventdata.contract.pages.3.options.0.description
    lastText: "\uBD89\uC740 \uACC4\uC57D\uC11C \uD68D\uB4DD"
  - propertyPath: pages.Array.data[3].options.Array.data[0].resultText
    key: data.randomeventdata.contract.pages.3.options.0.resulttext
    lastText: "\uC11C\uBA85\uC744 \uB9C8\uCE58\uC790 \uC228\uC774 \uC7A0\uC2DC \uB9C9\uD614\uB2E4.
      \uBAB8\uC744 \uC77C\uC73C\uD0A4\uB2C8 \uC774\uC804\uBCF4\uB2E4 \uBB34\uAE30\uAC00
      \uAC00\uBCCD\uB2E4. \uACC4\uC57D\uC11C\uC640 \uBC1B\uCE68\uD568\uC774 \uD568\uAED8
      \uBD89\uC740 \uC7AC\uAC00 \uB418\uC5B4 \uD769\uC5B4\uC84C\uB2E4."
  - propertyPath: pages.Array.data[3].options.Array.data[1].title
