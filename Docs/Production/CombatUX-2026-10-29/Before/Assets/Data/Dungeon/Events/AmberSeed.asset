  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: AmberSeed
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.amberseed.displayname
    lastText: "\uB531 \uD558\uB098 \uB0A8\uC740 \uC5F4\uB9E4"
  - propertyPath: narrative
    key: data.randomeventdata.amberseed.narrative
    lastText: "\uC5F0\uAE08\uC220\uC2E4 \uC548\uCABD\uC5D0 \uC120\uBC18\uACFC \uD654\uBD84\uC774
      \uB298\uC5B4\uC120 \uC791\uC740 \uBC29\uC774 \uC788\uB2E4.\r\n\r\n\uB300\uBD80\uBD84
      \uB9D0\uB77C \uC8FD\uC5C8\uC9C0\uB9CC \uC720\uB9AC \uB36E\uAC1C \uC544\uB798
      \uC5F4\uB9E4 \uD558\uB098\uAC00 \uB0A8\uC544 \uC788\uB2E4.\r\n\r\n\uD654\uBD84\uC758
      \uC124\uBA85\uC5D0\uB294 \uD53C\uB97C \uBA39\uC5EC \uD0A4\uC6B0\uBA74 \uBAB8\uC744
      \uD2BC\uD2BC\uD558\uAC8C \uD574 \uC8FC\uB294 \uC2DD\uBB3C\uC774\uB77C\uACE0
      \uC801\uD600 \uC788\uB2E4.\r\n\r\n\uC5F4\uB9E4\uB97C \uBC14\uB85C \uBA39\uC5B4\uB3C4
      \uC0C1\uCC98\uC5D0 \uC88B\uC9C0\uB9CC, \uC528\uC557\uAE4C\uC9C0 \uBA39\uC73C\uBA74
      \uB2E4\uC2DC \uD0A4\uC6B8 \uC218\uB294 \uC5C6\uB2E4\uACE0 \uD55C\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.amberseed.options.0.title
    lastText: "\uB0B4 \uD53C\uB85C \uC2F9\uC744 \uD2D4\uC6B4\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.amberseed.options.0.description
    lastText: "\uCCB4\uB825 -10. \uD638\uBC15\uBE5B \uC2F9: \uC804\uD22C 3\uC2B9\uB9C8\uB2E4
      \uCD5C\uB300\xB7\uD604\uC7AC \uCCB4\uB825 +4."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.amberseed.options.1.title
    lastText: "\uC528\uC557\uC9F8 \uC539\uC5B4 \uC0BC\uD0A8\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.amberseed.options.1.description
    lastText: "\uCCB4\uB825 20 \uD68C\uBCF5. \uC528\uC557\uC740 \uC0AC\uB77C\uC9C4\uB2E4."
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.amberseed.options.0.resulttext
    lastText: 
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.amberseed.options.1.resulttext
    lastText: 
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.amberseed.pages.0.narrative
    lastText: "\uC5F0\uAE08\uC220\uC2E4 \uC548\uCABD\uC5D0 \uC120\uBC18\uACFC \uD654\uBD84\uC774
      \uB298\uC5B4\uC120 \uC791\uC740 \uBC29\uC774 \uC788\uB2E4.\r\n\r\n\uB300\uBD80\uBD84
      \uB9D0\uB77C \uC8FD\uC5C8\uC9C0\uB9CC \uC720\uB9AC \uB36E\uAC1C \uC544\uB798
      \uC5F4\uB9E4 \uD558\uB098\uAC00 \uB0A8\uC544 \uC788\uB2E4.\r\n\r\n\uD654\uBD84\uC758
      \uC124\uBA85\uC5D0\uB294 \uD53C\uB97C \uBA39\uC5EC \uD0A4\uC6B0\uBA74 \uBAB8\uC744
      \uD2BC\uD2BC\uD558\uAC8C \uD574 \uC8FC\uB294 \uC2DD\uBB3C\uC774\uB77C\uACE0
      \uC801\uD600 \uC788\uB2E4.\r\n\r\n\uC5F4\uB9E4\uB97C \uBC14\uB85C \uBA39\uC5B4\uB3C4
      \uC0C1\uCC98\uC5D0 \uC88B\uC9C0\uB9CC, \uC528\uC557\uAE4C\uC9C0 \uBA39\uC73C\uBA74
      \uB2E4\uC2DC \uD0A4\uC6B8 \uC218\uB294 \uC5C6\uB2E4\uACE0 \uD55C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.amberseed.pages.0.options.0.title
    lastText: "\uB0B4 \uD53C\uB85C \uC2F9\uC744 \uD2D4\uC6B4\uB2E4"
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
    key: data.randomeventdata.amberseed.pages.0.options.0.description
    lastText: "\uD638\uBC15\uBE5B \uC2F9 \uD68D\uB4DD"
  - propertyPath: pages.Array.data[0].options.Array.data[0].resultText
    key: data.randomeventdata.amberseed.pages.0.options.0.resulttext
    lastText: "\uC7A5\uBE44\uB97C \uCC59\uAE30\uACE0 \uB2E4\uC2DC \uBCF5\uB3C4\uB85C
      \uB098\uC130\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].title
    key: data.randomeventdata.amberseed.pages.0.options.1.title
    lastText: "\uC528\uC557\uC9F8 \uC539\uC5B4 \uC0BC\uD0A8\uB2E4"
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
    key: data.randomeventdata.amberseed.pages.0.options.1.description
    lastText: "\uCCB4\uB825 +20"
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: data.randomeventdata.amberseed.pages.0.options.1.resulttext
    lastText: "\uC7A5\uBE44\uB97C \uCC59\uAE30\uACE0 \uB2E4\uC2DC \uBCF5\uB3C4\uB85C
      \uB098\uC130\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].title
    key: data.randomeventdata.amberseed.pages.0.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].description
    key: data.randomeventdata.amberseed.pages.0.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
