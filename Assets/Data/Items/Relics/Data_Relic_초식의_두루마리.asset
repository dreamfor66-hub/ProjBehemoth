  m_Script: {fileID: 11500000, guid: 712ff626d2b05654998c4db4d3365c86, type: 3}
  m_Name: "Data_Relic_\uCD08\uC2DD\uC758_\uB450\uB8E8\uB9C8\uB9AC"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.equipmentdata.starter_monk.displayname
    lastText: "\uCD08\uC2DD\uC758 \uB450\uB8E8\uB9C8\uB9AC"
  - propertyPath: description
    key: data.equipmentdata.starter_monk.description
    lastText: "\uC77C\uBC18 \uACF5\uACA9 \uBC29\uD5A5\uC5D0 \uB530\uB77C \uCD08\uC2DD\uC744
      \uC900\uBE44\uD569\uB2C8\uB2E4. \uD328\uD134\uC744 \uB9CC\uB4E0 \uD6C4, \uCC28\uC9C0
      \uACF5\uACA9\uC73C\uB85C \uCD08\uC2DD\uC744 \uB9C8\uBB34\uB9AC \uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4. \uCD08\uC2DD\uC744 \uB9C8\uBB34\uB9AC\uD558\uBA74
      \uC544\uB798\uC640 \uAC19\uC740 \uD6A8\uACFC\uB97C \uC5BB\uC2B5\uB2C8\uB2E4.\r\n\u2193\u2191
      \uBD95\uAD8C: 1.7\uBC30 \uCC28\uC9C0 \uD53C\uD574\r\n\u2190\u2192 \uBC31\uB82C\uAD8C:
      0.55\uBC30 \uCC28\uC9C0 3\uD68C \uD53C\uD574\r\n\u2193\u2192 \uD638\uC2E0\uACA9:
      \uAC00\uB4DC +5, \uB2E4\uC74C 1\uD68C\uC5D0 \uD55C\uD574 \uBC1B\uB294 \uD53C\uD574
      -50%.\r\n\u2192\u2191 \uC5F0\uD658: \uB2E4\uC74C \uC77C\uBC18\uACF5\uACA9 2\uD68C
      \uCFE8\uD0C0\uC784 -40%."
  textOwnerGuid: b7e632a71dec8d641b22b585670f40bb
  id: Starter_Monk
  displayName: "\uCD08\uC2DD\uC758 \uB450\uB8E8\uB9C8\uB9AC"
  description: "\uC77C\uBC18 \uACF5\uACA9 \uBC29\uD5A5\uC5D0 \uB530\uB77C \uCD08\uC2DD\uC744
    \uC900\uBE44\uD569\uB2C8\uB2E4. \uD328\uD134\uC744 \uB9CC\uB4E0 \uD6C4, \uCC28\uC9C0
    \uACF5\uACA9\uC73C\uB85C \uCD08\uC2DD\uC744 \uB9C8\uBB34\uB9AC \uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4. \uCD08\uC2DD\uC744 \uB9C8\uBB34\uB9AC\uD558\uBA74 \uC544\uB798\uC640
    \uAC19\uC740 \uD6A8\uACFC\uB97C \uC5BB\uC2B5\uB2C8\uB2E4.\r\n\u2193\u2191 \uBD95\uAD8C:
    1.7\uBC30 \uCC28\uC9C0 \uD53C\uD574\r\n\u2190\u2192 \uBC31\uB82C\uAD8C: 0.55\uBC30
    \uCC28\uC9C0 3\uD68C \uD53C\uD574\r\n\u2193\u2192 \uD638\uC2E0\uACA9: \uAC00\uB4DC
    +5, \uB2E4\uC74C 1\uD68C\uC5D0 \uD55C\uD574 \uBC1B\uB294 \uD53C\uD574 -50%.\r\n\u2192\u2191
    \uC5F0\uD658: \uB2E4\uC74C \uC77C\uBC18\uACF5\uACA9 2\uD68C \uCFE8\uD0C0\uC784
    -40%."
