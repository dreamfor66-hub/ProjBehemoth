  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: Symbiosis
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.symbiosis.displayname
    lastText: "\uB450 \uBC88\uC9F8 \uB9E5\uBC15"
  - propertyPath: narrative
    key: data.randomeventdata.symbiosis.narrative
    lastText: "\uC528\uC557\uC744 \uC954 \uC190\uC5D0\uC11C \uB9E5\uBC15\uC774 \uB450
      \uBC88 \uB6F4\uB2E4. \uD558\uB098\uB294 \uB2F9\uC2E0 \uAC83, \uB2E4\uB978 \uD558\uB098\uB294
      \uC544\uC9C1 \uC790\uB9AC\uB97C \uCC3E\uC9C0 \uBABB\uD588\uB2E4.\n\n\uC606\uC5D0\uB294
      \uBFCC\uB9AC\uB97C \uD0DC\uC6B8 \uB9CC\uD55C \uD654\uB85C\uAC00 \uB0A8\uC544
      \uC788\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.symbiosis.options.0.title
    lastText: "\uBFCC\uB9AC\uB0B4\uB9B4 \uC790\uB9AC\uB97C \uC900\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.symbiosis.options.0.description
    lastText: "\uCD5C\uB300 \uCCB4\uB825 -12. \uACF5\uC0DD\uD558\uB294 \uC528\uC557:
      \uC77C\uBC18 \uBB34\uAE30 \uD53C\uD574 +25%, \uCC28\uC9C0 \uD53C\uD574 +20%."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.symbiosis.options.1.title
    lastText: "\uBFCC\uB9AC\uC640 \uD568\uAED8 \uBC84\uB987 \uD558\uB098\uB97C \uD0DC\uC6B4\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.symbiosis.options.1.description
    lastText: "\uBCF4\uC720 \uD37D \uD558\uB098 \uC81C\uAC70 \uD6C4 \uC0C8 \uD37D\uC744
      \uC120\uD0DD\uD55C\uB2E4."
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.symbiosis.options.2.title
    lastText: "\uAECD\uC9C8\uC744 \uC57D\uC7AC\uB85C \uC4F4\uB2E4"
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.symbiosis.options.2.description
    lastText: "\uCCB4\uB825 10 \uD68C\uBCF5. \uC528\uC557\uC758 \uD798\uC740 \uB0A8\uAE34\uB2E4."
