  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: Banner
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.banner.displayname
    lastText: "\uC544\uC9C1 \uAD50\uB300 \uC2DC\uAC04\uC774 \uC544\uB2C8\uB2E4"
  - propertyPath: narrative
    key: data.randomeventdata.banner.narrative
    lastText: "\uBE48 \uAC11\uC637\uC774 \uAE43\uBC1C \uC544\uB798 \uC11C \uC788\uB2E4.\n\u201C\uAD50\uB300\uC790.
      \uC790\uACA9\uC744 \uC99D\uBA85\uD558\uB77C.\u201D\n\n\uB4A4\uCABD \uBCF4\uAE09\uD568\uC5D0\uB294
      \uB9C8\uC9C0\uB9C9 \uAE09\uB8CC\uAC00 \uB0A8\uC544 \uC788\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.banner.options.0.title
    lastText: "\uB0B4\uAC00 \uAD50\uB300\uD55C\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.banner.options.0.description
    lastText: "\uC218\uD638\uC790\uC640 \uC804\uD22C. \uC2B9\uB9AC \uC2DC \uAE43\uBC1C
      \uD68D\uB4DD: \uC0B4\uC544 \uC788\uB294 \uC801 \uD558\uB098\uB2F9 \uBB34\uAE30
      \uD53C\uD574 +8%."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.banner.options.1.title
    lastText: "\uB0A8\uACA8\uC9C4 \uAE09\uB8CC\uB97C \uCC59\uAE34\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.banner.options.1.description
    lastText: "\uACE8\uB4DC +15. \uAE43\uBC1C\uC740 \uC9C0\uD0A4\uB294 \uC790\uC5D0\uAC8C
      \uB0A8\uAE34\uB2E4."
