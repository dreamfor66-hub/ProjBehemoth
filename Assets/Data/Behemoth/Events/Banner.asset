  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: Banner
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.banner.displayname
    lastText: "\uC544\uC9C1 \uAD50\uB300 \uC2DC\uAC04\uC774 \uC544\uB2C8\uB2E4"
  - propertyPath: narrative
    key: data.randomeventdata.banner.narrative
    lastText: "\uAC80\uBB38\uC18C\uC758 \uAC11\uC637\uC774 \uCC3D\uC744 \uB0B4\uB824
      \uAE38\uC744 \uB9C9\uB294\uB2E4.\r\n\r\n\uAD50\uB300\uC790. \uC18C\uC18D\uC744
      \uBC1D\uD600\uB77C.\r\n\r\n\uD22C\uAD6C \uC548\uC740 \uBE44\uC5B4 \uC788\uB2E4.
      \uC774 \uC131\uC758 \uC218\uBE44\uB300\uAC00 \uC0AC\uB77C\uC9C4 \uAC83\uB3C4
      \uBAA8\uB974\uB294 \uBAA8\uC591\uC774\uB2E4.\r\n\r\n\uAC11\uC637\uC740 \uB0B4
      \uBB34\uC7A5\uC744 \uC0B4\uD53C\uB354\uB2C8 \uC2DC\uD5D8\uC744 \uBC1B\uC544
      \uAD50\uB300\uD560 \uC790\uACA9\uC744 \uC99D\uBA85\uD558\uB77C\uACE0 \uD55C\uB2E4.\r\n\r\n\uC2F8\uC6B8
      \uC0DD\uAC01\uC774 \uC5C6\uB2E4\uBA74 \uAE09\uB8CC\uD568\uB9CC \uBE44\uC6B0\uACE0
      \uAC00\uB77C. \uC544\uC9C1 \uBC1B\uC73C\uB7EC \uC628 \uC0AC\uB78C\uC774 \uC5C6\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.banner.options.0.title
    lastText: "\uB0B4\uAC00 \uAD50\uB300\uD55C\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.banner.options.0.description
    lastText: "\uC218\uD638\uC790\uC640 \uC804\uD22C. \uC2B9\uB9AC \uC2DC \uAE43\uBC1C
      \uD68D\uB4DD: \uC0B4\uC544 \uC788\uB294 \uC801 \uD558\uB098\uB2F9 \uBB34\uAE30
      \uD53C\uD574 +8%."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.banner.options.1.title
    lastText: "\uB0A8\uACA8\uC9C4 \uAE09\uB8CC\uB97C \uCC59\uAE34\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.banner.options.1.description
    lastText: "\uACE8\uB4DC +15. \uAE43\uBC1C\uC740 \uC9C0\uD0A4\uB294 \uC790\uC5D0\uAC8C
      \uB0A8\uAE34\uB2E4."
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.banner.options.0.resulttext
    lastText: 
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.banner.options.1.resulttext
    lastText: 
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.banner.pages.0.narrative
    lastText: "\uAC80\uBB38\uC18C\uC758 \uAC11\uC637\uC774 \uCC3D\uC744 \uB0B4\uB824
      \uAE38\uC744 \uB9C9\uB294\uB2E4.\r\n\r\n\uAD50\uB300\uC790. \uC18C\uC18D\uC744
      \uBC1D\uD600\uB77C.\r\n\r\n\uD22C\uAD6C \uC548\uC740 \uBE44\uC5B4 \uC788\uB2E4.
      \uC774 \uC131\uC758 \uC218\uBE44\uB300\uAC00 \uC0AC\uB77C\uC9C4 \uAC83\uB3C4
      \uBAA8\uB974\uB294 \uBAA8\uC591\uC774\uB2E4.\r\n\r\n\uAC11\uC637\uC740 \uB0B4
      \uBB34\uC7A5\uC744 \uC0B4\uD53C\uB354\uB2C8 \uC2DC\uD5D8\uC744 \uBC1B\uC544
      \uAD50\uB300\uD560 \uC790\uACA9\uC744 \uC99D\uBA85\uD558\uB77C\uACE0 \uD55C\uB2E4.\r\n\r\n\uC2F8\uC6B8
      \uC0DD\uAC01\uC774 \uC5C6\uB2E4\uBA74 \uAE09\uB8CC\uD568\uB9CC \uBE44\uC6B0\uACE0
      \uAC00\uB77C. \uC544\uC9C1 \uBC1B\uC73C\uB7EC \uC628 \uC0AC\uB78C\uC774 \uC5C6\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.banner.pages.0.options.0.title
    lastText: "\uB0B4\uAC00 \uAD50\uB300\uD55C\uB2E4"
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
    key: data.randomeventdata.banner.pages.0.options.0.description
    lastText: "\uC804\uD22C \xB7 \uC774\uB984 \uC5C6\uB294 \uAE43\uBC1C \uD68D\uB4DD"
  - propertyPath: pages.Array.data[0].options.Array.data[0].resultText
    key: data.randomeventdata.banner.pages.0.options.0.resulttext
    lastText: "\uC7A5\uBE44\uB97C \uCC59\uAE30\uACE0 \uB2E4\uC2DC \uBCF5\uB3C4\uB85C
      \uB098\uC130\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].title
    key: data.randomeventdata.banner.pages.0.options.1.title
    lastText: "\uB0A8\uACA8\uC9C4 \uAE09\uB8CC\uB97C \uCC59\uAE34\uB2E4"
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
    key: data.randomeventdata.banner.pages.0.options.1.description
    lastText: "\uACE8\uB4DC +15"
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: data.randomeventdata.banner.pages.0.options.1.resulttext
    lastText: "\uC7A5\uBE44\uB97C \uCC59\uAE30\uACE0 \uB2E4\uC2DC \uBCF5\uB3C4\uB85C
      \uB098\uC130\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].title
    key: data.randomeventdata.banner.pages.0.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].description
    key: data.randomeventdata.banner.pages.0.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
