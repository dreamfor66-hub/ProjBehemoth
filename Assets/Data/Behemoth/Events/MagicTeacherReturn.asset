    lastText: 
  - propertyPath: pages.Array.data[2].narrative
    key: data.randomeventdata.magicteacherreturn.pages.2.narrative
    lastText: "\uBB34\uAE30\uB294 \uB9C8\uB825\uC774 \uBA38\uBB34\uB97C \uC790\uB9AC\uB97C
      \uB9CC\uB4E4\uC5B4 \uC90D\uB2C8\uB2E4. \uC5B4\uB290 \uC18D\uC131\uC744 \uC775\uD790\uAE4C\uC694?"
  - propertyPath: pages.Array.data[2].options.Array.data[0].title
    key: data.randomeventdata.magicteacherreturn.pages.2.options.0.title
    lastText: "\uC778\uCC48\uD2B8 \uD30C\uC774\uC5B4"
  - propertyPath: pages.Array.data[2].options.Array.data[0].description
    key: data.randomeventdata.magicteacherreturn.pages.2.options.0.description
    lastText: "10\uCD08 \uB3D9\uC548 \uBB34\uAE30 \uACF5\uACA9\uC5D0 \uD654\uC5FC
      \uD53C\uD574 4\uC640 \uD654\uC0C1\uC744 \uCD94\uAC00\uD55C\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].resultText
    key: data.randomeventdata.magicteacherreturn.pages.2.options.0.resulttext
    lastText: "\uC120\uC0DD\uC774 \uB9C8\uC9C0\uB9C9 \uC601\uCC3D\uC744 \uACE0\uCCD0
      \uC8FC\uACE0 \uCC45\uC744 \uB36E\uC5C8\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[1].title
    key: data.randomeventdata.magicteacherreturn.pages.2.options.1.title
    lastText: "\uC778\uCC48\uD2B8 \uC544\uC774\uC2A4"
  - propertyPath: pages.Array.data[2].options.Array.data[1].description
    key: data.randomeventdata.magicteacherreturn.pages.2.options.1.description
    lastText: "10\uCD08 \uB3D9\uC548 \uBB34\uAE30 \uACF5\uACA9\uC5D0 \uB0C9\uAE30
      \uD53C\uD574 4\uC640 \uB454\uD654\uB97C \uCD94\uAC00\uD55C\uB2E4."
