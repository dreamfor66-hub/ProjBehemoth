    lastText: "\uC120\uC0DD\uC774 \uB9C8\uC9C0\uB9C9 \uC601\uCC3D\uC744 \uACE0\uCCD0
      \uC8FC\uACE0 \uCC45\uC744 \uB36E\uC5C8\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[2].title
    key: data.randomeventdata.magicteacherreturn.pages.2.options.2.title
    lastText: "\uC778\uCC48\uD2B8 \uB77C\uC774\uD2B8\uB2DD"
  - propertyPath: pages.Array.data[2].options.Array.data[2].description
    key: data.randomeventdata.magicteacherreturn.pages.2.options.2.description
    lastText: "10\uCD08 \uB3D9\uC548 \uBB34\uAE30 \uACF5\uACA9\uC5D0 \uBC88\uAC1C
      \uD53C\uD574 4\uB97C \uCD94\uAC00\uD558\uACE0 \uC8FC\uBCC0 \uC801\uC5D0\uAC8C
      \uBC88\uAC1C \uD53C\uD574 2\uB97C \uC900\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[2].resultText
    key: data.randomeventdata.magicteacherreturn.pages.2.options.2.resulttext
    lastText: "\uC120\uC0DD\uC774 \uB9C8\uC9C0\uB9C9 \uC601\uCC3D\uC744 \uACE0\uCCD0
      \uC8FC\uACE0 \uCC45\uC744 \uB36E\uC5C8\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[3].title
    key: data.randomeventdata.magicteacherreturn.pages.2.options.3.title
    lastText: "\uB2E4\uB978 \uC218\uC5C5\uC744 \uBB3B\uB294\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[3].description
    key: data.randomeventdata.magicteacherreturn.pages.2.options.3.description
    lastText: 
  - propertyPath: pages.Array.data[2].options.Array.data[3].resultText
