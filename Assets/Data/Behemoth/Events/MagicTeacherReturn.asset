  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.magicteacherreturn.options.0.description
    lastText: 
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.magicteacherreturn.options.0.resulttext
    lastText: "\uADF8\uB300\uB85C \uC790\uB9AC\uB97C \uB5A0\uB0AC\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.magicteacherreturn.pages.0.narrative
    lastText: "\uC5F0\uAD6C\uC2E4 \uC548\uC5D0\uC11C \uC775\uC219\uD55C \uBAA9\uC18C\uB9AC\uAC00
      \uB4E4\uB9B0\uB2E4.\r\n\r\n\uC9C0\uB09C\uBC88\uC5D0 \uAC00\uB974\uCCD0 \uB4DC\uB9B0
      \uBD84\uC774\uAD70\uC694. \uC7A0\uAE50, \uC190\uC744 \uC880 \uD3B4 \uBCF4\uC2DC\uACA0\uC5B4\uC694?\r\n\r\n\uBC8C\uC368
      \uC774\uB9CC\uD07C \uC775\uD614\uC5B4\uC694? \uC774\uB807\uAC8C \uBE60\uB978
      \uBD84\uC740 \uB4DC\uBB38\uB370.\r\n\r\n\uB2E4\uB978 \uAC83\uB3C4 \uBC30\uC6CC
      \uBCFC \uC0DD\uAC01 \uC788\uC73C\uC138\uC694?"
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.magicteacherreturn.pages.0.options.0.title
    lastText: "\uB354 \uBC30\uC6CC \uBCF4\uACE0 \uC2F6\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
    key: data.randomeventdata.magicteacherreturn.pages.0.options.0.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[0].resultText
    key: data.randomeventdata.magicteacherreturn.pages.0.options.0.resulttext
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[1].title
    key: data.randomeventdata.magicteacherreturn.pages.0.options.1.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
    key: data.randomeventdata.magicteacherreturn.pages.0.options.1.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: data.randomeventdata.magicteacherreturn.pages.0.options.1.resulttext
    lastText: "\uB178\uC778\uC5D0\uAC8C \uC131 \uC548\uC758 \uB9C9\uD78C \uD1B5\uB85C\uC640
      \uC61B \uAC15\uC758\uC2E4 \uC774\uC57C\uAE30\uB97C \uB4E4\uC5C8\uB2E4. \uD5E4\uC5B4\uC9C8
      \uB54C\uAE4C\uC9C0 \uC218\uC5C5 \uC774\uC57C\uAE30\uB294 \uB2E4\uC2DC \uB098\uC624\uC9C0
      \uC54A\uC558\uB2E4."
  - propertyPath: pages.Array.data[1].narrative
    key: data.randomeventdata.magicteacherreturn.pages.1.narrative
    lastText: "\uC791\uC740 \uBD88\uAF43\uC744 \uC775\uD614\uC73C\uB2C8, \uC774\uBC88\uC5D0\uB294
      \uBD88\uC774 \uD37C\uC9C0\uB294 \uBC29\uC2DD\uC744 \uBC30\uC6CC\uB3C4 \uB418\uACA0\uB124\uC694.\r\n\r\n\uB2E4\uB978
      \uC18D\uC131\uC774\uB098 \uBB34\uAE30\uC5D0 \uB9C8\uB825\uC744 \uC2E3\uB294
      \uCABD\uC774 \uAD81\uAE08\uD558\uBA74 \uADF8\uAC83\uB3C4 \uB9D0\uC500\uD558\uC2DC\uACE0\uC694."
  - propertyPath: pages.Array.data[1].options.Array.data[0].title
    key: data.randomeventdata.magicteacherreturn.pages.1.options.0.title
    lastText: "\uBD88\uC744 \uD55C\uAEBC\uBC88\uC5D0 \uD130\uB728\uB9AC\uB294 \uBC95\uC744
      \uBC30\uC6B4\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].description
    key: data.randomeventdata.magicteacherreturn.pages.1.options.0.description
    lastText: "\uCCB4\uB825 \uBE44\uC728\uC774 \uAC00\uC7A5 \uB0AE\uC740 \uC801 \uC8FC\uC704\uC5D0
      \uD3ED\uBC1C\uD55C\uB2E4. \uBC18\uACBD \uC548\uC758 \uC801\uC744 \uD568\uAED8
      \uACF5\uACA9\uD55C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].resultText
    key: data.randomeventdata.magicteacherreturn.pages.1.options.0.resulttext
    lastText: "\uC120\uC0DD\uC774 \uB9C8\uC9C0\uB9C9 \uC601\uCC3D\uC744 \uACE0\uCCD0
      \uC8FC\uACE0 \uCC45\uC744 \uB36E\uC5C8\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].title
    key: data.randomeventdata.magicteacherreturn.pages.1.options.1.title
    lastText: "\uB2E4\uB978 \uC18D\uC131\uC758 \uAE30\uCD08\uB97C \uBC30\uC6B4\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].description
    key: data.randomeventdata.magicteacherreturn.pages.1.options.1.description
    lastText: "\uAE0B\uAE30\uB97C \uB05D\uB0B8 \uC9C0\uC810\uC5D0 \uBC88\uAC1C\uB97C
      \uB5A8\uC5B4\uB728\uB9AC\uACE0 \uAC00\uAE4C\uC6B4 \uC801\uC73C\uB85C \uCD5C\uB300
      3\uD68C \uC5F0\uACB0\uD55C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].resultText
    key: data.randomeventdata.magicteacherreturn.pages.1.options.1.resulttext
    lastText: "\uC120\uC0DD\uC774 \uB9C8\uC9C0\uB9C9 \uC601\uCC3D\uC744 \uACE0\uCCD0
      \uC8FC\uACE0 \uCC45\uC744 \uB36E\uC5C8\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[2].title
    key: data.randomeventdata.magicteacherreturn.pages.1.options.2.title
    lastText: "\uBB34\uAE30\uC5D0 \uB9C8\uB825\uC744 \uC2E3\uB294 \uBC95\uC744 \uBB3B\uB294\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[2].description
    key: data.randomeventdata.magicteacherreturn.pages.1.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[2].resultText
    key: data.randomeventdata.magicteacherreturn.pages.1.options.2.resulttext
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[3].title
    key: data.randomeventdata.magicteacherreturn.pages.1.options.3.title
    lastText: "\uC544\uC8FC \uD070 \uB9C8\uBC95\uC744 \uBC30\uC6B0\uACE0 \uC2F6\uB2E4\uACE0
      \uD55C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[3].description
    key: data.randomeventdata.magicteacherreturn.pages.1.options.3.description
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[3].resultText
