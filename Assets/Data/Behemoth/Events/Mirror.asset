  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: Mirror
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.mirror.displayname
    lastText: "\uAC70\uC6B8\uC774 \uBA3C\uC800 \uBCA4\uB2E4"
  - propertyPath: narrative
    key: data.randomeventdata.mirror.narrative
    lastText: "\uAC70\uC6B8 \uC18D\uC758 \uB2F9\uC2E0\uC774 \uBA3C\uC800 \uAC80\uC744
      \uB4E0\uB2E4. \uB0A0\uC774 \uC720\uB9AC \uBC16\uC73C\uB85C \uC870\uAE08 \uD280\uC5B4\uB098\uC628\uB2E4.\n\n\uADF8\uB300\uB85C
      \uB530\uB77C \uBC30\uC6CC\uB3C4 \uC88B\uACA0\uC9C0\uB9CC, \uC800 \uC6C0\uC9C1\uC784\uC744
      \uC870\uAC01\uC9F8 \uB5BC\uC5B4 \uAC08 \uC218\uB3C4 \uC788\uACA0\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.mirror.options.0.title
    lastText: "\uD55C \uBC88 \uBCA0\uC774\uACE0 \uD55C \uC870\uAC01 \uCC59\uAE34\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.mirror.options.0.description
    lastText: "\uCCB4\uB825 -16. \uAC70\uC6B8 \uC870\uAC01: \uB9E4 4\uBC88\uC9F8
      \uBB34\uAE30 \uC801\uC911\uC5D0 \uD53C\uD574 40% \uCD94\uAC00."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.mirror.options.1.title
    lastText: "\uB0B4 \uB3D9\uC791\uC744 \uACE0\uCCD0 \uBC30\uC6B4\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.mirror.options.1.description
    lastText: "\uBCF4\uC720 \uD37D \uD558\uB098\uB97C 1\uB2E8\uACC4 \uAC15\uD654\uD55C\uB2E4."
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.mirror.options.2.title
    lastText: "\uAC70\uC6B8 \uB4B7\uBA74\uC758 \uC740\uC744 \uAE01\uC5B4\uB0B8\uB2E4"
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.mirror.options.2.description
    lastText: "\uACE8\uB4DC +12. \uAC70\uC6B8\uC740 \uB354 \uC774\uC0C1 \uC6C0\uC9C1\uC774\uC9C0
      \uC54A\uB294\uB2E4."
