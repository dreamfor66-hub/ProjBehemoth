  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.contract.displayname
    lastText: "\uBD89\uC740 \uC11C\uBA85"
  - propertyPath: narrative
    key: data.randomeventdata.contract.narrative
    lastText: "\uACC4\uC57D\uC11C\uC5D0\uB294 \uD798\uC744 \uBE4C\uB824 \uC900\uB2E4\uB294
      \uD55C \uC904\uB9CC \uC788\uB2E4. \uC11C\uBA85\uB780\uC740 \uC774\uC0C1\uD558\uB9AC\uB9CC\uD07C
      \uAE38\uB2E4.\n\n\uD589\uC0C1\uC774 \uBE48 \uC789\uD06C\uBCD1\uC744 \uB4E4\uC5B4
      \uBCF4\uC778\uB2E4.\n\u201C\uADF8\uB9CC\uD07C\uC758 \uD53C\uAC00 \uC544\uB2C8\uB77C,
      \uADF8\uB9CC\uD07C\uC758 \uBBF8\uB798\uC785\uB2C8\uB2E4.\u201D"
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.contract.options.0.title
    lastText: "\uC9E7\uACE0 \uAD75\uAC8C"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.contract.options.0.description
    lastText: "\uCD5C\uB300 \uCCB4\uB825 -18. \uBD89\uC740 \uACC4\uC57D\uC11C: \uBAA8\uB4E0
      \uD53C\uD574 +25%."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.contract.options.1.title
    lastText: "\uBC31\uC9C0 \uACC4\uC57D\uC11C\uB97C \uB418\uD310\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.contract.options.1.description
    lastText: "\uACE8\uB4DC +25. \uACC4\uC57D\uC758 \uD798\uC740 \uC5BB\uC9C0 \uC54A\uB294\uB2E4."
