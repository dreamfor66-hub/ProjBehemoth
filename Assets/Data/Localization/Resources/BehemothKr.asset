  - key: data.randomeventdata.shelter.pages.0.narrative
    kr: "\uBCF5\uB3C4 \uD55C\uCABD\uC5D0 \uBC84\uB824\uC9C4 \uACBD\uBE44\uC2E4\uC774
      \uC788\uB2E4.\r\n\r\n\uBB38\uC5D0\uB294 \uC548\uC5D0\uC11C \uAC78 \uC218 \uC788\uB294
      \uD2BC\uD2BC\uD55C \uBE57\uC7A5\uC774 \uB0A8\uC544 \uC788\uB2E4.\r\n\r\n\uB3CC\uB09C\uB85C
      \uC606\uC5D0\uB294 \uB9C8\uB978 \uC7A5\uC791\uC774 \uC313\uC5EC \uC788\uACE0,
      \uBCA4\uCE58\uC5D0\uB294 \uB0A1\uC740 \uB2F4\uC694\uAC00 \uB193\uC5EC \uC788\uB2E4.\r\n\r\n\uBB38\uC744
      \uB2EB\uACE0 \uBD88\uC744 \uD53C\uC6B0\uBA74 \uC7A0\uC2DC \uBAB8\uC744 \uC26C\uAC8C
      \uD560 \uC218 \uC788\uACA0\uB2E4."
