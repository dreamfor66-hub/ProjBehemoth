  - key: data.monsterdata.alarmhound.encounterhint
    kr: "\uC6B8\uC74C\uC758 \uC57D\uC810\uC744 \uAE68\uAC70\uB098 \uBA3C\uC800 \uCC98\uCE58\uD558\uBA74
