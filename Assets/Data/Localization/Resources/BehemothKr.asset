  - key: data.randomeventdata.well.narrative
    kr: "\uC6B0\uBB3C \uBCBD\uC758 \uC120\uBC18\uC5D0 \uC791\uC740 \uAE08 \uC8FC\uBA38\uB2C8\uAC00
      \uB193\uC5EC \uC788\uB2E4. \uADF8 \uC544\uB798\uC5D0\uB294 \uBB35\uC9C1\uD55C
      \uAE08\uACE0.\n\n\uBC27\uC904\uC744 \uB2F9\uAE38 \uB54C\uB9C8\uB2E4 \uBC29\uD328\uB97C
      \uC9D3\uB204\uB974\uB294 \uB4EF\uD55C \uBB34\uAC8C\uAC00 \uB290\uAEF4\uC9C4\uB2E4."
