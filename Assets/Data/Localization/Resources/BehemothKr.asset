  - key: data.randomeventdata.well.options.2.description
    kr: "\uACF5\uC6A9 \uC720\uBB3C \uD558\uB098 \uC120\uD0DD. \uACE8\uB4DC \uBE5A
      75. \uC2B9\uB9AC\uB9C8\uB2E4 \uCD5C\uB300 15\uACE8\uB4DC \uC0C1\uD658."
    source: Assets/Data/Dungeon/Events/Well.asset:options.Array.data[2].description
