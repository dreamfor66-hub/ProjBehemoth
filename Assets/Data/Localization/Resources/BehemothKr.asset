    source: Assets/Data/Behemoth/Events/StrayDog.asset:displayName
  - key: data.randomeventdata.straydog.narrative
    kr: "\uBB38\uD2C8\uC5D0\uC11C \uC791\uC740 \uCF54\uAC00 \uB098\uC628\uB2E4. \uB4A4\uB530\uB77C
      \uB098\uC628 \uBC1C \uD558\uB098\uC5D0\uB294 \uCCA0\uC0AC\uAC00 \uAC10\uACA8
      \uC788\uB2E4.\n\n\uCCA0\uC0AC\uB97C \uB04A\uC5B4 \uC8FC\uC790 \uAC15\uC544\uC9C0\uAC00
      \uC808\uB69D\uC774\uBA70 \uB530\uB77C\uC628\uB2E4. \uC57D\uC774\uB098 \uBA39\uC744
      \uAC83\uC774 \uC788\uB2E4\uBA74 \uB354 \uBA40\uB9AC \uD568\uAED8 \uAC78\uC744
      \uC218 \uC788\uACA0\uB2E4."
