  - key: ui.run.start.controls
    kr: "\uBE60\uB974\uAC8C \uAE0B\uAE30: \uC77C\uBC18\uACF5\uACA9\r\n\uC804\uC7A5\uC744
      \uB204\uB978 \uB4A4 \uAE0B\uAE30: \uCC28\uC9C0 \uACF5\uACA9 \xB7 \uC57D\uC810
      \uD30C\uAD34\r\n\uCE90\uB9AD\uD130\uB97C \uB204\uB974\uB294 \uB3D9\uC548: \uAC00\uB4DC\r\n\r\n\uBC29\uD5A5\uC744
      \uACE8\uB77C \uC131 \uC548\uC744 \uD0D0\uD5D8\uD558\uC138\uC694."
    source: AshenVow
  - key: ui.run.start.magic
    kr: "\uAC00\uB4DC \uC911 \uBC29\uD5A5\uC73C\uB85C \uAE0B\uACE0 \uB5BC\uAE30:
      \uC8FC\uBB38\r\n\uC8FC\uBB38\uC740 MP\uB97C \uC18C\uBE44\uD558\uBA70, MP\uB294
      \uC804\uD22C\uB9C8\uB2E4 \uD68C\uBCF5\uB429\uB2C8\uB2E4."
    source: AshenVow
  - key: ui.spell.learn.title
    kr: "\uC0C8 \uC8FC\uBB38 \uC775\uD788\uAE30"
    source: AshenVow
  - key: ui.spell.learn.body
    kr: "{0}\uC744 \uC775\uD799\uB2C8\uB2E4.\r\n{1} \uBC29\uD5A5\uC5D0 \uC900\uBE44\uD560
      \uC8FC\uBB38\uC744 \uACE0\uB974\uC138\uC694. \uBC30\uC6B4 \uC8FC\uBB38\uC740
      \uC8FC\uBB38\uC11C\uC5D0 \uB0A8\uC2B5\uB2C8\uB2E4."
    source: AshenVow
  - key: ui.spell.learn.prepare
    kr: " \uC900\uBE44"
    source: AshenVow
  - key: ui.spell.learn.store
    kr: "\uC0C8 \uC8FC\uBB38\uC744 \uC775\uD600 \uC8FC\uBB38\uC11C\uC5D0 \uBCF4\uAD00\uD558\uACE0,
      \uD604\uC7AC \uC8FC\uBB38\uC744 \uACC4\uC18D \uC0AC\uC6A9\uD569\uB2C8\uB2E4."
    source: AshenVow
