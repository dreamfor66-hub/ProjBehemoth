  - key: data.randomeventdata.well.pages.0.narrative
    kr: "\uC9C0\uD558 \uC6B0\uBB3C\uBC29\uC5D0 \uB3C8\uC8FC\uBA38\uB2C8\uB97C \uB9E4\uB2E8
      \uBC27\uC904\uC774 \uAC78\uB824 \uC788\uB2E4.\r\n\r\n\uC6B0\uBB3C \uC911\uAC04
      \uC120\uBC18\uC5D0 \uC791\uC740 \uC8FC\uBA38\uB2C8\uAC00 \uC788\uACE0, \uB354
      \uC544\uB798\uC5D0\uB294 \uCEE4\uB2E4\uB780 \uAE08\uACE0\uAC00 \uBCF4\uC778\uB2E4."
    source: Assets/Data/Dungeon/Events/Well.asset:pages.Array.data[0].narrative
