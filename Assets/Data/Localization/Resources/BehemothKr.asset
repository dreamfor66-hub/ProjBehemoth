    source: Assets/Data/Behemoth/Events/Contract.asset:displayName
  - key: data.randomeventdata.contract.narrative
    kr: "\uACC4\uC57D\uC11C\uC5D0\uB294 \uD798\uC744 \uBE4C\uB824 \uC900\uB2E4\uB294
      \uD55C \uC904\uB9CC \uC788\uB2E4. \uC11C\uBA85\uB780\uC740 \uC774\uC0C1\uD558\uB9AC\uB9CC\uD07C
      \uAE38\uB2E4.\n\n\uD589\uC0C1\uC774 \uBE48 \uC789\uD06C\uBCD1\uC744 \uB4E4\uC5B4
      \uBCF4\uC778\uB2E4.\n\u201C\uADF8\uB9CC\uD07C\uC758 \uD53C\uAC00 \uC544\uB2C8\uB77C,
      \uADF8\uB9CC\uD07C\uC758 \uBBF8\uB798\uC785\uB2C8\uB2E4.\u201D"
    source: Assets/Data/Behemoth/Events/Contract.asset:narrative
  - key: data.randomeventdata.contract.options.0.title
    kr: "\uC9E7\uACE0 \uAD75\uAC8C"
    source: Assets/Data/Behemoth/Events/Contract.asset:options.Array.data[0].title
  - key: data.randomeventdata.contract.options.0.description
    kr: "\uCD5C\uB300 \uCCB4\uB825 -18. \uBD89\uC740 \uACC4\uC57D\uC11C: \uBAA8\uB4E0
      \uD53C\uD574 +25%."
    source: Assets/Data/Behemoth/Events/Contract.asset:options.Array.data[0].description
  - key: data.randomeventdata.contract.options.1.title
    kr: "\uBC31\uC9C0 \uACC4\uC57D\uC11C\uB97C \uB418\uD310\uB2E4"
    source: Assets/Data/Behemoth/Events/Contract.asset:options.Array.data[1].title
  - key: data.randomeventdata.contract.options.1.description
    kr: "\uACE8\uB4DC +25. \uACC4\uC57D\uC758 \uD798\uC740 \uC5BB\uC9C0 \uC54A\uB294\uB2E4."
    source: Assets/Data/Behemoth/Events/Contract.asset:options.Array.data[1].description
  - key: data.randomeventdata.delivery.displayname
    kr: "\uC0C1\uC790\uAC00 \uB450 \uAC1C\uB2E4"
    source: Assets/Data/Behemoth/Events/Delivery.asset:displayName
  - key: data.randomeventdata.delivery.narrative
    kr: "\uC0C1\uC790\uC5D0\uB294 \uB2F9\uC2E0 \uC774\uB984\uC774 \uD558\uB098\uC529
      \uC801\uD600 \uC788\uB2E4. \uD558\uB098\uB294 \uC9C0\uB09C\uBC88\uC758 \uB2F9\uC2E0,
      \uB2E4\uB978 \uD558\uB098\uB294 \uC544\uC9C1 \uB9CC\uB098\uC9C0 \uBABB\uD55C
      \uB2F9\uC2E0\uC5D0\uAC8C \uC654\uB2E4.\n\n\uC9D0\uAFBC\uC740 \uD558\uB098\uB9CC
      \uACE0\uB974\uB77C\uB294 \uB4EF \uC190\uC744 \uD3B8\uB2E4."
    source: Assets/Data/Behemoth/Events/Delivery.asset:narrative
  - key: data.randomeventdata.delivery.options.0.title
    kr: "\uB9E1\uACA8 \uB454 \uBB3C\uAC74\uC744 \uBC1B\uB294\uB2E4"
    source: Assets/Data/Behemoth/Events/Delivery.asset:options.Array.data[0].title
  - key: data.randomeventdata.delivery.options.0.description
    kr: "\uACF5\uC6A9 \uC720\uBB3C \uD558\uB098 \uC120\uD0DD, \uACE8\uB4DC +45."
    source: Assets/Data/Behemoth/Events/Delivery.asset:options.Array.data[0].description
  - key: data.randomeventdata.delivery.options.1.title
    kr: "\uC7A5\uBE44 \uB300\uC2E0 \uC5EC\uBE44\uB97C \uBC1B\uB294\uB2E4"
    source: Assets/Data/Behemoth/Events/Delivery.asset:options.Array.data[1].title
  - key: data.randomeventdata.delivery.options.1.description
    kr: "\uBCF4\uC720 \uD37D \uD558\uB098 \uC81C\uAC70. \uACE8\uB4DC +100."
    source: Assets/Data/Behemoth/Events/Delivery.asset:options.Array.data[1].description
  - key: data.randomeventdata.forge.displayname
    kr: "\uB0A0\uC774 \uC544\uB2C8\uB77C \uBC84\uB987\uC744 \uAC04\uB2E4"
    source: Assets/Data/Behemoth/Events/Forge.asset:displayName
  - key: data.randomeventdata.forge.narrative
    kr: "\uC7A5\uC778\uC740 \uAC80\uC744 \uBCF4\uC9C0\uB3C4 \uC54A\uB294\uB2E4.\n\u201C\uD55C
      \uBC88 \uD718\uB458\uB7EC \uBD10.\u201D\n\n\uBD88\uAF43 \uC18D\uC5D0\uC11C
      \uC9C0\uB09C \uC804\uD22C\uC758 \uBC84\uB987\uC774 \uB3C4\uB4DC\uB77C\uC9C4\uB2E4.\n\u201C\uB0A8\uAE38\uAE4C,
      \uAC08\uC544 \uC5C6\uC568\uAE4C?\u201D"
    source: Assets/Data/Behemoth/Events/Forge.asset:narrative
  - key: data.randomeventdata.forge.options.0.title
    kr: "\uC775\uC219\uD55C \uAE30\uC220\uC744 \uBCBC\uB9B0\uB2E4"
    source: Assets/Data/Behemoth/Events/Forge.asset:options.Array.data[0].title
  - key: data.randomeventdata.forge.options.0.description
    kr: "30\uACE8\uB4DC \uC18C\uBAA8. \uBCF4\uC720 \uD37D \uD558\uB098\uB97C \uAC15\uD654."
    source: Assets/Data/Behemoth/Events/Forge.asset:options.Array.data[0].description
  - key: data.randomeventdata.forge.options.1.title
    kr: "\uD558\uB098\uB97C \uBC84\uB9AC\uACE0 \uB450 \uAC1C\uB97C \uBC30\uC6B4\uB2E4"
    source: Assets/Data/Behemoth/Events/Forge.asset:options.Array.data[1].title
  - key: data.randomeventdata.forge.options.1.description
    kr: "\uBCF4\uC720 \uD37D \uD558\uB098 \uC81C\uAC70 \uD6C4 \uC0C8 \uD37D \uB450
      \uBC88 \uC120\uD0DD."
    source: Assets/Data/Behemoth/Events/Forge.asset:options.Array.data[1].description
  - key: data.randomeventdata.forge.options.2.title
    kr: "\uBC29\uD328\uC758 \uCC0C\uADF8\uB7EC\uC9C4 \uACF3\uB9CC \uD3B8\uB2E4"
    source: Assets/Data/Behemoth/Events/Forge.asset:options.Array.data[2].title
  - key: data.randomeventdata.forge.options.2.description
    kr: "\uCD5C\uB300 \uAC00\uB4DC\uAC8C\uC774\uC9C0 +3. \uD37D\uC740 \uBC14\uB00C\uC9C0
      \uC54A\uB294\uB2E4."
    source: Assets/Data/Behemoth/Events/Forge.asset:options.Array.data[2].description
  - key: data.randomeventdata.hourglass.displayname
    kr: "\uB0B4\uC77C\uC758 \uD55C\uC228"
    source: Assets/Data/Behemoth/Events/Hourglass.asset:displayName
  - key: data.randomeventdata.hourglass.narrative
    kr: "\uBAA8\uB798\uC2DC\uACC4\uB97C \uB4A4\uC9D1\uC790 \uBAB8\uC774 \uAC00\uBCBC\uC6CC\uC9C4\uB2E4.
      \uC720\uB9AC\uC5D0\uB294 \uAE08\uC774 \uD558\uB098 \uB298\uC5C8\uB2E4.\n\n\uBA48\uCDB0
      \uC120 \uBAA8\uB798\uC54C\uC744 \uC138\uB2E4 \uBCF4\uB2C8, \uC624\uB798\uB41C
      \uB3D9\uC791 \uD558\uB098\uAC00 \uC0C8\uC0BC \uB5A0\uC624\uB978\uB2E4."
    source: Assets/Data/Behemoth/Events/Hourglass.asset:narrative
  - key: data.randomeventdata.hourglass.options.0.title
    kr: "\uB0B4\uC77C\uC744 \uC870\uAE08 \uC798\uB77C \uB0B8\uB2E4"
    source: Assets/Data/Behemoth/Events/Hourglass.asset:options.Array.data[0].title
  - key: data.randomeventdata.hourglass.options.0.description
    kr: "\uCD5C\uB300 \uCCB4\uB825 -8. \uAE68\uC5B4\uC9C4 \uBAA8\uB798\uC2DC\uACC4:
      \uCC28\uC9C0 \uC900\uBE44\uC2DC\uAC04\uACFC \uC8FC\uBB38 \uCFE8\uD0C0\uC784
      -12%."
    source: Assets/Data/Behemoth/Events/Hourglass.asset:options.Array.data[0].description
  - key: data.randomeventdata.hourglass.options.1.title
    kr: "\uC624\uB798\uB41C \uB3D9\uC791\uC744 \uBC84\uB9AC\uACE0 \uB2E4\uC2DC \uC775\uD78C\uB2E4"
    source: Assets/Data/Behemoth/Events/Hourglass.asset:options.Array.data[1].title
  - key: data.randomeventdata.hourglass.options.1.description
    kr: "\uBCF4\uC720 \uD37D \uD558\uB098 \uC81C\uAC70 \uD6C4 \uC0C8 \uD37D\uC744
      \uB450 \uBC88 \uC120\uD0DD\uD55C\uB2E4."
    source: Assets/Data/Behemoth/Events/Hourglass.asset:options.Array.data[1].description
  - key: data.randomeventdata.investment.displayname
    kr: "\uBC30\uB2EC\uC9C0\uB294 \uB2E4\uC74C \uB9C9"
    source: Assets/Data/Behemoth/Events/Investment.asset:displayName
  - key: data.randomeventdata.investment.narrative
    kr: "\uC9D0\uAFBC\uC774 \uBAA9\uC801\uC9C0\uB97C \uB4E3\uB354\uB2C8 \uC0C1\uC790\uC5D0
      \uC774\uB984\uC744 \uC4F4\uB2E4.\n\u201C\uB2F9\uC7A5 \uC4F8 \uC57D\uC774 \uD544\uC694\uD558\uC2E0\uAC00\uC694,
      \uB2E4\uC74C \uB9C9\uC758 \uBB3C\uAC74\uC774 \uD544\uC694\uD558\uC2E0\uAC00\uC694?\u201D"
    source: Assets/Data/Behemoth/Events/Investment.asset:narrative
  - key: data.randomeventdata.investment.options.0.title
    kr: "\uB3C4\uCC29\uD574\uC11C \uBC1B\uB294\uB2E4"
    source: Assets/Data/Behemoth/Events/Investment.asset:options.Array.data[0].title
  - key: data.randomeventdata.investment.options.0.description
    kr: "25\uACE8\uB4DC \uC18C\uBAA8. \uB2E4\uC74C \uB9C9\uC758 \uBC30\uB2EC \uC0AC\uAC74\uC5D0\uC11C
      \uC720\uBB3C\uACFC \uACE8\uB4DC \uC218\uB839."
    source: Assets/Data/Behemoth/Events/Investment.asset:options.Array.data[0].description
  - key: data.randomeventdata.investment.options.1.title
    kr: "\uC9C0\uAE08 \uC4F8 \uC57D\uC744 \uBC1B\uB294\uB2E4"
    source: Assets/Data/Behemoth/Events/Investment.asset:options.Array.data[1].title
  - key: data.randomeventdata.investment.options.1.description
    kr: "\uD3EC\uC158 1\uAC1C. \uBC30\uB2EC \uC608\uC57D\uC740 \uD558\uC9C0 \uC54A\uB294\uB2E4."
    source: Assets/Data/Behemoth/Events/Investment.asset:options.Array.data[1].description
  - key: data.randomeventdata.lostbeliever.displayname
    kr: "\uADF8 \uB3CC\uC5D0 \uC801\uD78C \uC774\uB984"
    source: Assets/Data/Behemoth/Events/LostBeliever.asset:displayName
  - key: data.randomeventdata.lostbeliever.narrative
    kr: "\uC18C\uB144\uC774 \uC954 \uB3CC\uC5D0\uB294 \uC775\uC219\uD55C \uC774\uB984\uC774
      \uC788\uB2E4. \uC21C\uB840\uC790\uC758 \uC9D0\uC5D0\uC11C \uBCF8 \uC774\uB984\uC774\uB2E4.\n\n\uB4F1\uBD88\uC740
      \uC18C\uB144\uC758 \uC190\uC744 \uB5A0\uB098 \uB2F9\uC2E0 \uCABD\uC73C\uB85C
      \uC870\uAE08\uC529 \uAE30\uC6B4\uB2E4."
    source: Assets/Data/Behemoth/Events/LostBeliever.asset:narrative
  - key: data.randomeventdata.lostbeliever.options.0.title
    kr: "\uC11C\uC57D\uC758 \uB3CC\uC744 \uB9DE\uCDB0 \uBCF8\uB2E4"
    source: Assets/Data/Behemoth/Events/LostBeliever.asset:options.Array.data[0].title
  - key: data.randomeventdata.lostbeliever.options.0.description
    kr: "\uAE38\uC7A1\uC774\uC758 \uB4F1\uBD88 \uD68D\uB4DD: \uCC28\uC9C0 \uC801\uC911\uACFC
      \uC8FC\uBB38 \uBC1C\uB3D9\uC5D0 \uD53C\uD574 6 \uCD94\uAC00."
    source: Assets/Data/Behemoth/Events/LostBeliever.asset:options.Array.data[0].description
  - key: data.randomeventdata.lostbeliever.options.1.title
    kr: "\uC704\uD5D8\uD55C \uC0DB\uAE38\uC744 \uD568\uAED8 \uAC77\uB294\uB2E4"
    source: Assets/Data/Behemoth/Events/LostBeliever.asset:options.Array.data[1].title
  - key: data.randomeventdata.lostbeliever.options.1.description
    kr: "\uCCB4\uB825 -18. \uAE38\uC7A1\uC774\uC758 \uB4F1\uBD88 \uD68D\uB4DD."
    source: Assets/Data/Behemoth/Events/LostBeliever.asset:options.Array.data[1].description
  - key: data.randomeventdata.mastertrial.displayname
    kr: "\uBB38\uC774 \uC774\uB984\uC744 \uD2C0\uB9AC\uAC8C \uBD80\uB978\uB2E4"
    source: Assets/Data/Behemoth/Events/MasterTrial.asset:displayName
  - key: data.randomeventdata.mastertrial.narrative
    kr: "\uBB38\uC5D0 \uC0C8\uACA8\uC9C4 \uC785\uC774 \uB2F9\uC2E0 \uC774\uB984\uC744
      \uD55C \uAE00\uC790 \uD2C0\uB9AC\uAC8C \uBD80\uB978\uB2E4.\n\n\uC815\uC815\uD558\uC790
      \uBB34\uAC70\uC6B4 \uBC1C\uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4.\n\u201C\uC9C1\uC811
      \uC99D\uBA85\uD558\uB77C.\u201D\n\uBB38 \uC606\uC5D0\uB294 \uC624\uB798\uB41C
      \uAC00\uB974\uCE68\uC774 \uC0C8\uACA8\uC838 \uC788\uB2E4."
    source: Assets/Data/Behemoth/Events/MasterTrial.asset:narrative
  - key: data.randomeventdata.mastertrial.options.0.title
    kr: "\uC815\uD655\uD788 \uAE30\uC5B5\uD558\uAC8C \uD574 \uC8FC\uC9C0"
    source: Assets/Data/Behemoth/Events/MasterTrial.asset:options.Array.data[0].title
  - key: data.randomeventdata.mastertrial.options.0.description
    kr: "\uC2EC\uCE35 \uC218\uD638\uC790\uC640 \uC804\uD22C. \uC2B9\uB9AC \uD6C4
      \uC804\uC6A9 \uC720\uBB3C \uD558\uB098 \uC120\uD0DD."
    source: Assets/Data/Behemoth/Events/MasterTrial.asset:options.Array.data[0].description
  - key: data.randomeventdata.mastertrial.options.1.title
    kr: "\uC0C8 \uC774\uB984\uC5D0 \uB9DE\uB294 \uAE30\uC220\uC744 \uBC30\uC6B4\uB2E4"
    source: Assets/Data/Behemoth/Events/MasterTrial.asset:options.Array.data[1].title
  - key: data.randomeventdata.mastertrial.options.1.description
    kr: "\uBCF4\uC720 \uD37D \uD558\uB098 \uC81C\uAC70 \uD6C4 \uC0C8 \uD37D \uB450
      \uBC88 \uC120\uD0DD."
    source: Assets/Data/Behemoth/Events/MasterTrial.asset:options.Array.data[1].description
  - key: data.randomeventdata.mirror.displayname
    kr: "\uAC70\uC6B8\uC774 \uBA3C\uC800 \uBCA4\uB2E4"
    source: Assets/Data/Behemoth/Events/Mirror.asset:displayName
  - key: data.randomeventdata.mirror.narrative
    kr: "\uAC70\uC6B8 \uC18D\uC758 \uB2F9\uC2E0\uC774 \uBA3C\uC800 \uAC80\uC744 \uB4E0\uB2E4.
      \uB0A0\uC774 \uC720\uB9AC \uBC16\uC73C\uB85C \uC870\uAE08 \uD280\uC5B4\uB098\uC628\uB2E4.\n\n\uADF8\uB300\uB85C
      \uB530\uB77C \uBC30\uC6CC\uB3C4 \uC88B\uACA0\uC9C0\uB9CC, \uC800 \uC6C0\uC9C1\uC784\uC744
      \uC870\uAC01\uC9F8 \uB5BC\uC5B4 \uAC08 \uC218\uB3C4 \uC788\uACA0\uB2E4."
    source: Assets/Data/Behemoth/Events/Mirror.asset:narrative
  - key: data.randomeventdata.mirror.options.0.title
    kr: "\uD55C \uBC88 \uBCA0\uC774\uACE0 \uD55C \uC870\uAC01 \uCC59\uAE34\uB2E4"
    source: Assets/Data/Behemoth/Events/Mirror.asset:options.Array.data[0].title
  - key: data.randomeventdata.mirror.options.0.description
    kr: "\uCCB4\uB825 -16. \uAC70\uC6B8 \uC870\uAC01: \uB9E4 4\uBC88\uC9F8 \uBB34\uAE30
      \uC801\uC911\uC5D0 \uD53C\uD574 40% \uCD94\uAC00."
    source: Assets/Data/Behemoth/Events/Mirror.asset:options.Array.data[0].description
  - key: data.randomeventdata.mirror.options.1.title
    kr: "\uB0B4 \uB3D9\uC791\uC744 \uACE0\uCCD0 \uBC30\uC6B4\uB2E4"
    source: Assets/Data/Behemoth/Events/Mirror.asset:options.Array.data[1].title
  - key: data.randomeventdata.mirror.options.1.description
    kr: "\uBCF4\uC720 \uD37D \uD558\uB098\uB97C 1\uB2E8\uACC4 \uAC15\uD654\uD55C\uB2E4."
    source: Assets/Data/Behemoth/Events/Mirror.asset:options.Array.data[1].description
  - key: data.randomeventdata.pilgrim.displayname
    kr: "\uC9D0 \uD558\uB098\uB9CC \uBD80\uD0C1\uD558\uB124"
    source: Assets/Data/Behemoth/Events/Pilgrim.asset:displayName
  - key: data.randomeventdata.pilgrim.narrative
    kr: "\uC9D0 \uC548\uC5D0\uB294 \uC774\uB984\uC774 \uC0C8\uACA8\uC9C4 \uB3CC\uB4E4\uC774
      \uAC00\uB4DD\uD558\uB2E4.\n\n\u201C\uC0AC\uB78C \uB300\uC2E0 \uB3CC\uC544\uAC00\uB294
      \uC774\uB984\uB4E4\uC774\uB124. \uC5EC\uBE44\uAC00 \uBAA8\uC790\uB77C \uC774
      \uB3CC\uC744 \uB450\uACE0 \uAC08 \uBED4\uD588\uC5B4.\u201D"
    source: Assets/Data/Behemoth/Events/Pilgrim.asset:narrative
  - key: data.randomeventdata.pilgrim.options.0.title
    kr: "\uC5EC\uBE44\uB97C \uBCF4\uD0E0\uB2E4"
    source: Assets/Data/Behemoth/Events/Pilgrim.asset:options.Array.data[0].title
  - key: data.randomeventdata.pilgrim.options.0.description
    kr: "25\uACE8\uB4DC \uC18C\uBAA8. \uC21C\uB840\uC790\uC758 \uC11C\uC57D \uD68D\uB4DD.
      \uAC00\uB4DC 3\uD68C\uB9C8\uB2E4 \uAC8C\uC774\uC9C0 +3. \uC778\uC5F0\uC744
      \uB0A8\uAE34\uB2E4."
    source: Assets/Data/Behemoth/Events/Pilgrim.asset:options.Array.data[0].description
  - key: data.randomeventdata.pilgrim.options.1.title
    kr: "\uC0D8\uC758 \uC704\uCE58\uB97C \uC11C\uB85C \uB098\uB208\uB2E4"
    source: Assets/Data/Behemoth/Events/Pilgrim.asset:options.Array.data[1].title
  - key: data.randomeventdata.pilgrim.options.1.description
    kr: "\uCCB4\uB825 12 \uD68C\uBCF5. \uC11C\uC57D\uC740 \uC5BB\uC9C0 \uC54A\uB294\uB2E4."
    source: Assets/Data/Behemoth/Events/Pilgrim.asset:options.Array.data[1].description
  - key: data.randomeventdata.pilgrim.options.2.title
    kr: "\uC598\uAC00 \uC9C0\uB984\uAE38\uC744 \uCC3E\uC744 \uAC70\uC57C"
    source: Assets/Data/Behemoth/Events/Pilgrim.asset:options.Array.data[2].title
  - key: data.randomeventdata.pilgrim.options.2.description
