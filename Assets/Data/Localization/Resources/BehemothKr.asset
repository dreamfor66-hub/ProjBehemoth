  - key: data.randomeventdata.symbiosis.options.0.title
    kr: "\uBFCC\uB9AC\uB0B4\uB9B4 \uC790\uB9AC\uB97C \uC900\uB2E4"
    source: Assets/Data/Behemoth/Events/Symbiosis.asset:options.Array.data[0].title
  - key: data.randomeventdata.symbiosis.options.0.description
    kr: "\uCD5C\uB300 \uCCB4\uB825 -12. \uACF5\uC0DD\uD558\uB294 \uC528\uC557: \uC77C\uBC18
      \uBB34\uAE30 \uD53C\uD574 +25%, \uCC28\uC9C0 \uD53C\uD574 +20%."
    source: Assets/Data/Behemoth/Events/Symbiosis.asset:options.Array.data[0].description
  - key: data.randomeventdata.symbiosis.options.1.title
    kr: "\uBFCC\uB9AC\uC640 \uD568\uAED8 \uBC84\uB987 \uD558\uB098\uB97C \uD0DC\uC6B4\uB2E4"
    source: Assets/Data/Behemoth/Events/Symbiosis.asset:options.Array.data[1].title
  - key: data.randomeventdata.symbiosis.options.1.description
    kr: "\uBCF4\uC720 \uD37D \uD558\uB098 \uC81C\uAC70 \uD6C4 \uC0C8 \uD37D\uC744
      \uC120\uD0DD\uD55C\uB2E4."
    source: Assets/Data/Behemoth/Events/Symbiosis.asset:options.Array.data[1].description
  - key: data.randomeventdata.tooth.displayname
    kr: "\uAE08\uBE5B \uC774\uBE68\uC758 \uB0B4\uAE30"
    source: Assets/Data/Behemoth/Events/Tooth.asset:displayName
  - key: data.randomeventdata.tooth.narrative
    kr: "\uAE08\uB2C8\uC758 \uC0C1\uC778\uC774 \uC7A5\uBD80\uB97C \uB0B4\uBBFC\uB2E4.\n\u201C\uC774\uBC88\uC5D4
      \uC0B4\uC544 \uB3CC\uC544\uC624\uC2DC\uB294 \uCABD\uC5D0 \uAC78\uC8E0.\u201D\n\n\uD0C1\uC790
      \uC544\uB798\uC5D0\uB294 \uACB0\uD22C\uC6A9 \uCE7C\uACFC \uC791\uC740 \uAE08\uACE0\uAC00
      \uC788\uB2E4."
