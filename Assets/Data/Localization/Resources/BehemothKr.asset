  - key: data.equipmentdata.icefocus.displayname
    kr: "\uACA8\uC6B8\uC758 \uC2DC\uC120"
    source: Assets/Data/Items/Relics/IceFocus.asset:displayName
  - key: data.equipmentdata.icefocus.description
    kr: "\uC11C\uB9AC \uD30C\uB3D9 \uC2B5\uB4DD. \uB0C9\uAE30 \uC8FC\uBB38 \uD53C\uD574
      +20%, \uB454\uD654 \uC9C0\uC18D\uC2DC\uAC04 +0.5\uCD08."
    source: Assets/Data/Items/Relics/IceFocus.asset:description
  - key: data.equipmentdata.ironfortress.displayname
    kr: "\uBD88\uAD74\uC758 \uC131\uCC44"
    source: Assets/Data/Items/Relics/IronFortress.asset:displayName
  - key: data.equipmentdata.ironfortress.description
    kr: "\uCD5C\uB300 \uAC00\uB4DC\uAC8C\uC774\uC9C0 +25, \uC804\uD22C \uC911 \uC790\uC5F0\uD68C\uBCF5
      \uCD08\uB2F9 +2."
    source: Assets/Data/Items/Relics/IronFortress.asset:description
  - key: data.equipmentdata.lightningrod.displayname
    kr: "\uD53C\uB8B0\uCE68 \uC9C0\uD321\uC774"
    source: Assets/Data/Items/Relics/LightningRod.asset:displayName
  - key: data.equipmentdata.lightningrod.description
    kr: "\uC2A4\uD30C\uD06C \uC2B5\uB4DD. \uBB34\uAE30 \uC801\uC911 \uB300\uC0C1\uC5D0\uAC8C
      8\uCD08 \uB3D9\uC548 \uD53C\uB8B0\uCE68\uC744 \uB0A8\uACA8 \uBC88\uAC1C\uAC00
      \uC6B0\uC120\uD55C\uB2E4."
    source: Assets/Data/Items/Relics/LightningRod.asset:description
  - key: data.equipmentdata.longdragon.displayname
    kr: "\uC720\uB8E1\uC758 \uB450\uB8E8\uB9C8\uB9AC"
    source: Assets/Data/Items/Relics/LongDragon.asset:displayName
  - key: data.equipmentdata.longdragon.description
    kr: "\u2191\u2193\u2192 \uD6C4 \uCC28\uC9C0\uB85C \uC720\uB8E1\uC5F0\uD0C0 \uD574\uAE08.
      \uCC28\uC9C0 \uD53C\uD574 \xD70.6\uB85C 4\uD68C, \uC57D\uC810\uB3C4 4\uD68C
      \uD0C0\uACA9."
    source: Assets/Data/Items/Relics/LongDragon.asset:description
  - key: data.equipmentdata.longrage.displayname
    kr: "\uB05D\uB098\uC9C0 \uC54A\uB294 \uACA9\uB178"
    source: Assets/Data/Items/Relics/LongRage.asset:displayName
  - key: data.equipmentdata.longrage.description
    kr: "\uBD84\uB178 \uC18C\uBAA8\uAC00 \uCD08\uB2F9 8 \uAC10\uC18C\uD55C\uB2E4.
      \uBD84\uB178 \uC911 \uC77C\uBC18\uACF5\uACA9 \uC2DC \uBD84\uB178 +6."
    source: Assets/Data/Items/Relics/LongRage.asset:description
  - key: data.equipmentdata.longtiger.displayname
    kr: "\uB9F9\uD638\uC758 \uB450\uB8E8\uB9C8\uB9AC"
    source: Assets/Data/Items/Relics/LongTiger.asset:displayName
  - key: data.equipmentdata.longtiger.description
    kr: "\u2193\u2191\u2191 \uD6C4 \uCC28\uC9C0\uB85C \uB9F9\uD638\uBD95\uAD8C \uD574\uAE08.
      \uCC28\uC9C0 \uD53C\uD574 \xD72.5. \uAE34 \uD328\uD134\uC774 \uC6B0\uC120\uD55C\uB2E4."
    source: Assets/Data/Items/Relics/LongTiger.asset:description
  - key: data.equipmentdata.mindfulguard.displayname
    kr: "\uC8FC\uBB38\uC744 \uC787\uB294 \uD638\uD761"
    source: Assets/Data/Items/Relics/MindfulGuard.asset:displayName
  - key: data.equipmentdata.mindfulguard.description
    kr: "\uC2A4\uD30C\uD06C \uC2B5\uB4DD. \uCD08\uC2DD \uC0AC\uC6A9 \uC2DC \uC8FC\uBB38
      \uCFE8\uD0C0\uC784 -1\uCD08. \uC8FC\uBB38 \uBC1C\uB3D9 \uC2DC \uAC00\uB4DC\uAC8C\uC774\uC9C0
      +3."
    source: Assets/Data/Items/Relics/MindfulGuard.asset:description
  - key: data.equipmentdata.mirrorshard.displayname
    kr: "\uAE30\uC5B5\uD558\uB294 \uAC70\uC6B8 \uC870\uAC01"
    source: Assets/Data/Items/Relics/MirrorShard.asset:displayName
  - key: data.equipmentdata.mirrorshard.description
    kr: "\uB9E4 4\uBC88\uC9F8 \uBB34\uAE30 \uC801\uC911\uC5D0 \uD574\uB2F9 \uD53C\uD574\uC758
      40%\uB97C \uB354\uD55C\uB2E4."
    source: Assets/Data/Items/Relics/MirrorShard.asset:description
  - key: data.equipmentdata.paladin.displayname
    kr: "\uC131\uAE30\uC0AC\uC758 \uAE38"
    source: Assets/Data/Items/Relics/Paladin.asset:displayName
  - key: data.equipmentdata.paladin.description
    kr: "\uC7BF\uBD88 \uD654\uC0B4 \uC2B5\uB4DD. \uAC00\uB4DC \uC131\uACF5 \uC2DC
      \uC8FC\uBB38\uC758 \uB0A8\uC740 \uCFE8\uD0C0\uC784 -1\uCD08."
    source: Assets/Data/Items/Relics/Paladin.asset:description
  - key: data.equipmentdata.parasite.displayname
    kr: "\uACF5\uC0DD\uD558\uB294 \uC528\uC557"
    source: Assets/Data/Items/Relics/Parasite.asset:displayName
  - key: data.equipmentdata.parasite.description
    kr: "\uC77C\uBC18 \uBB34\uAE30 \uD53C\uD574 +25%, \uCC28\uC9C0 \uD53C\uD574 +20%."
    source: Assets/Data/Items/Relics/Parasite.asset:description
  - key: data.equipmentdata.parryrecovery.displayname
    kr: "\uD2C8\uC744 \uBCA0\uB2E4"
    source: Assets/Data/Items/Relics/ParryRecovery.asset:displayName
  - key: data.equipmentdata.parryrecovery.description
    kr: "\uB0A9\uB3C4\uD328\uB9AC \uC131\uACF5 \uC2DC \uACF5\uACA9 \uCFE8\uD0C0\uC784
      \uC989\uC2DC \uCD08\uAE30\uD654."
    source: Assets/Data/Items/Relics/ParryRecovery.asset:description
  - key: data.equipmentdata.patientsheath.displayname
    kr: "\uAE30\uB2E4\uB9BC\uC758 \uCE7C"
    source: Assets/Data/Items/Relics/PatientSheath.asset:displayName
  - key: data.equipmentdata.patientsheath.description
    kr: "\uB0A9\uB3C4 \uC720\uC9C0 1\uCD08\uB2F9 \uBC1C\uB3C4 \uD53C\uD574 +30%,
      \uCD5C\uB300 +100%."
    source: Assets/Data/Items/Relics/PatientSheath.asset:description
  - key: data.equipmentdata.perfectmending.displayname
    kr: "\uC644\uBCBD\uD55C \uC218\uD638"
    source: Assets/Data/Items/Relics/PerfectMending.asset:displayName
  - key: data.equipmentdata.perfectmending.description
    kr: "\uAC00\uB4DC \uC2DC\uC791 0.1\uCD08\uC5D0 \uD37C\uD399\uD2B8\uAC00\uB4DC
      \uAC00\uB2A5. \uC131\uACF5 \uC2DC \uAC8C\uC774\uC9C0\uB97C \uC4F0\uC9C0 \uC54A\uACE0
      10\uCD08 \uB3D9\uC548 \uD53C\uD574 +30%. \uAC31\uC2E0\uB418\uBA70 \uC911\uCCA9\uB418\uC9C0
      \uC54A\uB294\uB2E4."
    source: Assets/Data/Items/Relics/PerfectMending.asset:description
  - key: data.equipmentdata.perfectriposte.displayname
    kr: "\uB418\uBE44\uCE58\uB294 \uAC80\uAD11"
    source: Assets/Data/Items/Relics/PerfectRiposte.asset:displayName
  - key: data.equipmentdata.perfectriposte.description
    kr: "\uB0A9\uB3C4\uD328\uB9AC \uC131\uACF5 \uC2DC \uACF5\uACA9\uD55C \uC801\uC5D0\uAC8C
      \uCC28\uC9C0 \uACF5\uACA9\uB825\uC758 50% \uD53C\uD574."
    source: Assets/Data/Items/Relics/PerfectRiposte.asset:description
  - key: data.equipmentdata.pilgrimoath.displayname
    kr: "\uC21C\uB840\uC790\uC758 \uC11C\uC57D"
    source: Assets/Data/Items/Relics/PilgrimOath.asset:displayName
  - key: data.equipmentdata.pilgrimoath.description
    kr: "\uAC00\uB4DC 3\uD68C\uB9C8\uB2E4 \uAC00\uB4DC\uAC8C\uC774\uC9C0 +3. \uC21C\uB840\uC790\uC758
      \uC778\uC5F0\uC744 \uC99D\uBA85\uD55C\uB2E4."
    source: Assets/Data/Items/Relics/PilgrimOath.asset:description
  - key: data.equipmentdata.poisonleech.displayname
    kr: "\uB9F9\uB3C5\uC758 \uC0DD\uBA85\uC904"
    source: Assets/Data/Items/Relics/PoisonLeech.asset:displayName
  - key: data.equipmentdata.poisonleech.description
    kr: "\uB3C5 \uD53C\uD574\uC758 12%\uB9CC\uD07C \uCCB4\uB825\uC744 \uD68C\uBCF5\uD55C\uB2E4."
    source: Assets/Data/Items/Relics/PoisonLeech.asset:description
  - key: data.equipmentdata.pressurepoint.displayname
    kr: "\uAE30\uD608 \uD30C\uC1C4"
    source: Assets/Data/Items/Relics/PressurePoint.asset:displayName
  - key: data.equipmentdata.pressurepoint.description
    kr: "\uAE30\uC808\uD55C \uB300\uC0C1\uC5D0\uAC8C \uCD08\uC2DD \uB9C8\uBB34\uB9AC
      \uD53C\uD574 +35%."
    source: Assets/Data/Items/Relics/PressurePoint.asset:description
  - key: data.equipmentdata.quickcasting.displayname
    kr: "\uCD95\uC57D \uC601\uCC3D"
    source: Assets/Data/Items/Relics/QuickCasting.asset:displayName
  - key: data.equipmentdata.quickcasting.description
    kr: "\uC8FC\uBB38 \uCE90\uC2A4\uD305 \uC2DC\uAC04 -35%."
    source: Assets/Data/Items/Relics/QuickCasting.asset:description
  - key: data.equipmentdata.ragecharge.displayname
    kr: "\uBD84\uB178\uC758 \uC77C\uACA9"
    source: Assets/Data/Items/Relics/RageCharge.asset:displayName
  - key: data.equipmentdata.ragecharge.description
    kr: "\uBD84\uB178 \uC911 \uCC28\uC9C0 \uD53C\uD574\uAC00 \uD604\uC7AC \uBD84\uB178
      1\uB2F9 1% \uC99D\uAC00\uD55C\uB2E4. \uD574\uB2F9 \uCC28\uC9C0 \uD6C4 \uBD84\uB178
      35 \uC18C\uBAA8."
    source: Assets/Data/Items/Relics/RageCharge.asset:description
  - key: data.equipmentdata.rageleech.displayname
    kr: "\uD53C\uC758 \uC5F0\uD68C"
    source: Assets/Data/Items/Relics/RageLeech.asset:displayName
  - key: data.equipmentdata.rageleech.description
    kr: "\uBD84\uB178 \uC911 \uC9C1\uC811 \uBB34\uAE30 \uD53C\uD574\uC758 10%\uB9CC\uD07C
      \uCCB4\uB825\uC744 \uD68C\uBCF5\uD55C\uB2E4."
    source: Assets/Data/Items/Relics/RageLeech.asset:description
  - key: data.equipmentdata.raggedbanner.displayname
    kr: "\uC774\uB984 \uC5C6\uB294 \uAE43\uBC1C"
    source: Assets/Data/Items/Relics/RaggedBanner.asset:displayName
  - key: data.equipmentdata.raggedbanner.description
    kr: "\uC0B4\uC544 \uC788\uB294 \uC801 \uD558\uB098\uB2F9 \uBB34\uAE30 \uD53C\uD574
      +8%."
    source: Assets/Data/Items/Relics/RaggedBanner.asset:description
  - key: data.equipmentdata.shadowcounter.displayname
    kr: "\uB3C5\uC744 \uC77D\uB294 \uC8FC\uBB38\uC11C"
    source: Assets/Data/Items/Relics/ShadowCounter.asset:displayName
  - key: data.equipmentdata.shadowcounter.description
    kr: "\uC2A4\uD30C\uD06C \uC2B5\uB4DD. \uAC00\uB4DC \uC131\uACF5 \uC2DC \uC8FC\uBB38
      \uCFE8\uD0C0\uC784 -0.5\uCD08. \uC8FC\uBB38 \uBC1C\uB3D9 \uC2DC \uB300\uC0C1\uC5D0\uAC8C
      \uB3C5 2\uC911\uCCA9."
    source: Assets/Data/Items/Relics/ShadowCounter.asset:description
  - key: data.equipmentdata.shadowsheath.displayname
    kr: "\uCC30\uB098\uC758 \uC794\uC601"
    source: Assets/Data/Items/Relics/ShadowSheath.asset:displayName
  - key: data.equipmentdata.shadowsheath.description
    kr: "\uB0A9\uB3C4\uD328\uB9AC \uD310\uC815 \uC2DC\uAC04\uC774 0.1\uCD08 \uB298\uC5B4\uB09C\uB2E4."
    source: Assets/Data/Items/Relics/ShadowSheath.asset:description
  - key: data.equipmentdata.sheltermaster.displayname
    kr: "\uAE08\uAC15 \uD638\uC2E0"
    source: Assets/Data/Items/Relics/ShelterMaster.asset:displayName
  - key: data.equipmentdata.sheltermaster.description
    kr: "\uD638\uC2E0\uACA9 \uC0AC\uC6A9 \uC2DC \uCD5C\uB300 \uAC00\uB4DC\uAC8C\uC774\uC9C0\uC758
      30%\uB97C \uCD94\uAC00 \uD68C\uBCF5."
    source: Assets/Data/Items/Relics/ShelterMaster.asset:description
  - key: data.equipmentdata.shieldbash.displayname
    kr: "\uC2E0\uC131\uAC80\uC758 \uC11C\uC57D"
    source: Assets/Data/Items/Relics/ShieldBash.asset:displayName
  - key: data.equipmentdata.shieldbash.description
    kr: "\uAC00\uB4DC\uB85C \uC18C\uBAA8\uD55C \uAC8C\uC774\uC9C0\uC758 50%\uB97C
      \uC800\uC7A5\uD558\uC5EC \uB2E4\uC74C \uBB34\uAE30 \uC801\uC911\uC5D0 \uB354\uD55C\uB2E4."
    source: Assets/Data/Items/Relics/ShieldBash.asset:description
  - key: data.equipmentdata.shieldedge.displayname
    kr: "\uBC29\uD328\uC758 \uCE7C\uB0A0"
    source: Assets/Data/Items/Relics/ShieldEdge.asset:displayName
  - key: data.equipmentdata.shieldedge.description
    kr: "\uBB34\uAE30 \uC801\uC911\uC5D0 \uD604\uC7AC \uAC00\uB4DC\uAC8C\uC774\uC9C0\uC758
      15%\uB97C \uCD94\uAC00\uD55C\uB2E4."
    source: Assets/Data/Items/Relics/ShieldEdge.asset:description
  - key: data.equipmentdata.spear.displayname
    kr: "\uCC9C\uACF5\uCC3D"
    source: Assets/Data/Items/Relics/Spear.asset:displayName
  - key: data.equipmentdata.spear.description
    kr: "\uC62C\uB824\uCE58\uAE30 \uD53C\uD574 +35%, \uACF5\uACA9 \uCFE8\uD0C0\uC784
      -50%. \uB2E4\uB978 \uBC29\uD5A5 \uD53C\uD574 -20%, \uACF5\uACA9 \uCFE8\uD0C0\uC784
      +25%."
    source: Assets/Data/Items/Relics/Spear.asset:description
  - key: data.equipmentdata.spellblade.displayname
    kr: "\uC8FC\uBB38\uAC80"
    source: Assets/Data/Items/Relics/SpellBlade.asset:displayName
  - key: data.equipmentdata.spellblade.description
    kr: "\uC5D0\uB108\uC9C0 \uBCFC\uD2B8 \uC2B5\uB4DD. \uB0A9\uB3C4 \uC911 \uCE90\uC2A4\uD305
      \uC2DC\uAC04 -25%. \uC8FC\uBB38 \uBC1C\uB3D9 \uD6C4 \uB2E4\uC74C \uBC1C\uB3C4
      \uD53C\uD574 +40%."
    source: Assets/Data/Items/Relics/SpellBlade.asset:description
  - key: data.equipmentdata.spellecho.displayname
    kr: "\uC8FC\uBB38\uC758 \uC794\uD5A5"
    source: Assets/Data/Items/Relics/SpellEcho.asset:displayName
  - key: data.equipmentdata.spellecho.description
    kr: "\uC138 \uBC88\uC9F8 \uC8FC\uBB38\uB9C8\uB2E4 0.22\uCD08 \uD6C4 \uAC19\uC740
      \uC8FC\uBB38\uC744 50% \uD53C\uD574\uB85C \uD55C \uBC88 \uB354 \uBC1C\uB3D9\uD55C\uB2E4."
    source: Assets/Data/Items/Relics/SpellEcho.asset:description
  - key: data.equipmentdata.staffconduit.displayname
    kr: "\uC9C0\uD321\uC774\uC640 \uC8FC\uBB38 \uC0AC\uC774"
    source: Assets/Data/Items/Relics/StaffConduit.asset:displayName
  - key: data.equipmentdata.staffconduit.description
    kr: "\uC77C\uBC18 \uBB34\uAE30 \uD53C\uD574 +15%. \uC9C0\uD321\uC774 \uCC28\uC9C0
      \uC801\uC911 \uD6C4 \uB2E4\uC74C \uC8FC\uBB38\uC740 \uCE90\uC2A4\uD305 \uC2DC\uAC04
      -60%, \uD53C\uD574 +20%. \uC57D\uC810 \uD30C\uAD34 \uC2DC \uAC00\uB4DC\uAC8C\uC774\uC9C0
      +3."
    source: Assets/Data/Items/Relics/StaffConduit.asset:description
  - key: data.equipmentdata.starter_barbarian.displayname
    kr: "\uACA9\uB178\uC758 \uC2EC\uC7A5"
    source: Assets/Data/Items/Relics/Starter_Barbarian.asset:displayName
  - key: data.equipmentdata.starter_barbarian.description
    kr: "\uC77C\uBC18 \uACF5\uACA9 \uC2DC \uACA9\uB178 12\uC911\uCCA9 \uD68D\uB4DD.
      \uACA9\uB178 24 \uC774\uC0C1\uC5D0\uC11C \uCC28\uC9C0 \uACF5\uACA9 \uC2DC \uC313\uC778
      \uACA9\uB178\uB97C \uBD84\uB178\uB85C \uC804\uD658\uD569\uB2C8\uB2E4.\r\n[\uBD84\uB178]
      \uBB34\uAE30 \uD53C\uD574 +30%, \uACF5\uACA9 \uCFE8\uD0C0\uC784 -45%, \uBC1B\uB294
      \uCCB4\uB825 \uD53C\uD574 -25%. \uBD84\uB178\uB294 \uCD08\uB2F9 25\uC911\uCCA9
      \uC18C\uBAA8\uD55C\uB2E4."
    source: Assets/Data/Items/Relics/Starter_Barbarian.asset:description
  - key: data.equipmentdata.starter_monk.displayname
    kr: "\uCD08\uC2DD\uC758 \uB450\uB8E8\uB9C8\uB9AC"
    source: Assets/Data/Items/Relics/Starter_Monk.asset:displayName
  - key: data.equipmentdata.starter_monk.description
    kr: "\uC77C\uBC18 \uACF5\uACA9 \uBC29\uD5A5\uC5D0 \uB530\uB77C \uCD08\uC2DD\uC744
      \uC900\uBE44\uD569\uB2C8\uB2E4. \uD328\uD134\uC744 \uB9CC\uB4E0 \uD6C4, \uCC28\uC9C0
      \uACF5\uACA9\uC73C\uB85C \uCD08\uC2DD\uC744 \uB9C8\uBB34\uB9AC \uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4. \uCD08\uC2DD\uC744 \uB9C8\uBB34\uB9AC\uD558\uBA74
      \uC544\uB798\uC640 \uAC19\uC740 \uD6A8\uACFC\uB97C \uC5BB\uC2B5\uB2C8\uB2E4.\r\n\u2193\u2191
      \uBD95\uAD8C: 1.7\uBC30 \uCC28\uC9C0 \uD53C\uD574\r\n\u2190\u2192 \uBC31\uB82C\uAD8C:
      0.55\uBC30 \uCC28\uC9C0 3\uD68C \uD53C\uD574\r\n\u2193\u2192 \uD638\uC2E0\uACA9:
      \uAC00\uB4DC +5, \uB2E4\uC74C 1\uD68C\uC5D0 \uD55C\uD574 \uBC1B\uB294 \uD53C\uD574
      -50%.\r\n\u2192\u2191 \uC5F0\uD658: \uB2E4\uC74C \uC77C\uBC18\uACF5\uACA9 2\uD68C
      \uCFE8\uD0C0\uC784 -40%."
    source: Assets/Data/Items/Relics/Starter_Monk.asset:description
  - key: data.equipmentdata.starter_rogue.displayname
    kr: "\uADF8\uB9BC\uC790 \uB9DD\uD1A0"
    source: Assets/Data/Items/Relics/Starter_Rogue.asset:displayName
  - key: data.equipmentdata.starter_rogue.description
    kr: "\uC804\uD22C \uAC1C\uC2DC \uC2DC \uC740\uC2E0\uD558\uBA70, \uC801\uC774
      \uB208\uCE58\uCC44\uAE30 \uC804\uC5D0 \uBA3C\uC800 \uD589\uB3D9\uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4. \uAC01 \uD589\uB3D9 \uB9C8\uB2E4 25% \uD655\uB960\uB85C
      \uBC1C\uAC01\uB429\uB2C8\uB2E4. \uC801\uC774 \uACF5\uACA9\uBC1B\uC73C\uBA74
      \uC989\uC2DC \uBC1C\uAC01\uB429\uB2C8\uB2E4."
    source: Assets/Data/Items/Relics/Starter_Rogue.asset:description
  - key: data.equipmentdata.starter_samurai.displayname
    kr: "\uACE0\uC694\uD55C \uCE7C\uC9D1"
    source: Assets/Data/Items/Relics/Starter_Samurai.asset:displayName
  - key: data.equipmentdata.starter_samurai.description
    kr: "\uAC00\uB4DC \uC9C4\uC785 \uC2DC \uB0A9\uB3C4. \uB0A9\uB3C4 \uD328\uB9AC
      0.3\uCD08. \uB2E4\uC74C \uBC1C\uB3C4 \uD53C\uD574 +50%. \uB0A9\uB3C4 \uD328\uB9AC
      \uC131\uACF5 \uC2DC \uB2E4\uC74C \uBC1C\uB3C4\uAC00 \uCC28\uC9C0 \uD310\uC815\uC744
      \uC5BB\uB294\uB2E4."
    source: Assets/Data/Items/Relics/Starter_Samurai.asset:description
  - key: data.equipmentdata.starter_warrior.displayname
    kr: "\uC218\uD638\uC790\uC758 \uBC29\uD328"
