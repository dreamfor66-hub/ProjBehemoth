  - key: ui.camp.full.detail
    kr: "\uD53C\uB85C\uB3C4 100\uAE4C\uC9C0 \xB7 \uCCB4\uB825 10 \uD68C\uBCF5\n\uB2E4\uC2DC
      \uAC78\uC744 \uC5EC\uC720\uB97C \uC5BB\uB294\uB2E4.\n\uC0B4\uC544 \uC788\uB294
      \uC77C\uBC18 \uBAAC\uC2A4\uD130\uAC00 \uC774\uB3D9\uD560 \uC218 \uC788\uB2E4."
