    source: Assets/Data/Behemoth/Events/StrayDog.asset:options.Array.data[2].title
  - key: data.randomeventdata.straydog.options.2.description
    kr: "\uAC15\uC544\uC9C0\uB294 \uC548\uC804\uD55C \uC57C\uC601\uC9C0\uC5D0 \uB0A8\uB294\uB2E4.
      \uB0A8\uC740 \uC57D\uCD08\uB85C \uB0B4 \uCCB4\uB825 8 \uD68C\uBCF5. \uB3D9\uB8CC\uB294
      \uC5BB\uC9C0 \uC54A\uB294\uB2E4."
    source: Assets/Data/Behemoth/Events/StrayDog.asset:options.Array.data[2].description
  - key: data.randomeventdata.symbiosis.displayname
    kr: "\uB450 \uBC88\uC9F8 \uB9E5\uBC15"
    source: Assets/Data/Behemoth/Events/Symbiosis.asset:displayName
  - key: data.randomeventdata.symbiosis.narrative
    kr: "\uC528\uC557\uC744 \uC954 \uC190\uC5D0\uC11C \uB9E5\uBC15\uC774 \uB450 \uBC88
      \uB6F4\uB2E4. \uD558\uB098\uB294 \uB2F9\uC2E0 \uAC83, \uB2E4\uB978 \uD558\uB098\uB294
      \uC544\uC9C1 \uC790\uB9AC\uB97C \uCC3E\uC9C0 \uBABB\uD588\uB2E4.\n\n\uC606\uC5D0\uB294
      \uBFCC\uB9AC\uB97C \uD0DC\uC6B8 \uB9CC\uD55C \uD654\uB85C\uAC00 \uB0A8\uC544
      \uC788\uB2E4."
