  - key: data.randomeventdata.training.displayname
    kr: "\uC624\uB298\uC758 \uC0C1\uB300\uB97C \uACE0\uB974\uC2DC\uC624"
    source: Assets/Data/Behemoth/Events/Training.asset:displayName
  - key: data.randomeventdata.training.narrative
    kr: "\uB098\uBB34 \uC778\uD615 \uC138 \uAC1C\uAC00 \uB098\uB780\uD788 \uC120\uB2E4.
      \uCCAB\uC9F8\uB294 \uB290\uC2A8\uD55C \uB048, \uB458\uC9F8\uB294 \uCCA0\uC0AC,
      \uC14B\uC9F8\uB294 \uC0AC\uC2AC\uB85C \uBB36\uC5EC \uC788\uB2E4.\n\n\u201C\uC131\uC801\uC5D0
      \uB9DE\uB294 \uC0C1\uC740 \uC900\uBE44\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4.\u201D"
    source: Assets/Data/Behemoth/Events/Training.asset:narrative
  - key: data.randomeventdata.training.options.0.title
    kr: "\uB048\uC744 \uD47C\uB2E4"
    source: Assets/Data/Behemoth/Events/Training.asset:options.Array.data[0].title
  - key: data.randomeventdata.training.options.0.description
    kr: "\uC5F0\uC2B5 \uC778\uD615 \uCCB4\uB825 75. \uC2B9\uB9AC \uD6C4 \uD3EC\uC158
