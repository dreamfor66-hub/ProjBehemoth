    source: Assets/Data/Behemoth/Encounters/BloodExecutioner.asset:displayName
  - key: data.encounterdata.bloodexecutioner.hint
    kr: "\uBB34\uAE30 \uC801\uC911 5\uD68C\uB9C8\uB2E4 \uB2E4\uC74C \uACF5\uACA9\uC774
      \uBE68\uB77C\uC9C4\uB2E4. \uC57D\uC810 \uD30C\uAD34\uB85C \uD655\uBCF4\uD55C
      \uAE30\uC808\uC5D0 \uD53C\uD574\uB97C \uC9D1\uC911\uD558\uC790."
