  - key: data.randomeventdata.well.pages.0.options.2.resulttext
    kr: "\uADF8\uB300\uB85C \uC790\uB9AC\uB97C \uB5A0\uB0AC\uB2E4."
    source: Assets/Data/Dungeon/Events/Well.asset:pages.Array.data[0].options.Array.data[2].resultText
  - key: data.randomeventdata.well.pages.1.narrative
    kr: "\uBC27\uC904\uC744 \uB2F9\uAE30\uC790 \uBC29\uD328\uB97C \uB4E0 \uD314\uC774
      \uAC11\uC790\uAE30 \uBB34\uAC70\uC6CC\uC9C4\uB2E4.\r\n\r\n\uAE08\uACE0\uAC00
      \uC62C\uB77C\uC624\uBA70 \uBCBD\uC744 \uAC00\uB9B0 \uBB3C\uB54C\uAC00 \uBC97\uACA8\uC84C\uB2E4.
      \uADF8 \uC544\uB798\uC5D0 \uACBD\uACE0\uBB38\uC774 \uC788\uB2E4.\r\n\r\n\uAE08\uACE0\uB97C
      \uAC00\uC838\uAC00\uB294 \uC790\uB294 \uADF8 \uBB34\uAC8C\uB3C4 \uD568\uAED8
      \uC9CA\uC5B4\uC9C4\uB2E4."
    source: Assets/Data/Dungeon/Events/Well.asset:pages.Array.data[1].narrative
  - key: data.randomeventdata.well.pages.1.options.0.title
    kr: "\uC800\uC8FC\uB97C \uAC10\uC218\uD558\uACE0 \uAE08\uACE0\uB97C \uAC00\uC838\uAC04\uB2E4."
    source: Assets/Data/Dungeon/Events/Well.asset:pages.Array.data[1].options.Array.data[0].title
  - key: data.randomeventdata.well.pages.1.options.0.description
    kr: "\uACE8\uB4DC +150 \xB7 \uC6B0\uBB3C \uBC11\uC758 \uBB34\uAC8C \uD68D\uB4DD"
    source: Assets/Data/Dungeon/Events/Well.asset:pages.Array.data[1].options.Array.data[0].description
