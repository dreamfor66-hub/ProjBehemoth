  - key: data.randomeventdata.shelter.narrative
    kr: "\uBD88\uC744 \uD53C\uC6B0\uC790 \uC5B4\uB460 \uC18D\uC758 \uB208\uB4E4\uC774
      \uAC10\uAE34\uB2E4. \uC7A5\uC791\uC740 \uD558\uB8FB\uBC24\uC744 \uBC84\uD2F8
