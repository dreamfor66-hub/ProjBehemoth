  - key: data.randomeventdata.amberseed.displayname
    kr: "\uB531 \uD558\uB098 \uB0A8\uC740 \uC5F4\uB9E4"
    source: Assets/Data/Dungeon/Events/AmberSeed.asset:displayName
  - key: data.randomeventdata.amberseed.narrative
    kr: "\uC5F0\uAE08\uC220\uC2E4 \uC548\uCABD\uC5D0 \uC120\uBC18\uACFC \uD654\uBD84\uC774
      \uB298\uC5B4\uC120 \uC791\uC740 \uBC29\uC774 \uC788\uB2E4.\r\n\r\n\uB300\uBD80\uBD84
      \uB9D0\uB77C \uC8FD\uC5C8\uC9C0\uB9CC \uC720\uB9AC \uB36E\uAC1C \uC544\uB798
      \uC5F4\uB9E4 \uD558\uB098\uAC00 \uB0A8\uC544 \uC788\uB2E4.\r\n\r\n\uD654\uBD84\uC758
      \uC124\uBA85\uC5D0\uB294 \uD53C\uB97C \uBA39\uC5EC \uD0A4\uC6B0\uBA74 \uBAB8\uC744
      \uD2BC\uD2BC\uD558\uAC8C \uD574 \uC8FC\uB294 \uC2DD\uBB3C\uC774\uB77C\uACE0
      \uC801\uD600 \uC788\uB2E4.\r\n\r\n\uC5F4\uB9E4\uB97C \uBC14\uB85C \uBA39\uC5B4\uB3C4
      \uC0C1\uCC98\uC5D0 \uC88B\uC9C0\uB9CC, \uC528\uC557\uAE4C\uC9C0 \uBA39\uC73C\uBA74
      \uB2E4\uC2DC \uD0A4\uC6B8 \uC218\uB294 \uC5C6\uB2E4\uACE0 \uD55C\uB2E4."
    source: Assets/Data/Dungeon/Events/AmberSeed.asset:narrative
  - key: data.randomeventdata.amberseed.options.0.title
    kr: "\uB0B4 \uD53C\uB85C \uC2F9\uC744 \uD2D4\uC6B4\uB2E4"
    source: Assets/Data/Dungeon/Events/AmberSeed.asset:options.Array.data[0].title
  - key: data.randomeventdata.amberseed.options.0.description
    kr: "\uCCB4\uB825 -10. \uD638\uBC15\uBE5B \uC2F9: \uC804\uD22C 3\uC2B9\uB9C8\uB2E4
      \uCD5C\uB300\xB7\uD604\uC7AC \uCCB4\uB825 +4."
    source: Assets/Data/Dungeon/Events/AmberSeed.asset:options.Array.data[0].description
  - key: data.randomeventdata.amberseed.options.1.title
    kr: "\uC528\uC557\uC9F8 \uC539\uC5B4 \uC0BC\uD0A8\uB2E4"
    source: Assets/Data/Dungeon/Events/AmberSeed.asset:options.Array.data[1].title
  - key: data.randomeventdata.amberseed.options.1.description
    kr: "\uCCB4\uB825 20 \uD68C\uBCF5. \uC528\uC557\uC740 \uC0AC\uB77C\uC9C4\uB2E4."
    source: Assets/Data/Dungeon/Events/AmberSeed.asset:options.Array.data[1].description
  - key: data.randomeventdata.banner.displayname
    kr: "\uC544\uC9C1 \uAD50\uB300 \uC2DC\uAC04\uC774 \uC544\uB2C8\uB2E4"
    source: Assets/Data/Dungeon/Events/Banner.asset:displayName
  - key: data.randomeventdata.banner.narrative
    kr: "\uAC80\uBB38\uC18C\uC758 \uAC11\uC637\uC774 \uCC3D\uC744 \uB0B4\uB824 \uAE38\uC744
      \uB9C9\uB294\uB2E4.\r\n\r\n\uAD50\uB300\uC790. \uC18C\uC18D\uC744 \uBC1D\uD600\uB77C.\r\n\r\n\uD22C\uAD6C
      \uC548\uC740 \uBE44\uC5B4 \uC788\uB2E4. \uC774 \uC131\uC758 \uC218\uBE44\uB300\uAC00
      \uC0AC\uB77C\uC9C4 \uAC83\uB3C4 \uBAA8\uB974\uB294 \uBAA8\uC591\uC774\uB2E4.\r\n\r\n\uAC11\uC637\uC740
      \uB0B4 \uBB34\uC7A5\uC744 \uC0B4\uD53C\uB354\uB2C8 \uC2DC\uD5D8\uC744 \uBC1B\uC544
      \uAD50\uB300\uD560 \uC790\uACA9\uC744 \uC99D\uBA85\uD558\uB77C\uACE0 \uD55C\uB2E4.\r\n\r\n\uC2F8\uC6B8
      \uC0DD\uAC01\uC774 \uC5C6\uB2E4\uBA74 \uAE09\uB8CC\uD568\uB9CC \uBE44\uC6B0\uACE0
      \uAC00\uB77C. \uC544\uC9C1 \uBC1B\uC73C\uB7EC \uC628 \uC0AC\uB78C\uC774 \uC5C6\uB2E4."
    source: Assets/Data/Dungeon/Events/Banner.asset:narrative
  - key: data.randomeventdata.banner.options.0.title
    kr: "\uB0B4\uAC00 \uAD50\uB300\uD55C\uB2E4"
    source: Assets/Data/Dungeon/Events/Banner.asset:options.Array.data[0].title
  - key: data.randomeventdata.banner.options.0.description
    kr: "\uC218\uD638\uC790\uC640 \uC804\uD22C. \uC2B9\uB9AC \uC2DC \uAE43\uBC1C
      \uD68D\uB4DD: \uC0B4\uC544 \uC788\uB294 \uC801 \uD558\uB098\uB2F9 \uBB34\uAE30
      \uD53C\uD574 +8%."
    source: Assets/Data/Dungeon/Events/Banner.asset:options.Array.data[0].description
  - key: data.randomeventdata.banner.options.1.title
    kr: "\uB0A8\uACA8\uC9C4 \uAE09\uB8CC\uB97C \uCC59\uAE34\uB2E4"
    source: Assets/Data/Dungeon/Events/Banner.asset:options.Array.data[1].title
  - key: data.randomeventdata.banner.options.1.description
    kr: "\uACE8\uB4DC +15. \uAE43\uBC1C\uC740 \uC9C0\uD0A4\uB294 \uC790\uC5D0\uAC8C
      \uB0A8\uAE34\uB2E4."
    source: Assets/Data/Dungeon/Events/Banner.asset:options.Array.data[1].description
  - key: data.randomeventdata.bell.displayname
    kr: "\uC18C\uB9AC \uB098\uB294 \uCABD\uC744 \uBC1B\uCCD0\uB77C"
    source: Assets/Data/Dungeon/Events/Bell.asset:displayName
  - key: data.randomeventdata.bell.narrative
    kr: "\uBB34\uB108\uC9C4 \uC608\uBC30\uC2E4\uC5D0\uC11C \uC885\uC18C\uB9AC\uAC00
      \uB4E4\uB9B0\uB2E4.\r\n\r\n\uC791\uC740 \uC885\uC774 \uB3CC\uB85C \uB41C \uB4E4\uBCF4
      \uC544\uB798\uC5D0 \uB07C\uC5B4 \uC788\uB2E4."
    source: Assets/Data/Dungeon/Events/Bell.asset:narrative
  - key: data.randomeventdata.bell.options.0.title
    kr: "\uAC00\uC838\uC628 \uC720\uBB3C\uB85C \uBC1B\uCE5C\uB2E4"
    source: Assets/Data/Dungeon/Events/Bell.asset:options.Array.data[0].title
  - key: data.randomeventdata.bell.options.0.description
    kr: "\uACF5\uC6A9 \uC720\uBB3C \uD558\uB098 \uC120\uD0DD\uD574 \uC81C\uAC70.
      \uC218\uD638\uC758 \uC885: \uCD5C\uB300 \uAC00\uB4DC +10, \uC804\uD22C \uC2DC\uC791
      3\uCD08 \uCCB4\uB825 \uD53C\uD574 -20%."
    source: Assets/Data/Dungeon/Events/Bell.asset:options.Array.data[0].description
  - key: data.randomeventdata.bell.options.1.title
    kr: "\uC5B4\uAE68\uB85C \uB4E4\uC5B4 \uC62C\uB9B0\uB2E4"
    source: Assets/Data/Dungeon/Events/Bell.asset:options.Array.data[1].title
  - key: data.randomeventdata.bell.options.1.description
    kr: "\uCCB4\uB825 -20. \uC218\uD638\uC758 \uC885 \uD68D\uB4DD."
    source: Assets/Data/Dungeon/Events/Bell.asset:options.Array.data[1].description
  - key: data.randomeventdata.bell.options.2.title
    kr: "\uAC00\uC7A5\uC790\uB9AC\uC758 \uCCAD\uB3D9\uB9CC \uB5BC\uC5B4 \uAC04\uB2E4"
    source: Assets/Data/Dungeon/Events/Bell.asset:options.Array.data[2].title
  - key: data.randomeventdata.bell.options.2.description
    kr: "\uACE8\uB4DC +20. \uC885\uC740 \uAEBC\uB0B4\uC9C0 \uBABB\uD55C\uB2E4."
    source: Assets/Data/Dungeon/Events/Bell.asset:options.Array.data[2].description
  - key: data.randomeventdata.contract.displayname
    kr: "\uBD89\uC740 \uC11C\uBA85"
    source: Assets/Data/Dungeon/Events/Contract.asset:displayName
  - key: data.randomeventdata.contract.narrative
    kr: "\uBB34\uB108\uC9C4 \uC9D1\uBB34\uC2E4\uC5D0\uC11C \uD589\uC0C1\uC774 \uBB38\uC11C\uB4E4\uC744
      \uACE8\uB77C \uB2F4\uACE0 \uC788\uB2E4.\r\n\r\n\uBC1C\uBC11\uC5D0 \uB5A8\uC5B4\uC9C4
      \uBD89\uC740 \uACC4\uC57D\uC11C\uB97C \uC8FC\uC6B0\uB2C8 \uD589\uC0C1\uC774
      \uC190\uC744 \uB0B4\uBBFC\uB2E4.\r\n\r\n\uC11C\uBA85 \uC548 \uB41C \uAC70\uAD70\uC694.
      \uADF8\uAC74 \uC81C\uAC00 \uC0AC\uACA0\uC2B5\uB2C8\uB2E4."
    source: Assets/Data/Dungeon/Events/Contract.asset:narrative
  - key: data.randomeventdata.contract.options.0.title
    kr: "\uC9E7\uACE0 \uAD75\uAC8C"
    source: Assets/Data/Dungeon/Events/Contract.asset:options.Array.data[0].title
  - key: data.randomeventdata.contract.options.0.description
    kr: "\uCD5C\uB300 \uCCB4\uB825 -18. \uBD89\uC740 \uACC4\uC57D\uC11C: \uBAA8\uB4E0
      \uD53C\uD574 +25%."
    source: Assets/Data/Dungeon/Events/Contract.asset:options.Array.data[0].description
  - key: data.randomeventdata.contract.options.1.title
    kr: "\uBC31\uC9C0 \uACC4\uC57D\uC11C\uB97C \uB418\uD310\uB2E4"
    source: Assets/Data/Dungeon/Events/Contract.asset:options.Array.data[1].title
  - key: data.randomeventdata.contract.options.1.description
    kr: "\uACE8\uB4DC +25. \uACC4\uC57D\uC758 \uD798\uC740 \uC5BB\uC9C0 \uC54A\uB294\uB2E4."
    source: Assets/Data/Dungeon/Events/Contract.asset:options.Array.data[1].description
  - key: data.randomeventdata.delivery.displayname
    kr: "\uC0C1\uC790\uAC00 \uB450 \uAC1C\uB2E4"
    source: Assets/Data/Dungeon/Events/Delivery.asset:displayName
  - key: data.randomeventdata.delivery.narrative
    kr: "\uC2B9\uAC15 \uC7A5\uCE58 \uC606\uC5D0\uC11C \uC775\uC219\uD55C \uC9D0\uAFBC\uC774
      \uC190\uC744 \uD754\uB4E0\uB2E4.\r\n\r\n\uC5EC\uAE30 \uACC4\uC168\uAD70\uC694.
      \uC57D\uC18D\uD55C \uBB3C\uAC74 \uAC00\uC838\uC654\uC2B5\uB2C8\uB2E4.\r\n\r\n\uB0B4
      \uC774\uB984\uC774 \uC801\uD78C \uC7A5\uBE44 \uC0C1\uC790\uC640 \uC791\uC740
      \uAE08\uACE0\uB97C \uB098\uB780\uD788 \uB0B4\uB824\uB193\uB294\uB2E4.\r\n\r\n\uC5EC\uBE44\uAC00
      \uB354 \uD544\uC694\uD558\uC2DC\uBA74 \uAC70\uB798\uB97C \uBC14\uAFD4\uB3C4
      \uB429\uB2C8\uB2E4. \uB300\uC2E0 \uADF8\uB54C\uB294 \uAE30\uC220 \uD558\uB098\uB97C
      \uC81C \uAE30\uB85D\uC9C0\uC5D0 \uB0A8\uACA8 \uC8FC\uC154\uC57C \uD558\uACE0\uC694."
    source: Assets/Data/Dungeon/Events/Delivery.asset:narrative
  - key: data.randomeventdata.delivery.options.0.title
    kr: "\uB9E1\uACA8 \uB454 \uBB3C\uAC74\uC744 \uBC1B\uB294\uB2E4"
    source: Assets/Data/Dungeon/Events/Delivery.asset:options.Array.data[0].title
  - key: data.randomeventdata.delivery.options.0.description
    kr: "\uACF5\uC6A9 \uC720\uBB3C \uD558\uB098 \uC120\uD0DD, \uACE8\uB4DC +45."
    source: Assets/Data/Dungeon/Events/Delivery.asset:options.Array.data[0].description
  - key: data.randomeventdata.delivery.options.1.title
    kr: "\uC7A5\uBE44 \uB300\uC2E0 \uC5EC\uBE44\uB97C \uBC1B\uB294\uB2E4"
    source: Assets/Data/Dungeon/Events/Delivery.asset:options.Array.data[1].title
  - key: data.randomeventdata.delivery.options.1.description
    kr: "\uBCF4\uC720 \uB2A5\uB825 \uD558\uB098 \uC81C\uAC70. \uACE8\uB4DC +100."
    source: Assets/Data/Dungeon/Events/Delivery.asset:options.Array.data[1].description
  - key: data.randomeventdata.forge.displayname
    kr: "\uB0A0\uC774 \uC544\uB2C8\uB77C \uBC84\uB987\uC744 \uAC04\uB2E4"
    source: Assets/Data/Dungeon/Events/Forge.asset:displayName
  - key: data.randomeventdata.forge.narrative
    kr: "\uBB34\uAE30 \uC815\uBE44\uC2E4\uC5D0\uC11C \uB9DD\uCE58 \uC18C\uB9AC\uAC00
      \uB4E4\uB9B0\uB2E4.\r\n\r\n\uC7A5\uC778\uC774 \uB0B4 \uC7A5\uBE44\uB97C \uBCF4\uB354\uB2C8
      \uBC29\uD328\uC758 \uCC0C\uADF8\uB7EC\uC9C4 \uBD80\uBD84\uC744 \uAC00\uB9AC\uD0A8\uB2E4.\r\n\r\n\uADF8\uAC74
      \uAE08\uBC29 \uD3B4\uC9C0\uC9C0. \uC2F8\uC6B0\uB294 \uC790\uC138\uB3C4 \uBD10
      \uC904 \uC218 \uC788\uACE0."
    source: Assets/Data/Dungeon/Events/Forge.asset:narrative
  - key: data.randomeventdata.forge.options.0.title
    kr: "\uC775\uC219\uD55C \uAE30\uC220\uC744 \uBCBC\uB9B0\uB2E4"
    source: Assets/Data/Dungeon/Events/Forge.asset:options.Array.data[0].title
  - key: data.randomeventdata.forge.options.0.description
    kr: "30\uACE8\uB4DC \uC18C\uBAA8. \uBCF4\uC720 \uB2A5\uB825 \uD558\uB098\uB97C
      \uAC15\uD654."
    source: Assets/Data/Dungeon/Events/Forge.asset:options.Array.data[0].description
  - key: data.randomeventdata.forge.options.1.title
    kr: "\uD558\uB098\uB97C \uBC84\uB9AC\uACE0 \uB450 \uAC1C\uB97C \uBC30\uC6B4\uB2E4"
    source: Assets/Data/Dungeon/Events/Forge.asset:options.Array.data[1].title
  - key: data.randomeventdata.forge.options.1.description
    kr: "\uBCF4\uC720 \uB2A5\uB825 \uD558\uB098 \uC81C\uAC70 \uD6C4 \uC0C8 \uB2A5\uB825
      \uB450 \uBC88 \uC120\uD0DD."
    source: Assets/Data/Dungeon/Events/Forge.asset:options.Array.data[1].description
  - key: data.randomeventdata.forge.options.2.title
    kr: "\uBC29\uD328\uC758 \uCC0C\uADF8\uB7EC\uC9C4 \uACF3\uB9CC \uD3B8\uB2E4"
    source: Assets/Data/Dungeon/Events/Forge.asset:options.Array.data[2].title
  - key: data.randomeventdata.forge.options.2.description
    kr: "\uCD5C\uB300 \uAC00\uB4DC\uAC8C\uC774\uC9C0 +3. \uB2A5\uB825\uC740 \uBC14\uB00C\uC9C0
      \uC54A\uB294\uB2E4."
    source: Assets/Data/Dungeon/Events/Forge.asset:options.Array.data[2].description
  - key: data.randomeventdata.hourglass.displayname
    kr: "\uB0B4\uC77C\uC758 \uD55C\uC228"
    source: Assets/Data/Dungeon/Events/Hourglass.asset:displayName
  - key: data.randomeventdata.hourglass.narrative
    kr: "\uAE30\uB85D\uC2E4 \uCC45\uC0C1 \uC704\uC5D0\uC11C \uBAA8\uB798\uAC00 \uAC70\uAFB8\uB85C
      \uD750\uB974\uACE0 \uC788\uB2E4.\r\n\r\n\uC606\uC5D0 \uB193\uC778 \uAE30\uB85D\uC5D0\uB294
      \uC774 \uBAA8\uB798\uC2DC\uACC4\uB85C \uC2DC\uAC04\uC744 \uBE4C\uB9B4 \uC218
      \uC788\uB2E4\uACE0 \uC801\uD600 \uC788\uB2E4."
    source: Assets/Data/Dungeon/Events/Hourglass.asset:narrative
  - key: data.randomeventdata.hourglass.options.0.title
    kr: "\uB0B4\uC77C\uC744 \uC870\uAE08 \uC798\uB77C \uB0B8\uB2E4"
    source: Assets/Data/Dungeon/Events/Hourglass.asset:options.Array.data[0].title
  - key: data.randomeventdata.hourglass.options.0.description
    kr: "\uCD5C\uB300 \uCCB4\uB825 -8. \uAE68\uC5B4\uC9C4 \uBAA8\uB798\uC2DC\uACC4:
      \uCC28\uC9C0 \uC900\uBE44\uC2DC\uAC04\uACFC \uC8FC\uBB38 \uCFE8\uD0C0\uC784
      -12%."
    source: Assets/Data/Dungeon/Events/Hourglass.asset:options.Array.data[0].description
  - key: data.randomeventdata.hourglass.options.1.title
    kr: "\uC624\uB798\uB41C \uB3D9\uC791\uC744 \uBC84\uB9AC\uACE0 \uB2E4\uC2DC \uC775\uD78C\uB2E4"
    source: Assets/Data/Dungeon/Events/Hourglass.asset:options.Array.data[1].title
  - key: data.randomeventdata.hourglass.options.1.description
    kr: "\uBCF4\uC720 \uB2A5\uB825 \uD558\uB098 \uC81C\uAC70 \uD6C4 \uC0C8 \uB2A5\uB825\uC744
      \uB450 \uBC88 \uC120\uD0DD\uD55C\uB2E4."
    source: Assets/Data/Dungeon/Events/Hourglass.asset:options.Array.data[1].description
  - key: data.randomeventdata.investment.displayname
    kr: "\uBC30\uB2EC\uC9C0\uB294 \uB2E4\uC74C \uB9C9"
    source: Assets/Data/Dungeon/Events/Investment.asset:displayName
  - key: data.randomeventdata.investment.narrative
    kr: "\uC6B4\uBC18 \uACC4\uB2E8 \uC55E\uC5D0\uC11C \uC9D0\uAFBC\uC774 \uC0C1\uC790\uB4E4\uC744
      \uBB36\uACE0 \uC788\uB2E4.\r\n\r\n\uB354 \uAE4A\uC774 \uB0B4\uB824\uAC00\uC2DC\uB294
      \uAC81\uB2C8\uAE4C? \uC800\uB294 \uC9D0\uC744 \uB098\uB974\uB294 \uAE38\uC744
      \uC555\uB2C8\uB2E4.\r\n\r\n\uC608\uC57D\uAE08\uC744 \uB0B4\uBA74 \uB2E4\uC74C
      \uAD6C\uC5ED\uAE4C\uC9C0 \uC7A5\uBE44\uB97C \uAC00\uC838\uB2E4\uC8FC\uACA0\uB2E4\uACE0
      \uD55C\uB2E4.\r\n\r\n\uC9C0\uAE08 \uC57D\uC774 \uD544\uC694\uD558\uC2DC\uBA74
      \uC5EC\uAE30\uC11C \uB4DC\uB9B4 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4. \uB458
      \uC911 \uBB34\uC5C7\uC774 \uC88B\uC73C\uC138\uC694?"
    source: Assets/Data/Dungeon/Events/Investment.asset:narrative
  - key: data.randomeventdata.investment.options.0.title
    kr: "\uB3C4\uCC29\uD574\uC11C \uBC1B\uB294\uB2E4"
    source: Assets/Data/Dungeon/Events/Investment.asset:options.Array.data[0].title
  - key: data.randomeventdata.investment.options.0.description
    kr: "25\uACE8\uB4DC \uC18C\uBAA8. \uB2E4\uC74C \uB9C9\uC758 \uBC30\uB2EC \uC0AC\uAC74\uC5D0\uC11C
      \uC720\uBB3C\uACFC \uACE8\uB4DC \uC218\uB839."
    source: Assets/Data/Dungeon/Events/Investment.asset:options.Array.data[0].description
  - key: data.randomeventdata.investment.options.1.title
    kr: "\uC9C0\uAE08 \uC4F8 \uC57D\uC744 \uBC1B\uB294\uB2E4"
    source: Assets/Data/Dungeon/Events/Investment.asset:options.Array.data[1].title
  - key: data.randomeventdata.investment.options.1.description
    kr: "\uD3EC\uC158 1\uAC1C. \uBC30\uB2EC \uC608\uC57D\uC740 \uD558\uC9C0 \uC54A\uB294\uB2E4."
    source: Assets/Data/Dungeon/Events/Investment.asset:options.Array.data[1].description
  - key: data.randomeventdata.lostbeliever.displayname
    kr: "\uADF8 \uB3CC\uC5D0 \uC801\uD78C \uC774\uB984"
    source: Assets/Data/Dungeon/Events/LostBeliever.asset:displayName
  - key: data.randomeventdata.lostbeliever.narrative
    kr: "\uC18C\uB144 \uD558\uB098\uAC00 \uBB34\uB108\uC9C4 \uD68C\uB791 \uC55E\uC5D0\uC11C
      \uC11C\uC131\uC774\uACE0 \uC788\uB2E4.\r\n\r\n\uC190\uC5D0 \uC954 \uB3CC\uC5D0\uB294
      \uC804\uC5D0 \uB9CC\uB09C \uC21C\uB840\uC790\uC758 \uC9D0\uC5D0\uC11C \uBCF8
      \uC774\uB984\uC774 \uC0C8\uACA8\uC838 \uC788\uB2E4.\r\n\r\n\uADF8 \uD45C\uC2DD,
      \uC544\uBC84\uC9C0\uC758 \uC720\uD488\uC744 \uAC00\uC838\uC624\uC2E0 \uBD84\uAED8
      \uBC1B\uC73C\uC168\uB098\uC694?"
    source: Assets/Data/Dungeon/Events/LostBeliever.asset:narrative
  - key: data.randomeventdata.lostbeliever.options.0.title
    kr: "\uC11C\uC57D\uC758 \uB3CC\uC744 \uB9DE\uCDB0 \uBCF8\uB2E4"
    source: Assets/Data/Dungeon/Events/LostBeliever.asset:options.Array.data[0].title
  - key: data.randomeventdata.lostbeliever.options.0.description
    kr: "\uAE38\uC7A1\uC774\uC758 \uB4F1\uBD88 \uD68D\uB4DD: \uCC28\uC9C0 \uC801\uC911\uACFC
      \uC8FC\uBB38 \uBC1C\uB3D9\uC5D0 \uD53C\uD574 6 \uCD94\uAC00."
    source: Assets/Data/Dungeon/Events/LostBeliever.asset:options.Array.data[0].description
  - key: data.randomeventdata.lostbeliever.options.1.title
    kr: "\uC704\uD5D8\uD55C \uC0DB\uAE38\uC744 \uD568\uAED8 \uAC77\uB294\uB2E4"
    source: Assets/Data/Dungeon/Events/LostBeliever.asset:options.Array.data[1].title
  - key: data.randomeventdata.lostbeliever.options.1.description
    kr: "\uCCB4\uB825 -18. \uAE38\uC7A1\uC774\uC758 \uB4F1\uBD88 \uD68D\uB4DD."
    source: Assets/Data/Dungeon/Events/LostBeliever.asset:options.Array.data[1].description
  - key: data.randomeventdata.mastertrial.displayname
    kr: "\uBB38\uC774 \uC774\uB984\uC744 \uD2C0\uB9AC\uAC8C \uBD80\uB978\uB2E4"
    source: Assets/Data/Dungeon/Events/MasterTrial.asset:displayName
  - key: data.randomeventdata.mastertrial.narrative
    kr: "\uB3CC\uBB38 \uC55E\uC744 \uC9C0\uB098\uC790 \uC870\uAC01\uB41C \uC785\uC774
      \uC6C0\uC9C1\uC778\uB2E4.\r\n\r\n\uB0B4 \uC774\uB984\uC774\uB2E4. \uD558\uC9C0\uB9CC
      \uD55C \uAE00\uC790\uAC00 \uD2C0\uB838\uB2E4."
    source: Assets/Data/Dungeon/Events/MasterTrial.asset:narrative
  - key: data.randomeventdata.mastertrial.options.0.title
    kr: "\uC815\uD655\uD788 \uAE30\uC5B5\uD558\uAC8C \uD574 \uC8FC\uC9C0"
    source: Assets/Data/Dungeon/Events/MasterTrial.asset:options.Array.data[0].title
  - key: data.randomeventdata.mastertrial.options.0.description
    kr: "\uC2EC\uCE35 \uC218\uD638\uC790\uC640 \uC804\uD22C. \uC2B9\uB9AC \uD6C4
      \uC804\uC6A9 \uC720\uBB3C \uD558\uB098 \uC120\uD0DD."
    source: Assets/Data/Dungeon/Events/MasterTrial.asset:options.Array.data[0].description
  - key: data.randomeventdata.mastertrial.options.1.title
    kr: "\uC0C8 \uC774\uB984\uC5D0 \uB9DE\uB294 \uAE30\uC220\uC744 \uBC30\uC6B4\uB2E4"
    source: Assets/Data/Dungeon/Events/MasterTrial.asset:options.Array.data[1].title
  - key: data.randomeventdata.mastertrial.options.1.description
    kr: "\uBCF4\uC720 \uB2A5\uB825 \uD558\uB098 \uC81C\uAC70 \uD6C4 \uC0C8 \uB2A5\uB825
      \uB450 \uBC88 \uC120\uD0DD."
    source: Assets/Data/Dungeon/Events/MasterTrial.asset:options.Array.data[1].description
  - key: data.randomeventdata.mirror.displayname
    kr: "\uAC70\uC6B8\uC774 \uBA3C\uC800 \uBCA4\uB2E4"
    source: Assets/Data/Dungeon/Events/Mirror.asset:displayName
  - key: data.randomeventdata.mirror.narrative
    kr: "\uC637\uBC29\uC758 \uCEE4\uB2E4\uB780 \uAC70\uC6B8\uC5D0 \uB0B4 \uBAA8\uC2B5\uC774
      \uBE44\uCE5C\uB2E4.\r\n\r\n\uB098\uB294 \uBA48\uCDB0 \uC130\uB294\uB370 \uAC70\uC6B8
      \uC18D\uC758 \uB098\uB294 \uC544\uC9C1 \uC6C0\uC9C1\uC774\uACE0 \uC788\uB2E4."
    source: Assets/Data/Dungeon/Events/Mirror.asset:narrative
  - key: data.randomeventdata.mirror.options.0.title
    kr: "\uD55C \uBC88 \uBCA0\uC774\uACE0 \uD55C \uC870\uAC01 \uCC59\uAE34\uB2E4"
    source: Assets/Data/Dungeon/Events/Mirror.asset:options.Array.data[0].title
  - key: data.randomeventdata.mirror.options.0.description
    kr: "\uCCB4\uB825 -16. \uAC70\uC6B8 \uC870\uAC01: \uB9E4 4\uBC88\uC9F8 \uBB34\uAE30
      \uC801\uC911\uC5D0 \uD53C\uD574 40% \uCD94\uAC00."
    source: Assets/Data/Dungeon/Events/Mirror.asset:options.Array.data[0].description
  - key: data.randomeventdata.mirror.options.1.title
    kr: "\uB0B4 \uB3D9\uC791\uC744 \uACE0\uCCD0 \uBC30\uC6B4\uB2E4"
    source: Assets/Data/Dungeon/Events/Mirror.asset:options.Array.data[1].title
  - key: data.randomeventdata.mirror.options.1.description
    kr: "\uBCF4\uC720 \uB2A5\uB825 \uD558\uB098\uB97C 1\uB2E8\uACC4 \uAC15\uD654\uD55C\uB2E4."
    source: Assets/Data/Dungeon/Events/Mirror.asset:options.Array.data[1].description
  - key: data.randomeventdata.pilgrim.displayname
    kr: "\uC9D0 \uD558\uB098\uB9CC \uBD80\uD0C1\uD558\uB124"
    source: Assets/Data/Dungeon/Events/Pilgrim.asset:displayName
  - key: data.randomeventdata.pilgrim.narrative
    kr: "\uC791\uC740 \uC608\uBC30\uC2E4\uC5D0\uC11C \uB178\uC778\uC774 \uB3CC\uB4E4\uC744
      \uC8FC\uC6CC \uB2F4\uACE0 \uC788\uB2E4.\r\n\r\n\uB0B4\uAC00 \uAD74\uB7EC\uC628
      \uB3CC \uD558\uB098\uB97C \uAC74\uB124\uC790 \uB178\uC778\uC774 \uC790\uB8E8\uB97C
      \uBC8C\uB824 \uBCF4\uC778\uB2E4.\r\n\r\n\uB3CC\uB9C8\uB2E4 \uC0AC\uB78C\uC758
      \uC774\uB984\uC774 \uC0C8\uACA8\uC838 \uC788\uB2E4.\r\n\r\n\uC5EC\uAE30\uC11C
      \uC8FD\uC740 \uC774\uB4E4\uC774\uB124. \uC720\uC871\uB4E4\uC5D0\uAC8C \uC774\uAC83\uB9CC\uC774\uB77C\uB3C4
      \uC804\uD574 \uC8FC\uB824\uB294 \uCC38\uC774\uC57C.\r\n\r\n\uC790\uB8E8\uAC00
      \uBB34\uAC70\uC6CC \uC9D0\uAFBC\uC744 \uAD6C\uD588\uB294\uB370, \uC5EC\uBE44\uAC00
      \uBAA8\uC790\uB77C \uB3CC\uC544\uAC00\uB824\uB358 \uC911\uC774\uB77C\uACE0
      \uD55C\uB2E4.\r\n\r\n\uC131\uC758 \uC61B \uC6B4\uBC18\uC6A9 \uACC4\uB2E8\uC744
      \uCC3E\uC73C\uBA74 \uAE38\uC744 \uC904\uC77C \uC218 \uC788\uC9C0\uB9CC, \uC785\uAD6C\uB97C
      \uCC3E\uC9C0 \uBABB\uD588\uB2E4\uB294 \uBAA8\uC591\uC774\uB2E4."
    source: Assets/Data/Dungeon/Events/Pilgrim.asset:narrative
  - key: data.randomeventdata.pilgrim.options.0.title
    kr: "\uC5EC\uBE44\uB97C \uBCF4\uD0E0\uB2E4"
    source: Assets/Data/Dungeon/Events/Pilgrim.asset:options.Array.data[0].title
  - key: data.randomeventdata.pilgrim.options.0.description
    kr: "25\uACE8\uB4DC \uC18C\uBAA8. \uC21C\uB840\uC790\uC758 \uC11C\uC57D \uD68D\uB4DD.
      \uAC00\uB4DC 3\uD68C\uB9C8\uB2E4 \uAC8C\uC774\uC9C0 +3. \uC778\uC5F0\uC744
      \uB0A8\uAE34\uB2E4."
    source: Assets/Data/Dungeon/Events/Pilgrim.asset:options.Array.data[0].description
  - key: data.randomeventdata.pilgrim.options.1.title
    kr: "\uC0D8\uC758 \uC704\uCE58\uB97C \uC11C\uB85C \uB098\uB208\uB2E4"
    source: Assets/Data/Dungeon/Events/Pilgrim.asset:options.Array.data[1].title
  - key: data.randomeventdata.pilgrim.options.1.description
    kr: "\uCCB4\uB825 12 \uD68C\uBCF5. \uC11C\uC57D\uC740 \uC5BB\uC9C0 \uC54A\uB294\uB2E4."
    source: Assets/Data/Dungeon/Events/Pilgrim.asset:options.Array.data[1].description
  - key: data.randomeventdata.pilgrim.options.2.title
    kr: "\uC598\uAC00 \uC9C0\uB984\uAE38\uC744 \uCC3E\uC744 \uAC70\uC57C"
    source: Assets/Data/Dungeon/Events/Pilgrim.asset:options.Array.data[2].title
  - key: data.randomeventdata.pilgrim.options.2.description
    kr: "\uAC15\uC544\uC9C0\uAC00 \uAE38\uC744 \uCC3E\uB294\uB2E4. \uC11C\uC57D \uD68D\uB4DD,
      \uCCB4\uB825 12 \uD68C\uBCF5, \uC778\uC5F0\uC744 \uB0A8\uAE34\uB2E4."
    source: Assets/Data/Dungeon/Events/Pilgrim.asset:options.Array.data[2].description
  - key: data.randomeventdata.scholar.displayname
    kr: "\uB05D\uAE4C\uC9C0 \uC77D\uB294 \uBC95"
    source: Assets/Data/Dungeon/Events/Scholar.asset:displayName
  - key: data.randomeventdata.scholar.narrative
    kr: "\uCC9C\uC7A5\uC5D0\uC11C \uBB3C\uC774 \uC0C8\uB294 \uC11C\uACE0\uC5D0 \uCC45
      \uD55C \uAD8C\uC774 \uB5A0 \uC788\uB2E4.\r\n\r\n\uB2E4\uB978 \uCC45\uB4E4\uC740
      \uBD88\uC5B4\uC11C \uCC22\uC5B4\uC84C\uB294\uB370, \uC774 \uCC45\uB9CC \uBA40\uCA61\uD558\uB2E4."
    source: Assets/Data/Dungeon/Events/Scholar.asset:narrative
  - key: data.randomeventdata.scholar.options.0.title
    kr: "\uC0C8 \uC601\uCC3D\uC5D0 \uD53C\uB85C \uBC11\uC904\uC744 \uAE0B\uB294\uB2E4"
    source: Assets/Data/Dungeon/Events/Scholar.asset:options.Array.data[0].title
  - key: data.randomeventdata.scholar.options.0.description
    kr: "\uCCB4\uB825 -9. \uC8FC\uBB38 \uD558\uB098 \uC120\uD0DD."
    source: Assets/Data/Dungeon/Events/Scholar.asset:options.Array.data[0].description
  - key: data.randomeventdata.scholar.options.1.title
    kr: "\uC774\uBBF8 \uC544\uB294 \uAD6C\uC808\uC744 \uB2E4\uC2DC \uC77D\uB294\uB2E4"
    source: Assets/Data/Dungeon/Events/Scholar.asset:options.Array.data[1].title
  - key: data.randomeventdata.scholar.options.1.description
    kr: "\uBCF4\uC720 \uB2A5\uB825 \uD558\uB098\uB97C \uAC15\uD654\uD55C\uB2E4."
    source: Assets/Data/Dungeon/Events/Scholar.asset:options.Array.data[1].description
  - key: data.randomeventdata.scholar.options.2.title
    kr: "\uC57D\uC81C\uBC95 \uD55C \uCABD\uC744 \uBCA0\uB080\uB2E4"
    source: Assets/Data/Dungeon/Events/Scholar.asset:options.Array.data[2].title
  - key: data.randomeventdata.scholar.options.2.description
    kr: "\uD3EC\uC158 1\uAC1C. \uD3EC\uC158\uC774 \uAC00\uB4DD\uD558\uBA74 \uCCB4\uB825
      8 \uD68C\uBCF5."
    source: Assets/Data/Dungeon/Events/Scholar.asset:options.Array.data[2].description
  - key: data.randomeventdata.shelter.displayname
    kr: "\uBD88\uCE68\uBC88\uC744 \uC815\uD558\uC790"
    source: Assets/Data/Dungeon/Events/Shelter.asset:displayName
  - key: data.randomeventdata.shelter.narrative
    kr: "\uBCF5\uB3C4 \uD55C\uCABD\uC5D0 \uBC84\uB824\uC9C4 \uACBD\uBE44\uC2E4\uC774
      \uC788\uB2E4.\r\n\r\n\uBB38\uC5D0\uB294 \uC548\uC5D0\uC11C \uAC78 \uC218 \uC788\uB294
      \uD2BC\uD2BC\uD55C \uBE57\uC7A5\uC774 \uB0A8\uC544 \uC788\uB2E4.\r\n\r\n\uB3CC\uB09C\uB85C
      \uC606\uC5D0\uB294 \uB9C8\uB978 \uC7A5\uC791\uC774 \uC313\uC5EC \uC788\uACE0,
      \uBCA4\uCE58\uC5D0\uB294 \uB0A1\uC740 \uB2F4\uC694\uAC00 \uB193\uC5EC \uC788\uB2E4.\r\n\r\n\uBB38\uC744
      \uB2EB\uACE0 \uBD88\uC744 \uD53C\uC6B0\uBA74 \uC7A0\uC2DC \uBAB8\uC744 \uC26C\uAC8C
      \uD560 \uC218 \uC788\uACA0\uB2E4."
    source: Assets/Data/Dungeon/Events/Shelter.asset:narrative
  - key: data.randomeventdata.shelter.options.0.title
    kr: "\uBD88\uC744 \uC9C0\uD0A4\uBA70 \uC270\uB2E4"
    source: Assets/Data/Dungeon/Events/Shelter.asset:options.Array.data[0].title
  - key: data.randomeventdata.shelter.options.0.description
    kr: "\uCCB4\uB825 24 \uD68C\uBCF5."
    source: Assets/Data/Dungeon/Events/Shelter.asset:options.Array.data[0].description
  - key: data.randomeventdata.shelter.options.1.title
    kr: "\uBC24\uC0C8 \uBAB8\uC744 \uB2E8\uB828\uD55C\uB2E4"
    source: Assets/Data/Dungeon/Events/Shelter.asset:options.Array.data[1].title
  - key: data.randomeventdata.shelter.options.1.description
    kr: "\uCD5C\uB300\xB7\uD604\uC7AC \uCCB4\uB825 +5."
    source: Assets/Data/Dungeon/Events/Shelter.asset:options.Array.data[1].description
  - key: data.randomeventdata.shelter.options.2.title
    kr: "\uB108 \uBA3C\uC800 \uC790. \uB2E4\uC74C\uC740 \uB0B4 \uCC28\uB840\uC57C"
    source: Assets/Data/Dungeon/Events/Shelter.asset:options.Array.data[2].title
  - key: data.randomeventdata.shelter.options.2.description
    kr: "\uAC15\uC544\uC9C0\uC640 \uBC88\uAC08\uC544 \uB9DD\uC744 \uBCF8\uB2E4. \uCCB4\uB825
      28 \uD68C\uBCF5, \uACE8\uB4DC +12."
    source: Assets/Data/Dungeon/Events/Shelter.asset:options.Array.data[2].description
  - key: data.randomeventdata.stormbottle.displayname
    kr: "\uBC88\uAC1C\uB97C \uD30C\uB294 \uD589\uC0C1"
    source: Assets/Data/Dungeon/Events/StormBottle.asset:displayName
  - key: data.randomeventdata.stormbottle.narrative
    kr: "\uBCF5\uB3C4 \uBCBD\uAC10\uC5D0\uC11C \uC791\uC740 \uCC9C\uB465\uC18C\uB9AC\uAC00
      \uB09C\uB2E4.\r\n\r\n\uD589\uC0C1\uC774 \uBD88\uBE5B\uC774 \uBC88\uCA4D\uC774\uB294
      \uBCD1\uC744 \uB4E4\uACE0 \uB098\uB97C \uBD80\uB978\uB2E4.\r\n\r\n\uBB34\uAE30\uC5D0
      \uC4F8 \uBC88\uAC1C \uD544\uC694\uD558\uC2ED\uB2C8\uAE4C? \uC601\uCC3D\uC744
      \uBAB0\uB77C\uB3C4 \uB429\uB2C8\uB2E4.\r\n\r\n\uBCD1\uC744 \uAE30\uC6B8\uC774\uC790
      \uBC88\uAC1C\uAC00 \uC720\uB9AC\uBCBD\uC744 \uB530\uB77C \uC6C0\uC9C1\uC778\uB2E4.\r\n\r\n\uC9C1\uC811
      \uC8FC\uBB38\uC744 \uC4F0\uACE0 \uC2F6\uC73C\uC2DC\uBA74 \uC606 \uCC45\uC744
      \uBCF4\uC138\uC694. \uBE48 \uBCD1\uC744 \uBAA8\uC544 \uC8FC\uC2DC\uBA74 \uD488\uC0AF\uB3C4
      \uB4DC\uB9AC\uACE0\uC694."
    source: Assets/Data/Dungeon/Events/StormBottle.asset:narrative
  - key: data.randomeventdata.stormbottle.options.0.title
    kr: "\uD3ED\uD48D \uD55C \uBCD1"
    source: Assets/Data/Dungeon/Events/StormBottle.asset:options.Array.data[0].title
  - key: data.randomeventdata.stormbottle.options.0.description
    kr: "45\uACE8\uB4DC \uC18C\uBAA8. \uCC28\uC9C0 \uC801\uC911\uC5D0 \uBC88\uAC1C
      \uD53C\uD574 8\uC744 \uB354\uD558\uB294 \uC720\uBB3C \uD68D\uB4DD."
    source: Assets/Data/Dungeon/Events/StormBottle.asset:options.Array.data[0].description
  - key: data.randomeventdata.stormbottle.options.1.title
    kr: "\uBC88\uAC1C\uB97C \uC77D\uB294 \uBC95"
    source: Assets/Data/Dungeon/Events/StormBottle.asset:options.Array.data[1].title
  - key: data.randomeventdata.stormbottle.options.1.description
    kr: "25\uACE8\uB4DC \uC18C\uBAA8. \uC8FC\uBB38 \uD558\uB098 \uC120\uD0DD."
    source: Assets/Data/Dungeon/Events/StormBottle.asset:options.Array.data[1].description
  - key: data.randomeventdata.stormbottle.options.2.title
    kr: "\uBE48 \uBCD1 \uC218\uAC70\uB97C \uB3D5\uB294\uB2E4"
    source: Assets/Data/Dungeon/Events/StormBottle.asset:options.Array.data[2].title
  - key: data.randomeventdata.stormbottle.options.2.description
    kr: "\uACE8\uB4DC +12. \uC720\uBB3C\uACFC \uC8FC\uBB38\uC740 \uC0AC\uC9C0 \uC54A\uB294\uB2E4."
    source: Assets/Data/Dungeon/Events/StormBottle.asset:options.Array.data[2].description
  - key: data.randomeventdata.straydog.displayname
    kr: "\uC816\uC740 \uBC1C\uC790\uAD6D"
    source: Assets/Data/Dungeon/Events/StrayDog.asset:displayName
  - key: data.randomeventdata.straydog.narrative
    kr: "\uAD6C\uC11D\uC5D0 \uB2E4\uCE5C \uAC15\uC544\uC9C0\uAC00 \uBD88\uC30D\uD55C
      \uB208\uC73C\uB85C \uB098\uB97C \uCCD0\uB2E4\uBCF4\uACE0 \uC788\uB2E4.\r\n\r\n\uAC15\uC544\uC9C0\uB294
      \uAD76\uACE0 \uC788\uC9C0\uB9CC \uBAA9\uC904 \uB54C\uBB38\uC5D0 \uC6C0\uC9C1\uC77C
      \uC218 \uC5C6\uC5B4 \uBCF4\uC778\uB2E4.\r\n\r\n\uBAA9\uC904\uC744 \uD480\uC5B4
      \uC904\uAE4C?"
    source: Assets/Data/Dungeon/Events/StrayDog.asset:narrative
  - key: data.randomeventdata.straydog.options.0.title
    kr: "\uB0B4 \uC57D\uC744 \uB098\uB208\uB2E4"
    source: Assets/Data/Dungeon/Events/StrayDog.asset:options.Array.data[0].title
  - key: data.randomeventdata.straydog.options.0.description
    kr: "\uD68C\uBCF5 \uD3EC\uC158 1\uAC1C \uC18C\uBAA8. \uAE38\uB3D9\uBB34 \uD569\uB958:
      4\uCD08\uB9C8\uB2E4 \uC57D\uD55C \uC801\uC744 \uD611\uACF5\uD55C\uB2E4."
    source: Assets/Data/Dungeon/Events/StrayDog.asset:options.Array.data[0].description
  - key: data.randomeventdata.straydog.options.1.title
    kr: "\uC2DD\uB7C9 \uD55C \uAFB8\uB7EC\uBBF8"
    source: Assets/Data/Dungeon/Events/StrayDog.asset:options.Array.data[1].title
  - key: data.randomeventdata.straydog.options.1.description
    kr: "35\uACE8\uB4DC \uC18C\uBAA8. \uAE38\uB3D9\uBB34\uAC00 \uD569\uB958\uD55C\uB2E4."
    source: Assets/Data/Dungeon/Events/StrayDog.asset:options.Array.data[1].description
  - key: data.randomeventdata.straydog.options.2.title
    kr: "\uAE38\uAC00\uC758 \uC57D\uCD08\uB85C \uAC10\uC2F8 \uC900\uB2E4"
    source: Assets/Data/Dungeon/Events/StrayDog.asset:options.Array.data[2].title
  - key: data.randomeventdata.straydog.options.2.description
    kr: "\uAC15\uC544\uC9C0\uB294 \uC548\uC804\uD55C \uC57C\uC601\uC9C0\uC5D0 \uB0A8\uB294\uB2E4.
      \uB0A8\uC740 \uC57D\uCD08\uB85C \uB0B4 \uCCB4\uB825 8 \uD68C\uBCF5. \uB3D9\uB8CC\uB294
      \uC5BB\uC9C0 \uC54A\uB294\uB2E4."
    source: Assets/Data/Dungeon/Events/StrayDog.asset:options.Array.data[2].description
  - key: data.randomeventdata.symbiosis.displayname
    kr: "\uB450 \uBC88\uC9F8 \uB9E5\uBC15"
    source: Assets/Data/Dungeon/Events/Symbiosis.asset:displayName
  - key: data.randomeventdata.symbiosis.narrative
    kr: "\uC5F0\uAE08\uC220\uC2E4 \uC2E4\uD5D8\uB300\uC5D0 \uBFCC\uB9AC\uAC00 \uB3CB\uC740
      \uC528\uC557\uC774 \uB193\uC5EC \uC788\uB2E4.\r\n\r\n\uC606\uC758 \uAE30\uB85D\uC5D0\uB294
      \uC219\uC8FC\uC758 \uC0DD\uBA85\uB825\uC744 \uBA39\uACE0 \uADFC\uC721\uC744
      \uAC15\uD654\uD558\uB294 \uC2DD\uBB3C\uC774\uB77C\uACE0 \uC801\uD600 \uC788\uB2E4.\r\n\r\n\uBFCC\uB9AC\uB97C
      \uD0DC\uC6B4 \uC5F0\uAE30\uB294 \uAE30\uC5B5\uC744 \uD750\uB9AC\uAC8C \uD558\uACE0,
      \uAECD\uC9C8\uC740 \uC0C1\uCC98\uC5D0 \uC4F0\uB294 \uC57D\uC7AC\uB77C\uACE0
      \uD55C\uB2E4.\r\n\r\n\uC190\uC744 \uAC00\uAE4C\uC774 \uB300\uC790 \uBFCC\uB9AC\uAC00
      \uB0B4 \uC190\uBAA9\uC744 \uD5A5\uD574 \uC6C0\uC9C1\uC778\uB2E4."
    source: Assets/Data/Dungeon/Events/Symbiosis.asset:narrative
  - key: data.randomeventdata.symbiosis.options.0.title
    kr: "\uBFCC\uB9AC\uB0B4\uB9B4 \uC790\uB9AC\uB97C \uC900\uB2E4"
    source: Assets/Data/Dungeon/Events/Symbiosis.asset:options.Array.data[0].title
  - key: data.randomeventdata.symbiosis.options.0.description
    kr: "\uCD5C\uB300 \uCCB4\uB825 -12. \uACF5\uC0DD\uD558\uB294 \uC528\uC557: \uC77C\uBC18
      \uBB34\uAE30 \uD53C\uD574 +25%, \uCC28\uC9C0 \uD53C\uD574 +20%."
    source: Assets/Data/Dungeon/Events/Symbiosis.asset:options.Array.data[0].description
  - key: data.randomeventdata.symbiosis.options.1.title
    kr: "\uBFCC\uB9AC\uC640 \uD568\uAED8 \uBC84\uB987 \uD558\uB098\uB97C \uD0DC\uC6B4\uB2E4"
    source: Assets/Data/Dungeon/Events/Symbiosis.asset:options.Array.data[1].title
  - key: data.randomeventdata.symbiosis.options.1.description
    kr: "\uBCF4\uC720 \uB2A5\uB825 \uD558\uB098 \uC81C\uAC70 \uD6C4 \uC0C8 \uB2A5\uB825\uC744
      \uC120\uD0DD\uD55C\uB2E4."
    source: Assets/Data/Dungeon/Events/Symbiosis.asset:options.Array.data[1].description
  - key: data.randomeventdata.tooth.displayname
    kr: "\uAE08\uBE5B \uC774\uBE68\uC758 \uB0B4\uAE30"
    source: Assets/Data/Dungeon/Events/Tooth.asset:displayName
  - key: data.randomeventdata.tooth.narrative
    kr: "\uC61B \uC720\uD76C\uC2E4\uC5D0\uC11C \uAE08\uB2C8\uC758 \uC0C1\uC778\uC774
      \uB098\uB97C \uC54C\uC544\uBCF4\uACE0 \uC790\uB9AC\uB97C \uAD8C\uD55C\uB2E4.\r\n\r\n\uC544\uC9C1
      \uC0B4\uC544 \uACC4\uC168\uAD70\uC694. \uC774\uBC88\uC5D0\uB294 \uC0B4\uC544
      \uB3CC\uC544\uC624\uC2DC\uB294 \uCABD\uC5D0 \uAC78\uACA0\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC0C1\uC778\uC774
      \uC7A5\uBD80\uC5D0 \uB0B4 \uC774\uB984\uC744 \uC801\uACE0, \uB3C8\uC744 \uBCF4\uD0DC\uBA74
      \uC2B9\uB9AC\uD560 \uB54C\uB9C8\uB2E4 \uBC30\uB2F9\uC744 \uC8FC\uACA0\uB2E4\uACE0
      \uD55C\uB2E4."
    source: Assets/Data/Dungeon/Events/Tooth.asset:narrative
  - key: data.randomeventdata.tooth.options.0.title
    kr: "\uB0B4 \uB3C8\uB3C4 \uAC74\uB2E4"
    source: Assets/Data/Dungeon/Events/Tooth.asset:options.Array.data[0].title
  - key: data.randomeventdata.tooth.options.0.description
    kr: "40\uACE8\uB4DC \uC18C\uBAA8. \uAE08\uBE5B \uC774\uBE68: \uC804\uD22C \uC2B9\uB9AC\uB9C8\uB2E4
      \uACE8\uB4DC +10."
    source: Assets/Data/Dungeon/Events/Tooth.asset:options.Array.data[0].description
  - key: data.randomeventdata.tooth.options.1.title
    kr: "\uB0B4\uAC00 \uC774\uAE30\uB294\uC9C0 \uC9C1\uC811 \uBCF4\uC2DC\uC9C0"
    source: Assets/Data/Dungeon/Events/Tooth.asset:options.Array.data[1].title
  - key: data.randomeventdata.tooth.options.1.description
    kr: "\uCCB4\uB825 -8. \uACE8\uB4DC +65. \uC720\uBB3C\uC740 \uC5BB\uC9C0 \uC54A\uB294\uB2E4."
    source: Assets/Data/Dungeon/Events/Tooth.asset:options.Array.data[1].description
  - key: data.randomeventdata.training.displayname
    kr: "\uC624\uB298\uC758 \uC0C1\uB300\uB97C \uACE0\uB974\uC2DC\uC624"
    source: Assets/Data/Dungeon/Events/Training.asset:displayName
  - key: data.randomeventdata.training.narrative
    kr: "\uD6C8\uB828\uC7A5\uC5D0 \uB4E4\uC5B4\uC11C\uC790 \uB098\uBB34 \uC778\uD615
      \uC138 \uAC1C\uAC00 \uB3D9\uC2DC\uC5D0 \uACE0\uAC1C\uB97C \uB3CC\uB9B0\uB2E4.\r\n\r\n\uCCAB\uC9F8\uB294
      \uB048, \uB458\uC9F8\uB294 \uCCA0\uC0AC, \uC14B\uC9F8\uB294 \uAD75\uC740 \uC0AC\uC2AC\uB85C
      \uBB36\uC5EC \uC788\uB2E4.\r\n\r\n\uBCBD\uC758 \uC548\uB0B4\uD310\uC5D0\uB294
      \uAC01 \uC778\uD615\uC758 \uC704\uD5D8\uB3C4\uC640 \uBCF4\uC0C1\uC774 \uC801\uD600
      \uC788\uB2E4.\r\n\r\n\uB3C4\uC804\uD560 \uC0C1\uB300\uC758 \uAD6C\uC18D\uC744
      \uD480\uC5B4 \uC8FC\uC2ED\uC2DC\uC624."
    source: Assets/Data/Dungeon/Events/Training.asset:narrative
  - key: data.randomeventdata.training.options.0.title
    kr: "\uB048\uC744 \uD47C\uB2E4"
    source: Assets/Data/Dungeon/Events/Training.asset:options.Array.data[0].title
  - key: data.randomeventdata.training.options.0.description
    kr: "\uC5F0\uC2B5 \uC778\uD615 \uCCB4\uB825 75. \uC2B9\uB9AC \uD6C4 \uD3EC\uC158
      1\uAC1C. \uD3EC\uC158\uC774 \uAC00\uB4DD\uD558\uBA74 \uCCB4\uB825 8 \uD68C\uBCF5."
    source: Assets/Data/Dungeon/Events/Training.asset:options.Array.data[0].description
  - key: data.randomeventdata.training.options.1.title
    kr: "\uCCA0\uC0AC\uB97C \uB04A\uB294\uB2E4"
    source: Assets/Data/Dungeon/Events/Training.asset:options.Array.data[1].title
  - key: data.randomeventdata.training.options.1.description
    kr: "\uC5F0\uC2B5 \uC778\uD615 \uCCB4\uB825 140. \uC2B9\uB9AC \uD6C4 \uBCF4\uC720
      \uB2A5\uB825\uC744 \uB450 \uBC88 \uAC15\uD654."
    source: Assets/Data/Dungeon/Events/Training.asset:options.Array.data[1].description
  - key: data.randomeventdata.training.options.2.title
    kr: "\uC0AC\uC2AC\uC744 \uD47C\uB2E4"
    source: Assets/Data/Dungeon/Events/Training.asset:options.Array.data[2].title
  - key: data.randomeventdata.training.options.2.description
    kr: "\uC5F0\uC2B5 \uC778\uD615 \uCCB4\uB825 240. \uC2B9\uB9AC \uD6C4 \uACF5\uC6A9
      \uC720\uBB3C \uD558\uB098 \uC120\uD0DD."
    source: Assets/Data/Dungeon/Events/Training.asset:options.Array.data[2].description
  - key: data.randomeventdata.well.displayname
    kr: "\uBC11\uBC14\uB2E5\uC758 \uAE08\uACE0"
    source: Assets/Data/Dungeon/Events/Well.asset:displayName
  - key: data.randomeventdata.well.narrative
    kr: "\uC9C0\uD558 \uC6B0\uBB3C\uBC29\uC5D0 \uB3C8\uC8FC\uBA38\uB2C8\uB97C \uB9E4\uB2E8
      \uBC27\uC904\uC774 \uAC78\uB824 \uC788\uB2E4.\r\n\r\n\uC6B0\uBB3C \uC911\uAC04
      \uC120\uBC18\uC5D0 \uC791\uC740 \uC8FC\uBA38\uB2C8\uAC00 \uC788\uACE0, \uB354
      \uC544\uB798\uC5D0\uB294 \uCEE4\uB2E4\uB780 \uAE08\uACE0\uAC00 \uBCF4\uC778\uB2E4."
    source: Assets/Data/Dungeon/Events/Well.asset:narrative
  - key: data.randomeventdata.well.options.0.title
    kr: "\uC120\uBC18\uC758 \uC8FC\uBA38\uB2C8\uB9CC \uAC74\uC9C4\uB2E4"
    source: Assets/Data/Dungeon/Events/Well.asset:options.Array.data[0].title
  - key: data.randomeventdata.well.options.0.description
    kr: "\uACE8\uB4DC +30."
    source: Assets/Data/Dungeon/Events/Well.asset:options.Array.data[0].description
  - key: data.randomeventdata.well.options.1.title
    kr: "\uBC14\uB2E5\uC758 \uAE08\uACE0\uAE4C\uC9C0 \uB04C\uC5B4 \uC62C\uB9B0\uB2E4"
    source: Assets/Data/Dungeon/Events/Well.asset:options.Array.data[1].title
  - key: data.randomeventdata.well.options.1.description
    kr: "\uACE8\uB4DC +150. \uC800\uC8FC \uC720\uBB3C \uD68D\uB4DD: \uCD5C\uB300
      \uAC00\uB4DC\uAC8C\uC774\uC9C0 -8."
