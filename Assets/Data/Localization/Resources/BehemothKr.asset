    source: Assets/Data/Behemoth/Relics/ShelterMaster.asset:description
  - key: data.equipmentdata.shieldbash.displayname
    kr: "\uC2E0\uC131\uAC80\uC758 \uC11C\uC57D"
    source: Assets/Data/Behemoth/Relics/ShieldBash.asset:displayName
  - key: data.equipmentdata.shieldbash.description
    kr: "\uAC00\uB4DC\uB85C \uC18C\uBAA8\uD55C \uAC8C\uC774\uC9C0\uC758 50%\uB97C
      \uC800\uC7A5\uD558\uC5EC \uB2E4\uC74C \uBB34\uAE30 \uC801\uC911\uC5D0 \uB354\uD55C\uB2E4."
    source: Assets/Data/Behemoth/Relics/ShieldBash.asset:description
  - key: data.equipmentdata.shieldedge.displayname
    kr: "\uBC29\uD328\uC758 \uCE7C\uB0A0"
    source: Assets/Data/Behemoth/Relics/ShieldEdge.asset:displayName
  - key: data.equipmentdata.shieldedge.description
    kr: "\uBB34\uAE30 \uC801\uC911\uC5D0 \uD604\uC7AC \uAC00\uB4DC\uAC8C\uC774\uC9C0\uC758
      15%\uB97C \uCD94\uAC00\uD55C\uB2E4."
    source: Assets/Data/Behemoth/Relics/ShieldEdge.asset:description
  - key: data.equipmentdata.spear.displayname
    kr: "\uCC9C\uACF5\uCC3D"
    source: Assets/Data/Behemoth/Relics/Spear.asset:displayName
  - key: data.equipmentdata.spear.description
    kr: "\uC62C\uB824\uCE58\uAE30 \uD53C\uD574 +35%, \uACF5\uACA9 \uCFE8\uD0C0\uC784
      -50%. \uB2E4\uB978 \uBC29\uD5A5 \uD53C\uD574 -20%, \uACF5\uACA9 \uCFE8\uD0C0\uC784
      +25%."
    source: Assets/Data/Behemoth/Relics/Spear.asset:description
  - key: data.equipmentdata.spellblade.displayname
    kr: "\uC8FC\uBB38\uAC80"
    source: Assets/Data/Behemoth/Relics/SpellBlade.asset:displayName
  - key: data.equipmentdata.spellblade.description
    kr: "\uC5D0\uB108\uC9C0 \uBCFC\uD2B8 \uC2B5\uB4DD. \uB0A9\uB3C4 \uC911 \uCE90\uC2A4\uD305
      \uC2DC\uAC04 -25%. \uC8FC\uBB38 \uBC1C\uB3D9 \uD6C4 \uB2E4\uC74C \uBC1C\uB3C4
      \uD53C\uD574 +40%."
    source: Assets/Data/Behemoth/Relics/SpellBlade.asset:description
  - key: data.equipmentdata.spellecho.displayname
    kr: "\uC8FC\uBB38\uC758 \uC794\uD5A5"
    source: Assets/Data/Behemoth/Relics/SpellEcho.asset:displayName
  - key: data.equipmentdata.spellecho.description
    kr: "\uC138 \uBC88\uC9F8 \uC8FC\uBB38\uB9C8\uB2E4 0.22\uCD08 \uD6C4 \uAC19\uC740
      \uC8FC\uBB38\uC744 50% \uD53C\uD574\uB85C \uD55C \uBC88 \uB354 \uBC1C\uB3D9\uD55C\uB2E4."
    source: Assets/Data/Behemoth/Relics/SpellEcho.asset:description
  - key: data.equipmentdata.staffconduit.displayname
    kr: "\uC9C0\uD321\uC774\uC640 \uC8FC\uBB38 \uC0AC\uC774"
    source: Assets/Data/Behemoth/Relics/StaffConduit.asset:displayName
  - key: data.equipmentdata.staffconduit.description
    kr: "\uC77C\uBC18 \uBB34\uAE30 \uD53C\uD574 +15%. \uC9C0\uD321\uC774 \uCC28\uC9C0
      \uC801\uC911 \uD6C4 \uB2E4\uC74C \uC8FC\uBB38\uC740 \uCE90\uC2A4\uD305 \uC2DC\uAC04
      -60%, \uD53C\uD574 +20%. \uC57D\uC810 \uD30C\uAD34 \uC2DC \uAC00\uB4DC\uAC8C\uC774\uC9C0
      +3."
    source: Assets/Data/Behemoth/Relics/StaffConduit.asset:description
  - key: data.equipmentdata.starter_barbarian.displayname
    kr: "\uACA9\uB178\uC758 \uC2EC\uC7A5"
    source: Assets/Data/Behemoth/Relics/Starter_Barbarian.asset:displayName
  - key: data.equipmentdata.starter_barbarian.description
    kr: "\uC77C\uBC18 \uACF5\uACA9 \uC2DC \uACA9\uB178 \uC911\uCCA9\uC744 12 \uC5BB\uC2B5\uB2C8\uB2E4.\n\uACA9\uB178
      40 \uC774\uC0C1\uC5D0\uC11C \uCC28\uC9C0\uD558\uBA74 \uBD84\uB178 \uC0C1\uD0DC
      \uC9C4\uC785.\n\uBD84\uB178 \uC911 \uBB34\uAE30 \uD53C\uD574 +30%, \uACF5\uACA9
      \uCFE8\uD0C0\uC784 -20%, \uBC1B\uB294 \uCCB4\uB825 \uD53C\uD574 -25%. \uCD08\uB2F9
      \uACA9\uB178 25 \uC18C\uBAA8."
    source: Assets/Data/Behemoth/Relics/Starter_Barbarian.asset:description
  - key: data.equipmentdata.starter_monk.displayname
    kr: "\uCD08\uC2DD\uC758 \uB450\uB8E8\uB9C8\uB9AC"
    source: Assets/Data/Behemoth/Relics/Starter_Monk.asset:displayName
  - key: data.equipmentdata.starter_monk.description
    kr: "\uC77C\uBC18 \uACF5\uACA9 \uBC29\uD5A5\uC5D0 \uB530\uB77C \uCD08\uC2DD\uC744
      \uC900\uBE44\uD569\uB2C8\uB2E4. \uD328\uD134\uC744 \uB9CC\uB4E0 \uD6C4, \uCC28\uC9C0
      \uACF5\uACA9\uC73C\uB85C \uCD08\uC2DD\uC744 \uB9C8\uBB34\uB9AC \uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4. \uCD08\uC2DD\uC744 \uB9C8\uBB34\uB9AC\uD558\uBA74
      \uC544\uB798\uC640 \uAC19\uC740 \uD6A8\uACFC\uB97C \uC5BB\uC2B5\uB2C8\uB2E4.\n\u2193\u2191
      \uBD95\uAD8C: 1.7\uBC30 \uCC28\uC9C0 \uD53C\uD574\n\u2190\u2192 \uBC31\uB82C\uAD8C:
      0.55\uBC30 \uCC28\uC9C0 3\uD68C \uD53C\uD574\n\u2193\u2192 \uD638\uC2E0\uACA9:
      \uAC00\uB4DC +5, \uB2E4\uC74C 1\uD68C\uC5D0 \uD55C\uD574 \uBC1B\uB294 \uD53C\uD574
      -50%.\n\u2192\u2191 \uC5F0\uD658: \uB2E4\uC74C \uC77C\uBC18\uACF5\uACA9 2\uD68C
      \uCFE8\uD0C0\uC784 -40%."
    source: Assets/Data/Behemoth/Relics/Starter_Monk.asset:description
  - key: data.equipmentdata.starter_rogue.displayname
    kr: "\uADF8\uB9BC\uC790 \uB9DD\uD1A0"
    source: Assets/Data/Behemoth/Relics/Starter_Rogue.asset:displayName
  - key: data.equipmentdata.starter_rogue.description
    kr: "\uC804\uD22C \uAC1C\uC2DC \uC2DC \uC740\uC2E0\uD558\uBA70, \uC801\uC774
      \uB208\uCE58\uCC44\uAE30 \uC804\uC5D0 \uBA3C\uC800 \uD589\uB3D9\uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4. \uAC01 \uD589\uB3D9 \uB9C8\uB2E4 25% \uD655\uB960\uB85C
      \uBC1C\uAC01\uB429\uB2C8\uB2E4. \uC801\uC774 \uACF5\uACA9\uBC1B\uC73C\uBA74
      \uC989\uC2DC \uBC1C\uAC01\uB429\uB2C8\uB2E4."
    source: Assets/Data/Behemoth/Relics/Starter_Rogue.asset:description
  - key: data.equipmentdata.starter_samurai.displayname
    kr: "\uACE0\uC694\uD55C \uCE7C\uC9D1"
    source: Assets/Data/Behemoth/Relics/Starter_Samurai.asset:displayName
  - key: data.equipmentdata.starter_samurai.description
    kr: "\uAC00\uB4DC \uC9C4\uC785 \uC2DC \uB0A9\uB3C4. \uB0A9\uB3C4 \uD328\uB9AC
      0.1\uCD08. \uB2E4\uC74C \uBC1C\uB3C4 \uD53C\uD574 +50%. \uB0A9\uB3C4 \uD328\uB9AC
      \uC131\uACF5 \uC2DC \uB2E4\uC74C \uBC1C\uB3C4\uAC00 \uCC28\uC9C0 \uD310\uC815\uC744
      \uC5BB\uB294\uB2E4."
    source: Assets/Data/Behemoth/Relics/Starter_Samurai.asset:description
  - key: data.equipmentdata.starter_warrior.displayname
    kr: "\uC218\uD638\uC790\uC758 \uBC29\uD328"
    source: Assets/Data/Behemoth/Relics/Starter_Warrior.asset:displayName
  - key: data.equipmentdata.starter_warrior.description
    kr: "\uC804\uD22C \uC911 \uAC00\uB4DC\uAC8C\uC774\uC9C0\uAC00 \uCD08\uB2F9 2.5
      \uD68C\uBCF5\uB429\uB2C8\uB2E4."
    source: Assets/Data/Behemoth/Relics/Starter_Warrior.asset:description
  - key: data.equipmentdata.starter_wizard.displayname
    kr: "\uC9D1\uC911\uC758 \uC218\uC815"
    source: Assets/Data/Behemoth/Relics/Starter_Wizard.asset:displayName
  - key: data.equipmentdata.starter_wizard.description
    kr: "\uC5D0\uB108\uC9C0 \uBCFC\uD2B8\uB97C \uAC00\uC9C0\uACE0 \uAC8C\uC784\uC744
      \uC2DC\uC791\uD569\uB2C8\uB2E4.\n\uC8FC\uBB38 \uCFE8\uD0C0\uC784 -25%"
    source: Assets/Data/Behemoth/Relics/Starter_Wizard.asset:description
  - key: data.equipmentdata.stormbottle.displayname
    kr: "\uBCD1 \uC18D\uC758 \uD3ED\uD48D"
    source: Assets/Data/Behemoth/Relics/StormBottle.asset:displayName
  - key: data.equipmentdata.stormbottle.description
    kr: "\uCC28\uC9C0 \uC801\uC911 \uC2DC \uBC88\uAC1C \uD53C\uD574 8 \uCD94\uAC00."
    source: Assets/Data/Behemoth/Relics/StormBottle.asset:description
  - key: data.equipmentdata.straydog.displayname
    kr: "\uC791\uC740 \uBC1C\uC790\uAD6D"
    source: Assets/Data/Behemoth/Relics/StrayDog.asset:displayName
  - key: data.equipmentdata.straydog.description
    kr: "\uAC15\uC544\uC9C0\uAC00 \uACC1\uC5D0\uC11C \uB3D9\uD589\uD55C\uB2E4. 4\uCD08\uB9C8\uB2E4
      \uCCB4\uB825\uC774 \uAC00\uC7A5 \uB0AE\uC740 \uC801\uC5D0\uAC8C 7 + \uD604\uC7AC
      \uB808\uBCA8\uB9CC\uD07C \uD53C\uD574."
    source: Assets/Data/Behemoth/Relics/StrayDog.asset:description
  - key: data.equipmentdata.thunderouscharge.displayname
    kr: "\uB1CC\uC131\uC758 \uB300\uAC80"
    source: Assets/Data/Behemoth/Relics/ThunderousCharge.asset:displayName
  - key: data.equipmentdata.thunderouscharge.description
    kr: "\uC2A4\uD30C\uD06C \uC2B5\uB4DD. \uCC28\uC9C0 \uC801\uC911 \uC2DC \uBC88\uAC1C
      \uD53C\uD574 8 \uCD94\uAC00. \uBC88\uAC1C \uC8FC\uBB38 \uBC1C\uB3D9 \uC2DC
      \uAC00\uB4DC\uAC8C\uC774\uC9C0 +2."
    source: Assets/Data/Behemoth/Relics/ThunderousCharge.asset:description
  - key: data.equipmentdata.tome_chainlightning.displayname
    kr: "\uC5F0\uC1C4 \uBC88\uAC1C\uC758 \uB9C8\uB3C4\uC11C"
    source: Assets/Data/Behemoth/Relics/Tome_ChainLightning.asset:displayName
  - key: data.equipmentdata.tome_chainlightning.description
    kr: "\uD68D\uB4DD \uC989\uC2DC \uC8FC\uBB38 \uC2B5\uB4DD. \uBB34\uC791\uC704
      \uB300\uC0C1\uC5D0\uC11C \uAC00\uAE4C\uC6B4 \uC801\uC73C\uB85C \uCD5C\uB300
      3\uD68C \uC5F0\uACB0\uD55C\uB2E4. \uC0AC\uC120\uC774 \uB9DE\uC9C0 \uC54A\uC544\uB3C4
      \uC5EC\uB7EC \uC801\uC744 \uACF5\uACA9\uD55C\uB2E4."
    source: Assets/Data/Behemoth/Relics/Tome_ChainLightning.asset:description
  - key: data.equipmentdata.tome_ember.displayname
    kr: "\uC7BF\uBD88 \uD654\uC0B4\uC758 \uB9C8\uB3C4\uC11C"
    source: Assets/Data/Behemoth/Relics/Tome_Ember.asset:displayName
  - key: data.equipmentdata.tome_ember.description
    kr: "\uD68D\uB4DD \uC989\uC2DC \uC8FC\uBB38 \uC2B5\uB4DD. \uCCB4\uB825 \uBE44\uC728\uC774
      \uAC00\uC7A5 \uB0AE\uC740 \uC801\uC744 \uACA8\uB0E5\uD55C\uB2E4. \uBAA9\uD45C
      \uB108\uBA38\uC758 \uC801\uB3C4 \uAD00\uD1B5\uD55C\uB2E4."
    source: Assets/Data/Behemoth/Relics/Tome_Ember.asset:description
  - key: data.equipmentdata.tome_energybolt.displayname
    kr: "\uC5D0\uB108\uC9C0 \uBCFC\uD2B8\uC758 \uB9C8\uB3C4\uC11C"
    source: Assets/Data/Behemoth/Relics/Tome_EnergyBolt.asset:displayName
  - key: data.equipmentdata.tome_energybolt.description
    kr: "\uD68D\uB4DD \uC989\uC2DC \uC8FC\uBB38 \uC2B5\uB4DD. \uB9C8\uC9C0\uB9C9
      \uBB34\uAE30 \uC801\uC911 \uB300\uC0C1 \uC6B0\uC120. \uC9C0\uC815 \uB300\uC0C1\uC774
      \uC5C6\uC73C\uBA74 \uD604\uC7AC \uCCB4\uB825\uC774 \uAC00\uC7A5 \uB192\uC740
      \uC801\uC744 \uACA8\uB0E5\uD55C\uB2E4. \uAD00\uD1B5 \uACF5\uACA9."
    source: Assets/Data/Behemoth/Relics/Tome_EnergyBolt.asset:description
  - key: data.equipmentdata.tome_firebloom.displayname
    kr: "\uD654\uC5FC \uAC1C\uD654\uC758 \uB9C8\uB3C4\uC11C"
    source: Assets/Data/Behemoth/Relics/Tome_FireBloom.asset:displayName
  - key: data.equipmentdata.tome_firebloom.description
    kr: "\uD68D\uB4DD \uC989\uC2DC \uC8FC\uBB38 \uC2B5\uB4DD. \uCCB4\uB825 \uBE44\uC728\uC774
      \uAC00\uC7A5 \uB0AE\uC740 \uC801 \uC8FC\uC704\uC5D0 \uD3ED\uBC1C\uD55C\uB2E4.
      \uBC18\uACBD \uC548\uC758 \uC801\uC744 \uD568\uAED8 \uACF5\uACA9\uD55C\uB2E4."
    source: Assets/Data/Behemoth/Relics/Tome_FireBloom.asset:description
  - key: data.equipmentdata.tome_frostring.displayname
    kr: "\uC11C\uB9AC \uD30C\uB3D9\uC758 \uB9C8\uB3C4\uC11C"
    source: Assets/Data/Behemoth/Relics/Tome_FrostRing.asset:displayName
  - key: data.equipmentdata.tome_frostring.description
    kr: "\uD68D\uB4DD \uC989\uC2DC \uC8FC\uBB38 \uC2B5\uB4DD. \uB9C8\uC9C0\uB9C9
      \uBB34\uAE30 \uC801\uC911 \uB300\uC0C1 \uC8FC\uC704\uC5D0 \uC11C\uB9AC\uB97C
      \uD3BC\uCE5C\uB2E4. \uB9DE\uC740 \uC801\uC758 \uD589\uB3D9\uC774 3\uCD08\uAC04
      \uB290\uB824\uC9C4\uB2E4."
    source: Assets/Data/Behemoth/Relics/Tome_FrostRing.asset:description
  - key: data.equipmentdata.tome_spark.displayname
    kr: "\uC2A4\uD30C\uD06C\uC758 \uB9C8\uB3C4\uC11C"
    source: Assets/Data/Behemoth/Relics/Tome_Spark.asset:displayName
  - key: data.equipmentdata.tome_spark.description
    kr: "\uD68D\uB4DD \uC989\uC2DC \uC8FC\uBB38 \uC2B5\uB4DD. \uBB34\uC791\uC704
      \uC801 \uD558\uB098\uB97C \uACA8\uB0E5\uD574 \uBC88\uAC1C\uB97C \uBED7\uB294\uB2E4.
      \uD53C\uB8B0\uCE68\uC774 \uC788\uC73C\uBA74 \uC6B0\uC120\uD55C\uB2E4. \uACBD\uB85C\uC758
      \uC801\uB3C4 \uC801\uC911\uD55C\uB2E4."
    source: Assets/Data/Behemoth/Relics/Tome_Spark.asset:description
  - key: data.equipmentdata.twindaggers.displayname
    kr: "\uC30D\uB2E8\uB3C4"
    source: Assets/Data/Behemoth/Relics/TwinDaggers.asset:displayName
  - key: data.equipmentdata.twindaggers.description
    kr: "\uC88C\xB7\uC6B0 \uC77C\uBC18\uACF5\uACA9\uC744 \uC5F0\uC18D\uD558\uBA74
      \uACF5\uACA9 \uCFE8\uD0C0\uC784\uC774 4%\uC529 \uAC10\uC18C, \uCD5C\uB300 40%.
      \uC0C1\xB7\uD558 \uACF5\uACA9\uC73C\uB85C \uCD08\uAE30\uD654."
    source: Assets/Data/Behemoth/Relics/TwinDaggers.asset:description
  - key: data.equipmentdata.unstoppable.displayname
    kr: "\uBC29\uC5B4 \uBD84\uC1C4"
    source: Assets/Data/Behemoth/Relics/Unstoppable.asset:displayName
  - key: data.equipmentdata.unstoppable.description
    kr: "\uCC28\uC9C0\uB294 \uBC29\uD5A5 \uBC29\uBCBD\uC744 \uBB34\uC2DC\uD55C\uB2E4.
      \uCC28\uC9C0 \uD53C\uD574 +20%."
    source: Assets/Data/Behemoth/Relics/Unstoppable.asset:description
  - key: data.equipmentdata.venomspread.displayname
    kr: "\uBC88\uC9C0\uB294 \uB9F9\uB3C5"
    source: Assets/Data/Behemoth/Relics/VenomSpread.asset:displayName
  - key: data.equipmentdata.venomspread.description
    kr: "\uCC98\uCE58\uD55C \uC801\uC758 \uB3C5 \uC808\uBC18\uC5D0 2\uC911\uCCA9\uC744
      \uB354\uD574 \uB2E4\uB978 \uC801\uC5D0\uAC8C \uC804\uD30C\uD55C\uB2E4. \uB3C5
      \uD53C\uD574\uB294 \uC911\uCCA9\uB2F9 1, \uCD5C\uB300 8\uC911\uCCA9."
    source: Assets/Data/Behemoth/Relics/VenomSpread.asset:description
  - key: data.equipmentdata.viperfang.displayname
    kr: "\uB3C5\uC0AC\uC758 \uC1A1\uACF3\uB2C8"
    source: Assets/Data/Behemoth/Relics/ViperFang.asset:displayName
  - key: data.equipmentdata.viperfang.description
    kr: "\uCC28\uC9C0 \uC801\uC911 \uC2DC \uB3C5\uC744 \uC804\uBD80 \uC18C\uBAA8\uD574
      \uB0A8\uC740 \uC911\uCCA9\uB2F9 \uB3C5 \uD53C\uD574\uC758 2\uBC30\uB97C \uC989\uC2DC
      \uC900\uB2E4."
    source: Assets/Data/Behemoth/Relics/ViperFang.asset:description
  - key: data.spelldata.chainlightning.displayname
    kr: "\uC5F0\uC1C4 \uBC88\uAC1C"
    source: Assets/Data/Behemoth/Spells/ChainLightning.asset:displayName
  - key: data.spelldata.chainlightning.description
    kr: "\uBB34\uC791\uC704 \uB300\uC0C1\uC5D0\uC11C \uAC00\uAE4C\uC6B4 \uC801\uC73C\uB85C
      \uCD5C\uB300 3\uD68C \uC5F0\uACB0\uD55C\uB2E4. \uC0AC\uC120\uC774 \uB9DE\uC9C0
      \uC54A\uC544\uB3C4 \uC5EC\uB7EC \uC801\uC744 \uACF5\uACA9\uD55C\uB2E4."
    source: Assets/Data/Behemoth/Spells/ChainLightning.asset:description
  - key: data.spelldata.ember.displayname
    kr: "\uC7BF\uBD88 \uD654\uC0B4"
    source: Assets/Data/Behemoth/Spells/Ember.asset:displayName
  - key: data.spelldata.ember.description
    kr: "\uCCB4\uB825 \uBE44\uC728\uC774 \uAC00\uC7A5 \uB0AE\uC740 \uC801\uC744 \uACA8\uB0E5\uD55C\uB2E4.
