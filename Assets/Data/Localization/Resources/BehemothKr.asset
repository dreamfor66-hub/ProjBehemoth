  - key: data.randomeventdata.magicteacherfirst.pages.3.options.2.resulttext
    kr: "\uADF8\uB807\uB2E4\uBA74 \uC774\uAC78 \uBC1B\uC73C\uC138\uC694. \uB2E4\uC74C\uC5D0\uB294
      \uB4A4\uB3C4 \uC880 \uBCF4\uBA74\uC11C \uB2E4\uB2C8\uACA0\uC2B5\uB2C8\uB2E4."
