  - key: data.randomeventdata.magicteacheradvanced.pages.1.options.1.resulttext
    kr: "\uADF8\uB300\uB85C \uC790\uB9AC\uB97C \uB5A0\uB0AC\uB2E4."
    source: Assets/Data/Dungeon/Events/MagicTeacherAdvanced.asset:pages.Array.data[1].options.Array.data[1].resultText
  - key: data.randomeventdata.magicteacheradvanced.pages.2.narrative
    kr: "\uC120\uC0DD\uC740 \uC758\uC2DD\uC2E4\uC758 \uB9C8\uBC95\uC9C4\uC744 \uB36E\uACE0
      \uAE30\uB85D\uC744 \uC815\uB9AC\uD558\uACE0 \uC788\uB2E4.\r\n\r\n\uC544\uC9C1
      \uD070 \uC8FC\uBB38\uC744 \uBC84\uD2F8 \uB9CC\uD07C \uB9C8\uB825\uC774 \uBAA8\uC774\uC9C0
      \uC54A\uC558\uAD70\uC694. \uC624\uB298\uC740 \uC131\uC758 \uAE30\uB85D\uC744
      \uC880 \uC77D\uACE0 \uAC00\uC138\uC694.\r\n\r\n\uD568\uAED8 \uC624\uB798\uB41C
      \uAE30\uB85D\uC744 \uC77D\uACE0 \uC758\uC2DD\uC2E4\uC744 \uB098\uC654\uB2E4."
    source: Assets/Data/Dungeon/Events/MagicTeacherAdvanced.asset:pages.Array.data[2].narrative
  - key: data.randomeventdata.magicteacheradvanced.pages.2.options.0.title
    kr: "\uB5A0\uB09C\uB2E4."
