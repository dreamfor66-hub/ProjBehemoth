  - key: data.randomeventdata.magicteacherreturn.pages.0.options.1.title
    kr: "\uB5A0\uB09C\uB2E4."
    source: Assets/Data/Dungeon/Events/MagicTeacherReturn.asset:pages.Array.data[0].options.Array.data[1].title
  - key: data.randomeventdata.magicteacherreturn.pages.0.options.1.description
    kr: 
    source: Assets/Data/Dungeon/Events/MagicTeacherReturn.asset:pages.Array.data[0].options.Array.data[1].description
  - key: data.randomeventdata.magicteacherreturn.pages.0.options.1.resulttext
    kr: "\uB178\uC778\uC5D0\uAC8C \uC131 \uC548\uC758 \uB9C9\uD78C \uD1B5\uB85C\uC640
      \uC61B \uAC15\uC758\uC2E4 \uC774\uC57C\uAE30\uB97C \uB4E4\uC5C8\uB2E4. \uD5E4\uC5B4\uC9C8
      \uB54C\uAE4C\uC9C0 \uC218\uC5C5 \uC774\uC57C\uAE30\uB294 \uB2E4\uC2DC \uB098\uC624\uC9C0
      \uC54A\uC558\uB2E4."
    source: Assets/Data/Dungeon/Events/MagicTeacherReturn.asset:pages.Array.data[0].options.Array.data[1].resultText
  - key: data.randomeventdata.magicteacherreturn.pages.1.narrative
    kr: "\uC791\uC740 \uBD88\uAF43\uC744 \uC775\uD614\uC73C\uB2C8, \uC774\uBC88\uC5D0\uB294
      \uBD88\uC774 \uD37C\uC9C0\uB294 \uBC29\uC2DD\uC744 \uBC30\uC6CC\uB3C4 \uB418\uACA0\uB124\uC694.\r\n\r\n\uB2E4\uB978
      \uC18D\uC131\uC774\uB098 \uBB34\uAE30\uC5D0 \uB9C8\uB825\uC744 \uC2E3\uB294
      \uCABD\uC774 \uAD81\uAE08\uD558\uBA74 \uADF8\uAC83\uB3C4 \uB9D0\uC500\uD558\uC2DC\uACE0\uC694."
    source: Assets/Data/Dungeon/Events/MagicTeacherReturn.asset:pages.Array.data[1].narrative
  - key: data.randomeventdata.magicteacherreturn.pages.1.options.0.title
    kr: "\uBD88\uC744 \uD55C\uAEBC\uBC88\uC5D0 \uD130\uB728\uB9AC\uB294 \uBC95\uC744
      \uBC30\uC6B4\uB2E4."
    source: Assets/Data/Dungeon/Events/MagicTeacherReturn.asset:pages.Array.data[1].options.Array.data[0].title
  - key: data.randomeventdata.magicteacherreturn.pages.1.options.0.description
    kr: "\uCCB4\uB825 \uBE44\uC728\uC774 \uAC00\uC7A5 \uB0AE\uC740 \uC801 \uC8FC\uC704\uC5D0
      \uD3ED\uBC1C\uD55C\uB2E4. \uBC18\uACBD \uC548\uC758 \uC801\uC744 \uD568\uAED8
      \uACF5\uACA9\uD55C\uB2E4."
    source: Assets/Data/Dungeon/Events/MagicTeacherReturn.asset:pages.Array.data[1].options.Array.data[0].description
  - key: data.randomeventdata.magicteacherreturn.pages.1.options.0.resulttext
    kr: "\uC120\uC0DD\uC774 \uB9C8\uC9C0\uB9C9 \uC601\uCC3D\uC744 \uACE0\uCCD0 \uC8FC\uACE0
      \uCC45\uC744 \uB36E\uC5C8\uB2E4."
    source: Assets/Data/Dungeon/Events/MagicTeacherReturn.asset:pages.Array.data[1].options.Array.data[0].resultText
  - key: data.randomeventdata.magicteacherreturn.pages.1.options.1.title
    kr: "\uB2E4\uB978 \uC18D\uC131\uC758 \uAE30\uCD08\uB97C \uBC30\uC6B4\uB2E4."
    source: Assets/Data/Dungeon/Events/MagicTeacherReturn.asset:pages.Array.data[1].options.Array.data[1].title
  - key: data.randomeventdata.magicteacherreturn.pages.1.options.1.description
    kr: "\uAE0B\uAE30\uB97C \uB05D\uB0B8 \uC9C0\uC810\uC5D0 \uBC88\uAC1C\uB97C \uB5A8\uC5B4\uB728\uB9AC\uACE0
      \uAC00\uAE4C\uC6B4 \uC801\uC73C\uB85C \uCD5C\uB300 3\uD68C \uC5F0\uACB0\uD55C\uB2E4."
    source: Assets/Data/Dungeon/Events/MagicTeacherReturn.asset:pages.Array.data[1].options.Array.data[1].description
