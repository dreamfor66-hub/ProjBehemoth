  - key: data.randomeventdata.amberseed.displayname
    kr: "\uB531 \uD558\uB098 \uB0A8\uC740 \uC5F4\uB9E4"
    source: Assets/Data/Behemoth/Events/AmberSeed.asset:displayName
  - key: data.randomeventdata.amberseed.narrative
    kr: "\uBE5B\uB098\uB294 \uC5F4\uB9E4 \uC548\uC5D0 \uC791\uC740 \uC528\uC557\uC774
      \uC788\uB2E4. \uAC00\uC9C0\uC5D0\uB294 \uD53C\uB97C \uBA39\uACE0 \uC790\uB780\uB2E4\uB294
      \uD45C\uC2DD\uC774 \uB0A8\uC544 \uC788\uB2E4.\n\n\uC9C0\uAE08 \uBC30\uB97C
      \uCC44\uC6B8 \uC218\uB3C4, \uC624\uB798 \uD488\uACE0 \uAC08 \uC218\uB3C4 \uC788\uACA0\uB2E4."
    source: Assets/Data/Behemoth/Events/AmberSeed.asset:narrative
  - key: data.randomeventdata.amberseed.options.0.title
    kr: "\uB0B4 \uD53C\uB85C \uC2F9\uC744 \uD2D4\uC6B4\uB2E4"
    source: Assets/Data/Behemoth/Events/AmberSeed.asset:options.Array.data[0].title
  - key: data.randomeventdata.amberseed.options.0.description
    kr: "\uCCB4\uB825 -10. \uD638\uBC15\uBE5B \uC2F9: \uC804\uD22C 3\uC2B9\uB9C8\uB2E4
      \uCD5C\uB300\xB7\uD604\uC7AC \uCCB4\uB825 +4."
    source: Assets/Data/Behemoth/Events/AmberSeed.asset:options.Array.data[0].description
  - key: data.randomeventdata.amberseed.options.1.title
    kr: "\uC528\uC557\uC9F8 \uC539\uC5B4 \uC0BC\uD0A8\uB2E4"
    source: Assets/Data/Behemoth/Events/AmberSeed.asset:options.Array.data[1].title
  - key: data.randomeventdata.amberseed.options.1.description
    kr: "\uCCB4\uB825 20 \uD68C\uBCF5. \uC528\uC557\uC740 \uC0AC\uB77C\uC9C4\uB2E4."
    source: Assets/Data/Behemoth/Events/AmberSeed.asset:options.Array.data[1].description
  - key: data.randomeventdata.banner.displayname
    kr: "\uC544\uC9C1 \uAD50\uB300 \uC2DC\uAC04\uC774 \uC544\uB2C8\uB2E4"
    source: Assets/Data/Behemoth/Events/Banner.asset:displayName
  - key: data.randomeventdata.banner.narrative
    kr: "\uBE48 \uAC11\uC637\uC774 \uAE43\uBC1C \uC544\uB798 \uC11C \uC788\uB2E4.\n\u201C\uAD50\uB300\uC790.
      \uC790\uACA9\uC744 \uC99D\uBA85\uD558\uB77C.\u201D\n\n\uB4A4\uCABD \uBCF4\uAE09\uD568\uC5D0\uB294
      \uB9C8\uC9C0\uB9C9 \uAE09\uB8CC\uAC00 \uB0A8\uC544 \uC788\uB2E4."
    source: Assets/Data/Behemoth/Events/Banner.asset:narrative
  - key: data.randomeventdata.banner.options.0.title
    kr: "\uB0B4\uAC00 \uAD50\uB300\uD55C\uB2E4"
    source: Assets/Data/Behemoth/Events/Banner.asset:options.Array.data[0].title
  - key: data.randomeventdata.banner.options.0.description
    kr: "\uC218\uD638\uC790\uC640 \uC804\uD22C. \uC2B9\uB9AC \uC2DC \uAE43\uBC1C
      \uD68D\uB4DD: \uC0B4\uC544 \uC788\uB294 \uC801 \uD558\uB098\uB2F9 \uBB34\uAE30
      \uD53C\uD574 +8%."
    source: Assets/Data/Behemoth/Events/Banner.asset:options.Array.data[0].description
  - key: data.randomeventdata.banner.options.1.title
    kr: "\uB0A8\uACA8\uC9C4 \uAE09\uB8CC\uB97C \uCC59\uAE34\uB2E4"
    source: Assets/Data/Behemoth/Events/Banner.asset:options.Array.data[1].title
  - key: data.randomeventdata.banner.options.1.description
    kr: "\uACE8\uB4DC +15. \uAE43\uBC1C\uC740 \uC9C0\uD0A4\uB294 \uC790\uC5D0\uAC8C
      \uB0A8\uAE34\uB2E4."
    source: Assets/Data/Behemoth/Events/Banner.asset:options.Array.data[1].description
  - key: data.randomeventdata.bell.displayname
    kr: "\uC18C\uB9AC \uB098\uB294 \uCABD\uC744 \uBC1B\uCCD0\uB77C"
    source: Assets/Data/Behemoth/Events/Bell.asset:displayName
  - key: data.randomeventdata.bell.narrative
    kr: "\uC885 \uC544\uB798\uC5D0 \uB07C\uC5B4 \uC788\uB358 \uBB3C\uAC74\uB4E4\uC774
      \uC624\uB798\uC804\uC5D0 \uBD80\uC11C\uC84C\uB2E4. \uD558\uB098\uB97C \uBC00\uC5B4
      \uB123\uC73C\uBA74 \uC885\uC744 \uAEBC\uB0BC \uC218 \uC788\uACA0\uB2E4.\n\n\uC885\uC744
      \uD3EC\uAE30\uD558\uACE0 \uCCAD\uB3D9 \uC870\uAC01\uB9CC \uB5BC\uC5B4 \uAC00\uB294
      \uBC29\uBC95\uB3C4 \uC788\uB2E4."
    source: Assets/Data/Behemoth/Events/Bell.asset:narrative
  - key: data.randomeventdata.bell.options.0.title
    kr: "\uAC00\uC838\uC628 \uC720\uBB3C\uB85C \uBC1B\uCE5C\uB2E4"
    source: Assets/Data/Behemoth/Events/Bell.asset:options.Array.data[0].title
  - key: data.randomeventdata.bell.options.0.description
    kr: "\uACF5\uC6A9 \uC720\uBB3C \uD558\uB098 \uC120\uD0DD\uD574 \uC81C\uAC70.
      \uC218\uD638\uC758 \uC885: \uCD5C\uB300 \uAC00\uB4DC +10, \uC804\uD22C \uC2DC\uC791
      3\uCD08 \uCCB4\uB825 \uD53C\uD574 -20%."
    source: Assets/Data/Behemoth/Events/Bell.asset:options.Array.data[0].description
  - key: data.randomeventdata.bell.options.1.title
    kr: "\uC5B4\uAE68\uB85C \uB4E4\uC5B4 \uC62C\uB9B0\uB2E4"
    source: Assets/Data/Behemoth/Events/Bell.asset:options.Array.data[1].title
  - key: data.randomeventdata.bell.options.1.description
    kr: "\uCCB4\uB825 -20. \uC218\uD638\uC758 \uC885 \uD68D\uB4DD."
    source: Assets/Data/Behemoth/Events/Bell.asset:options.Array.data[1].description
  - key: data.randomeventdata.bell.options.2.title
    kr: "\uAC00\uC7A5\uC790\uB9AC\uC758 \uCCAD\uB3D9\uB9CC \uB5BC\uC5B4 \uAC04\uB2E4"
    source: Assets/Data/Behemoth/Events/Bell.asset:options.Array.data[2].title
  - key: data.randomeventdata.bell.options.2.description
