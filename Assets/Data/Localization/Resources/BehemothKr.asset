  - key: data.playercombatdata.barbarian.displayname
    kr: "\uBC14\uBC14\uB9AC\uC548"
    source: Assets/Data/Behemoth/Characters/Barbarian.asset:displayName
  - key: data.playercombatdata.barbarian.description
    kr: "\uB3D9\uBB3C\uC801 \uBCF8\uB2A5\uACFC \uC6D0\uCD08\uC801\uC778 \uD798, \uC2DD\uC744
      \uC904 \uBAA8\uB974\uB294 \uBD84\uB178\uB97C \uAC70\uCE68\uC5C6\uC774 \uBC1C\uC0B0\uD558\uB294
      \uC57C\uC131\uC801\uC778 \uC804\uC0AC\uC785\uB2C8\uB2E4."
    source: Assets/Data/Behemoth/Characters/Barbarian.asset:description
  - key: data.playercombatdata.monk.displayname
    kr: "\uBABD\uD06C"
    source: Assets/Data/Behemoth/Characters/Monk.asset:displayName
  - key: data.playercombatdata.monk.description
    kr: "\uC5EC\uB7EC \uACF5\uACA9\uC744 \uD558\uB098\uC758 \uACF5\uACA9 \uCC98\uB7FC
      \uBB3C \uD750\uB974\uB4EF \uC5F0\uACB0\uD558\uB294 \uB0A0\uB835\uD55C \uBAB8\uB180\uB9BC\uC758
      \uBB34\uC608\uAC00 \uC785\uB2C8\uB2E4."
    source: Assets/Data/Behemoth/Characters/Monk.asset:description
  - key: data.playercombatdata.rogue.displayname
    kr: "\uB85C\uADF8"
    source: Assets/Data/Behemoth/Characters/Rogue.asset:displayName
  - key: data.playercombatdata.rogue.description
    kr: "\uC740\uC2E0 \uB2A5\uB825\uACFC \uB3C5, \uB6F0\uC5B4\uB09C \uBC18\uC0AC
      \uC2E0\uACBD\uC744 \uD65C\uC6A9\uD574 \uB300\uBD80\uBD84\uC758 \uC0C1\uD669\uC5D0\uC11C
      \uC6B0\uC704\uB97C \uC810\uD560 \uC218 \uC788\uB294 \uB2E4\uC7AC\uB2E4\uB2A5\uD55C
      \uC874\uC7AC\uC785\uB2C8\uB2E4."
    source: Assets/Data/Behemoth/Characters/Rogue.asset:description
  - key: data.playercombatdata.samurai.displayname
    kr: "\uC0AC\uBB34\uB77C\uC774"
    source: Assets/Data/Behemoth/Characters/Samurai.asset:displayName
  - key: data.playercombatdata.samurai.description
    kr: "\uC804\uD22C \uC18D\uC5D0\uC11C\uB3C4 \uD56D\uC0C1 \uC9D1\uC911\uC744 \uC783\uC9C0
      \uC54A\uACE0, \uC801\uC758 \uBE48\uD2C8\uC744 \uC21C\uC2DD\uAC04\uC5D0 \uD30C\uACE0
      \uB4E4\uC5B4\uAC00 \uB354\uC6B1 \uCE58\uBA85\uC801\uC778 \uD53C\uD574\uB97C
      \uC785\uD788\uB294 \uB3D9\uBC29\uC758 \uBB34\uC0AC\uC785\uB2C8\uB2E4."
    source: Assets/Data/Behemoth/Characters/Samurai.asset:description
  - key: data.playercombatdata.warrior.displayname
    kr: "\uC6CC\uB9AC\uC5B4"
    source: Assets/Data/Behemoth/Characters/Warrior.asset:displayName
  - key: data.playercombatdata.warrior.description
    kr: "\uBC29\uD328\uC640 \uD55C\uC190\uAC80\uC744 \uC8FC \uBB34\uAE30\uB85C \uAC01\uC885
      \uC804\uC7C1\uC5D0 \uCC38\uC5EC\uD558\uBA70 \uC6A9\uBCD1\uC774\uB098 \uBAA8\uD5D8\uAC00
      \uC77C\uC744 \uD574 \uC628 \uC804\uD22C\uC758 \uB2EC\uC778\uC785\uB2C8\uB2E4."
    source: Assets/Data/Behemoth/Characters/Warrior.asset:description
  - key: data.playercombatdata.wizard.displayname
    kr: "\uC704\uC790\uB4DC"
    source: Assets/Data/Behemoth/Characters/Wizard.asset:displayName
  - key: data.playercombatdata.wizard.description
    kr: "\uD638\uAE30\uC2EC\uC5D0 \uC758\uD574 \uBBF8\uAD81\uC5D0 \uBC1C\uC744 \uB4E4\uC778
      \uD0D1\uC758 \uB9C8\uBC95\uC0AC. \uD0C0\uACE0\uB09C \uB9C8\uB825 \uC6B4\uC6A9\uC73C\uB85C
      \uB2E4\uC591\uD55C \uC8FC\uBB38\uC744 \uC27D\uAC8C \uB2E4\uB8F0 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    source: Assets/Data/Behemoth/Characters/Wizard.asset:description
