  - key: data.randomeventdata.tooth.pages.0.narrative
    kr: "\uC61B \uC720\uD76C\uC2E4\uC5D0\uC11C \uAE08\uB2C8\uC758 \uC0C1\uC778\uC774
      \uB098\uB97C \uC54C\uC544\uBCF4\uACE0 \uC790\uB9AC\uB97C \uAD8C\uD55C\uB2E4.\r\n\r\n\uC544\uC9C1
      \uC0B4\uC544 \uACC4\uC168\uAD70\uC694. \uC774\uBC88\uC5D0\uB294 \uC0B4\uC544
      \uB3CC\uC544\uC624\uC2DC\uB294 \uCABD\uC5D0 \uAC78\uACA0\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC0C1\uC778\uC774
      \uC7A5\uBD80\uC5D0 \uB0B4 \uC774\uB984\uC744 \uC801\uACE0, \uB3C8\uC744 \uBCF4\uD0DC\uBA74
      \uC2B9\uB9AC\uD560 \uB54C\uB9C8\uB2E4 \uBC30\uB2F9\uC744 \uC8FC\uACA0\uB2E4\uACE0
