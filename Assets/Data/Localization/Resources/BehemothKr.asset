  - key: data.randomeventdata.scholar.narrative
    kr: "\uBB3C\uC5D0\uC11C \uAC74\uC9C4 \uCC45\uC774 \uC190\uAC00\uB77D\uC744 \uBD99\uB4E0\uB2E4.\n\u201C\uD55C
