  - key: data.randomeventdata.magicteacherfirst.pages.3.options.2.title
    kr: "\uB9C8\uBC95\uBCF4\uB2E4\uB294 \uC5EC\uBE44\uAC00 \uD544\uC694\uD558\uB2E4\uACE0
      \uD55C\uB2E4."
