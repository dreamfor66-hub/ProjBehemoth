  m_Script: {fileID: 11500000, guid: 0b1a25789e2400345a2f0d0be4ba3362, type: 3}
  m_Name: "Data_ActGrowthBudget_2\uB9C9_\uC131\uC7A5_\uC608\uC0B0"
  m_EditorClassIdentifier: 
  act: 2
  designIntent: "\uBCF4\uC2A4 \uC9C4\uC785 \uC804 \uC694\uAD6C \uC131\uC7A5\uB7C9.
    \uD68D\uB4DD \uAE30\uD68C, \uC120\uD0DD \uC218\uB77D\uB960, \uD6A8\uACFC \uAC00\uCE58\uB294
    \uC870\uC815 \uAC00\uB2A5\uD55C \uC124\uACC4 \uAC00\uC815\uC774\uBA70 \uB79C\uB364
    \uB7F0 \uD3C9\uADE0\uC73C\uB85C \uC228\uAE30\uC9C0 \uC54A\uB294\uB2E4."
  stage: {fileID: 11400000, guid: 87d58353c431c8341bb0023eca025f7b, type: 2}
  normalCombatOpportunities: 8
  eliteCombatOpportunities: 2
  goddessOpportunities: 1
  inheritedExperience: 484.73337
  expectedExperience: 1104.5668
  cumulativeLevelUpPerks: 8
  requiredUnits: 12
  requiredOffenseUnits: 3.5
  requiredHealthUnits: 1
  referenceBuilds: []
  referenceOffenseAllocation: 0.8
  damageBonusPerOffenseUnit: 0.1
  healthPerDefenseUnit: 10
  underBudgetRatio: 0.65
  strongRatio: 1.35
  opportunities:
  - source: "\uC9C0\uAE08\uAE4C\uC9C0 \uB808\uBCA8\uC5C5 \uD37D"
    opportunities: 8
    acquisitionRate: 1
    unitsPerAcquisition: 0.8
    assumption: "\uCD5C\uC18C 3\uAC1C \uC120\uD0DD\uC9C0 \uC911 \uBE4C\uB4DC\uC5D0
      \uC4F8 \uC218 \uC788\uB294 \uC120\uD0DD\uC758 \uC2E4\uD6A8 \uD3C9\uADE0\uC744
      0.8U\uB85C \uAC00\uC815. \uC804\uCCB4 \uD37D\uC744 \uAC19\uC740 \uAC12\uC73C\uB85C
      \uD655\uC815\uD55C \uAC83\uC774 \uC544\uB2D8."
  - source: "\uC774\uC804 \uB9C9\uC758 \uBE44\uB808\uBCA8\uC5C5 \uC131\uC7A5"
    opportunities: 1
    acquisitionRate: 1
    unitsPerAcquisition: 6.175
    assumption: "\uC774\uC804 \uB9C9 \uC0C1\uC790\xB7\uC774\uBCA4\uD2B8\xB7\uC0C1\uC810\uC758
      \uAE30\uB300\uCE58\uC640 \uADF8 \uB9C9 \uBCF4\uC2A4 \uCC98\uCE58 \uD6C4 \uC720\uBB3C.
      \uC2DC\uC791 \uC720\uBB3C\uC740 \uD074\uB798\uC2A4 \uAE30\uBCF8 \uC131\uB2A5\uC73C\uB85C
      \uC81C\uC678."
  - source: "\uC720\uBB3C \uC0C1\uC790"
    opportunities: 1
    acquisitionRate: 1
    unitsPerAcquisition: 2
    assumption: "1\uB9C9\uC758 \uB2E4\uB978 \uC0C1\uC790\uB294 \uACE8\uB4DC\uC774\uBA70
      \uC720\uBB3C\uB85C \uC911\uBCF5 \uACC4\uC0B0\uD558\uC9C0 \uC54A\uC74C. \uC0C1\uC790
      \uBC29\uBB38\uC744 \uAC00\uC815\uD55C \uAE30\uD68C."
  - source: "\uC774\uBCA4\uD2B8 \uC131\uC7A5 \uC120\uD0DD"
    opportunities: 2
    acquisitionRate: 0.35
    unitsPerAcquisition: 1.5
    assumption: "\uC2E4\uC81C \uAE30\uBCF8 \uC774\uBCA4\uD2B8\uBC29 2\uACF3. \uC228\uACA8\uC9C4
      \uBC29\uC740 \uD544\uC218 \uC608\uC0B0\uC5D0 \uD3EC\uD568\uD558\uC9C0 \uC54A\uC74C.
      \uC218\uB77D\uB960 35%\uC640 \uD68D\uB4DD\uB2F9 1.5U\uB294 \uC774\uC804 \uC784\uC2DC
      \uAC00\uC815\uC774\uBA70 NPC \uBE44\uC911/\uC120\uD0DD \uBCC0\uACBD \uC774\uD6C4
      \uC544\uC9C1 \uC7AC\uAC80\uC99D\uD558\uC9C0 \uC54A\uC74C."
  - source: "\uC0C1\uC810 \uC131\uC7A5 \uAD6C\uB9E4"
    opportunities: 2
    acquisitionRate: 0.3
    unitsPerAcquisition: 2
    assumption: "\uCE35\uB2F9 \uD589\uC0C1\uC740 1\uBA85. \uAE30\uC874 1/2/3\uBA85\uBD84
      \uC7AC\uACE0\uB97C 6/12/18\uCE78\uC73C\uB85C \uBAA8\uC558\uC73C\uBBC0\uB85C
      \uD589\uC0C1 \uC218\uAC00 \uC544\uB2CC \uC7AC\uACE0 \uBB36\uC74C \uC218\uB97C
      \uAE30\uD68C\uB85C \uACC4\uC0B0. \uAD6C\uB9E4\uC728 30%\uC640 2U\uB294 \uBBF8\uAC80\uC99D
      \uC784\uC2DC \uAC00\uC815. \uACE8\uB4DC\uB97C \uCD94\uAC00 \uC9C0\uAE09\uD558\uC9C0
      \uC54A\uC74C."
  normalDamageShare: 0.7
  breakFollowupShare: 0.25
  referenceFightSeconds: 20
  valuations:
  - content: {fileID: 11400000, guid: e2fbacc97b5fc944b9c5e5a84b83b1de, type: 2}
