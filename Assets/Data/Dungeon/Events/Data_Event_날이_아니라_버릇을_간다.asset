  m_Name: "Data_Event_\uB0A0\uC774_\uC544\uB2C8\uB77C_\uBC84\uB987\uC744_\uAC04\uB2E4"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.forge.displayname
    lastText: "\uB0A0\uC774 \uC544\uB2C8\uB77C \uBC84\uB987\uC744 \uAC04\uB2E4"
  - propertyPath: narrative
    key: data.randomeventdata.forge.narrative
    lastText: "\uD734\uB300 \uBAA8\uB8E8\uB97C \uC9CA\uC5B4\uC9C4 \uC7A5\uC778\uC774
      \uAE38\uAC00\uC5D0\uC11C \uC26C\uACE0 \uC788\uB2E4. \uB0B4 \uBC29\uD328\uB97C
      \uBCF4\uB354\uB2C8 \uCC0C\uADF8\uB7EC\uC9C4 \uBD80\uBD84\uC744 \uAC00\uB9AC\uD0A8\uB2E4.\n\n\u201C\uADF8\uAC74
      \uAE08\uBC29 \uD3B4\uC9C0\uC9C0. \uC2F8\uC6B0\uB294 \uC790\uC138\uB3C4 \uBD10
      \uC904 \uC218 \uC788\uACE0.\u201D"
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.forge.options.0.title
    lastText: "\uC775\uC219\uD55C \uAE30\uC220\uC744 \uBCBC\uB9B0\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.forge.options.0.description
    lastText: "30\uACE8\uB4DC \uC18C\uBAA8. \uBCF4\uC720 \uB2A5\uB825 \uD558\uB098\uB97C
      \uAC15\uD654."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.forge.options.1.title
    lastText: "\uD558\uB098\uB97C \uBC84\uB9AC\uACE0 \uB450 \uAC1C\uB97C \uBC30\uC6B4\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.forge.options.1.description
    lastText: "\uBCF4\uC720 \uB2A5\uB825 \uD558\uB098 \uC81C\uAC70 \uD6C4 \uC0C8
      \uB2A5\uB825 \uB450 \uBC88 \uC120\uD0DD."
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.forge.options.2.title
    lastText: "\uBC29\uD328\uC758 \uCC0C\uADF8\uB7EC\uC9C4 \uACF3\uB9CC \uD3B8\uB2E4"
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.forge.options.2.description
    lastText: "\uCD5C\uB300 \uAC00\uB4DC\uAC8C\uC774\uC9C0 +3. \uB2A5\uB825\uC740
      \uBC14\uB00C\uC9C0 \uC54A\uB294\uB2E4."
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.forge.options.0.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.forge.options.1.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: options.Array.data[2].resultText
    key: data.randomeventdata.forge.options.2.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.forge.pages.0.narrative
    lastText: "\uD734\uB300 \uBAA8\uB8E8\uB97C \uC9CA\uC5B4\uC9C4 \uC7A5\uC778\uC774
      \uAE38\uAC00\uC5D0\uC11C \uC26C\uACE0 \uC788\uB2E4. \uB0B4 \uBC29\uD328\uB97C
      \uBCF4\uB354\uB2C8 \uCC0C\uADF8\uB7EC\uC9C4 \uBD80\uBD84\uC744 \uAC00\uB9AC\uD0A8\uB2E4.\n\n\u201C\uADF8\uAC74
      \uAE08\uBC29 \uD3B4\uC9C0\uC9C0. \uC2F8\uC6B0\uB294 \uC790\uC138\uB3C4 \uBD10
      \uC904 \uC218 \uC788\uACE0.\u201D"
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.forge.pages.0.options.0.title
    lastText: "\uBC29\uD328\uB9CC \uC218\uB9AC\uD55C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
    key: data.randomeventdata.forge.pages.0.options.0.description
    lastText: "\uCD5C\uB300 \uC2E4\uB4DC +3"
  - propertyPath: pages.Array.data[0].options.Array.data[0].resultText
    key: data.randomeventdata.forge.pages.0.options.0.resulttext
    lastText: "\uC7A5\uC778\uC774 \uD734\uB300 \uBAA8\uB8E8\uB97C \uB0B4\uB824\uB193\uACE0
      \uBC29\uD328\uB97C \uB450\uB4DC\uB824 \uD3C8\uB2E4. \uACE0\uCE5C \uBC29\uD328\uB97C
      \uBC1B\uC544 \uB4E4\uC790 \uADF8\uB294 \uB3C4\uAD6C\uB97C \uB2E4\uC2DC \uC815\uB9AC\uD588\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].title
    key: data.randomeventdata.forge.pages.0.options.1.title
    lastText: "\uC2F8\uC6B0\uB294 \uC790\uC138\uB97C \uBD10 \uB2EC\uB77C\uACE0 \uD55C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
    key: data.randomeventdata.forge.pages.0.options.1.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: data.randomeventdata.forge.pages.0.options.1.resulttext
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[2].title
    key: data.randomeventdata.forge.pages.0.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].description
    key: data.randomeventdata.forge.pages.0.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: data.randomeventdata.forge.pages.0.options.2.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[1].narrative
    key: data.randomeventdata.forge.pages.1.narrative
    lastText: "\u201C\uD55C \uBC88 \uD718\uB458\uB7EC \uBD10.\u201D\n\n\uBA87 \uBC88
      \uC6C0\uC9C1\uC774\uC790 \uC7A5\uC778\uC774 \uBC1C\uACFC \uC190\uBAA9\uC758
      \uC704\uCE58\uB97C \uC9DA\uC5B4 \uC900\uB2E4.\n\n\u201C\uC9C0\uAE08 \uAE30\uC220\uC744
      \uB2E4\uB4EC\uC744\uAE4C, \uB098\uC05C \uBC84\uB987 \uD558\uB098\uB97C \uBC84\uB9AC\uACE0
      \uC0C8\uB85C \uBC30\uC6B8\uAE4C?\u201D"
  - propertyPath: pages.Array.data[1].options.Array.data[0].title
    key: data.randomeventdata.forge.pages.1.options.0.title
    lastText: "\uC775\uC219\uD55C \uAE30\uC220\uC744 \uB2E4\uB4EC\uB294\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].description
    key: data.randomeventdata.forge.pages.1.options.0.description
    lastText: "\uBCF4\uC720 \uB2A5\uB825 \uD558\uB098 \uAC15\uD654"
  - propertyPath: pages.Array.data[1].options.Array.data[0].resultText
    key: data.randomeventdata.forge.pages.1.options.0.resulttext
    lastText: "\uBA87 \uCC28\uB840 \uC790\uC138\uB97C \uACE0\uCCD0 \uD718\uB458\uB800\uB2E4.
      \uC7A5\uC778\uC740 \uACE0\uAC1C\uB97C \uB044\uB355\uC774\uBA70 \uBAA8\uB8E8\uB97C
      \uCC59\uACBC\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].title
    key: data.randomeventdata.forge.pages.1.options.1.title
    lastText: "\uAE30\uC220 \uD558\uB098\uB97C \uBC84\uB9AC\uACE0 \uC0C8\uB85C \uBC30\uC6B4\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].description
    key: data.randomeventdata.forge.pages.1.options.1.description
    lastText: "\uB2A5\uB825 \uD558\uB098 \uC81C\uAC70 \xB7 \uC0C8 \uB2A5\uB825 \uC120\uD0DD
      \xB7 \uC0C8 \uB2A5\uB825 \uC120\uD0DD"
  - propertyPath: pages.Array.data[1].options.Array.data[1].resultText
    key: data.randomeventdata.forge.pages.1.options.1.resulttext
    lastText: "\uC775\uC219\uD55C \uB3D9\uC791\uC744 \uBC84\uB9AC\uACE0 \uC7A5\uC778\uC774
      \uC9DA\uC5B4 \uC900 \uB450 \uAC00\uC9C0 \uC790\uC138\uB97C \uC5F0\uC2B5\uD588\uB2E4.
      \uC218\uC5C5\uC744 \uB9C8\uCE58\uC790 \uADF8\uAC00 \uBAA8\uB8E8\uB97C \uCC59\uACBC\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[2].title
    key: data.randomeventdata.forge.pages.1.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[2].description
    key: data.randomeventdata.forge.pages.1.options.2.description
    lastText: 
