  m_Name: "Data_Event_\uC7A0\uAE50\uC758_\uAD50\uB300"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.shelter.displayname
    lastText: "\uC7A0\uAE50\uC758 \uAD50\uB300"
  - propertyPath: narrative
    key: data.randomeventdata.shelter.narrative
    lastText: "\uB0A1\uC740 \uB2F4\uC694\uB97C \uBB34\uB98E\uC5D0 \uB36E\uC740 \uACBD\uBE44\uBCD1\uC774
      \uAE38\uAC00\uC5D0 \uAE30\uB300\uC5B4 \uC788\uB2E4.\n\n\uB098\uB97C \uBCF4\uC790
      \uC878\uB9B0 \uB208\uC744 \uBE44\uBE44\uBA70 \uD55C\uCABD \uC790\uB9AC\uB97C
      \uB0B4\uC900\uB2E4.\n\n\u201C\uC7A0\uAE50 \uB208 \uC880 \uBD99\uC774\uB824\uB294\uB370,
      \uBC88\uAC08\uC544 \uB9DD\uC744 \uBD10 \uC8FC\uACA0\uC18C? \uC544\uBB34\uB3C4
      \uC548 \uBD10 \uC8FC\uBA74 \uBD88\uC548\uD574\uC11C \uB9D0\uC774\uC624.\u201D"
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.shelter.options.0.title
    lastText: "\uBD88\uC744 \uC9C0\uD0A4\uBA70 \uC270\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.shelter.options.0.description
    lastText: "\uCCB4\uB825 24 \uD68C\uBCF5."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.shelter.options.1.title
    lastText: "\uBC24\uC0C8 \uBAB8\uC744 \uB2E8\uB828\uD55C\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.shelter.options.1.description
    lastText: "\uCD5C\uB300\xB7\uD604\uC7AC \uCCB4\uB825 +5."
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.shelter.options.2.title
    lastText: "\uB108 \uBA3C\uC800 \uC790. \uB2E4\uC74C\uC740 \uB0B4 \uCC28\uB840\uC57C"
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.shelter.options.2.description
    lastText: "\uAC15\uC544\uC9C0\uC640 \uBC88\uAC08\uC544 \uB9DD\uC744 \uBCF8\uB2E4.
      \uCCB4\uB825 28 \uD68C\uBCF5, \uACE8\uB4DC +12."
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.shelter.options.0.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.shelter.options.1.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: options.Array.data[2].resultText
    key: data.randomeventdata.shelter.options.2.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.shelter.pages.0.narrative
    lastText: "\uB0A1\uC740 \uB2F4\uC694\uB97C \uBB34\uB98E\uC5D0 \uB36E\uC740 \uACBD\uBE44\uBCD1\uC774
      \uAE38\uAC00\uC5D0 \uAE30\uB300\uC5B4 \uC788\uB2E4.\n\n\uB098\uB97C \uBCF4\uC790
      \uC878\uB9B0 \uB208\uC744 \uBE44\uBE44\uBA70 \uD55C\uCABD \uC790\uB9AC\uB97C
      \uB0B4\uC900\uB2E4.\n\n\u201C\uC7A0\uAE50 \uB208 \uC880 \uBD99\uC774\uB824\uB294\uB370,
      \uBC88\uAC08\uC544 \uB9DD\uC744 \uBD10 \uC8FC\uACA0\uC18C? \uC544\uBB34\uB3C4
      \uC548 \uBD10 \uC8FC\uBA74 \uBD88\uC548\uD574\uC11C \uB9D0\uC774\uC624.\u201D"
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.shelter.pages.0.options.0.title
    lastText: "\uB9DD\uC744 \uBC88\uAC08\uC544 \uBCF4\uBA70 \uC270\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
    key: data.randomeventdata.shelter.pages.0.options.0.description
    lastText: "\uCCB4\uB825 +24"
  - propertyPath: pages.Array.data[0].options.Array.data[0].resultText
    key: data.randomeventdata.shelter.pages.0.options.0.resulttext
    lastText: "\uACBD\uBE44\uBCD1\uACFC \uBC88\uAC08\uC544 \uB9DD\uC744 \uBCF4\uBA70
      \uC7A0\uC2DC \uC26C\uC5C8\uB2E4. \uB0B4 \uCC28\uB840\uAC00 \uB05D\uB098\uC790
      \uADF8\uB294 \uB2E4\uC2DC \uB2F4\uC694\uB97C \uB04C\uC5B4\uB2F9\uACBC\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].title
    key: data.randomeventdata.shelter.pages.0.options.1.title
    lastText: "\uBAB8\uC744 \uD480\uBA70 \uB9DD\uC744 \uBCF8\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
    key: data.randomeventdata.shelter.pages.0.options.1.description
    lastText: "\uCD5C\uB300\xB7\uD604\uC7AC \uCCB4\uB825 +5"
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: data.randomeventdata.shelter.pages.0.options.1.resulttext
    lastText: "\uC7A0\uC744 \uC790\uB294 \uB300\uC2E0 \uBAB8\uC744 \uD480\uBA70 \uB9DD\uC744
      \uBD24\uB2E4. \uACBD\uBE44\uBCD1\uC774 \uC77C\uC5B4\uB098 \uACE0\uB9D9\uB2E4\uBA70
      \uC790\uB9AC\uB97C \uC815\uB3C8\uD588\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].title
