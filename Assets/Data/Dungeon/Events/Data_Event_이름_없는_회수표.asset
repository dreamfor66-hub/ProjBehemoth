  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: "Data_Event_\uC774\uB984_\uC5C6\uB294_\uD68C\uC218\uD45C"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: "data.randomeventdata.data_event_\uC774\uB984_\uC5C6\uB294_\uD68C\uC218\uD45C.displayname"
    lastText: "\uC774\uB984 \uC5C6\uB294 \uD68C\uC218\uD45C"
  - propertyPath: narrative
    key: "data.randomeventdata.data_event_\uC774\uB984_\uC5C6\uB294_\uD68C\uC218\uD45C.narrative"
    lastText: "\uD6C4\uB4DC\uB97C \uC4F4 \uC0AC\uB0B4\uAC00 \uBC27\uC904\uC744 \uC190\uBC14\uB2E5\uC5D0
      \uAC10\uB294\uB2E4. \uBAA9\uC5D0 \uAC78\uB9B0 \uD68C\uC218\uD45C\uC5D0\uB294
      \uC774\uB984\uC774 \uD558\uB098\uB3C4 \uC5C6\uB2E4.\n\n\u201C\uB3CC\uC544\uAC00\uC2E4
      \uB54C \uC9D0\uC774 \uBB34\uAC70\uC6B0\uBA74 \uC81C\uAC00 \uB4E4\uC5B4 \uB4DC\uB9AC\uC8E0.\u201D\n\n\uB9D0\uACFC
      \uB2EC\uB9AC \uC0AC\uB0B4\uC758 \uC2DC\uC120\uC740 \uB0B4 \uC8FC\uBA38\uB2C8\uC5D0
      \uBA38\uBB38\uB2E4. \uC7A5\uAC11 \uC544\uB798\uC5D0\uC11C \uC9E7\uC740 \uCE7C\uC774
      \uB4DC\uB7EC\uB09C\uB2E4.\n\n\u201C\uC9C0\uAE08 \uAC00\uBCCD\uAC8C \uD574 \uB4DC\uB9B4
      \uC218\uB3C4 \uC788\uACE0.\u201D"
  - propertyPath: options.Array.data[0].title
    key: "data.randomeventdata.data_event_\uC774\uB984_\uC5C6\uB294_\uD68C\uC218\uD45C.options.0.title"
    lastText: "\uCE7C\uC744 \uBF51\uC740 \uC190\uBD80\uD130 \uBCA4\uB2E4."
  - propertyPath: options.Array.data[0].description
    key: "data.randomeventdata.data_event_\uC774\uB984_\uC5C6\uB294_\uD68C\uC218\uD45C.options.0.description"
    lastText: "\uC804\uD22C \xB7 \uC2B9\uB9AC \uC2DC \uACE8\uB4DC +20"
  - propertyPath: options.Array.data[0].resultText
    key: "data.randomeventdata.data_event_\uC774\uB984_\uC5C6\uB294_\uD68C\uC218\uD45C.options.0.resulttext"
    lastText: "\uC0AC\uB0B4\uAC00 \uC4F0\uB7EC\uC84C\uB2E4. \uC774\uB984\uD45C \uC548\uCABD\uC5D0\uB294
      \uC0B4\uC544 \uC788\uB294 \uC6D0\uC815\uAC1D\uC758 \uC9D0\uAC12\uC774 \uC801\uD600
      \uC788\uC5C8\uB2E4. \uC8FC\uBA38\uB2C8\uC758 \uB3C8\uC744 \uAC70\uB450\uACE0
      \uBC27\uC904\uC744 \uB0B4\uB824\uB193\uC558\uB2E4."
  - propertyPath: options.Array.data[1].title
    key: "data.randomeventdata.data_event_\uC774\uB984_\uC5C6\uB294_\uD68C\uC218\uD45C.options.1.title"
    lastText: "\uB3D9\uC804\uC744 \uB358\uC9C0\uACE0 \uAC70\uB9AC\uB97C \uBC8C\uB9B0\uB2E4."
  - propertyPath: options.Array.data[1].description
    key: "data.randomeventdata.data_event_\uC774\uB984_\uC5C6\uB294_\uD68C\uC218\uD45C.options.1.description"
    lastText: "\uACE8\uB4DC 15 \uC9C0\uBD88"
  - propertyPath: options.Array.data[1].resultText
    key: "data.randomeventdata.data_event_\uC774\uB984_\uC5C6\uB294_\uD68C\uC218\uD45C.options.1.resulttext"
    lastText: "\uC0AC\uB0B4\uAC00 \uB3D9\uC804\uC744 \uC90D\uB294 \uB3D9\uC548 \uAC80\uC744
      \uACA8\uB208 \uCC44 \uBB3C\uB7EC\uC130\uB2E4. \uADF8\uB294 \uBE48 \uC774\uB984\uD45C\uB97C
      \uC637 \uC548\uC5D0 \uAC10\uCD94\uACE0 \uB2E4\uB978 \uAE38\uB85C \uBE60\uC84C\uB2E4."
  - propertyPath: options.Array.data[2].title
    key: "data.randomeventdata.data_event_\uC774\uB984_\uC5C6\uB294_\uD68C\uC218\uD45C.options.2.title"
    lastText: "\uC190\uB05D\uC5D0 \uB9C8\uB825\uC744 \uBAA8\uC544 \uBAA9\uC904\uC744
      \uACA8\uB208\uB2E4."
  - propertyPath: options.Array.data[2].description
    key: "data.randomeventdata.data_event_\uC774\uB984_\uC5C6\uB294_\uD68C\uC218\uD45C.options.2.description"
    lastText: "\uC2E4\uC81C\uB85C \uC8FC\uBB38\uC744 \uC0AC\uC6A9\uD55C \uACBD\uD5D8
      \uD544\uC694"
  - propertyPath: options.Array.data[2].resultText
    key: "data.randomeventdata.data_event_\uC774\uB984_\uC5C6\uB294_\uD68C\uC218\uD45C.options.2.resulttext"
    lastText: "\uC0AC\uB0B4\uAC00 \uC190\uB05D\uC758 \uB9C8\uB825\uC744 \uBCF4\uACE0
      \uBC27\uC904\uC744 \uB193\uC558\uB2E4. \u201C\uB2E4\uB978 \uC0AC\uB78C\uC778
      \uC904 \uC54C\uC558\uC2B5\uB2C8\uB2E4.\u201D \uB4F1\uC744 \uBCF4\uC774\uC9C0
      \uC54A\uC73C\uB824 \uC606\uAC78\uC74C\uCE58\uB358 \uADF8\uAC00 \uD1B5\uB85C
      \uB108\uBA38\uB85C \uC0AC\uB77C\uC84C\uB2E4."
  textOwnerGuid: 40481cb43d034e94881cdd670ae9be45
  id: RecoveryCutpurse
  displayName: "\uC774\uB984 \uC5C6\uB294 \uD68C\uC218\uD45C"
  discovery: 0
  worldObject: {fileID: 11400000, guid: 2cda420d80f0ba94c9316c4ce96318e2, type: 2}
  encounterKind: 3
  authoringLore: "\uD76C\uC0DD\uC790\uC758 \uADC0\uD658\uAE08\uC744 \uAC00\uB85C\uCC44\uAE30
    \uC704\uD574 \uD68C\uC218\uC5C5\uC790\uB85C \uC704\uC7A5\uD55C \uB2E8\uB3C5 \uB3C4\uC801.
    \uBE48 \uC774\uB984\uD45C\uC640 \uC0C8 \uBC27\uC904\uC744 \uB4E4\uACE0 \uC6D0\uC815\uAC1D\uC744
    \uBB3C\uC0C9\uD55C\uB2E4. \uC815\uB2F9\uD55C \uD68C\uC218\uC5C5\uC790\uC758 \uB2F3\uC740
    \uD45C\uC2DD\uACFC \uB300\uBE44\uB41C\uB2E4. \uCCAB \uB9C9\uC758 \uC0AC\uB78C\uD615
    \uC801\uB300 \uC870\uC6B0\uC774\uBA70 \uB300\uD654 NPC\uC758 \uC99D\uAC00\uB85C
    \uACC4\uC0B0\uD558\uC9C0 \uC54A\uB294\uB2E4."
