    key: data.randomeventdata.magicteacherreturn.pages.2.options.3.title
    lastText: "\uB2E4\uB978 \uC218\uC5C5\uC744 \uBB3B\uB294\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[3].description
