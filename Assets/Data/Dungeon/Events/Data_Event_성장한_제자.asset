  discovery: 1
  worldObject: {fileID: 11400000, guid: bba5492502f4bd84e8f01322952fdde9, type: 2}
  encounterKind: 1
  authoringLore: "\uD68C\uC218\uC18C\uC5D0 \uC0C8 \uADC0\uD658 \uC9C0\uB3C4\uB97C
    \uB0A9\uD488\uD558\uB294 \uD604\uC7A5 \uB9C8\uBC95\uC0AC. \uC61B \uC6D0\uC815\uB300\uC758
    \uAE38 \uD45C\uC2DC\uB97C \uC9C0\uB3C4\uB85C \uC62E\uAE30\uB418 \uC2E4\uC81C
    \uD1B5\uD589 \uC5EC\uBD80\uB97C \uD655\uC778\uD558\uBA70 \uC804\uC9C4\uD55C\uB2E4.
    \uB9CC\uB098\uB294 \uC6D0\uC815\uAC1D\uC5D0\uAC8C \uC9C0\uB098\uC628 \uD45C\uC2DD\uC744
    \uD655\uC778\uD558\uACE0, \uB2F5\uB840\uC640 \uD604\uC7A5 \uAE30\uB85D \uAD50\uD658\uC73C\uB85C
    \uC8FC\uBB38\uC744 \uAC00\uB974\uCE5C\uB2E4. \uAC01 \uB9C9\uC758 \uB2E4\uC74C
    \uAD50\uC2B5\uB3C4 \uC870\uC0AC \uC5EC\uC815 \uB3C4\uC911 \uB2E4\uC2DC \uB9CC\uB098\uB294
    \uB3D9\uC77C \uC778\uBB3C\uC774\uB2E4. \uBB34\uB2A5\uD55C \uBD88\uC7A5\uB09C/\uACF5\uAC04
    \uAC11\uC791\uC2A4\uB7F0 \uB4F1\uC7A5/\uD6C4\uBC29 \uC2B5\uACA9 \uC804\uC81C\uB294
    \uC5C6\uB2E4."
  roomLayout: 0
  roomInteriors:
  - {fileID: 0}
