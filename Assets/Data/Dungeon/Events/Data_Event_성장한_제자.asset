    key: "data.randomeventdata.data_event_\uC131\uC7A5\uD55C_\uC81C\uC790.pages.0.options.2.title"
    lastText: "\uD3BC\uCE5C \uAE30\uB85D\uC744 \uB09A\uC544\uCC48\uB2E4."
