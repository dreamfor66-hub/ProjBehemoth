    key: "data.randomeventdata.data_event_\uC131\uC7A5\uD55C_\uC81C\uC790.pages.0.options.2.description"
    lastText: "\uACE8\uB4DC +35 \xB7 \uC774\uD6C4 \uC774 \uC5F0\uAD6C\uC790\uC758
      \uC218\uC5C5\uC744 \uBC1B\uC9C0 \uBABB\uD568"
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: "data.randomeventdata.data_event_\uC131\uC7A5\uD55C_\uC81C\uC790.pages.0.options.2.resulttext"
    lastText: "\uB178\uC778\uC774 \uB0A8\uC740 \uAE30\uB85D\uC744 \uAC00\uBC29\uC5D0
      \uB123\uACE0 \uC190\uC744 \uAC70\uB480\uB2E4. \uCC59\uAE34 \uBB3C\uAC74\uC740
      \uB0B4\uB2E4 \uD314 \uC218 \uC788\uACA0\uC9C0\uB9CC, \uC774 \uC0AC\uB78C\uC5D0\uAC8C
      \uB2E4\uC74C \uC218\uC5C5\uC744 \uCCAD\uD560 \uC218\uB294 \uC5C6\uC744 \uAC83\uC774\uB2E4.
      \uADF8\uB294 \uC544\uBB34 \uB9D0 \uC5C6\uC774 \uB2E4\uB978 \uD1B5\uB85C\uB85C
      \uC0AC\uB77C\uC84C\uB2E4."
  - propertyPath: pages.Array.data[4].options.Array.data[1].title
    key: "data.randomeventdata.data_event_\uC131\uC7A5\uD55C_\uC81C\uC790.pages.4.options.1.title"
    lastText: "\uD3BC\uCE5C \uAE30\uB85D\uC744 \uB09A\uC544\uCC48\uB2E4."
  - propertyPath: pages.Array.data[4].options.Array.data[1].description
    key: "data.randomeventdata.data_event_\uC131\uC7A5\uD55C_\uC81C\uC790.pages.4.options.1.description"
    lastText: "\uACE8\uB4DC +35 \xB7 \uC774\uD6C4 \uC774 \uC5F0\uAD6C\uC790\uC758
      \uC218\uC5C5\uC744 \uBC1B\uC9C0 \uBABB\uD568"
