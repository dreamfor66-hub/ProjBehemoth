    lastText: 
  - propertyPath: pages.Array.data[3].narrative
    key: data.randomeventdata.magicteacherreturn.pages.3.narrative
    lastText: "\uC74C\u2026 \uADF8\uAC70\uAE4C\uC9C0\uB294 \uC544\uC9C1 \uC790\uC9C8\uC774
      \uC548 \uBCF4\uC774\uB294\uB370\uC694.\r\n\r\n\uC9C0\uAE08\uC740 \uB9C8\uB825\uC744
      \uB354 \uB2F4\uB294 \uC5F0\uC2B5\uBD80\uD130 \uD558\uB294 \uAC8C \uC88B\uACA0\uC2B5\uB2C8\uB2E4.
      \uBC30\uC6B8 \uC218 \uC788\uB294 \uAC83\uBD80\uD130 \uD574 \uBCFC\uAE4C\uC694?"
  - propertyPath: pages.Array.data[3].options.Array.data[0].title
    key: data.randomeventdata.magicteacherreturn.pages.3.options.0.title
    lastText: "\uAC00\uB2A5\uD55C \uB2E4\uB978 \uC218\uC5C5\uC744 \uACE0\uB978\uB2E4."
  - propertyPath: pages.Array.data[3].options.Array.data[0].description
    key: data.randomeventdata.magicteacherreturn.pages.3.options.0.description
    lastText: 
  - propertyPath: pages.Array.data[3].options.Array.data[0].resultText
    key: data.randomeventdata.magicteacherreturn.pages.3.options.0.resulttext
    lastText: 
  - propertyPath: pages.Array.data[3].options.Array.data[1].title
    key: data.randomeventdata.magicteacherreturn.pages.3.options.1.title
    lastText: "\uC218\uC5C5\uC744 \uBBF8\uB8E8\uACE0 \uAE38\uC744 \uACC4\uC18D \uAC04\uB2E4."
  - propertyPath: pages.Array.data[3].options.Array.data[1].description
    key: data.randomeventdata.magicteacherreturn.pages.3.options.1.description
    lastText: 
  - propertyPath: pages.Array.data[3].options.Array.data[1].resultText
    key: data.randomeventdata.magicteacherreturn.pages.3.options.1.resulttext
    lastText: "\uB354 \uB2E4\uAC00\uAC00\uC9C0 \uC54A\uACE0 \uAE38\uC744 \uBE44\uCF30\uB2E4.
      \uC544\uC9C1 \uACB0\uC815\uC744 \uB0B4\uB9AC\uC9C0\uB294 \uC54A\uC558\uB2E4."
  - propertyPath: pages.Array.data[4].narrative
    key: data.randomeventdata.magicteacherreturn.pages.4.narrative
    lastText: "\uB178\uC778\uC774 \uB0B4 \uC190\uB05D\uACFC \uAD50\uBCF8\uC758 \uB2E4\uC74C
      \uC7A5\uC744 \uBC88\uAC08\uC544 \uBCF8\uB2E4.\n\n\u201C\uC0C8 \uD798\uC744
      \uC5B9\uAE30 \uC804\uC5D0 \uC9C0\uAE08 \uC544\uB294 \uC8FC\uBB38\uBD80\uD130
      \uB354 \uC775\uD600\uC57C\uACA0\uAD70\uC694. \uC798 \uC548 \uB41C \uB3D9\uC791\uC744
      \uAE30\uC5B5\uD574 \uB450\uC138\uC694. \uADF8\uAC78 \uBD10\uC57C \uC5B4\uB514\uB97C
      \uACE0\uCE60\uC9C0 \uC555\uB2C8\uB2E4.\u201D\n\n\uADF8\uB294 \uAD50\uBCF8\uC744
      \uC811\uC5B4 \uC9C0\uB3C4\uD310 \uBC11\uC5D0 \uB07C\uC6B0\uACE0 \uBD84\uD544\uC744
      \uAEBC\uB0B8\uB2E4. \uC544\uC9C1 \uC9C0\uC6B0\uC9C0 \uBABB\uD55C \uAE38\uC774
      \uB0A8\uC544 \uC788\uB2E4."
  - propertyPath: pages.Array.data[4].options.Array.data[0].title
    key: data.randomeventdata.magicteacherreturn.pages.4.options.0.title
    lastText: "\uC8FC\uBB38\uC744 \uB354 \uC775\uD78C \uB4A4 \uB2E4\uC2DC \uB9D0
      \uAC78\uAE30\uB85C \uD55C\uB2E4."
  - propertyPath: pages.Array.data[4].options.Array.data[0].description
    key: data.randomeventdata.magicteacherreturn.pages.4.options.0.description
    lastText: 
  - propertyPath: pages.Array.data[4].options.Array.data[0].resultText
    key: data.randomeventdata.magicteacherreturn.pages.4.options.0.resulttext
    lastText: "\uC190\uC744 \uAC70\uB480\uB2E4. \uB178\uC778\uC740 \uC9E7\uAC8C \uACE0\uAC1C\uB97C
      \uB044\uB355\uC774\uACE0 \uC9C0\uB3C4\uC5D0 \uC0C8 \uC120\uC744 \uAE0B\uAE30
      \uC2DC\uC791\uD588\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[4].title
    key: "data.randomeventdata.data_event_\uC131\uC7A5\uD55C_\uC81C\uC790.pages.1.options.4.title"
    lastText: "\uC544\uC8FC \uD070 \uB9C8\uBC95\uC744 \uBC30\uC6B0\uACE0 \uC2F6\uB2E4\uACE0
      \uD55C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[4].description
    key: "data.randomeventdata.data_event_\uC131\uC7A5\uD55C_\uC81C\uC790.pages.1.options.4.description"
    lastText: 
