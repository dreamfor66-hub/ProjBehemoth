  m_Name: Training
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.training.displayname
    lastText: "\uC624\uB298\uC758 \uC0C1\uB300\uB97C \uACE0\uB974\uC2DC\uC624"
  - propertyPath: narrative
    key: data.randomeventdata.training.narrative
    lastText: "\uD6C8\uB828\uC7A5\uC5D0 \uB4E4\uC5B4\uC11C\uC790 \uB098\uBB34 \uC778\uD615
      \uC138 \uAC1C\uAC00 \uB3D9\uC2DC\uC5D0 \uACE0\uAC1C\uB97C \uB3CC\uB9B0\uB2E4.\r\n\r\n\uCCAB\uC9F8\uB294
      \uB048, \uB458\uC9F8\uB294 \uCCA0\uC0AC, \uC14B\uC9F8\uB294 \uAD75\uC740 \uC0AC\uC2AC\uB85C
      \uBB36\uC5EC \uC788\uB2E4.\r\n\r\n\uBCBD\uC758 \uC548\uB0B4\uD310\uC5D0\uB294
      \uAC01 \uC778\uD615\uC758 \uC704\uD5D8\uB3C4\uC640 \uBCF4\uC0C1\uC774 \uC801\uD600
      \uC788\uB2E4.\r\n\r\n\uB3C4\uC804\uD560 \uC0C1\uB300\uC758 \uAD6C\uC18D\uC744
      \uD480\uC5B4 \uC8FC\uC2ED\uC2DC\uC624."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.training.options.0.title
    lastText: "\uB048\uC744 \uD47C\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.training.options.0.description
    lastText: "\uC5F0\uC2B5 \uC778\uD615 \uCCB4\uB825 75. \uC2B9\uB9AC \uD6C4 \uD3EC\uC158
      1\uAC1C. \uD3EC\uC158\uC774 \uAC00\uB4DD\uD558\uBA74 \uCCB4\uB825 8 \uD68C\uBCF5."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.training.options.1.title
    lastText: "\uCCA0\uC0AC\uB97C \uB04A\uB294\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.training.options.1.description
    lastText: "\uC5F0\uC2B5 \uC778\uD615 \uCCB4\uB825 140. \uC2B9\uB9AC \uD6C4 \uBCF4\uC720
      \uB2A5\uB825\uC744 \uB450 \uBC88 \uAC15\uD654."
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.training.options.2.title
    lastText: "\uC0AC\uC2AC\uC744 \uD47C\uB2E4"
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.training.options.2.description
    lastText: "\uC5F0\uC2B5 \uC778\uD615 \uCCB4\uB825 240. \uC2B9\uB9AC \uD6C4 \uACF5\uC6A9
      \uC720\uBB3C \uD558\uB098 \uC120\uD0DD."
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.training.options.0.resulttext
    lastText: 
