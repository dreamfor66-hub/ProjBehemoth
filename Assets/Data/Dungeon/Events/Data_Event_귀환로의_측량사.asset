  m_Name: "Data_Event_\uADC0\uD658\uB85C\uC758_\uCE21\uB7C9\uC0AC"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.magicteacherfirst.displayname
    lastText: "\uADC0\uD658\uB85C\uC758 \uCE21\uB7C9\uC0AC"
  - propertyPath: narrative
    key: data.randomeventdata.magicteacherfirst.narrative
    lastText: "\uB178\uC778\uC774 \uC9C0\uB3C4\uD310\uC758 \uC9C0\uC6CC\uC9C4 \uC120\uC744
      \uBD84\uD544\uB85C \uB367\uADF8\uB9B0\uB2E4. \uC678\uD22C\uC5D0\uB294 \uC870\uC0AC\uC6A9
      \uB098\uCE68\uBC18\uACFC \uC9E7\uC740 \uD45C\uC2DD \uB048\uC774 \uB9E4\uB2EC\uB824
      \uC788\uB2E4. \uD310 \uC544\uB798\uC5D0\uB294 \uD68C\uC218\uC18C\uC758 \uB0A9
      \uD45C\uC2DD\uC774 \uBB36\uC5EC \uC788\uB2E4.\n\n\uADF8\uAC00 \uB0B4 \uBC1C\uB4A4\uAFC8\uCE58\uC758
      \uBA3C\uC9C0\uB97C \uBCF4\uACE0 \uACE0\uAC1C\uB97C \uB4E0\uB2E4.\n\n\u201C\uADF8\uCABD\uC5D0\uC11C
      \uC624\uC168\uAD70\uC694. \uC774 \uC9C0\uB3C4\uC5D0\uB294 \uB9C9\uD614\uB2E4\uACE0
      \uC801\uD600 \uC788\uC5B4\uC11C\uC694. \uC81C\uAC00 \uB193\uCE5C \uAE38\uC774
      \uC788\uB098 \uBD05\uB2C8\uB2E4.\u201D"
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.magicteacherfirst.options.0.title
    lastText: "\uBC29\uAE08 \uC9C0\uB098\uC628 \uBC29\uD5A5\uC744 \uC9DA\uC5B4 \uC900\uB2E4."
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.magicteacherfirst.options.0.description
    lastText: 
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.magicteacherfirst.options.0.resulttext
    lastText: 
