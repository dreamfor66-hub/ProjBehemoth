  - propertyPath: pages.Array.data[3].options.Array.data[1].resultText
    key: data.randomeventdata.magicteacherfirst.pages.3.options.1.resulttext
    lastText: "\uB354 \uB2E4\uAC00\uAC00\uC9C0 \uC54A\uACE0 \uAE38\uC744 \uBE44\uCF30\uB2E4.
      \uC544\uC9C1 \uACB0\uC815\uC744 \uB0B4\uB9AC\uC9C0\uB294 \uC54A\uC558\uB2E4."
  - propertyPath: pages.Array.data[4].narrative
    key: data.randomeventdata.magicteacherfirst.pages.4.narrative
    lastText: "\uB178\uC778\uC774 \uC7A5\uAC11 \uD55C\uCABD\uC744 \uBC97\uACE0 \uC190\uAC00\uB77D\uC744
      \uCC9C\uCC9C\uD788 \uD3B8\uB2E4.\n\n\u201C\uBD88\uC528\uB97C \uB0B4\uB294 \uAC8C
      \uBA3C\uC800\uAC00 \uC544\uB2D9\uB2C8\uB2E4. \uC190\uB05D \uD55C\uACF3\uC5D0
      \uD798\uC744 \uB0A8\uACA8 \uB450\uC138\uC694. \uC228\uC774 \uB04A\uC5B4\uC838\uB3C4
      \uD769\uC5B4\uC9C0\uC9C0 \uC54A\uAC8C.\u201D"
  - propertyPath: pages.Array.data[4].options.Array.data[0].title
    key: data.randomeventdata.magicteacherfirst.pages.4.options.0.title
    lastText: "\uC601\uCC3D\uC744 \uB530\uB77C \uD55C\uB2E4."
