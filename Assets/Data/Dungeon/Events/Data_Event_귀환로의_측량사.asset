  - propertyPath: pages.Array.data[3].options.Array.data[0].resultText
    key: data.randomeventdata.magicteacherfirst.pages.3.options.0.resulttext
    lastText: "\uBA87 \uBC88\uC744 \uB418\uD480\uC774\uD55C \uB4A4\uC5D0\uC57C \uC190\uB05D\uC758
      \uD798\uC774 \uD769\uC5B4\uC9C0\uC9C0 \uC54A\uC558\uB2E4. \uB178\uC778\uC774
      \uB0B4 \uC190\uC758 \uD754\uC801\uC744 \uAD50\uBCF8 \uC5EC\uBC31\uC5D0 \uB0A8\uACBC\uB2E4.
      \u201C\uB2E4\uC74C \uAE38\uBAA9\uC5D0\uC11C \uD655\uC778\uD574 \uBD05\uC2DC\uB2E4.\u201D
