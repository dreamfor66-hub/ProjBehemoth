  m_Name: "Data_Event_\uB0B4\uC77C\uC758_\uD55C\uC228"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.hourglass.displayname
    lastText: "\uB0B4\uC77C\uC758 \uD55C\uC228"
  - propertyPath: narrative
    key: data.randomeventdata.hourglass.narrative
    lastText: "\uAE30\uB85D\uC2E4 \uCC45\uC0C1 \uC704\uC5D0\uC11C \uBAA8\uB798\uAC00
      \uAC70\uAFB8\uB85C \uD750\uB974\uACE0 \uC788\uB2E4.\r\n\r\n\uC606\uC5D0 \uB193\uC778
      \uAE30\uB85D\uC5D0\uB294 \uC774 \uBAA8\uB798\uC2DC\uACC4\uB85C \uC2DC\uAC04\uC744
      \uBE4C\uB9B4 \uC218 \uC788\uB2E4\uACE0 \uC801\uD600 \uC788\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.hourglass.options.0.title
    lastText: "\uB0B4\uC77C\uC744 \uC870\uAE08 \uC798\uB77C \uB0B8\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.hourglass.options.0.description
    lastText: "\uCD5C\uB300 \uCCB4\uB825 -8. \uAE68\uC5B4\uC9C4 \uBAA8\uB798\uC2DC\uACC4:
      \uCC28\uC9C0 \uC900\uBE44\uC2DC\uAC04\uACFC \uC8FC\uBB38 \uCFE8\uD0C0\uC784
      -12%."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.hourglass.options.1.title
    lastText: "\uC624\uB798\uB41C \uB3D9\uC791\uC744 \uBC84\uB9AC\uACE0 \uB2E4\uC2DC
      \uC775\uD78C\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.hourglass.options.1.description
    lastText: "\uBCF4\uC720 \uB2A5\uB825 \uD558\uB098 \uC81C\uAC70 \uD6C4 \uC0C8
      \uB2A5\uB825\uC744 \uB450 \uBC88 \uC120\uD0DD\uD55C\uB2E4."
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.hourglass.options.2.title
    lastText: "\uAE08 \uAC04 \uC720\uB9AC\uB97C \uBAA8\uC740\uB2E4"
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.hourglass.options.2.description
    lastText: "\uACE8\uB4DC +10. \uC2DC\uAC04\uC758 \uD798\uC740 \uC5BB\uC9C0 \uC54A\uB294\uB2E4."
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.hourglass.options.0.resulttext
    lastText: 
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.hourglass.options.1.resulttext
    lastText: 
  - propertyPath: options.Array.data[2].resultText
    key: data.randomeventdata.hourglass.options.2.resulttext
    lastText: 
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.hourglass.pages.0.narrative
    lastText: "\uAE30\uB85D\uC2E4 \uCC45\uC0C1 \uC704\uC5D0\uC11C \uBAA8\uB798\uAC00
      \uAC70\uAFB8\uB85C \uD750\uB974\uACE0 \uC788\uB2E4.\r\n\r\n\uC606\uC5D0 \uB193\uC778
      \uAE30\uB85D\uC5D0\uB294 \uC774 \uBAA8\uB798\uC2DC\uACC4\uB85C \uC2DC\uAC04\uC744
      \uBE4C\uB9B4 \uC218 \uC788\uB2E4\uACE0 \uC801\uD600 \uC788\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.hourglass.pages.0.options.0.title
    lastText: "\uBAA8\uB798\uC2DC\uACC4\uB97C \uB4A4\uC9D1\uB294\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
    key: data.randomeventdata.hourglass.pages.0.options.0.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[0].resultText
    key: data.randomeventdata.hourglass.pages.0.options.0.resulttext
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[1].title
    key: data.randomeventdata.hourglass.pages.0.options.1.title
    lastText: "\uC8FC\uBCC0\uC758 \uAE68\uC9C4 \uC720\uB9AC\uB9CC \uCC59\uAE34\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
    key: data.randomeventdata.hourglass.pages.0.options.1.description
    lastText: "\uACE8\uB4DC +10"
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: data.randomeventdata.hourglass.pages.0.options.1.resulttext
    lastText: "\uC7A5\uBE44\uB97C \uCC59\uAE30\uACE0 \uB2E4\uC2DC \uBCF5\uB3C4\uB85C
      \uB098\uC130\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].title
    key: data.randomeventdata.hourglass.pages.0.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].description
    key: data.randomeventdata.hourglass.pages.0.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: data.randomeventdata.hourglass.pages.0.options.2.resulttext
    lastText: "\uADF8\uB300\uB85C \uC790\uB9AC\uB97C \uB5A0\uB0AC\uB2E4."
  - propertyPath: pages.Array.data[1].narrative
    key: data.randomeventdata.hourglass.pages.1.narrative
    lastText: "\uBAB8\uC774 \uAC00\uBCBC\uC6CC\uC9C4\uB2E4. \uB0B4\uAC00 \uC6C0\uC9C1\uC774\uB294
      \uB3D9\uC548 \uB5A8\uC5B4\uC9C0\uB358 \uC885\uC774 \uD55C \uC7A5\uC774 \uACF5\uC911\uC5D0
      \uBA48\uCDB0 \uC788\uB2E4.\r\n\r\n\uC720\uB9AC\uC5D0 \uAE08\uC774 \uD558\uB098
      \uB354 \uC0DD\uACBC\uB2E4.\r\n\r\n\uAE30\uB85D\uC744 \uB354 \uC77D\uC5B4 \uBCF4\uB2C8,
      \uC2DC\uAC04\uC744 \uBE4C\uB9B0 \uB9CC\uD07C \uC218\uBA85\uC774 \uC904\uC5B4\uB4E0\uB2E4\uACE0
      \uD55C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].title
    key: data.randomeventdata.hourglass.pages.1.options.0.title
    lastText: "\uC218\uBA85\uC744 \uB0B4\uC5B4 \uC8FC\uACE0 \uAC00\uC838\uAC04\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].description
    key: data.randomeventdata.hourglass.pages.1.options.0.description
    lastText: "\uAE68\uC5B4\uC9C4 \uBAA8\uB798\uC2DC\uACC4 \uD68D\uB4DD"
  - propertyPath: pages.Array.data[1].options.Array.data[0].resultText
    key: data.randomeventdata.hourglass.pages.1.options.0.resulttext
    lastText: "\uC7A5\uBE44\uB97C \uCC59\uAE30\uACE0 \uB2E4\uC2DC \uBCF5\uB3C4\uB85C
      \uB098\uC130\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].title
    key: data.randomeventdata.hourglass.pages.1.options.1.title
    lastText: "\uAE30\uC220\uC744 \uC775\uD788\uAE30 \uC804\uC73C\uB85C \uC2DC\uAC04\uC744
      \uB418\uB3CC\uB9B0\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].description
    key: data.randomeventdata.hourglass.pages.1.options.1.description
    lastText: "\uB2A5\uB825 \uD558\uB098 \uC81C\uAC70 \xB7 \uC0C8 \uB2A5\uB825 \uC120\uD0DD
      \xB7 \uC0C8 \uB2A5\uB825 \uC120\uD0DD"
  - propertyPath: pages.Array.data[1].options.Array.data[1].resultText
    key: data.randomeventdata.hourglass.pages.1.options.1.resulttext
    lastText: "\uC7A5\uBE44\uB97C \uCC59\uAE30\uACE0 \uB2E4\uC2DC \uBCF5\uB3C4\uB85C
      \uB098\uC130\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[2].title
    key: data.randomeventdata.hourglass.pages.1.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[2].description
    key: data.randomeventdata.hourglass.pages.1.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[2].resultText
    key: data.randomeventdata.hourglass.pages.1.options.2.resulttext
    lastText: "\uC8FC\uBCC0\uC758 \uC6C0\uC9C1\uC784\uC774 \uB3CC\uC544\uC654\uB2E4.
      \uB354 \uC2DC\uAC04\uC744 \uBE4C\uB9AC\uC9C0\uB294 \uC54A\uC558\uB2E4."
