  - propertyPath: pages.Array.data[0].options.Array.data[2].description
    key: data.randomeventdata.lostbeliever.pages.0.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: data.randomeventdata.lostbeliever.pages.0.options.2.resulttext
    lastText: "\uB354 \uB2E4\uAC00\uAC00\uC9C0 \uC54A\uACE0 \uAE38\uC744 \uBE44\uCF30\uB2E4.
      \uC544\uC9C1 \uACB0\uC815\uC744 \uB0B4\uB9AC\uC9C0\uB294 \uC54A\uC558\uB2E4."
  - propertyPath: pages.Array.data[1].narrative
    key: data.randomeventdata.lostbeliever.pages.1.narrative
    lastText: "\uC18C\uB144\uC774 \uB0B4\uAC00 \uC9C0\uB2CC \uD45C\uC2DD\uC744 \uC54C\uC544\uBCF4\uACE0
      \uC77C\uC5B4\uC120\uB2E4.\n\n\u201C\uADF8 \uD45C\uC2DD, \uC774\uB984\uC774
      \uC0C8\uACA8\uC9C4 \uB3CC\uC744 \uB4E4\uACE0 \uB2E4\uB2C8\uB294 \uBD84\uAED8
      \uBC1B\uC73C\uC168\uB098\uC694?\u201D"
  - propertyPath: pages.Array.data[1].options.Array.data[0].title
    key: data.randomeventdata.lostbeliever.pages.1.options.0.title
    lastText: "\uC21C\uB840\uC790\uAC00 \uD5A5\uD55C \uD1B5\uB85C\uB97C \uC54C\uB824
      \uC900\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].description
    key: data.randomeventdata.lostbeliever.pages.1.options.0.description
    lastText: "\uAE38\uC7A1\uC774\uC758 \uB4F1\uBD88 \uD68D\uB4DD"
  - propertyPath: pages.Array.data[1].options.Array.data[0].resultText
    key: data.randomeventdata.lostbeliever.pages.1.options.0.resulttext
    lastText: "\uD45C\uC2DD\uC744 \uBCF4\uC5EC \uC8FC\uACE0 \uC21C\uB840\uC790\uAC00
      \uD5A5\uD55C \uD1B5\uB85C\uB97C \uC9DA\uC5B4 \uC8FC\uC5C8\uB2E4. \uC18C\uB144\uC740
      \uBCF4\uB2F5\uC774\uB77C\uBA70 \uC791\uC740 \uB4F1\uBD88\uC744 \uAC74\uB124\uACE0
      \uBCF4\uB530\uB9AC\uB97C \uC548\uC544 \uB4E4\uC5C8\uB2E4. \uC6B0\uB9AC\uB294
      \uC11C\uB85C \uB2E4\uB978 \uAE38\uB85C \uD5A5\uD588\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].title
    key: data.randomeventdata.lostbeliever.pages.1.options.1.title
    lastText: "\uC9D1\uC73C\uB85C \uB3CC\uC544\uAC08 \uAE38\uB9CC \uADF8\uB824 \uC900\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].description
    key: data.randomeventdata.lostbeliever.pages.1.options.1.description
    lastText: "\uCCB4\uB825 +15"
  - propertyPath: pages.Array.data[1].options.Array.data[1].resultText
    key: data.randomeventdata.lostbeliever.pages.1.options.1.resulttext
    lastText: "\uB178\uC778\uC774 \uC788\uB294\uC9C0\uB294 \uBAA8\uB974\uC9C0\uB9CC
      \uB0B4\uAC00 \uC628 \uBC29\uD5A5\uC740 \uC9C0\uB098\uAC08 \uC218 \uC788\uB2E4\uACE0
      \uC54C\uB824 \uC8FC\uC5C8\uB2E4. \uC18C\uB144\uC740 \uC190\uC5D0 \uB0A8\uC740
      \uC57D\uC744 \uB35C\uC5B4 \uB0B4 \uC0C1\uCC98\uC5D0 \uBC1C\uB77C \uC8FC\uC5C8\uB2E4.
      \uD45C\uC2DD\uC744 \uC18C\uB9E4 \uC548\uC5D0 \uB123\uACE0 \uADF8 \uAE38\uB85C
      \uC870\uC2EC\uC2A4\uB808 \uB5A0\uB0AC\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[2].title
    key: data.randomeventdata.lostbeliever.pages.1.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[2].description
    key: data.randomeventdata.lostbeliever.pages.1.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[2].resultText
    key: data.randomeventdata.lostbeliever.pages.1.options.2.resulttext
    lastText: "\uB354 \uB2E4\uAC00\uAC00\uC9C0 \uC54A\uACE0 \uAE38\uC744 \uBE44\uCF30\uB2E4.
      \uC544\uC9C1 \uACB0\uC815\uC744 \uB0B4\uB9AC\uC9C0\uB294 \uC54A\uC558\uB2E4."
  - propertyPath: pages.Array.data[2].narrative
    key: data.randomeventdata.lostbeliever.pages.2.narrative
    lastText: "\uC18C\uB144\uC774 \uC190\uBC14\uB2E5\uC744 \uD3B4 \uBCF4\uC778\uB2E4.
      \uB179\uC2A8 \uD68C\uC218\uD45C \uAC00\uC7A5\uC790\uB9AC\uAC00 \uC190\uC744
      \uAE01\uC5C8\uB2E4. \uB4B7\uBA74\uC5D0\uB294 \uB0A0\uCE74\uB85C\uC6B4 \uAE08\uC18D
      \uD14C\uAC00 \uB9D0\uB824 \uC788\uB2E4.\n\n\u201C\uC774\uAC78 \uB5BC\uC11C
      \uC9D1\uC5D0 \uAC00\uC838\uAC00\uACE0 \uC2F6\uC5B4\uC694. \uC774\uB984\uB9CC
      \uC788\uC73C\uBA74 \uB418\uB294\uB370.\u201D\n\n\uB9E8\uC190\uC73C\uB85C \uD14C\uB97C
      \uD3B4\uBA74 \uC190\uC774 \uAE4A\uC774 \uBCA0\uC77C \uAC83 \uAC19\uB2E4. \uC18C\uB144\uC740
      \uC954 \uD45C\uB97C \uB193\uC9C0 \uC54A\uB294\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].title
    key: data.randomeventdata.lostbeliever.pages.2.options.0.title
    lastText: "\uBD80\uB7EC\uC9C4 \uACE0\uB9AC\uB97C \uB9E8\uC190\uC73C\uB85C \uAEBE\uB294\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].description
    key: data.randomeventdata.lostbeliever.pages.2.options.0.description
    lastText: "\uCCB4\uB825 18 \uC9C0\uBD88 \xB7 \uB4F1\uBD88 \uC720\uBB3C \uD68D\uB4DD"
  - propertyPath: pages.Array.data[2].options.Array.data[0].resultText
    key: data.randomeventdata.lostbeliever.pages.2.options.0.resulttext
    lastText: "\uB0A0\uCE74\uB85C\uC6B4 \uC1E0\uB05D\uC5D0 \uB0B4 \uC190\uC774 \uCC22\uC5B4\uC84C\uB2E4.
      \uC18C\uB144\uC740 \uC190\uC744 \uBE7C\uB0B4\uACE0 \uB4F1\uBD88\uC744 \uB0B4\uAC8C
      \uAC74\uB138\uB2E4. \uB098\uB294 \uC21C\uB840\uC790\uAC00 \uC4F0\uB294 \uD45C\uC2DD\uC744
      \uC885\uC774\uC5D0 \uADF8\uB824 \uC8FC\uC5C8\uB2E4. \uBCF4\uB530\uB9AC\uB97C
      \uB2E4\uC2DC \uBB36\uC740 \uC18C\uB144\uC774 \uC778\uC0AC\uB97C \uD558\uACE0
      \uB3CC\uC544\uAC14\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[1].title
    key: data.randomeventdata.lostbeliever.pages.2.options.1.title
    lastText: "\uC548\uB0B4\uB3C4\uB97C \uADF8\uB824 \uB3CC\uC544\uAC00\uAC8C \uD55C\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[1].description
    key: data.randomeventdata.lostbeliever.pages.2.options.1.description
    lastText: "\uCCB4\uB825 +15"
  - propertyPath: pages.Array.data[2].options.Array.data[1].resultText
    key: data.randomeventdata.lostbeliever.pages.2.options.1.resulttext
    lastText: "\uB178\uC778\uC774 \uC788\uB294\uC9C0\uB294 \uBAA8\uB974\uC9C0\uB9CC
      \uB0B4\uAC00 \uC628 \uBC29\uD5A5\uC740 \uC9C0\uB098\uAC08 \uC218 \uC788\uB2E4\uACE0
      \uC54C\uB824 \uC8FC\uC5C8\uB2E4. \uC18C\uB144\uC740 \uC190\uC5D0 \uB0A8\uC740
      \uC57D\uC744 \uB35C\uC5B4 \uB0B4 \uC0C1\uCC98\uC5D0 \uBC1C\uB77C \uC8FC\uC5C8\uB2E4.
      \uD45C\uC2DD\uC744 \uC18C\uB9E4 \uC548\uC5D0 \uB123\uACE0 \uADF8 \uAE38\uB85C
      \uC870\uC2EC\uC2A4\uB808 \uB5A0\uB0AC\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[3].title
    key: "data.randomeventdata.data_event_\uADF8_\uB3CC\uC5D0_\uC801\uD78C_\uC774\uB984.pages.0.options.3.title"
    lastText: "\uBCF4\uB530\uB9AC\uB97C \uBD99\uB4E0 \uC190\uC744 \uB5BC\uC5B4 \uB0B8\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[3].description
    key: "data.randomeventdata.data_event_\uADF8_\uB3CC\uC5D0_\uC801\uD78C_\uC774\uB984.pages.0.options.3.description"
    lastText: "\uB4F1\uBD88 \uC720\uBB3C \uD68D\uB4DD"
  - propertyPath: pages.Array.data[0].options.Array.data[3].resultText
    key: "data.randomeventdata.data_event_\uADF8_\uB3CC\uC5D0_\uC801\uD78C_\uC774\uB984.pages.0.options.3.resulttext"
    lastText: "\uC18C\uB144\uC758 \uC190\uC744 \uC81C\uCE58\uACE0 \uD68C\uC218\uD45C\uC758
      \uAE08\uC18D \uD14C\uB97C \uB04A\uC5C8\uB2E4. \uC548\uCABD\uC758 \uC791\uC740
      \uD45C\uC7A5\uC744 \uAC00\uC838\uAC00\uC790 \uC18C\uB144\uC774 \uC774\uB984
      \uC801\uD78C \uC885\uC774\uB97C \uC6C0\uCF1C\uC954\uB2E4. \uB098\uB294 \uB354
      \uBA38\uBB3C\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uAC00 \uB0B4 \uB4A4\uB97C \uD53C\uD574
      \uD1B5\uB85C\uB85C \uBB3C\uB7EC\uB0AC\uB2E4."
  - propertyPath: options.Array.data[3].title
    key: "data.randomeventdata.data_event_\uADF8_\uB3CC\uC5D0_\uC801\uD78C_\uC774\uB984.options.3.title"
    lastText: "\uBCF4\uB530\uB9AC\uB97C \uBD99\uB4E0 \uC190\uC744 \uB5BC\uC5B4 \uB0B8\uB2E4."
  - propertyPath: options.Array.data[3].description
    key: "data.randomeventdata.data_event_\uADF8_\uB3CC\uC5D0_\uC801\uD78C_\uC774\uB984.options.3.description"
    lastText: "\uB4F1\uBD88 \uC720\uBB3C \uD68D\uB4DD"
  - propertyPath: options.Array.data[3].resultText
    key: "data.randomeventdata.data_event_\uADF8_\uB3CC\uC5D0_\uC801\uD78C_\uC774\uB984.options.3.resulttext"
    lastText: "\uC18C\uB144\uC758 \uC190\uC744 \uC81C\uCE58\uACE0 \uD68C\uC218\uD45C\uC758
      \uAE08\uC18D \uD14C\uB97C \uB04A\uC5C8\uB2E4. \uC548\uCABD\uC758 \uC791\uC740
      \uD45C\uC7A5\uC744 \uAC00\uC838\uAC00\uC790 \uC18C\uB144\uC774 \uC774\uB984
      \uC801\uD78C \uC885\uC774\uB97C \uC6C0\uCF1C\uC954\uB2E4. \uB098\uB294 \uB354
      \uBA38\uBB3C\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uAC00 \uB0B4 \uB4A4\uB97C \uD53C\uD574
      \uD1B5\uB85C\uB85C \uBB3C\uB7EC\uB0AC\uB2E4."
  textOwnerGuid: be7331d68afcaaa4bbb16cc5d097b544
  id: LostBeliever
  displayName: "\uADF8 \uB3CC\uC5D0 \uC801\uD78C \uC774\uB984"
  discovery: 1
  worldObject: {fileID: 11400000, guid: d36f85516c50509478c22de12d7ae539, type: 2}
  encounterKind: 1
  authoringLore: "\uC131 \uBC16 \uD68C\uC218\uC18C\uC5D0\uC11C \uC774\uB984\uD45C\uB97C
    \uB300\uC870\uD558\uB358 \uC218\uC2B5 \uC2EC\uBD80\uB984\uAFBC. \uC544\uBC84\uC9C0\uC758
    \uADC0\uD658 \uACC4\uC57D\uC774 \uC774\uB984 \uB3CC \uD558\uB098\uB85C \uC885\uACB0\uB418\uB824
    \uD558\uC790 \uC9C1\uC811 \uC6D0\uC815 \uC9D0\uC744 \uB530\uB77C \uB4E4\uC5B4\uC654\uB2E4.
    \uC77C\uD589\uACFC \uB5A8\uC5B4\uC838 \uAE30\uB85D\uACFC \uC720\uD488\uC744 \uBD99\uB4E4\uACE0
    \uC788\uB2E4. \uAD6C\uD558\uB294 \uAC83\uC740 \uBD80\uB098 \uBAA8\uD5D8\uC774
    \uC544\uB2C8\uB77C \uACC4\uC57D\uC11C\uC5D0 \uC801\uD788\uC9C0 \uC54A\uC740 \uB9C8\uC9C0\uB9C9
    \uD589\uC801\uC774\uB2E4. \uC2AC\uD514\uC740 \uC774 \uC778\uBB3C\uC758 \uACE0\uC720\uD55C
    \uC0C1\uD669\uC774\uBA70 \uC804\uCCB4 \uB358\uC804 \uC8FC\uBBFC\uC758 \uAE30\uBCF8
    \uD0DC\uB3C4\uAC00 \uC544\uB2C8\uB2E4."
  roomLayout: 0
  roomInteriors:
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
  roomTheme: {fileID: 0}
  excludedFromRandomPool: 0
  narrative: "\uC18C\uB144\uC774 \uB0A1\uC740 \uD68C\uC218\uD45C\uB97C \uC190\uBC14\uB2E5\uC73C\uB85C
    \uBB38\uC9C0\uB978\uB2E4. \uD45C\uC2DD\uC758 \uC774\uB984\uACFC \uC885\uC774\uC5D0
    \uBCA0\uB080 \uC774\uB984\uC774 \uAC19\uB2E4.\n\n\u201C\uC800\uB294 \uD68C\uC218\uC18C
    \uC2EC\uBD80\uB984\uC744 \uD569\uB2C8\uB2E4. \uC774 \uD45C\uC5D0 \uC801\uD78C
    \uC0AC\uB78C\uC740\u2026 \uC81C \uC544\uBC84\uC9C0\uC608\uC694. \uB204\uAC00
    \uAC00\uC838\uC628 \uAC74\uC9C0 \uBB3C\uC73C\uB7EC \uB0B4\uB824\uC654\uC2B5\uB2C8\uB2E4.\u201D\n\n\uD68C\uC218\uC18C\uC758
    \uBC30\uB2EC \uC644\uC7A5\uC774 \uC18C\uB144\uC758 \uC190\uBAA9\uC5D0\uC11C \uD5D0\uAC81\uAC8C
    \uB3C8\uB2E4. \uADF8\uB294 \uB0B4\uAC00 \uC628 \uD1B5\uB85C\uC640 \uC950\uACE0
    \uC788\uB294 \uD45C\uC2DD\uC744 \uBC88\uAC08\uC544 \uBCF8\uB2E4.\n\n\u201C\uD45C\uC2DD\uC744
    \uB2EC\uACE0 \uB2E4\uB2C8\uB294 \uB178\uC778\uC744 \uBABB \uBCF4\uC168\uB098\uC694?\u201D"
  illustration: {fileID: 21300000, guid: 11e0d1b3e1e6f5e43b7d9e30828e0d6b, type: 3}
  accent: {r: 0.65, g: 0.8, b: 0.65, a: 1}
  illustratedPopup: 1
  minAct: 2
  maxAct: 3
  weight: 0.35
  minNormalCombatsInAct: 0
  referenceUrl: https://op.gg/ko/slay-the-spire2/events/TheLegendsWereTrue
  referenceExperience: "\uC774\uC804 \uC0AC\uAC74\uC758 \uC778\uC5F0\uC73C\uB85C
    \uD2B9\uBCC4 \uBCF4\uC0C1, \uC5C6\uC73C\uBA74 \uD604\uC7AC \uCCB4\uB825\uC73C\uB85C
    \uB3D5\uAC70\uB098 \uB2E4\uB978 \uD68C\uBCF5 \uC120\uD0DD.\n\uC11C\uC0AC/\uC5F0\uCD9C:
    Docs/Production/EventSequences-Castle.md\n\uC11C\uC0AC/\uC5F0\uCD9C: Docs/Production/EventSequences-Castle.md\n2026-11-01
