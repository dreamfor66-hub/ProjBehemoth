    lastText: "\uB178\uC778\uC774 \uC788\uB294\uC9C0\uB294 \uBAA8\uB974\uC9C0\uB9CC
      \uB0B4\uAC00 \uC628 \uBC29\uD5A5\uC740 \uC9C0\uB098\uAC08 \uC218 \uC788\uB2E4\uACE0
