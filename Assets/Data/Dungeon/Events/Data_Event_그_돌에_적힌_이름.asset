%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: "Data_Event_\uADF8_\uB3CC\uC5D0_\uC801\uD78C_\uC774\uB984"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.lostbeliever.displayname
    lastText: "\uADF8 \uB3CC\uC5D0 \uC801\uD78C \uC774\uB984"
  - propertyPath: narrative
    key: data.randomeventdata.lostbeliever.narrative
    lastText: "\uC18C\uB144\uC774 \uB0A1\uC740 \uD68C\uC218\uD45C\uB97C \uC190\uBC14\uB2E5\uC73C\uB85C
      \uBB38\uC9C0\uB978\uB2E4. \uD45C\uC2DD\uC758 \uC774\uB984\uACFC \uC885\uC774\uC5D0
      \uBCA0\uB080 \uC774\uB984\uC774 \uAC19\uB2E4.\n\n\u201C\uC800\uB294 \uD68C\uC218\uC18C
      \uC2EC\uBD80\uB984\uC744 \uD569\uB2C8\uB2E4. \uC774 \uD45C\uC5D0 \uC801\uD78C
      \uC0AC\uB78C\uC740\u2026 \uC81C \uC544\uBC84\uC9C0\uC608\uC694. \uB204\uAC00
      \uAC00\uC838\uC628 \uAC74\uC9C0 \uBB3C\uC73C\uB7EC \uB0B4\uB824\uC654\uC2B5\uB2C8\uB2E4.\u201D\n\n\uD68C\uC218\uC18C\uC758
      \uBC30\uB2EC \uC644\uC7A5\uC774 \uC18C\uB144\uC758 \uC190\uBAA9\uC5D0\uC11C
      \uD5D0\uAC81\uAC8C \uB3C8\uB2E4. \uADF8\uB294 \uB0B4\uAC00 \uC628 \uD1B5\uB85C\uC640
      \uC950\uACE0 \uC788\uB294 \uD45C\uC2DD\uC744 \uBC88\uAC08\uC544 \uBCF8\uB2E4.\n\n\u201C\uD45C\uC2DD\uC744
      \uB2EC\uACE0 \uB2E4\uB2C8\uB294 \uB178\uC778\uC744 \uBABB \uBCF4\uC168\uB098\uC694?\u201D"
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.lostbeliever.options.0.title
    lastText: "\uC18C\uB144\uC758 \uAE30\uB85D\uC744 \uC0B4\uD3B4\uBCF8\uB2E4."
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.lostbeliever.options.0.description
    lastText: 
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.lostbeliever.options.1.title
    lastText: "\uC548\uC804\uD558\uAC8C \uB3CC\uC544\uAC08 \uAE38\uC744 \uADF8\uB824
      \uC900\uB2E4."
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.lostbeliever.options.1.description
    lastText: "\uCCB4\uB825 +15"
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.lostbeliever.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.lostbeliever.options.2.description
    lastText: 
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.lostbeliever.options.0.resulttext
    lastText: 
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.lostbeliever.options.1.resulttext
    lastText: "\uB178\uC778\uC774 \uC788\uB294\uC9C0\uB294 \uBAA8\uB974\uC9C0\uB9CC
      \uB0B4\uAC00 \uC628 \uBC29\uD5A5\uC740 \uC9C0\uB098\uAC08 \uC218 \uC788\uB2E4\uACE0
      \uC54C\uB824 \uC8FC\uC5C8\uB2E4. \uC18C\uB144\uC740 \uC190\uC5D0 \uB0A8\uC740
      \uC57D\uC744 \uB35C\uC5B4 \uB0B4 \uC0C1\uCC98\uC5D0 \uBC1C\uB77C \uC8FC\uC5C8\uB2E4.
      \uD45C\uC2DD\uC744 \uC18C\uB9E4 \uC548\uC5D0 \uB123\uACE0 \uADF8 \uAE38\uB85C
      \uC870\uC2EC\uC2A4\uB808 \uB5A0\uB0AC\uB2E4."
  - propertyPath: options.Array.data[2].resultText
    key: data.randomeventdata.lostbeliever.options.2.resulttext
    lastText: "\uB354 \uB2E4\uAC00\uAC00\uC9C0 \uC54A\uACE0 \uAE38\uC744 \uBE44\uCF30\uB2E4.
      \uC544\uC9C1 \uACB0\uC815\uC744 \uB0B4\uB9AC\uC9C0\uB294 \uC54A\uC558\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.lostbeliever.pages.0.narrative
    lastText: "\uC18C\uB144\uC774 \uB0A1\uC740 \uD68C\uC218\uD45C\uB97C \uC190\uBC14\uB2E5\uC73C\uB85C
      \uBB38\uC9C0\uB978\uB2E4. \uD45C\uC2DD\uC758 \uC774\uB984\uACFC \uC885\uC774\uC5D0
      \uBCA0\uB080 \uC774\uB984\uC774 \uAC19\uB2E4.\n\n\u201C\uC800\uB294 \uD68C\uC218\uC18C
