  pages:
  - narrative: "\uB178\uC778\uC774 \uBB34\uAC70\uC6B4 \uB3CC\uC790\uB8E8\uB97C \uACE0\uCCD0
      \uC548\uB294\uB2E4. \uB3CC\uB9C8\uB2E4 \uC0AC\uB78C\uC758 \uC774\uB984\uACFC
      \uB0A0\uC9DC\uAC00 \uC9E7\uAC8C \uC0C8\uACA8\uC838 \uC788\uB2E4.\n\n\u201C\uBAB8\uAE4C\uC9C0
      \uB370\uB824\uC62C \uC218 \uC5C6\uC73C\uBA74, \uC774\uB984\uC774\uB77C\uB3C4
      \uC788\uC5B4\uC57C \uB3C8\uC744 \uBC1B\uC9C0.\u201D\n\n\uBAA9\uC5D0 \uAC78\uB9B0
      \uD68C\uC218 \uD45C\uC2DD\uC740 \uC624\uB798 \uB2F3\uC558\uACE0, \uC790\uB8E8
      \uC548\uC5D0\uB294 \uC791\uC740 \uC720\uD488\uB4E4\uC774 \uCC9C\uC5D0 \uC2F8\uC5EC
      \uC788\uB2E4.\n\n\uB178\uC778\uC740 \uB3CC\uC544\uAC08 \uC6B4\uC784\uC744 \uC138\uB2E4
      \uB3D9\uC804\uC744 \uB2E4\uC2DC \uB123\uB294\uB2E4.\n\n\u201C\uC774 \uC774\uB984\uB4E4\uC744
      \uAE30\uB2E4\uB9AC\uB294 \uC0AC\uB78C\uB4E4\uC774 \uC788\uC5B4. \uC9C0\uB984\uAE38\uC744
      \uC54C\uBA74 \uC54C\uB824 \uC8FC\uACA0\uB098.\u201D"
    illustration: {fileID: 21300000, guid: 0640b813254b6dc438986781fd7620a5, type: 3}
