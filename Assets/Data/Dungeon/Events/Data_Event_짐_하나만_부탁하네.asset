  pages:
  - narrative: "\uB178\uC778\uC774 \uB3CC\uC790\uB8E8\uB97C \uB0B4\uB824\uB193\uACE0
      \uD5C8\uB9AC\uB97C \uD3B8\uB2E4. \uC790\uB8E8 \uC548\uC758 \uB3CC\uB9C8\uB2E4
      \uC774\uB984\uACFC \uB0A0\uC9DC\uAC00 \uC9E7\uAC8C \uC0C8\uACA8\uC838 \uC788\uB2E4.
      \uC791\uC740 \uC720\uD488\uB4E4\uC740 \uCC9C\uC5D0 \uB530\uB85C \uC2F8\uC600\uB2E4.\n\n\u201C\uBAB8\uC744
      \uBABB \uBE7C\uB0B4\uBA74 \uC774\uB984\uC774\uB77C\uB3C4 \uAC00\uC838\uAC00\uC57C\uC9C0.
      \uBC16\uC5D0\uC11C\uB294 \uC774\uAC78 \uBCF4\uACE0 \uADC0\uD658\uAE08\uC744
      \uB0B4\uC8FC\uAC70\uB4E0.\u201D\n\n\uADF8\uAC00 \uBAA9\uC758 \uB2F3\uC740 \uD68C\uC218\uD45C\uB97C
      \uBCF4\uC5EC \uC900\uB2E4.\n\n\u201C\uC774\uBC88\uC5D4 \uC9D0\uC774 \uBB34\uAC81\uAD70.
      \uC5EC\uBE44\uB97C \uC880 \uBCF4\uD0DC \uC8FC\uACA0\uB098. \uC774 \uD45C\uC7A5\uC740
      \uB300\uC2E0 \uB9E1\uACA8\uB3C4 \uC88B\uB124. \uB098\uB294 \uB2E4\uC74C \uC9D0\uC5D0
      \uC0C8\uB85C \uBC1B\uC73C\uBA74 \uB3FC.\u201D"
    illustration: {fileID: 21300000, guid: 0640b813254b6dc438986781fd7620a5, type: 3}
