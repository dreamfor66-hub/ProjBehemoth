    key: data.randomeventdata.scholar.pages.0.options.1.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
    key: data.randomeventdata.scholar.pages.0.options.1.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: data.randomeventdata.scholar.pages.0.options.1.resulttext
    lastText: "\uBB3C\uC774 \uB5A8\uC5B4\uC9C0\uB294 \uC18C\uB9AC\uB97C \uB4A4\uB85C\uD558\uACE0
      \uC11C\uACE0\uB97C \uB098\uC654\uB2E4."
  - propertyPath: pages.Array.data[1].narrative
    key: data.randomeventdata.scholar.pages.1.narrative
    lastText: "\uCC45\uC744 \uD3BC\uCE58\uC790 \uD398\uC774\uC9C0\uAC00 \uC190\uAC00\uB77D\uC744
      \uAC10\uC2FC\uB2E4.\r\n\r\n\uD55C \uC904\uC740 \uC77D\uACE0 \uAC00.\r\n\r\n\uAE30\uC220,
      \uC601\uCC3D, \uC57D\uC81C\uBC95\uC774 \uC801\uD78C \uC7A5\uC774 \uCC28\uB840\uB85C
      \uD3BC\uCCD0\uC9C4\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].title
    key: data.randomeventdata.scholar.pages.1.options.0.title
    lastText: "\uC774\uBBF8 \uC544\uB294 \uAE30\uC220\uC744 \uC77D\uB294\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].description
    key: data.randomeventdata.scholar.pages.1.options.0.description
    lastText: "\uBCF4\uC720 \uB2A5\uB825 \uD558\uB098 \uAC15\uD654"
  - propertyPath: pages.Array.data[1].options.Array.data[0].resultText
    key: data.randomeventdata.scholar.pages.1.options.0.resulttext
    lastText: "\uC7A5\uBE44\uB97C \uCC59\uAE30\uACE0 \uB2E4\uC2DC \uBCF5\uB3C4\uB85C
      \uB098\uC130\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].title
    key: data.randomeventdata.scholar.pages.1.options.1.title
    lastText: "\uC0C8\uB85C\uC6B4 \uC601\uCC3D\uC744 \uC77D\uB294\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].description
