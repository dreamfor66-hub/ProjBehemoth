    key: data.randomeventdata.scholar.pages.1.options.2.title
    lastText: "\uC57D\uC81C\uBC95\uC744 \uB530\uB77C \uD55C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[2].description
