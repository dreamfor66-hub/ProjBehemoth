    lastText: "\uB05D\uAE4C\uC9C0 \uC77D\uB294 \uBC95"
  - propertyPath: narrative
    key: data.randomeventdata.scholar.narrative
    lastText: "\uCC9C\uC7A5\uC5D0\uC11C \uBB3C\uC774 \uC0C8\uB294 \uC11C\uACE0\uC5D0
      \uCC45 \uD55C \uAD8C\uC774 \uB5A0 \uC788\uB2E4.\r\n\r\n\uB2E4\uB978 \uCC45\uB4E4\uC740
      \uBD88\uC5B4\uC11C \uCC22\uC5B4\uC84C\uB294\uB370, \uC774 \uCC45\uB9CC \uBA40\uCA61\uD558\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.scholar.options.0.title
    lastText: "\uC0C8 \uC601\uCC3D\uC5D0 \uD53C\uB85C \uBC11\uC904\uC744 \uAE0B\uB294\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.scholar.options.0.description
    lastText: "\uCCB4\uB825 -9. \uC8FC\uBB38 \uD558\uB098 \uC120\uD0DD."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.scholar.options.1.title
    lastText: "\uC774\uBBF8 \uC544\uB294 \uAD6C\uC808\uC744 \uB2E4\uC2DC \uC77D\uB294\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.scholar.options.1.description
    lastText: "\uBCF4\uC720 \uB2A5\uB825 \uD558\uB098\uB97C \uAC15\uD654\uD55C\uB2E4."
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.scholar.options.2.title
    lastText: "\uC57D\uC81C\uBC95 \uD55C \uCABD\uC744 \uBCA0\uB080\uB2E4"
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.scholar.options.2.description
    lastText: "\uD3EC\uC158 1\uAC1C. \uD3EC\uC158\uC774 \uAC00\uB4DD\uD558\uBA74
      \uCCB4\uB825 8 \uD68C\uBCF5."
