    lastText: "\uD3EC\uC158 1\uAC1C"
  - propertyPath: pages.Array.data[1].options.Array.data[2].resultText
    key: data.randomeventdata.scholar.pages.1.options.2.resulttext
    lastText: "\uC7A5\uBE44\uB97C \uCC59\uAE30\uACE0 \uB2E4\uC2DC \uBCF5\uB3C4\uB85C
      \uB098\uC130\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[3].title
    key: data.randomeventdata.scholar.pages.1.options.3.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[3].description
    key: data.randomeventdata.scholar.pages.1.options.3.description
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[3].resultText
    key: data.randomeventdata.scholar.pages.1.options.3.resulttext
    lastText: "\uBE48 \uD45C\uC9C0 \uCABD\uC73C\uB85C \uC190\uC744 \uBE7C\uC790 \uCC45\uC774
      \uB2E4\uC2DC \uBB3C \uC704\uC5D0 \uB5A0\uC62C\uB790\uB2E4."
  - propertyPath: pages.Array.data[2].narrative
    key: data.randomeventdata.scholar.pages.2.narrative
    lastText: "\uC601\uCC3D \uBD80\uBD84\uC740 \uC789\uD06C\uAC00 \uD750\uB824 \uC77D\uC744
      \uC218 \uC5C6\uB2E4.\r\n\r\n\uCC45 \uADC0\uD241\uC774\uC758 \uC124\uBA85\uC5D0\uB294
      \uD53C\uB97C \uB300\uBA74 \uAC10\uCDB0\uC9C4 \uAE00\uC790\uB97C \uC77D\uC744
      \uC218 \uC788\uB2E4\uACE0 \uC801\uD600 \uC788\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].title
    key: data.randomeventdata.scholar.pages.2.options.0.title
    lastText: "\uD53C\uB97C \uB5A8\uC5B4\uB728\uB824 \uC77D\uB294\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].description
