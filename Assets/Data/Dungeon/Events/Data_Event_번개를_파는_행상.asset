  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: "Data_Event_\uBC88\uAC1C\uB97C_\uD30C\uB294_\uD589\uC0C1"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.stormbottle.displayname
    lastText: "\uBC88\uAC1C\uB97C \uD30C\uB294 \uD589\uC0C1"
  - propertyPath: narrative
    key: data.randomeventdata.stormbottle.narrative
    lastText: "\uBFB0\uC871\uD55C \uBAA8\uC790\uB97C \uC4F4 \uC5EC\uC778\uC774 \uAE38\uAC00\uC5D0\uC11C
      \uBCD1 \uD558\uB098\uB97C \uD754\uB4E0\uB2E4. \uC720\uB9AC \uC548\uC5D0\uC11C
      \uC791\uC740 \uCC9C\uB465\uC774 \uC6B8\uB9B0\uB2E4.\n\n\u201C\uBB34\uAE30\uC5D0
      \uC4F8 \uBC88\uAC1C \uD544\uC694\uD558\uC138\uC694? \uC601\uCC3D\uC744 \uBAB0\uB77C\uB3C4
      \uB429\uB2C8\uB2E4.\u201D\n\n\uBCD1\uC744 \uAE30\uC6B8\uC774\uC790 \uBC88\uAC1C\uAC00
      \uC720\uB9AC\uBCBD\uC744 \uB530\uB77C \uC6C0\uC9C1\uC778\uB2E4.\n\n\u201C\uC9C1\uC811
      \uC8FC\uBB38\uC744 \uC4F0\uACE0 \uC2F6\uC73C\uBA74 \uC774 \uB450\uB8E8\uB9C8\uB9AC\uB97C
      \uBCF4\uC138\uC694. \uBE48 \uBCD1\uC744 \uBAA8\uC544 \uC8FC\uC154\uB3C4 \uD488\uC0AF\uC740
      \uB4DC\uB824\uC694.\u201D"
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.stormbottle.options.0.title
    lastText: "\uD3ED\uD48D \uD55C \uBCD1"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.stormbottle.options.0.description
    lastText: "45\uACE8\uB4DC \uC18C\uBAA8. \uCC28\uC9C0 \uC801\uC911\uC5D0 \uBC88\uAC1C
      \uD53C\uD574 8\uC744 \uB354\uD558\uB294 \uC720\uBB3C \uD68D\uB4DD."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.stormbottle.options.1.title
    lastText: "\uBC88\uAC1C\uB97C \uC77D\uB294 \uBC95"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.stormbottle.options.1.description
    lastText: "25\uACE8\uB4DC \uC18C\uBAA8. \uC8FC\uBB38 \uD558\uB098 \uC120\uD0DD."
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.stormbottle.options.2.title
    lastText: "\uBE48 \uBCD1 \uC218\uAC70\uB97C \uB3D5\uB294\uB2E4"
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.stormbottle.options.2.description
    lastText: "\uACE8\uB4DC +12. \uC720\uBB3C\uACFC \uC8FC\uBB38\uC740 \uC0AC\uC9C0
      \uC54A\uB294\uB2E4."
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.stormbottle.options.0.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.stormbottle.options.1.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: options.Array.data[2].resultText
    key: data.randomeventdata.stormbottle.options.2.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.stormbottle.pages.0.narrative
    lastText: "\uBFB0\uC871\uD55C \uBAA8\uC790\uB97C \uC4F4 \uC5EC\uC778\uC774 \uAE38\uAC00\uC5D0\uC11C
      \uBCD1 \uD558\uB098\uB97C \uD754\uB4E0\uB2E4. \uC720\uB9AC \uC548\uC5D0\uC11C
      \uC791\uC740 \uCC9C\uB465\uC774 \uC6B8\uB9B0\uB2E4.\n\n\u201C\uBB34\uAE30\uC5D0
      \uC4F8 \uBC88\uAC1C \uD544\uC694\uD558\uC138\uC694? \uC601\uCC3D\uC744 \uBAB0\uB77C\uB3C4
      \uB429\uB2C8\uB2E4.\u201D\n\n\uBCD1\uC744 \uAE30\uC6B8\uC774\uC790 \uBC88\uAC1C\uAC00
      \uC720\uB9AC\uBCBD\uC744 \uB530\uB77C \uC6C0\uC9C1\uC778\uB2E4.\n\n\u201C\uC9C1\uC811
      \uC8FC\uBB38\uC744 \uC4F0\uACE0 \uC2F6\uC73C\uBA74 \uC774 \uB450\uB8E8\uB9C8\uB9AC\uB97C
      \uBCF4\uC138\uC694. \uBE48 \uBCD1\uC744 \uBAA8\uC544 \uC8FC\uC154\uB3C4 \uD488\uC0AF\uC740
      \uB4DC\uB824\uC694.\u201D"
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.stormbottle.pages.0.options.0.title
    lastText: "\uD3ED\uD48D \uD55C \uBCD1"
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
    key: data.randomeventdata.stormbottle.pages.0.options.0.description
    lastText: "\uBCD1 \uC18D\uC758 \uD3ED\uD48D \uD68D\uB4DD"
  - propertyPath: pages.Array.data[0].options.Array.data[0].resultText
    key: data.randomeventdata.stormbottle.pages.0.options.0.resulttext
    lastText: "\uBC88\uAC1C\uAC00 \uAC07\uD78C \uBCD1\uC744 \uBC1B\uC558\uB2E4. \uC5EC\uC778\uC740
      \uB0A8\uC740 \uBCD1\uC758 \uB9C8\uAC1C\uB97C \uC810\uAC80\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].title
    key: data.randomeventdata.stormbottle.pages.0.options.1.title
    lastText: "\uBC88\uAC1C\uB97C \uC77D\uB294 \uBC95"
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
    key: data.randomeventdata.stormbottle.pages.0.options.1.description
    lastText: "\uC8FC\uBB38 \uD558\uB098 \uC2B5\uB4DD"
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: data.randomeventdata.stormbottle.pages.0.options.1.resulttext
    lastText: "\uC5EC\uC778\uC774 \uD3BC\uCE5C \uB450\uB8E8\uB9C8\uB9AC\uB97C \uC77D\uC5C8\uB2E4.
      \uC601\uCC3D\uC744 \uB418\uC9DA\uB294 \uB3D9\uC548 \uADF8\uB140\uB294 \uB0A8\uC740
      \uBCD1\uC744 \uC815\uB9AC\uD588\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].title
    key: data.randomeventdata.stormbottle.pages.0.options.2.title
    lastText: "\uBE48 \uBCD1 \uC218\uAC70\uB97C \uB3D5\uB294\uB2E4"
  - propertyPath: pages.Array.data[0].options.Array.data[2].description
    key: data.randomeventdata.stormbottle.pages.0.options.2.description
    lastText: "\uACE8\uB4DC +12"
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: data.randomeventdata.stormbottle.pages.0.options.2.resulttext
    lastText: "\uD769\uC5B4\uC9C4 \uBE48 \uBCD1\uC744 \uBAA8\uC544 \uAC74\uB124\uACE0
      \uD488\uC0AF\uC744 \uBC1B\uC558\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[3].title
    key: data.randomeventdata.stormbottle.pages.0.options.3.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[3].description
    key: data.randomeventdata.stormbottle.pages.0.options.3.description
