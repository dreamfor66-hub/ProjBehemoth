    failurePage: -1
    resultText: "\uB354 \uB2E4\uAC00\uAC00\uC9C0 \uC54A\uACE0 \uAE38\uC744 \uBE44\uCF30\uB2E4.
      \uC544\uC9C1 \uACB0\uC815\uC744 \uB0B4\uB9AC\uC9C0\uB294 \uC54A\uC558\uB2E4."
    resultingWorldObject: {fileID: 0}
    removeWorldObject: 0
    useWorldObject: 0
    leaveUnresolved: 1
    revisitTextKey: 
    requirements: []
    effects: []
  pages:
  - narrative: "\uC5EC\uC778\uC774 \uB450\uAEBC\uC6B4 \uC7A5\uAC11\uC73C\uB85C \uBCD1\uB9C8\uAC1C\uB97C
      \uC870\uC778\uB2E4. \uC720\uB9AC \uC548\uCABD\uC5D0\uC11C \uD770 \uC2E4\uAE08
      \uAC19\uC740 \uBC88\uAC1C\uAC00 \uBAA8\uC600\uB2E4 \uD769\uC5B4\uC9C0\uACE0,
      \uB9C8\uAC1C \uD2C8\uC5D0\uC11C \uC791\uC740 \uCC9C\uB465\uC774 \uB09C\uB2E4.\n\n\u201C\uC0C8
      \uBCD1\uC740 \uBE44\uC309\uB2C8\uB2E4. \uC131 \uC548\uC5D0\uC11C \uCC44\uC6B0\uACE0,
      \uBC16\uC5D0\uC11C \uD314\uC544\uC57C \uBCD1\uAC12\uC774 \uB098\uC640\uC694.\u201D\n\n\uB0A9\uD488\uD45C
      \uC544\uB798\uC5D0\uB294 \uC9C0\uC6B4 \uBE5A\uC758 \uC561\uC218\uAC00 \uC904\uC9C0\uC5B4
      \uC801\uD600 \uC788\uB2E4. \uADF8\uB140\uAC00 \uBC00\uB78D\uC744 \uB2E4\uC2DC
      \uB204\uB978\uB2E4.\n\n\u201C\uBD09\uC778\uB41C \uD55C \uBCD1\uC744 \uC0B4
      \uC218\uB3C4 \uC788\uACE0, \uC190\uB05D\uC5D0 \uB0A8\uAE30\uB294 \uBC95\uC744
      \uBC30\uC6B8 \uC218\uB3C4 \uC788\uC5B4\uC694. \uC81C \uACF5\uBC29\uC774 \uC0DD\uAE30\uBA74
      \uC774\uB7F0 \uB370\uAE4C\uC9C0 \uC548 \uC640\uB3C4 \uB418\uACA0\uC8E0.\u201D"
    illustration: {fileID: 21300000, guid: 8675f796249659e4ead89e24c1cf9a29, type: 3}
    options:
