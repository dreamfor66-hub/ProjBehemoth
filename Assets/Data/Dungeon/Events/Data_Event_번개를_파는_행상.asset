    resultText: "\uC5EC\uC778\uC758 \uBCD1 \uC8FC\uBA38\uB2C8\uB97C \uB09A\uC544\uCC44
      \uC785\uAD6C\uB97C \uC950\uC5C8\uB2E4. \uC720\uB9AC\uAC00 \uBD80\uB52A\uCE58\uC790
      \uADF8\uB140\uAC00 \uBD09\uC778\uB41C \uBCD1\uC744 \uD488\uC5D0 \uC228\uAE34\uB2E4.
      \uB098\uB294 \uBE48 \uBCD1 \uBC11\uC5D0 \uBAA8\uC778 \uC794\uB3C8\uC744 \uD138\uC5B4
      \uB0C8\uB2E4. \uADF8\uB140\uB294 \uB0A8\uC740 \uC9D0\uC744 \uCC59\uACA8 \uB2E4\uB978
