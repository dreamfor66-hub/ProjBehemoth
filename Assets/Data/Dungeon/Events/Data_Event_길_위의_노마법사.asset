  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.magicteacherfirst.displayname
    lastText: "\uAE38 \uC704\uC758 \uB178\uB9C8\uBC95\uC0AC"
  - propertyPath: narrative
    key: data.randomeventdata.magicteacherfirst.narrative
    lastText: "\uC789\uD06C \uBB3B\uC740 \uC190\uC758 \uB178\uC778\uC774 \uAE38\uAC00\uC5D0\uC11C
      \uB450\uB8E8\uB9C8\uB9AC\uB97C \uBD99\uC7A1\uACE0 \uC528\uB984\uD558\uACE0
      \uC788\uB2E4.\n\n\uADF8\uC758 \uC190\uC5D0\uC11C \uD758\uB7EC\uB098\uC628 \uC791\uC740
      \uBD88\uAF43\uC774 \uC637\uC790\uB77D\uC73C\uB85C \uC62E\uACA8\uBD99\uC73C\uB824
      \uD55C\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.magicteacherfirst.options.0.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: options.Array.data[0].description
