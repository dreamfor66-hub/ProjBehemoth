  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: Symbiosis
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.symbiosis.displayname
    lastText: "\uB450 \uBC88\uC9F8 \uB9E5\uBC15"
  - propertyPath: narrative
    key: data.randomeventdata.symbiosis.narrative
    lastText: "\uC5F0\uAE08\uC220\uC2E4 \uC2E4\uD5D8\uB300\uC5D0 \uBFCC\uB9AC\uAC00
      \uB3CB\uC740 \uC528\uC557\uC774 \uB193\uC5EC \uC788\uB2E4.\r\n\r\n\uC606\uC758
      \uAE30\uB85D\uC5D0\uB294 \uC219\uC8FC\uC758 \uC0DD\uBA85\uB825\uC744 \uBA39\uACE0
      \uADFC\uC721\uC744 \uAC15\uD654\uD558\uB294 \uC2DD\uBB3C\uC774\uB77C\uACE0
      \uC801\uD600 \uC788\uB2E4.\r\n\r\n\uBFCC\uB9AC\uB97C \uD0DC\uC6B4 \uC5F0\uAE30\uB294
      \uAE30\uC5B5\uC744 \uD750\uB9AC\uAC8C \uD558\uACE0, \uAECD\uC9C8\uC740 \uC0C1\uCC98\uC5D0
      \uC4F0\uB294 \uC57D\uC7AC\uB77C\uACE0 \uD55C\uB2E4.\r\n\r\n\uC190\uC744 \uAC00\uAE4C\uC774
      \uB300\uC790 \uBFCC\uB9AC\uAC00 \uB0B4 \uC190\uBAA9\uC744 \uD5A5\uD574 \uC6C0\uC9C1\uC778\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.symbiosis.options.0.title
    lastText: "\uBFCC\uB9AC\uB0B4\uB9B4 \uC790\uB9AC\uB97C \uC900\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.symbiosis.options.0.description
    lastText: "\uCD5C\uB300 \uCCB4\uB825 -12. \uACF5\uC0DD\uD558\uB294 \uC528\uC557:
      \uC77C\uBC18 \uBB34\uAE30 \uD53C\uD574 +25%, \uCC28\uC9C0 \uD53C\uD574 +20%."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.symbiosis.options.1.title
    lastText: "\uBFCC\uB9AC\uC640 \uD568\uAED8 \uBC84\uB987 \uD558\uB098\uB97C \uD0DC\uC6B4\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.symbiosis.options.1.description
    lastText: "\uBCF4\uC720 \uB2A5\uB825 \uD558\uB098 \uC81C\uAC70 \uD6C4 \uC0C8
      \uB2A5\uB825\uC744 \uC120\uD0DD\uD55C\uB2E4."
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.symbiosis.options.2.title
    lastText: "\uAECD\uC9C8\uC744 \uC57D\uC7AC\uB85C \uC4F4\uB2E4"
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.symbiosis.options.2.description
    lastText: "\uCCB4\uB825 10 \uD68C\uBCF5. \uC528\uC557\uC758 \uD798\uC740 \uB0A8\uAE34\uB2E4."
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.symbiosis.options.0.resulttext
    lastText: 
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.symbiosis.options.1.resulttext
    lastText: 
  - propertyPath: options.Array.data[2].resultText
    key: data.randomeventdata.symbiosis.options.2.resulttext
    lastText: 
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.symbiosis.pages.0.narrative
    lastText: "\uC5F0\uAE08\uC220\uC2E4 \uC2E4\uD5D8\uB300\uC5D0 \uBFCC\uB9AC\uAC00
      \uB3CB\uC740 \uC528\uC557\uC774 \uB193\uC5EC \uC788\uB2E4.\r\n\r\n\uC606\uC758
      \uAE30\uB85D\uC5D0\uB294 \uC219\uC8FC\uC758 \uC0DD\uBA85\uB825\uC744 \uBA39\uACE0
      \uADFC\uC721\uC744 \uAC15\uD654\uD558\uB294 \uC2DD\uBB3C\uC774\uB77C\uACE0
      \uC801\uD600 \uC788\uB2E4.\r\n\r\n\uBFCC\uB9AC\uB97C \uD0DC\uC6B4 \uC5F0\uAE30\uB294
      \uAE30\uC5B5\uC744 \uD750\uB9AC\uAC8C \uD558\uACE0, \uAECD\uC9C8\uC740 \uC0C1\uCC98\uC5D0
      \uC4F0\uB294 \uC57D\uC7AC\uB77C\uACE0 \uD55C\uB2E4.\r\n\r\n\uC190\uC744 \uAC00\uAE4C\uC774
      \uB300\uC790 \uBFCC\uB9AC\uAC00 \uB0B4 \uC190\uBAA9\uC744 \uD5A5\uD574 \uC6C0\uC9C1\uC778\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.symbiosis.pages.0.options.0.title
    lastText: "\uBFCC\uB9AC\uB0B4\uB9B4 \uC790\uB9AC\uB97C \uC900\uB2E4"
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
    key: data.randomeventdata.symbiosis.pages.0.options.0.description
    lastText: "\uACF5\uC0DD\uD558\uB294 \uC528\uC557 \uD68D\uB4DD"
  - propertyPath: pages.Array.data[0].options.Array.data[0].resultText
    key: data.randomeventdata.symbiosis.pages.0.options.0.resulttext
    lastText: "\uC7A5\uBE44\uB97C \uCC59\uAE30\uACE0 \uB2E4\uC2DC \uBCF5\uB3C4\uB85C
      \uB098\uC130\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].title
