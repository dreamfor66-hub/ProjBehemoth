    key: "data.randomeventdata.data_event_\uC9C0\uD321\uC774_\uB05D\uC758_\uC218\uC5C5.options.3.resulttext"
    lastText: "\uB178\uC778\uC774 \uAD50\uBCF8\uC744 \uAC00\uBC29\uC5D0 \uB123\uACE0
      \uC9C0\uB3C4\uD310\uC744 \uACE0\uCCD0 \uC954\uB2E4. \u201C\uC368 \uBCF4\uACE0
      \uB2E4\uC74C \uAE38\uBAA9\uC5D0\uC11C \uD655\uC778\uD569\uC2DC\uB2E4.\u201D
      \uC11C\uB85C \uC9C0\uB098\uC628 \uD45C\uC2DD\uC744 \uD655\uC778\uD558\uACE0
      \uAC01\uC790\uC758 \uD1B5\uB85C\uB85C \uD5A5\uD588\uB2E4."
  - propertyPath: options.Array.data[4].title
    key: "data.randomeventdata.data_event_\uC9C0\uD321\uC774_\uB05D\uC758_\uC218\uC5C5.options.4.title"
    lastText: "\uC9C0\uD321\uC774\uC758 \uC218\uC815\uC744 \uAC15\uC81C\uB85C \uB5BC\uC5B4
      \uB0B8\uB2E4."
  - propertyPath: options.Array.data[4].description
    key: "data.randomeventdata.data_event_\uC9C0\uD321\uC774_\uB05D\uC758_\uC218\uC5C5.options.4.description"
    lastText: "\uACE8\uB4DC +35 \xB7 \uC774\uD6C4 \uC774 \uC5F0\uAD6C\uC790\uC758
      \uC218\uC5C5\uC744 \uBC1B\uC9C0 \uBABB\uD568"
  - propertyPath: options.Array.data[4].resultText
    key: "data.randomeventdata.data_event_\uC9C0\uD321\uC774_\uB05D\uC758_\uC218\uC5C5.options.4.resulttext"
    lastText: "\uB178\uC778\uC774 \uB0A8\uC740 \uAE30\uB85D\uC744 \uAC00\uBC29\uC5D0
      \uB123\uACE0 \uC190\uC744 \uAC70\uB480\uB2E4. \uCC59\uAE34 \uBB3C\uAC74\uC740
      \uB0B4\uB2E4 \uD314 \uC218 \uC788\uACA0\uC9C0\uB9CC, \uC774 \uC0AC\uB78C\uC5D0\uAC8C
      \uB2E4\uC74C \uC218\uC5C5\uC744 \uCCAD\uD560 \uC218\uB294 \uC5C6\uC744 \uAC83\uC774\uB2E4.
      \uADF8\uB294 \uC544\uBB34 \uB9D0 \uC5C6\uC774 \uB2E4\uB978 \uD1B5\uB85C\uB85C
      \uC0AC\uB77C\uC84C\uB2E4."
  textOwnerGuid: 439941bfed097b44d8d55e5c147841f5
  id: MagicTeacherAdvanced
  displayName: "\uC9C0\uD321\uC774 \uB05D\uC758 \uC218\uC5C5"
  discovery: 1
  worldObject: {fileID: 11400000, guid: 95a5b5e8471ff7d4793635988e37cba7, type: 2}
  encounterKind: 1
  authoringLore: "\uD68C\uC218\uC18C\uC5D0 \uC0C8 \uADC0\uD658 \uC9C0\uB3C4\uB97C
    \uB0A9\uD488\uD558\uB294 \uD604\uC7A5 \uB9C8\uBC95\uC0AC. \uC61B \uC6D0\uC815\uB300\uC758
    \uAE38 \uD45C\uC2DC\uB97C \uC9C0\uB3C4\uB85C \uC62E\uAE30\uB418 \uC2E4\uC81C
    \uD1B5\uD589 \uC5EC\uBD80\uB97C \uD655\uC778\uD558\uBA70 \uC804\uC9C4\uD55C\uB2E4.
    \uB9CC\uB098\uB294 \uC6D0\uC815\uAC1D\uC5D0\uAC8C \uC9C0\uB098\uC628 \uD45C\uC2DD\uC744
    \uD655\uC778\uD558\uACE0, \uB2F5\uB840\uC640 \uD604\uC7A5 \uAE30\uB85D \uAD50\uD658\uC73C\uB85C
    \uC8FC\uBB38\uC744 \uAC00\uB974\uCE5C\uB2E4. \uAC01 \uB9C9\uC758 \uB2E4\uC74C
    \uAD50\uC2B5\uB3C4 \uC870\uC0AC \uC5EC\uC815 \uB3C4\uC911 \uB2E4\uC2DC \uB9CC\uB098\uB294
    \uB3D9\uC77C \uC778\uBB3C\uC774\uB2E4. \uBB34\uB2A5\uD55C \uBD88\uC7A5\uB09C/\uACF5\uAC04
    \uAC11\uC791\uC2A4\uB7F0 \uB4F1\uC7A5/\uD6C4\uBC29 \uC2B5\uACA9 \uC804\uC81C\uB294
    \uC5C6\uB2E4."
  roomLayout: 0
  roomInteriors:
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
  roomTheme: {fileID: 0}
  excludedFromRandomPool: 0
  narrative: "\uBD84\uD544 \uC790\uAD6D\uC774 \uBB3B\uC740 \uC9C0\uD321\uC774\uAC00
    \uAE38\uC744 \uB450\uB4DC\uB9B0\uB2E4. \uB178\uC778\uC774 \uC0C8 \uD45C\uC2DD
    \uB048\uC744 \uAC00\uBC29\uC5D0 \uB123\uC73C\uBA70 \uB098\uB97C \uC54C\uC544\uBCF8\uB2E4.\n\n\u201C\uC5EC\uAE30\uAE4C\uC9C0
    \uC654\uC73C\uBA74 \uADF8 \uC8FC\uBB38\uC740 \uC190\uC5D0 \uBD99\uC5C8\uACA0\uAD70\uC694.\u201D\n\n\uADF8\uAC00
    \uAD50\uBCF8 \uB4B7\uC7A5\uC744 \uD3BC\uCE5C\uB2E4. \u201C\uC774\uC81C \uB354
    \uD070 \uD798\uC744 \uC5B4\uB514\uC5D0 \uB0A8\uACA8 \uB458\uC9C0 \uC815\uD574
    \uBD05\uC2DC\uB2E4.\u201D"
  illustration: {fileID: 21300000, guid: c7cf755b429784641849a0792ff13bb5, type: 3}
