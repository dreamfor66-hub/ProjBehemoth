  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.magicteacheradvanced.displayname
    lastText: "\uC9C0\uD321\uC774 \uB05D\uC758 \uC218\uC5C5"
  - propertyPath: narrative
    key: data.randomeventdata.magicteacheradvanced.narrative
    lastText: "\uC218\uC815 \uC9C0\uD321\uC774\uB97C \uC9DA\uC740 \uB178\uC778\uC774
      \uAE38\uAC00\uC5D0\uC11C \uB0B4 \uB9C8\uB825\uC744 \uC0B4\uD540\uB2E4.\n\n\uC9C0\uB09C\uBC88\uC758
      \uC120\uC0DD\uC774\uB2E4. \uC9C0\uD321\uC774 \uB05D\uC758 \uBE5B\uC774 \uB0B4
      \uC190\uB05D\uC5D0 \uBC18\uC751\uD558\uC790 \uADF8\uB294 \uBA3C\uC800 \uCC45\uC744
      \uAEBC\uB0B8\uB2E4.\n\n\u201C\uC774\uC81C\uB294 \uB354 \uD070 \uC8FC\uBB38\uC744
      \uBC84\uD2F8 \uC218 \uC788\uACA0\uB124\uC694. \uC5B4\uB290 \uCABD\uC744 \uBC30\uC6CC
      \uBCFC\uAE4C\uC694?\u201D"
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.magicteacheradvanced.options.0.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.magicteacheradvanced.options.0.description
    lastText: 
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.magicteacheradvanced.options.0.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.magicteacheradvanced.pages.0.narrative
    lastText: "\uC218\uC815 \uC9C0\uD321\uC774\uB97C \uC9DA\uC740 \uB178\uC778\uC774
      \uAE38\uAC00\uC5D0\uC11C \uB0B4 \uB9C8\uB825\uC744 \uC0B4\uD540\uB2E4.\n\n\uC9C0\uB09C\uBC88\uC758
      \uC120\uC0DD\uC774\uB2E4. \uC9C0\uD321\uC774 \uB05D\uC758 \uBE5B\uC774 \uB0B4
      \uC190\uB05D\uC5D0 \uBC18\uC751\uD558\uC790 \uADF8\uB294 \uBA3C\uC800 \uCC45\uC744
      \uAEBC\uB0B8\uB2E4.\n\n\u201C\uC774\uC81C\uB294 \uB354 \uD070 \uC8FC\uBB38\uC744
      \uBC84\uD2F8 \uC218 \uC788\uACA0\uB124\uC694. \uC5B4\uB290 \uCABD\uC744 \uBC30\uC6CC
      \uBCFC\uAE4C\uC694?\u201D"
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.magicteacheradvanced.pages.0.options.0.title
    lastText: "\uD55C\uACF3\uC5D0 \uD070 \uBD88\uB369\uC774\uB97C \uB5A8\uC5B4\uB728\uB9AC\uB294
      \uBC95."
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
    key: data.randomeventdata.magicteacheradvanced.pages.0.options.0.description
    lastText: "\uAC70\uB300\uD55C \uC6B4\uC11D\uC744 \uB5A8\uC5B4\uB728\uB824 \uB113\uC740
      \uBC94\uC704\uC5D0 \uD654\uC5FC \uD53C\uD574 120\uC744 \uC900\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].resultText
    key: data.randomeventdata.magicteacheradvanced.pages.0.options.0.resulttext
    lastText: "\uC120\uC0DD\uC740 \uC9C0\uD321\uC774\uC758 \uBE5B\uC744 \uAC70\uB450\uACE0
      \uCC45\uC744 \uCC59\uACBC\uB2E4. \uC11C\uB85C \uC778\uC0AC\uB97C \uB098\uB208
      \uB4A4 \uADF8\uB294 \uB2E4\uB978 \uD1B5\uB85C\uB85C \uAC78\uC5B4\uAC14\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].title
    key: data.randomeventdata.magicteacheradvanced.pages.0.options.1.title
    lastText: "\uBC88\uAC1C\uB97C \uD55C\uACF3\uC5D0 \uBAA8\uC73C\uB294 \uBC95."
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
    key: data.randomeventdata.magicteacheradvanced.pages.0.options.1.description
    lastText: "6\uCD08 \uB3D9\uC548 \uBC88\uAC1C\uC758 \uC18C\uC6A9\uB3CC\uC774\uB97C
      \uD3BC\uCE5C\uB2E4. 0.75\uCD08\uB9C8\uB2E4 \uBC88\uAC1C \uD53C\uD574 14\uB97C
      \uC900\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: data.randomeventdata.magicteacheradvanced.pages.0.options.1.resulttext
    lastText: "\uC120\uC0DD\uC740 \uC9C0\uD321\uC774\uC758 \uBE5B\uC744 \uAC70\uB450\uACE0
      \uCC45\uC744 \uCC59\uACBC\uB2E4. \uC11C\uB85C \uC778\uC0AC\uB97C \uB098\uB208
      \uB4A4 \uADF8\uB294 \uB2E4\uB978 \uD1B5\uB85C\uB85C \uAC78\uC5B4\uAC14\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].title
    key: data.randomeventdata.magicteacheradvanced.pages.0.options.2.title
    lastText: "\uC5BC\uC74C \uCC3D\uC744 \uC3DF\uC544\uBD93\uB294 \uBC95."
  - propertyPath: pages.Array.data[0].options.Array.data[2].description
    key: data.randomeventdata.magicteacheradvanced.pages.0.options.2.description
    lastText: "\uACE0\uB4DC\uB984\uC744 6\uCC28\uB840 \uC3DF\uC544 \uAC01\uAC01 \uB0C9\uAE30
      \uD53C\uD574 16\uC744 \uC8FC\uACE0 \uC801\uC758 \uD589\uB3D9\uC744 \uB2A6\uCD98\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: data.randomeventdata.magicteacheradvanced.pages.0.options.2.resulttext
    lastText: "\uC120\uC0DD\uC740 \uC9C0\uD321\uC774\uC758 \uBE5B\uC744 \uAC70\uB450\uACE0
      \uCC45\uC744 \uCC59\uACBC\uB2E4. \uC11C\uB85C \uC778\uC0AC\uB97C \uB098\uB208
      \uB4A4 \uADF8\uB294 \uB2E4\uB978 \uD1B5\uB85C\uB85C \uAC78\uC5B4\uAC14\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[3].title
    key: data.randomeventdata.magicteacheradvanced.pages.0.options.3.title
    lastText: "\uAEBC\uC9C0\uC9C0 \uC54A\uB294 \uD64D\uC5FC\uC744 \uD3BC\uCE58\uB294
      \uBC95."
  - propertyPath: pages.Array.data[0].options.Array.data[3].description
    key: data.randomeventdata.magicteacheradvanced.pages.0.options.3.description
    lastText: "8\uCD08 \uB3D9\uC548 \uD64D\uC5FC\uC744 \uD3BC\uCE5C\uB2E4. \uB9E4\uCD08
      \uD654\uC5FC \uD53C\uD574 12\uB97C \uC8FC\uACE0 \uD654\uC0C1\uC744 \uB0A8\uAE34\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[3].resultText
    key: data.randomeventdata.magicteacheradvanced.pages.0.options.3.resulttext
    lastText: "\uC120\uC0DD\uC740 \uC9C0\uD321\uC774\uC758 \uBE5B\uC744 \uAC70\uB450\uACE0
      \uCC45\uC744 \uCC59\uACBC\uB2E4. \uC11C\uB85C \uC778\uC0AC\uB97C \uB098\uB208
      \uB4A4 \uADF8\uB294 \uB2E4\uB978 \uD1B5\uB85C\uB85C \uAC78\uC5B4\uAC14\uB2E4."
  - propertyPath: pages.Array.data[1].narrative
    key: data.randomeventdata.magicteacheradvanced.pages.1.narrative
    lastText: "\u201C\uC74C\u2026 \uADF8 \uC18D\uC131\uAE4C\uC9C0\uB294 \uC544\uC9C1
      \uC790\uC9C8\uC774 \uC548 \uBCF4\uC774\uB294\uB370\uC694. \uC775\uD78C \uB9C8\uBC95\uC5D0\uC11C
      \uB354 \uB098\uC544\uAC00\uB294 \uAC8C \uC88B\uACA0\uC2B5\uB2C8\uB2E4.\u201D"
  - propertyPath: pages.Array.data[1].options.Array.data[0].title
    key: data.randomeventdata.magicteacheradvanced.pages.1.options.0.title
    lastText: "\uB2E4\uB978 \uC218\uC5C5\uC744 \uACE0\uB978\uB2E4."
