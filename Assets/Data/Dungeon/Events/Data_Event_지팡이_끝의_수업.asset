  - propertyPath: pages.Array.data[2].narrative
    key: data.randomeventdata.magicteacheradvanced.pages.2.narrative
    lastText: "\uB178\uC778\uC774 \uC9C0\uD321\uC774\uC758 \uBE5B\uACFC \uB0B4 \uC190\uB05D\uC744
      \uBC88\uAC08\uC544 \uC0B4\uD53C\uB354\uB2C8 \uCC45\uC744 \uB3C4\uB85C \uB123\uB294\uB2E4.\n\n\u201C\uC544\uC9C1
      \uD070 \uC8FC\uBB38\uC744 \uBC84\uD2F8 \uB9CC\uD07C \uB9C8\uB825\uC774 \uBAA8\uC774\uC9C0
      \uC54A\uC558\uAD70\uC694. \uC624\uB298\uC740 \uC5EC\uAE30\uAE4C\uC9C0 \uD569\uC2DC\uB2E4.\u201D\n\n\uC7A0\uAE50
      \uAE38 \uC774\uC57C\uAE30\uB97C \uB098\uB208 \uB4A4 \uC11C\uB85C\uC758 \uC9D0\uC744
      \uCC59\uACBC\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].title
