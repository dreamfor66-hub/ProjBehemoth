  - narrative: "\uB178\uC778\uC774 \uC190\uB05D\uC5D0 \uBAA8\uC778 \uD798\uC744 \uC0B4\uD53C\uB354\uB2C8
      \uAD50\uBCF8\uC744 \uB36E\uB294\uB2E4.\n\n\u201C\uC544\uC9C1\uC740 \uADF8\uB987\uC774
      \uBABB \uBC84\uD301\uB2C8\uB2E4. \uAC19\uC740 \uC8FC\uBB38\uC744 \uB354 \uC368
      \uBCF4\uAC70\uB098 \uB9C8\uB825\uC744 \uB298\uB9B0 \uB4A4\uC5D0 \uBD05\uC2DC\uB2E4.\u201D\n\n\uADF8\uB294
      \uAD50\uBCF8\uC744 \uAC00\uBC29 \uC704\uC5D0 \uC62C\uB824 \uB450\uACE0 \uC870\uC0AC\uD558\uB358
      \uC9C0\uB3C4\uD310\uC73C\uB85C \uBAB8\uC744 \uB3CC\uB9B0\uB2E4."
    illustration: {fileID: 21300000, guid: c7cf755b429784641849a0792ff13bb5, type: 3}
