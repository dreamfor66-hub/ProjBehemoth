  - propertyPath: pages.Array.data[0].options.Array.data[3].title
    key: data.randomeventdata.magicteacheradvanced.pages.0.options.3.title
    lastText: "\uD64D\uC5FC \uAD50\uC2B5\uC744 \uBC1B\uB294\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[3].description
    key: data.randomeventdata.magicteacheradvanced.pages.0.options.3.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[3].resultText
    key: data.randomeventdata.magicteacheradvanced.pages.0.options.3.resulttext
    lastText: "\uB178\uC778\uC774 \uAD50\uBCF8\uC744 \uAC00\uBC29\uC5D0 \uB123\uACE0
      \uC9C0\uB3C4\uD310\uC744 \uACE0\uCCD0 \uC954\uB2E4. \u201C\uC368 \uBCF4\uACE0
      \uB2E4\uC74C \uAE38\uBAA9\uC5D0\uC11C \uD655\uC778\uD569\uC2DC\uB2E4.\u201D
      \uC11C\uB85C \uC9C0\uB098\uC628 \uD45C\uC2DD\uC744 \uD655\uC778\uD558\uACE0
      \uAC01\uC790\uC758 \uD1B5\uB85C\uB85C \uD5A5\uD588\uB2E4."
  - propertyPath: pages.Array.data[1].narrative
    key: data.randomeventdata.magicteacheradvanced.pages.1.narrative
    lastText: "\u201C\uC74C\u2026 \uADF8 \uC18D\uC131\uAE4C\uC9C0\uB294 \uC544\uC9C1
      \uC790\uC9C8\uC774 \uC548 \uBCF4\uC774\uB294\uB370\uC694. \uC775\uD78C \uB9C8\uBC95\uC5D0\uC11C
      \uB354 \uB098\uC544\uAC00\uB294 \uAC8C \uC88B\uACA0\uC2B5\uB2C8\uB2E4.\u201D"
  - propertyPath: pages.Array.data[1].options.Array.data[0].title
    key: data.randomeventdata.magicteacheradvanced.pages.1.options.0.title
    lastText: "\uB2E4\uB978 \uC218\uC5C5\uC744 \uACE0\uB978\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].description
    key: data.randomeventdata.magicteacheradvanced.pages.1.options.0.description
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[0].resultText
    key: data.randomeventdata.magicteacheradvanced.pages.1.options.0.resulttext
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[1].title
    key: data.randomeventdata.magicteacheradvanced.pages.1.options.1.title
    lastText: "\uC218\uC5C5\uC744 \uBBF8\uB8E8\uACE0 \uAE38\uC744 \uACC4\uC18D \uAC04\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].description
    key: data.randomeventdata.magicteacheradvanced.pages.1.options.1.description
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[1].resultText
    key: data.randomeventdata.magicteacheradvanced.pages.1.options.1.resulttext
    lastText: "\uB354 \uB2E4\uAC00\uAC00\uC9C0 \uC54A\uACE0 \uAE38\uC744 \uBE44\uCF30\uB2E4.
      \uC544\uC9C1 \uACB0\uC815\uC744 \uB0B4\uB9AC\uC9C0\uB294 \uC54A\uC558\uB2E4."
  - propertyPath: pages.Array.data[2].narrative
    key: data.randomeventdata.magicteacheradvanced.pages.2.narrative
    lastText: "\uB178\uC778\uC774 \uC190\uB05D\uC5D0 \uBAA8\uC778 \uD798\uC744 \uC0B4\uD53C\uB354\uB2C8
      \uAD50\uBCF8\uC744 \uB36E\uB294\uB2E4.\n\n\u201C\uC544\uC9C1\uC740 \uADF8\uB987\uC774
      \uBABB \uBC84\uD301\uB2C8\uB2E4. \uAC19\uC740 \uC8FC\uBB38\uC744 \uB354 \uC368
      \uBCF4\uAC70\uB098 \uB9C8\uB825\uC744 \uB298\uB9B0 \uB4A4\uC5D0 \uBD05\uC2DC\uB2E4.\u201D\n\n\uADF8\uB294
      \uAD50\uBCF8\uC744 \uAC00\uBC29 \uC704\uC5D0 \uC62C\uB824 \uB450\uACE0 \uC870\uC0AC\uD558\uB358
      \uC9C0\uB3C4\uD310\uC73C\uB85C \uBAB8\uC744 \uB3CC\uB9B0\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].title
    key: data.randomeventdata.magicteacheradvanced.pages.2.options.0.title
    lastText: "\uD798\uC744 \uB354 \uAE30\uB978 \uB4A4 \uB2E4\uC2DC \uCC3E\uC544\uC624\uAE30\uB85C
      \uD55C\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].description
    key: data.randomeventdata.magicteacheradvanced.pages.2.options.0.description
    lastText: 
  - propertyPath: pages.Array.data[2].options.Array.data[0].resultText
    key: data.randomeventdata.magicteacheradvanced.pages.2.options.0.resulttext
    lastText: "\uAD50\uBCF8\uC5D0\uC11C \uC190\uC744 \uB5D0\uB2E4. \uB178\uC778\uC740
      \uAC00\uBC29 \uACC1\uC5D0 \uC11C\uC11C \uC9C0\uB3C4\uC758 \uD45C\uC2DD\uC744
      \uACE0\uCCD0 \uADF8\uB838\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[4].title
    key: "data.randomeventdata.data_event_\uC9C0\uD321\uC774_\uB05D\uC758_\uC218\uC5C5.pages.0.options.4.title"
    lastText: "\uC9C0\uD321\uC774\uC758 \uC218\uC815\uC744 \uAC15\uC81C\uB85C \uB5BC\uC5B4
      \uB0B8\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[4].description
    key: "data.randomeventdata.data_event_\uC9C0\uD321\uC774_\uB05D\uC758_\uC218\uC5C5.pages.0.options.4.description"
    lastText: "\uACE8\uB4DC +35 \xB7 \uC774\uD6C4 \uC774 \uC5F0\uAD6C\uC790\uC758
      \uC218\uC5C5\uC744 \uBC1B\uC9C0 \uBABB\uD568"
  - propertyPath: pages.Array.data[0].options.Array.data[4].resultText
    key: "data.randomeventdata.data_event_\uC9C0\uD321\uC774_\uB05D\uC758_\uC218\uC5C5.pages.0.options.4.resulttext"
    lastText: "\uB178\uC778\uC774 \uB0A8\uC740 \uAE30\uB85D\uC744 \uAC00\uBC29\uC5D0
      \uB123\uACE0 \uC190\uC744 \uAC70\uB480\uB2E4. \uCC59\uAE34 \uBB3C\uAC74\uC740
      \uB0B4\uB2E4 \uD314 \uC218 \uC788\uACA0\uC9C0\uB9CC, \uC774 \uC0AC\uB78C\uC5D0\uAC8C
      \uB2E4\uC74C \uC218\uC5C5\uC744 \uCCAD\uD560 \uC218\uB294 \uC5C6\uC744 \uAC83\uC774\uB2E4.
      \uADF8\uB294 \uC544\uBB34 \uB9D0 \uC5C6\uC774 \uB2E4\uB978 \uD1B5\uB85C\uB85C
      \uC0AC\uB77C\uC84C\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[1].title
    key: "data.randomeventdata.data_event_\uC9C0\uD321\uC774_\uB05D\uC758_\uC218\uC5C5.pages.2.options.1.title"
    lastText: "\uC9C0\uD321\uC774\uC758 \uC218\uC815\uC744 \uAC15\uC81C\uB85C \uB5BC\uC5B4
      \uB0B8\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[1].description
    key: "data.randomeventdata.data_event_\uC9C0\uD321\uC774_\uB05D\uC758_\uC218\uC5C5.pages.2.options.1.description"
    lastText: "\uACE8\uB4DC +35 \xB7 \uC774\uD6C4 \uC774 \uC5F0\uAD6C\uC790\uC758
      \uC218\uC5C5\uC744 \uBC1B\uC9C0 \uBABB\uD568"
