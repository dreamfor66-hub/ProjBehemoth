    resultText: "\uD53C \uBB3B\uC740 \uC190\uC744 \uAC70\uB450\uC5C8\uB2E4. \uBD89\uC740
      \uD3EC\uB0AD\uC774 \uC881\uC740 \uD2C8 \uC548\uC73C\uB85C \uB04C\uB824\uB4E4\uC5B4\uAC14\uB2E4.
      \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uB2F9\uACA8\uC9C4 \uBFCC\uB9AC\uAC00 \uC11D\uD310
      \uC544\uB798\uC5D0 \uBC00\uCC29\uB410\uB2E4. \uCE7C\uB05D\uC744 \uB123\uC5B4
      \uBD10\uB3C4 \uB354\uB294 \uAC78\uB9AC\uB294 \uAC83\uC774 \uC5C6\uB2E4."
    resultingWorldObject: {fileID: 0}
    removeWorldObject: 0
    useWorldObject: 1
    leaveUnresolved: 0
    revisitTextKey: ui.encounter.revisit.AmberSeed.0.2
    requirements: []
    effects: []
  pages:
  - narrative: "\uAD75\uC740 \uBFCC\uB9AC\uAC00 \uBCBD\uC758 \uC904\uB208\uC744 \uBC00\uC5B4
      \uBC8C\uB838\uB2E4. \uBFCC\uB9AC \uC0AC\uC774\uC5D0\uB294 \uBC18\uCBE4 \uB179\uC740
      \uC791\uC740 \uBF08\uB4E4\uC774 \uC5C9\uACA8 \uC788\uB2E4. \uB05D\uC5D0 \uB9E4\uB2EC\uB9B0
      \uBD89\uC740 \uD3EC\uB0AD \uD558\uB098\uAC00 \uCC9C\uCC9C\uD788 \uC624\uBBC0\uB77C\uB4E0\uB2E4.\n\n\uAC00\uAE4C\uC774
      \uB2E4\uAC00\uC11C\uC790 \uBFCC\uB9AC\uB4E4\uC774 \uB5A8\uB9AC\uBA70 \uBCBD\uC758
      \uC881\uC740 \uD2C8\uC73C\uB85C \uB2F9\uACA8\uC9C4\uB2E4. \uAC00\uC2DC \uB05D\uC5D0
      \uC190\uAC00\uB77D\uC774 \uAE01\uD614\uB2E4. \uD54F\uBC29\uC6B8\uC774 \uB2FF\uC740
      \uAC00\uB294 \uBFCC\uB9AC \uD558\uB098\uAC00 \uC0C1\uCC98\uC5D0 \uB2EC\uB77C\uBD99\uB354\uB2C8
      \uAC08\uB77C\uC9C4 \uC0B4\uC744 \uB36E\uB294\uB2E4.\n\n\uBD89\uC740 \uD3EC\uB0AD\uC740
      \uC810\uC810 \uC548\uC73C\uB85C \uB04C\uB824\uAC04\uB2E4. \uC548\uCABD\uC5D0\uB294
      \uC528\uC557\uCC98\uB7FC \uB2E8\uB2E8\uD55C \uB369\uC5B4\uB9AC\uAC00 \uBE44\uCE5C\uB2E4."
    illustration: {fileID: 21300000, guid: 9c61f1f0b6c57cf4081a2d1aa2017dd8, type: 3}
    options:
    - title: "\uC0B4\uC544 \uC788\uB294 \uBFCC\uB9AC\uB97C \uC190\uBAA9\uC5D0 \uBD99\uC778\uB2E4."
      description: "\uCCB4\uB825 10 \uC9C0\uBD88 \xB7 \uD608\uADFC\uC758 \uC528 \uD68D\uB4DD"
      goldCost: 0
      hpCost: 10
      maxHpCost: 0
      consumeHealingPotion: 0
      requiredPower: 0
      requiredRelic: {fileID: 0}
      requiredPerk: 
      requiredFlag: 
      supply: {fileID: 0}
      supplyCost: 0
      nextPage: -1
      failurePage: -1
      resultText: "\uAC00\uB290\uB2E4\uB780 \uBFCC\uB9AC\uAC00 \uC190\uBAA9\uC744
        \uD30C\uACE0\uB4E4\uC5C8\uB2E4. \uD3EC\uB0AD\uC5D0\uC11C \uBE60\uC838\uB098\uC628
        \uB2E8\uB2E8\uD55C \uC528\uAC00 \uBFCC\uB9AC\uC640 \uD568\uAED8 \uC0B4\uBC11\uC5D0
        \uBD99\uB294\uB2E4. \uBCBD\uC5D0 \uB0A8\uC740 \uBFCC\uB9AC\uB294 \uC218\uBD84\uC744
        \uC783\uACE0 \uB298\uC5B4\uC84C\uB2E4. \uB0B4 \uB9E5\uBC15 \uC0AC\uC774\uC5D0
        \uB0AF\uC120 \uACE0\uB3D9\uC774 \uB07C\uC5C8\uB2E4."
