    key: data.randomeventdata.amberseed.pages.0.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: data.randomeventdata.amberseed.pages.0.options.2.resulttext
    lastText: "\uD53C \uBB3B\uC740 \uC190\uC744 \uAC70\uB450\uC5C8\uB2E4. \uBD89\uC740
      \uD3EC\uB0AD\uC774 \uC881\uC740 \uD2C8 \uC548\uC73C\uB85C \uB04C\uB824\uB4E4\uC5B4\uAC14\uB2E4.
      \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uB2F9\uACA8\uC9C4 \uBFCC\uB9AC\uAC00 \uC11D\uD310
      \uC544\uB798\uC5D0 \uBC00\uCC29\uB410\uB2E4. \uCE7C\uB05D\uC744 \uB123\uC5B4
      \uBD10\uB3C4 \uB354\uB294 \uAC78\uB9AC\uB294 \uAC83\uC774 \uC5C6\uB2E4."
  - propertyPath: options.Array.data[2].title
    key: "data.randomeventdata.data_event_\uB531_\uD558\uB098_\uB0A8\uC740_\uC5F4\uB9E4.options.2.title"
