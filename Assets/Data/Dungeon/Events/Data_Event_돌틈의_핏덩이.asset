    key: "data.randomeventdata.data_event_\uB531_\uD558\uB098_\uB0A8\uC740_\uC5F4\uB9E4.options.2.resulttext"
    lastText: "\uD53C \uBB3B\uC740 \uC190\uC744 \uAC70\uB450\uC5C8\uB2E4. \uBD89\uC740
      \uD3EC\uB0AD\uC774 \uC881\uC740 \uD2C8 \uC548\uC73C\uB85C \uB04C\uB824\uB4E4\uC5B4\uAC14\uB2E4.
      \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uB2F9\uACA8\uC9C4 \uBFCC\uB9AC\uAC00 \uC11D\uD310
      \uC544\uB798\uC5D0 \uBC00\uCC29\uB410\uB2E4. \uCE7C\uB05D\uC744 \uB123\uC5B4
      \uBD10\uB3C4 \uB354\uB294 \uAC78\uB9AC\uB294 \uAC83\uC774 \uC5C6\uB2E4."
  textOwnerGuid: a04fa7615e63a844185ead2a471a79af
  id: AmberSeed
  displayName: "\uB3CC\uD2C8\uC758 \uD54F\uB369\uC774"
  discovery: 1
  worldObject: {fileID: 11400000, guid: e97041d23bb8abd4c8a9bf6500b5c13d, type: 2}
  encounterKind: 0
  authoringLore: "\uBCBD\uC758 \uD2C8\uACFC \uBF08 \uC0AC\uC774\uC5D0\uC11C \uC790\uB77C\uB294
    \uD608\uADFC. \uC601\uC591 \uC800\uC7A5 \uD3EC\uB0AD\uC744 \uB0B4\uBC00\uC5C8\uB2E4\uAC00
    \uC9C4\uB3D9\uC744 \uBC1B\uC73C\uBA74 \uBCBD \uAE4A\uC740 \uD2C8\uC73C\uB85C
    \uC218\uCD95\uD558\uB294 \uBBF8\uAD81 \uC0DD\uBA85\uCCB4. \uCC98\uC74C\uBD80\uD130
    \uC218\uCD95\uACFC \uC6C0\uC9C1\uC784\uC774 \uAD00\uCC30\uB418\uBBC0\uB85C \uAE30\uB2E4\uB9AC\uBA74
    \uAE30\uD68C\uAC00 \uB05D\uB09C\uB2E4\uB294 \uACB0\uB860\uC740 \uAC11\uC790\uAE30
    \uBD99\uC778 \uADDC\uCE59\uC774 \uC544\uB2C8\uB2E4. \uC774\uC2DD/\uC12D\uCDE8\uB85C
    \uC800\uC7A5\uAE30\uAD00\uC744 \uC18C\uBAA8\uD558\uAC70\uB098, \uBB3C\uB7EC\uC11C\uB294
    \uC0AC\uC774 \uD3EC\uB0AD\uC774 \uD2C8 \uC548\uC73C\uB85C \uC0AC\uB77C\uC838
    \uB354 \uC774\uC0C1 \uC190\uC774 \uB2FF\uC9C0 \uC54A\uB294\uB2E4. \uD654\uBD84/\uC7AC\uBC30\uC790/\uC124\uBA85\uC11C\uB294
    \uC5C6\uB2E4."
