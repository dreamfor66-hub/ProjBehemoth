  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: "Data_Event_\uB3CC\uD2C8\uC758_\uD54F\uB369\uC774"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.amberseed.displayname
    lastText: "\uB3CC\uD2C8\uC758 \uD54F\uB369\uC774"
  - propertyPath: narrative
    key: data.randomeventdata.amberseed.narrative
    lastText: "\uAD75\uC740 \uBFCC\uB9AC\uAC00 \uBCBD\uC758 \uC904\uB208\uC744 \uBC00\uC5B4
      \uBC8C\uB838\uB2E4. \uBFCC\uB9AC \uC0AC\uC774\uC5D0\uB294 \uBC18\uCBE4 \uB179\uC740
      \uC791\uC740 \uBF08\uB4E4\uC774 \uC5C9\uACA8 \uC788\uB2E4. \uB05D\uC5D0 \uB9E4\uB2EC\uB9B0
      \uBD89\uC740 \uD3EC\uB0AD \uD558\uB098\uAC00 \uCC9C\uCC9C\uD788 \uC624\uBBC0\uB77C\uB4E0\uB2E4.\n\n\uAC00\uAE4C\uC774
      \uB2E4\uAC00\uC11C\uC790 \uBFCC\uB9AC\uB4E4\uC774 \uB5A8\uB9AC\uBA70 \uBCBD\uC758
      \uC881\uC740 \uD2C8\uC73C\uB85C \uB2F9\uACA8\uC9C4\uB2E4. \uAC00\uC2DC \uB05D\uC5D0
      \uC190\uAC00\uB77D\uC774 \uAE01\uD614\uB2E4. \uD54F\uBC29\uC6B8\uC774 \uB2FF\uC740
      \uAC00\uB294 \uBFCC\uB9AC \uD558\uB098\uAC00 \uC0C1\uCC98\uC5D0 \uB2EC\uB77C\uBD99\uB354\uB2C8
      \uAC08\uB77C\uC9C4 \uC0B4\uC744 \uB36E\uB294\uB2E4.\n\n\uBD89\uC740 \uD3EC\uB0AD\uC740
      \uC810\uC810 \uC548\uC73C\uB85C \uB04C\uB824\uAC04\uB2E4. \uC548\uCABD\uC5D0\uB294
      \uC528\uC557\uCC98\uB7FC \uB2E8\uB2E8\uD55C \uB369\uC5B4\uB9AC\uAC00 \uBE44\uCE5C\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.amberseed.options.0.title
    lastText: "\uC0B4\uC544 \uC788\uB294 \uBFCC\uB9AC\uB97C \uC190\uBAA9\uC5D0 \uBD99\uC778\uB2E4."
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.amberseed.options.0.description
    lastText: "\uCCB4\uB825 10 \uC9C0\uBD88 \xB7 \uD608\uADFC\uC758 \uC528 \uD68D\uB4DD"
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.amberseed.options.1.title
    lastText: "\uD3EC\uB0AD\uC744 \uC798\uB77C \uB0B4\uC6A9\uBB3C\uC744 \uC0BC\uD0A8\uB2E4."
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.amberseed.options.1.description
    lastText: "\uCCB4\uB825 20 \uD68C\uBCF5"
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.amberseed.options.0.resulttext
    lastText: "\uAC00\uB290\uB2E4\uB780 \uBFCC\uB9AC\uAC00 \uC190\uBAA9\uC744 \uD30C\uACE0\uB4E4\uC5C8\uB2E4.
      \uD3EC\uB0AD\uC5D0\uC11C \uBE60\uC838\uB098\uC628 \uB2E8\uB2E8\uD55C \uC528\uAC00
      \uBFCC\uB9AC\uC640 \uD568\uAED8 \uC0B4\uBC11\uC5D0 \uBD99\uB294\uB2E4. \uBCBD\uC5D0
      \uB0A8\uC740 \uBFCC\uB9AC\uB294 \uC218\uBD84\uC744 \uC783\uACE0 \uB298\uC5B4\uC84C\uB2E4.
      \uB0B4 \uB9E5\uBC15 \uC0AC\uC774\uC5D0 \uB0AF\uC120 \uACE0\uB3D9\uC774 \uB07C\uC5C8\uB2E4."
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.amberseed.options.1.resulttext
    lastText: "\uC587\uC740 \uAECD\uC9C8\uC744 \uAC00\uB974\uC790 \uB048\uB048\uD55C
      \uACFC\uC721\uC774 \uD758\uB800\uB2E4. \uC774\uB97C \uC545\uBB3C\uACE0 \uC0BC\uCF30\uB2E4.
      \uB530\uB73B\uD55C \uAC83\uC774 \uC0C1\uCC98\uB97C \uD0C0\uACE0 \uBC88\uC9C0\uB294
      \uB3D9\uC548 \uBCBD\uC758 \uBFCC\uB9AC\uB294 \uAC80\uAC8C \uC624\uADF8\uB77C\uB4E4\uC5C8\uB2E4.
      \uB2E8\uB2E8\uD55C \uD575\uAE4C\uC9C0 \uC539\uD600 \uB354\uB294 \uB0A8\uC740
      \uAC83\uC774 \uC5C6\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.amberseed.pages.0.narrative
