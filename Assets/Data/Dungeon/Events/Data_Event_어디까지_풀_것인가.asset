      \uBC14\uB2E5\uC5D0 \uB5A8\uC5B4\uC84C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].title
    key: data.randomeventdata.training.pages.0.options.2.title
    lastText: "\uC644\uC804\uAC00\uB3D9 \uC0AC\uC2AC\uC744 \uD47C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].description
    key: data.randomeventdata.training.pages.0.options.2.description
    lastText: "\uC804\uD22C \xB7 \uACF5\uC6A9 \uC720\uBB3C \uC120\uD0DD"
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: data.randomeventdata.training.pages.0.options.2.resulttext
    lastText: "\uC778\uD615\uC774 \uB9C8\uC9C0\uB9C9 \uC77C\uACA9 \uB4A4 \uBA48\uCDC4\uB2E4.
      \uC7A5\uBE44\uD568\uC758 \uAC78\uC1E0\uAC00 \uD480\uB9AC\uACE0, \uBD80\uC11C\uC9C4
      \uD0DC\uC5FD \uC870\uAC01\uC774 \uC6B4\uBC18\uD2C0 \uC544\uB798\uB85C \uC3DF\uC544\uC84C\uB2E4.
      \uB0A8\uC740 \uC7A5\uBE44\uB97C \uCC59\uACBC\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[3].title
    key: data.randomeventdata.training.pages.0.options.3.title
    lastText: "\uAE34\uAE09\uC815\uC9C0 \uB808\uBC84\uB97C \uB2F9\uAE34\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[3].description
    key: data.randomeventdata.training.pages.0.options.3.description
    lastText: "\uBCF4\uC0C1 \uC5C6\uC774 \uD6C8\uB828 \uC885\uB8CC"
  - propertyPath: pages.Array.data[0].options.Array.data[3].resultText
    key: data.randomeventdata.training.pages.0.options.3.resulttext
    lastText: "\uB808\uBC84\uB97C \uB05D\uAE4C\uC9C0 \uB2F9\uACBC\uB2E4. \uAD6C\uB3D9\uCD95
      \uC548\uC5D0\uC11C \uAE08\uC18D\uC774 \uB04A\uC5B4\uC9C0\uB294 \uC18C\uB9AC\uAC00
      \uB0AC\uB2E4. \uC778\uD615\uC758 \uD314\uC774 \uB298\uC5B4\uC84C\uB2E4. \uC138
      \uC9C0\uAE09\uD568\uC758 \uAC78\uC1E0\uB294 \uC7A0\uAE34 \uCC44\uB2E4. \uB2E4\uC2DC
      \uBC1C\uD310\uC744 \uBC1F\uC544\uB3C4 \uCD95\uC740 \uB3CC\uC544\uAC00\uC9C0
      \uC54A\uB294\uB2E4."
  - propertyPath: options.Array.data[3].title
    key: "data.randomeventdata.data_event_\uC5B4\uB514\uAE4C\uC9C0_\uD480_\uAC83\uC778\uAC00.options.3.title"
    lastText: "\uAE34\uAE09\uC815\uC9C0 \uB808\uBC84\uB97C \uB2F9\uAE34\uB2E4."
  - propertyPath: options.Array.data[3].description
    key: "data.randomeventdata.data_event_\uC5B4\uB514\uAE4C\uC9C0_\uD480_\uAC83\uC778\uAC00.options.3.description"
    lastText: "\uBCF4\uC0C1 \uC5C6\uC774 \uD6C8\uB828 \uC885\uB8CC"
  - propertyPath: options.Array.data[3].resultText
    key: "data.randomeventdata.data_event_\uC5B4\uB514\uAE4C\uC9C0_\uD480_\uAC83\uC778\uAC00.options.3.resulttext"
    lastText: "\uB808\uBC84\uB97C \uB05D\uAE4C\uC9C0 \uB2F9\uACBC\uB2E4. \uAD6C\uB3D9\uCD95
      \uC548\uC5D0\uC11C \uAE08\uC18D\uC774 \uB04A\uC5B4\uC9C0\uB294 \uC18C\uB9AC\uAC00
      \uB0AC\uB2E4. \uC778\uD615\uC758 \uD314\uC774 \uB298\uC5B4\uC84C\uB2E4. \uC138
      \uC9C0\uAE09\uD568\uC758 \uAC78\uC1E0\uB294 \uC7A0\uAE34 \uCC44\uB2E4. \uB2E4\uC2DC
      \uBC1C\uD310\uC744 \uBC1F\uC544\uB3C4 \uCD95\uC740 \uB3CC\uC544\uAC00\uC9C0
      \uC54A\uB294\uB2E4."
  textOwnerGuid: f4744ac83644fda4abb9cf9f29823da9
  id: Training
  displayName: "\uC5B4\uB514\uAE4C\uC9C0 \uD480 \uAC83\uC778\uAC00"
