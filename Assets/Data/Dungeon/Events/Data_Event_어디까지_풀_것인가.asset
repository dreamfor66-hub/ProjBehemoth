    \uC778\uD615 \uC815\uC9C0 \uD6C4 \uD574\uB2F9 \uB2E8\uACC4\uC758 \uC9C0\uAE09\uD568
    \uAC1C\uBC29. \uAE34\uAE09\uC815\uC9C0 \uC2DC \uAD6C\uB3D9\uCD95 \uC808\uB2E8.\u201D\n\n\uD2C0
    \uC544\uB798\uC5D0\uB294 \uC57D\uC81C\uD568\uACFC \uB3C4\uD574\uD568, \uC7A5\uBE44\uD568\uC774
    \uAC78\uC1E0\uC5D0 \uBB3C\uB824 \uC788\uB2E4. \uC606\uC758 \uAE34\uAE09\uC815\uC9C0
    \uB808\uBC84\uC5D0\uB294 \uBD89\uC740 \uCE60\uC774 \uB0A8\uC544 \uC788\uB2E4."
