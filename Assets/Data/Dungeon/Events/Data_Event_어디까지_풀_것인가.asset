  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: "Data_Event_\uC5B4\uB514\uAE4C\uC9C0_\uD480_\uAC83\uC778\uAC00"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.training.displayname
    lastText: "\uC5B4\uB514\uAE4C\uC9C0 \uD480 \uAC83\uC778\uAC00"
  - propertyPath: narrative
    key: data.randomeventdata.training.narrative
    lastText: "\uBC29\uD328\uC640 \uCC3D\uC744 \uBCF4\uAD00\uD558\uB358 \uC120\uBC18
      \uC0AC\uC774\uC5D0 \uD6C8\uB828 \uC778\uD615\uC774 \uACE0\uC815\uB418\uC5B4
      \uC788\uB2E4. \uD2C0 \uC55E\uC758 \uBC1C\uD310\uC744 \uBC1F\uC790 \uAD6C\uB3D9\uCD95\uC774
      \uB3CC\uC544\uAC00\uBA70 \uAC80\uC744 \uC954 \uD314\uC774 \uAD6C\uC18D\uAD6C\uB97C
      \uB2F9\uAE34\uB2E4.\n\n\uC6B4\uBC18\uD2C0\uC758 \uAE08\uC18D\uD310\uC5D0 \uAE00\uC790\uAC00
      \uCC0D\uD600 \uC788\uB2E4.\n\n\u201C\uC785\uBB38: \uB048 \uD574\uC81C / \uAC80\uC815:
      \uCCA0\uC0AC \uC808\uB2E8 / \uC644\uC804\uAC00\uB3D9: \uC0AC\uC2AC \uD574\uC81C.
      \uC778\uD615 \uC815\uC9C0 \uD6C4 \uD574\uB2F9 \uB2E8\uACC4\uC758 \uC9C0\uAE09\uD568
      \uAC1C\uBC29. \uAE34\uAE09\uC815\uC9C0 \uC2DC \uAD6C\uB3D9\uCD95 \uC808\uB2E8.\u201D\n\n\uD2C0
      \uC544\uB798\uC5D0\uB294 \uC57D\uC81C\uD568\uACFC \uB3C4\uD574\uD568, \uC7A5\uBE44\uD568\uC774
      \uAC78\uC1E0\uC5D0 \uBB3C\uB824 \uC788\uB2E4. \uC606\uC758 \uAE34\uAE09\uC815\uC9C0
      \uB808\uBC84\uC5D0\uB294 \uBD89\uC740 \uCE60\uC774 \uB0A8\uC544 \uC788\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.training.options.0.title
    lastText: "\uC785\uBB38\uC6A9 \uB048\uC744 \uD47C\uB2E4."
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.training.options.0.description
    lastText: "\uC804\uD22C \xB7 \uD3EC\uC158 1\uAC1C"
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.training.options.1.title
    lastText: "\uAC80\uC815\uC6A9 \uCCA0\uC0AC\uB97C \uB04A\uB294\uB2E4."
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.training.options.1.description
    lastText: "\uC804\uD22C \xB7 \uBCF4\uC720 \uB2A5\uB825 \uD558\uB098 \uAC15\uD654"
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.training.options.2.title
    lastText: "\uC644\uC804\uAC00\uB3D9 \uC0AC\uC2AC\uC744 \uD47C\uB2E4."
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.training.options.2.description
    lastText: "\uC804\uD22C \xB7 \uACF5\uC6A9 \uC720\uBB3C \uC120\uD0DD"
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.training.options.0.resulttext
    lastText: "\uC778\uD615\uC774 \uBA4E\uC790 \uC57D\uC81C\uD568\uC758 \uAC78\uC1E0\uAC00
      \uD480\uB838\uB2E4. \uC57D\uBCD1\uC744 \uCC59\uAE30\uB294 \uB3D9\uC548 \uD0DC\uC5FD\uC774
      \uB04A\uC5B4\uC9C0\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uC778\uD615\uC758
      \uD314\uC740 \uB298\uC5B4\uC9C4 \uCC44 \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uB294\uB2E4."
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.training.options.1.resulttext
    lastText: "\uC778\uD615\uC758 \uBE48\uD2C8\uC744 \uB05D\uAE4C\uC9C0 \uB530\uB77C\uBD99\uC5C8\uB2E4.
      \uAC80\uC815\uC744 \uB9C8\uCE58\uC790 \uB3C4\uD574\uD568\uC774 \uC5F4\uB838\uB2E4.
      \uBAB8\uC5D0 \uB0A8\uC740 \uC6C0\uC9C1\uC784\uC744 \uB3C4\uD574\uC640 \uB9DE\uCDB0
      \uC775\uD614\uB2E4. \uD0DC\uC5FD\uC774 \uB04A\uC5B4\uC9C0\uACE0 \uAD6C\uC18D\uAD6C\uAC00
      \uBC14\uB2E5\uC5D0 \uB5A8\uC5B4\uC84C\uB2E4."
  - propertyPath: options.Array.data[2].resultText
    key: data.randomeventdata.training.options.2.resulttext
    lastText: "\uC778\uD615\uC774 \uB9C8\uC9C0\uB9C9 \uC77C\uACA9 \uB4A4 \uBA48\uCDC4\uB2E4.
      \uC7A5\uBE44\uD568\uC758 \uAC78\uC1E0\uAC00 \uD480\uB9AC\uACE0, \uBD80\uC11C\uC9C4
      \uD0DC\uC5FD \uC870\uAC01\uC774 \uC6B4\uBC18\uD2C0 \uC544\uB798\uB85C \uC3DF\uC544\uC84C\uB2E4.
      \uB0A8\uC740 \uC7A5\uBE44\uB97C \uCC59\uACBC\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.training.pages.0.narrative
    lastText: "\uBC29\uD328\uC640 \uCC3D\uC744 \uBCF4\uAD00\uD558\uB358 \uC120\uBC18
      \uC0AC\uC774\uC5D0 \uD6C8\uB828 \uC778\uD615\uC774 \uACE0\uC815\uB418\uC5B4
      \uC788\uB2E4. \uD2C0 \uC55E\uC758 \uBC1C\uD310\uC744 \uBC1F\uC790 \uAD6C\uB3D9\uCD95\uC774
      \uB3CC\uC544\uAC00\uBA70 \uAC80\uC744 \uC954 \uD314\uC774 \uAD6C\uC18D\uAD6C\uB97C
      \uB2F9\uAE34\uB2E4.\n\n\uC6B4\uBC18\uD2C0\uC758 \uAE08\uC18D\uD310\uC5D0 \uAE00\uC790\uAC00
      \uCC0D\uD600 \uC788\uB2E4.\n\n\u201C\uC785\uBB38: \uB048 \uD574\uC81C / \uAC80\uC815:
      \uCCA0\uC0AC \uC808\uB2E8 / \uC644\uC804\uAC00\uB3D9: \uC0AC\uC2AC \uD574\uC81C.
      \uC778\uD615 \uC815\uC9C0 \uD6C4 \uD574\uB2F9 \uB2E8\uACC4\uC758 \uC9C0\uAE09\uD568
      \uAC1C\uBC29. \uAE34\uAE09\uC815\uC9C0 \uC2DC \uAD6C\uB3D9\uCD95 \uC808\uB2E8.\u201D\n\n\uD2C0
      \uC544\uB798\uC5D0\uB294 \uC57D\uC81C\uD568\uACFC \uB3C4\uD574\uD568, \uC7A5\uBE44\uD568\uC774
      \uAC78\uC1E0\uC5D0 \uBB3C\uB824 \uC788\uB2E4. \uC606\uC758 \uAE34\uAE09\uC815\uC9C0
      \uB808\uBC84\uC5D0\uB294 \uBD89\uC740 \uCE60\uC774 \uB0A8\uC544 \uC788\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.training.pages.0.options.0.title
    lastText: "\uC785\uBB38\uC6A9 \uB048\uC744 \uD47C\uB2E4."
