  worldObject: {fileID: 11400000, guid: d620f8d08e1f7d74eaa2e0075a5c0d6c, type: 2}
  encounterKind: 3
  authoringLore: "\uD3D0\uC131 \uC218\uBE44\uB300\uAC00 \uC804\uD22C \uAC80\uC815\uACFC
    \uC7A5\uBE44 \uBD88\uCD9C\uC744 \uD568\uAED8 \uD558\uB358 \uC790\uB3D9 \uD6C8\uB828\uACE0.
    \uAD6C\uC18D\uB048/\uCCA0\uC0AC/\uC0AC\uC2AC\uC758 \uAC80\uC815 \uB2E8\uACC4\uAC00
    \uC2E4\uC81C \uC778\uD615\uC758 \uAC15\uB3C4\uC640 \uBCF4\uC0C1 \uC218\uB0A9\uD568\uC744
    \uAD6C\uBD84\uD55C\uB2E4. \uD45C\uC758 \uBB38\uAD6C\uB97C \uC77D\uAE30 \uC804\uC5D0\uB294
    \uAE30\uB2A5\uC744 \uB2E8\uC815\uD558\uC9C0 \uC54A\uB294\uB2E4. \uB3C4\uC804\uC744
    \uC2DC\uC791\uD558\uBA74 \uD574\uB2F9 \uAC80\uC815\uC758 \uC77C\uD68C\uC6A9 \uD0DC\uC5FD\uC774
    \uBD80\uC11C\uC838 \uAC19\uC740 \uC778\uD615\uC744 \uC7AC\uAC00\uB3D9\uD558\uC9C0
    \uBABB\uD55C\uB2E4."
  roomLayout: 1
  roomInteriors:
  - {fileID: 21300000, guid: fb9680f22ada6cd4080f9cc9fdfed712, type: 3}
  - {fileID: 21300000, guid: bf486e7f598cfee4a86238c5007aacff, type: 3}
  - {fileID: 21300000, guid: 6d030cb5ccff9514583c1cf53d33fadb, type: 3}
