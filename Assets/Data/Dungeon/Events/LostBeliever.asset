  - propertyPath: pages.Array.data[2].narrative
    key: data.randomeventdata.lostbeliever.pages.2.narrative
    lastText: "\uBCBD\uC758 \uC810\uAC80\uAD6C \uB108\uBA38\uB85C \uC6B0\uD68C\uD560
      \uC218 \uC788\uACA0\uB2E4. \uC881\uC740 \uD1B5\uB85C\uC5D0\uB294 \uB0A0\uCE74\uB85C\uC6B4
      \uCCA0\uC81C \uC794\uD574\uAC00 \uAC00\uB4DD\uD558\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].title
    key: data.randomeventdata.lostbeliever.pages.2.options.0.title
    lastText: "\uC0C1\uCC98\uB97C \uAC10\uC218\uD558\uACE0 \uD568\uAED8 \uC9C0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].description
