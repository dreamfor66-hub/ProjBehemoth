  m_Name: "Data_Event_\uAC70\uC6B8\uC774_\uBA3C\uC800_\uBCA4\uB2E4"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.mirror.displayname
    lastText: "\uAC70\uC6B8\uC774 \uBA3C\uC800 \uBCA4\uB2E4"
  - propertyPath: narrative
    key: data.randomeventdata.mirror.narrative
    lastText: "\uD1B5\uB85C \uAC00\uC7A5\uC790\uB9AC\uC5D0 \uCEE4\uB2E4\uB780 \uAC70\uC6B8\uC774
      \uAE30\uB300\uC5B4 \uC788\uB2E4.\n\n\uB098\uB294 \uBA48\uCDB0 \uC130\uB294\uB370
      \uAC70\uC6B8 \uC18D\uC758 \uB098\uB294 \uC544\uC9C1 \uC6C0\uC9C1\uC774\uACE0
      \uC788\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.mirror.options.0.title
    lastText: "\uD55C \uBC88 \uBCA0\uC774\uACE0 \uD55C \uC870\uAC01 \uCC59\uAE34\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.mirror.options.0.description
    lastText: "\uCCB4\uB825 -16. \uAC70\uC6B8 \uC870\uAC01: \uB9E4 4\uBC88\uC9F8
      \uBB34\uAE30 \uC801\uC911\uC5D0 \uD53C\uD574 40% \uCD94\uAC00."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.mirror.options.1.title
    lastText: "\uB0B4 \uB3D9\uC791\uC744 \uACE0\uCCD0 \uBC30\uC6B4\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.mirror.options.1.description
    lastText: "\uBCF4\uC720 \uB2A5\uB825 \uD558\uB098\uB97C 1\uB2E8\uACC4 \uAC15\uD654\uD55C\uB2E4."
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.mirror.options.2.title
    lastText: "\uAC70\uC6B8 \uB4B7\uBA74\uC758 \uC740\uC744 \uAE01\uC5B4\uB0B8\uB2E4"
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.mirror.options.2.description
    lastText: "\uACE8\uB4DC +12. \uAC70\uC6B8\uC740 \uB354 \uC774\uC0C1 \uC6C0\uC9C1\uC774\uC9C0
      \uC54A\uB294\uB2E4."
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.mirror.options.0.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.mirror.options.1.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: options.Array.data[2].resultText
    key: data.randomeventdata.mirror.options.2.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.mirror.pages.0.narrative
    lastText: "\uD1B5\uB85C \uAC00\uC7A5\uC790\uB9AC\uC5D0 \uCEE4\uB2E4\uB780 \uAC70\uC6B8\uC774
      \uAE30\uB300\uC5B4 \uC788\uB2E4.\n\n\uB098\uB294 \uBA48\uCDB0 \uC130\uB294\uB370
      \uAC70\uC6B8 \uC18D\uC758 \uB098\uB294 \uC544\uC9C1 \uC6C0\uC9C1\uC774\uACE0
      \uC788\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.mirror.pages.0.options.0.title
    lastText: "\uC190\uC744 \uB4E4\uC5B4 \uC6C0\uC9C1\uC784\uC744 \uD655\uC778\uD55C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
