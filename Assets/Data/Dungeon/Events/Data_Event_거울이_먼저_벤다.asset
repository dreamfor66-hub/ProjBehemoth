    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: data.randomeventdata.mirror.pages.0.options.1.resulttext
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[2].title
    key: data.randomeventdata.mirror.pages.0.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].description
    key: data.randomeventdata.mirror.pages.0.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: data.randomeventdata.mirror.pages.0.options.2.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[1].narrative
    key: data.randomeventdata.mirror.pages.1.narrative
    lastText: "\uAC70\uC6B8 \uC18D\uC758 \uB0B4\uAC00 \uBB34\uAE30\uB97C \uCC9C\uCC9C\uD788
      \uD718\uB450\uB978\uB2E4.\n\n\uB0B4\uAC00 \uC790\uC8FC \uC4F0\uB294 \uB3D9\uC791\uC774\uB2E4.
      \uD558\uC9C0\uB9CC \uBC1C\uC744 \uB51B\uB294 \uC704\uCE58\uAC00 \uC870\uAE08
      \uB2E4\uB974\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].title
    key: data.randomeventdata.mirror.pages.1.options.0.title
    lastText: "\uAC70\uB9AC\uB97C \uB450\uACE0 \uB3D9\uC791\uC744 \uB530\uB77C \uD55C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].description
    key: data.randomeventdata.mirror.pages.1.options.0.description
    lastText: "\uBCF4\uC720 \uB2A5\uB825 \uD558\uB098 \uAC15\uD654"
  - propertyPath: pages.Array.data[1].options.Array.data[0].resultText
    key: data.randomeventdata.mirror.pages.1.options.0.resulttext
    lastText: "\uBA87 \uBC88\uC744 \uB530\uB77C \uD558\uC790 \uC790\uC138\uC758 \uC798\uBABB\uB41C
      \uBD80\uBD84\uC744 \uC54C \uAC83 \uAC19\uB2E4. \uAC70\uC6B8 \uC18D\uC758 \uB0B4\uAC00
      \uBB34\uAE30\uB97C \uB0B4\uB838\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].title
    key: data.randomeventdata.mirror.pages.1.options.1.title
    lastText: "\uC720\uB9AC \uBC16\uC73C\uB85C \uB098\uC628 \uBB34\uAE30\uB97C \uBD99\uC7A1\uB294\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].description
    key: data.randomeventdata.mirror.pages.1.options.1.description
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[1].resultText
    key: data.randomeventdata.mirror.pages.1.options.1.resulttext
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[2].title
    key: data.randomeventdata.mirror.pages.1.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[2].description
    key: data.randomeventdata.mirror.pages.1.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[2].resultText
    key: data.randomeventdata.mirror.pages.1.options.2.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[2].narrative
    key: data.randomeventdata.mirror.pages.2.narrative
    lastText: "\uCC28\uAC00\uC6B4 \uB0A0\uC774 \uC190\uC744 \uC2A4\uCE5C\uB2E4. \uB354
      \uB2F9\uAE30\uBA74 \uC720\uB9AC \uD55C \uC870\uAC01\uACFC \uD568\uAED8 \uB5A8\uC5B4\uC9C8
      \uAC83 \uAC19\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].title
    key: data.randomeventdata.mirror.pages.2.options.0.title
    lastText: "\uC0C1\uCC98\uB97C \uAC10\uC218\uD558\uACE0 \uB5BC\uC5B4 \uB0B8\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].description
    key: data.randomeventdata.mirror.pages.2.options.0.description
    lastText: "\uAE30\uC5B5\uD558\uB294 \uAC70\uC6B8 \uC870\uAC01 \uD68D\uB4DD"
  - propertyPath: pages.Array.data[2].options.Array.data[0].resultText
    key: data.randomeventdata.mirror.pages.2.options.0.resulttext
    lastText: "\uD314\uC5D0 \uAE34 \uC0C1\uCC98\uAC00 \uC0DD\uACBC\uB2E4. \uC870\uAC01\uC744
      \uB5BC\uC5B4 \uB0B4\uC790 \uB098\uBA38\uC9C0 \uAC70\uC6B8\uACFC \uBC1B\uCE68\uB300\uAC00
      \uAC00\uB8E8\uB85C \uD769\uC5B4\uC84C\uB2E4. \uC190\uC5D0 \uB0A8\uC740 \uC870\uAC01
      \uC548\uC5D0\uC11C\uB294 \uC544\uC9C1 \uB0B4 \uBB34\uAE30\uAC00 \uC6C0\uC9C1\uC774\uACE0
      \uC788\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[1].title
    key: data.randomeventdata.mirror.pages.2.options.1.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[1].description
    key: data.randomeventdata.mirror.pages.2.options.1.description
    lastText: 
  - propertyPath: pages.Array.data[2].options.Array.data[1].resultText
    key: data.randomeventdata.mirror.pages.2.options.1.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[3].narrative
    key: data.randomeventdata.mirror.pages.3.narrative
    lastText: "\uAC70\uC6B8\uC744 \uB3CC\uB824 \uBCF4\uB2C8 \uB4B7\uBA74\uC758 \uC740\uC774
      \uB450\uAECD\uAC8C \uBC97\uACA8\uC838 \uC788\uB2E4."
  - propertyPath: pages.Array.data[3].options.Array.data[0].title
    key: data.randomeventdata.mirror.pages.3.options.0.title
    lastText: "\uC740\uC744 \uAE01\uC5B4 \uCC59\uAE34\uB2E4."
  - propertyPath: pages.Array.data[3].options.Array.data[0].description
    key: data.randomeventdata.mirror.pages.3.options.0.description
    lastText: "\uACE8\uB4DC +12"
  - propertyPath: pages.Array.data[3].options.Array.data[0].resultText
    key: data.randomeventdata.mirror.pages.3.options.0.resulttext
    lastText: "\uBC97\uACA8\uC9C4 \uC740\uC744 \uCC59\uACBC\uB2E4. \uAC70\uC6B8\uC5D0\uB294
      \uB354 \uC774\uC0C1 \uB0AF\uC120 \uC6C0\uC9C1\uC784\uC774 \uBE44\uCE58\uC9C0
      \uC54A\uB294\uB2E4."
  - propertyPath: pages.Array.data[3].options.Array.data[1].title
    key: data.randomeventdata.mirror.pages.3.options.1.title
    lastText: "\uB5A0\uB09C\uB2E4."
