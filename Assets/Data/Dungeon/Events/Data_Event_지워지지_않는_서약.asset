--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: "Data_Event_\uC9C0\uC6CC\uC9C0\uC9C0_\uC54A\uB294_\uC11C\uC57D"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.contract.displayname
    lastText: "\uC9C0\uC6CC\uC9C0\uC9C0 \uC54A\uB294 \uC11C\uC57D"
  - propertyPath: narrative
    key: data.randomeventdata.contract.narrative
    lastText: "\uB0AE\uC740 \uC11C\uBA85\uB300\uC758 \uBD89\uC740 \uC885\uC774\uB97C
      \uB4E4\uC5B4 \uC62C\uB9AC\uC790 \uB05D\uC774 \uC190\uBAA9\uC744 \uAC10\uC544
      \uBD99\uB294\uB2E4. \uB5BC\uC5B4 \uB0B4\uB824\uACE0 \uC7A1\uC544\uB2F9\uACA8\uB3C4
      \uC885\uC774\uBCF4\uB2E4 \uC0B4\uC774 \uBA3C\uC800 \uB2F9\uACA8\uC9C4\uB2E4.
      \uBCBD\uC758 \uD683\uBD88 \uBD88\uAF43\uC774 \uBC00\uB78D \uC704\uC5D0\uC11C
      \uD754\uB4E4\uB9B0\uB2E4.\n\n\uC885\uC774\uC5D0 \uC0C8 \uAE00\uC790\uAC00 \uB5A0\uC624\uB978\uB2E4.\n\n\u201C\uBAB8\uC758
      \uC77C\uBD80\uB97C \uB0A8\uAE30\uACE0, \uB0A8\uC740 \uBAB8\uC5D0 \uCE7C\uC758
      \uD798\uC744 \uBC1B\uB294\uB2E4. \uB9F9\uC57D \uB4A4\uC758 \uC0C1\uCC98\uB294
      \uC804\uCC98\uB7FC \uC544\uBB3C\uC9C0 \uC54A\uC73C\uB9AC\uB77C.\u201D\n\n\uB9E8
      \uC544\uB798\uC5D0\uB294 \uC774\uB984\uC744 \uB123\uB294 \uBE48\uCE78\uC774
      \uC788\uB2E4. \uC190\uBAA9\uC744 \uAC10\uC2FC \uBC14\uAE65\uCABD \uC885\uC774\uB294
      \uBD88\uAF43 \uAC00\uAE4C\uC774\uC5D0\uC11C \uAC80\uAC8C \uB9D0\uB9B0\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.contract.options.0.title
    lastText: "\uB0B4 \uC774\uB984\uC744 \uC4F0\uACE0 \uB9F9\uC57D\uD55C\uB2E4."
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.contract.options.0.description
    lastText: "\uCD5C\uB300 \uCCB4\uB825 18 \uC9C0\uBD88 \xB7 \uBAA8\uB4E0 \uD53C\uD574
      +25% \xB7 \uBC1B\uB294 \uD68C\uBCF5\uB7C9 \u221240%"
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.contract.options.1.title
    lastText: "\uD683\uBD88\uC5D0 \uC11C\uC57D\uC9C0\uB97C \uD0DC\uC6CC \uB04A\uB294\uB2E4."
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.contract.options.1.description
    lastText: "\uBCF4\uC0C1 \uC5C6\uC774 \uC11C\uC57D \uD30C\uAE30"
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.contract.options.0.resulttext
    lastText: "\uC774\uB984\uC744 \uB9C8\uCE58\uC790 \uBD89\uC740 \uAE00\uC790\uAC00
      \uC190\uBAA9\uC73C\uB85C \uD0C0 \uB4E4\uC5B4\uC654\uB2E4. \uC228\uC744 \uBAB0\uC544\uC26C\uBA70
      \uB300\uC5D0\uC11C \uC190\uC744 \uB5D0\uB2E4. \uBB34\uAE30\uB294 \uAC00\uBCBC\uC6CC\uC84C\uC9C0\uB9CC
      \uC0C1\uCC98 \uAC00\uC7A5\uC790\uB9AC\uB294 \uCC28\uAC11\uAC8C \uAD73\uC5C8\uB2E4.
      \uC11C\uC57D\uC9C0\uB294 \uAC80\uC740 \uC7AC\uAC00 \uB418\uC5B4 \uC190\uAC00\uB77D
      \uC0AC\uC774\uB85C \uD769\uC5B4\uC84C\uB2E4."
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.contract.options.1.resulttext
    lastText: "\uC190\uBAA9\uC758 \uBC14\uAE65\uCABD \uC885\uC774\uB97C \uBCBD\uC758
      \uBD88\uAF43\uC5D0 \uB314\uB2E4. \uBC00\uB78D \uB0C4\uC0C8\uC640 \uD568\uAED8
      \uAE00\uC790 \uB05D\uC774 \uD0C0\uB4E4\uC5B4 \uAC14\uB2E4. \uBD88\uAE38\uC774
      \uC774\uB984 \uCE78\uC5D0 \uB2FF\uC790 \uC885\uC774\uAC00 \uD798\uC744 \uC783\uACE0
      \uD480\uB838\uB2E4. \uB05D\uAE4C\uC9C0 \uD0DC\uC6CC \uBC84\uB9B0 \uC7AC\uB97C
      \uBC14\uB2E5\uC5D0 \uD138\uC5C8\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.contract.pages.0.narrative
    lastText: "\uB0AE\uC740 \uC11C\uBA85\uB300\uC758 \uBD89\uC740 \uC885\uC774\uB97C
      \uB4E4\uC5B4 \uC62C\uB9AC\uC790 \uB05D\uC774 \uC190\uBAA9\uC744 \uAC10\uC544
      \uBD99\uB294\uB2E4. \uB5BC\uC5B4 \uB0B4\uB824\uACE0 \uC7A1\uC544\uB2F9\uACA8\uB3C4
      \uC885\uC774\uBCF4\uB2E4 \uC0B4\uC774 \uBA3C\uC800 \uB2F9\uACA8\uC9C4\uB2E4.
      \uBCBD\uC758 \uD683\uBD88 \uBD88\uAF43\uC774 \uBC00\uB78D \uC704\uC5D0\uC11C
      \uD754\uB4E4\uB9B0\uB2E4.\n\n\uC885\uC774\uC5D0 \uC0C8 \uAE00\uC790\uAC00 \uB5A0\uC624\uB978\uB2E4.\n\n\u201C\uBAB8\uC758
      \uC77C\uBD80\uB97C \uB0A8\uAE30\uACE0, \uB0A8\uC740 \uBAB8\uC5D0 \uCE7C\uC758
      \uD798\uC744 \uBC1B\uB294\uB2E4. \uB9F9\uC57D \uB4A4\uC758 \uC0C1\uCC98\uB294
      \uC804\uCC98\uB7FC \uC544\uBB3C\uC9C0 \uC54A\uC73C\uB9AC\uB77C.\u201D\n\n\uB9E8
      \uC544\uB798\uC5D0\uB294 \uC774\uB984\uC744 \uB123\uB294 \uBE48\uCE78\uC774
      \uC788\uB2E4. \uC190\uBAA9\uC744 \uAC10\uC2FC \uBC14\uAE65\uCABD \uC885\uC774\uB294
      \uBD88\uAF43 \uAC00\uAE4C\uC774\uC5D0\uC11C \uAC80\uAC8C \uB9D0\uB9B0\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.contract.pages.0.options.0.title
    lastText: "\uB0B4 \uC774\uB984\uC744 \uC4F0\uACE0 \uB9F9\uC57D\uD55C\uB2E4."
