  id: Contract
  displayName: "\uC9C0\uC6CC\uC9C0\uC9C0 \uC54A\uB294 \uC11C\uC57D"
  discovery: 1
  worldObject: {fileID: 11400000, guid: c9a221aba6a89f94e8c5402049c7fef0, type: 2}
  encounterKind: 0
  authoringLore: "\uC61B \uC218\uBE44\uB300 \uC11C\uC57D\uC18C\uC5D0\uC11C \uC9C0\uC6D0\uC790\uC758
    \uC190\uBAA9\uC744 \uBD99\uC7A1\uC544 \uB9F9\uC57D\uC744 \uC0C8\uAE30\uB358 \uC8FC\uC220
    \uC11C\uC57D\uC9C0. \uC190\uB300\uB294 \uC21C\uAC04 \uC190\uBAA9\uC5D0 \uAC10\uAE34
    \uC885\uC774\uC640 \uB300\uAC00\uC758 \uBB38\uAD6C\uAC00 \uB4DC\uB7EC\uB09C\uB2E4.
    \uC11C\uBA85\uD558\uBA74 \uB9F9\uC57D\uC774 \uBAB8\uC73C\uB85C \uC62E\uACA8 \uC18C\uC9C4\uB418\uBA70,
    \uAC70\uBD80\uD558\uB824\uBA74 \uC2E4\uC81C \uBCBD \uD683\uBD88\uC5D0 \uC885\uC774\uB97C
    \uD0DC\uC6CC \uB04A\uB294\uB2E4. \uAC70\uC808\uD558\uACE0\uB3C4 \uC815\uC0C1
    \uACC4\uC57D\uC11C\uAC00 \uB0A8\uB294 \uBAA8\uC21C\uACFC \uACF5\uC9DC \uAE08\uBC15
    \uAC70\uB798\uB294 \uC5C6\uB2E4. \uC11C\uBA85\uACFC \uBB3C\uB9AC\uC801 \uD30C\uAE30\uB97C
    \uC120\uD0DD\uD560 \uC218 \uC788\uB2E4."
