  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: "Data_Event_\uAEBC\uC9C4_\uAE30\uB3C4"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: "data.randomeventdata.data_event_\uAEBC\uC9C4_\uAE30\uB3C4.displayname"
    lastText: "\uAEBC\uC9C4 \uAE30\uB3C4"
  - propertyPath: narrative
    key: "data.randomeventdata.data_event_\uAEBC\uC9C4_\uAE30\uB3C4.narrative"
    lastText: "\uC131\uC9C1\uC790\uAC00 \uBB34\uB98E\uC744 \uB04C\uC5B4\uC548\uACE0
      \uC788\uB2E4. \uBC1C\uBAA9\uC758 \uBD95\uB300\uB294 \uAC80\uAC8C \uC816\uC5C8\uACE0,
      \uBE48 \uB4E4\uAC83\uC758 \uC5B4\uAE68\uB048\uC744 \uC544\uC9C1 \uC950\uACE0
      \uC788\uB2E4.\n\n\u201C\uB9C8\uC9C0\uB9C9 \uB458\uC740 \uBA3C\uC800 \uBCF4\uB0C8\uC5B4\uC694.
      \uC5EC\uAE30\uAE4C\uC9C0 \uC5C5\uACE0 \uC628 \uAC74 \uD5DB\uC77C\uC774 \uC544\uB2C8\uC5C8\uACA0\uC8E0.\u201D\n\n\uC190\uC744
      \uD3B4\uC790 \uC791\uC740 \uC131\uD45C\uAC00 \uB4DC\uB7EC\uB09C\uB2E4.\n\n\u201C\uC81C
      \uAC83\uC740 \uBAA8\uB974\uACA0\uC9C0\uB9CC\u2026 \uB2E4\uB978 \uC0C1\uCC98\uB294
      \uC544\uC9C1 \uBCFC \uC218 \uC788\uC5B4\uC694. \uC57D\uCD08\uAC00 \uC870\uAE08
      \uB0A8\uC558\uAC70\uB4E0\uC694.\u201D"
  - propertyPath: options.Array.data[0].title
    key: "data.randomeventdata.data_event_\uAEBC\uC9C4_\uAE30\uB3C4.options.0.title"
    lastText: "\uC0C1\uCC98\uB97C \uB9E1\uAE34\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: "data.randomeventdata.data_event_\uAEBC\uC9C4_\uAE30\uB3C4.options.0.description"
    lastText: "\uAE08\uD654 14 \uC9C0\uBD88 \xB7 \uCCB4\uB825 25 \uD68C\uBCF5"
  - propertyPath: options.Array.data[0].resultText
    key: "data.randomeventdata.data_event_\uAEBC\uC9C4_\uAE30\uB3C4.options.0.resulttext"
    lastText: "\uC131\uC9C1\uC790\uB294 \uB0A8\uC740 \uC57D\uCD08\uB97C \uAC08\uC544
      \uB0B4 \uC0C1\uCC98\uB97C \uAC10\uC30C\uB2E4. \uBE48 \uC57D\uCD08\uC8FC\uBA38\uB2C8\uB97C
      \uC811\uC5B4 \uBB34\uB98E \uC544\uB798 \uB123\uB294\uB2E4. \u201C\uB3CC\uC544\uAC00\uB294
      \uAE38\uC744 \uCC3E\uC73C\uBA74\u2026 \uC800 \uBC14\uAE65\uC5D0\uB3C4 \uC544\uC9C1
      \uC544\uCE68\uC774 \uC624\uB294\uC9C0 \uC54C\uB824 \uC8FC\uC138\uC694.\u201D
      \uC190\uC5D0\uB294 \uB354 \uC954 \uAC83\uC774 \uC5C6\uC5C8\uB2E4."
  - propertyPath: options.Array.data[1].title
    key: "data.randomeventdata.data_event_\uAEBC\uC9C4_\uAE30\uB3C4.options.1.title"
    lastText: "\uB0A8\uC740 \uC57D\uCD08\uB97C \uAC15\uC81C\uB85C \uCC59\uAE34\uB2E4."
  - propertyPath: options.Array.data[1].description
    key: "data.randomeventdata.data_event_\uAEBC\uC9C4_\uAE30\uB3C4.options.1.description"
    lastText: "\uCCB4\uB825 12 \uD68C\uBCF5"
  - propertyPath: options.Array.data[1].resultText
    key: "data.randomeventdata.data_event_\uAEBC\uC9C4_\uAE30\uB3C4.options.1.resulttext"
    lastText: "\uADF8\uB140\uC758 \uC190\uC744 \uBC00\uC5B4\uB0B4\uACE0 \uC57D\uCD08\uB97C
      \uAC70\uB450\uC5C8\uB2E4. \uB0B4 \uC0C1\uCC98\uC5D0 \uB20C\uB7EC \uBC14\uB974\uB294
      \uB3D9\uC548 \uC131\uC9C1\uC790\uB294 \uBE48\uC190\uC744 \uBB34\uB98E \uC544\uB798
      \uAC10\uCDC4\uB2E4. \uB354\uB294 \uB0B4 \uCABD\uC744 \uBCF4\uC9C0 \uC54A\uC558\uB2E4."
  - propertyPath: options.Array.data[2].title
    key: "data.randomeventdata.data_event_\uAEBC\uC9C4_\uAE30\uB3C4.options.2.title"
    lastText: "\uAE38\uC744 \uACC4\uC18D \uAC04\uB2E4"
  - propertyPath: options.Array.data[2].description
    key: "data.randomeventdata.data_event_\uAEBC\uC9C4_\uAE30\uB3C4.options.2.description"
    lastText: "\uADF8\uB140\uB97C \uBC29\uD574\uD558\uC9C0 \uC54A\uB294\uB2E4."
  - propertyPath: options.Array.data[2].resultText
    key: "data.randomeventdata.data_event_\uAEBC\uC9C4_\uAE30\uB3C4.options.2.resulttext"
    lastText: "\uB354 \uB2E4\uAC00\uAC00\uC9C0 \uC54A\uACE0 \uAE38\uC744 \uBE44\uCF30\uB2E4.
      \uC544\uC9C1 \uACB0\uC815\uC744 \uB0B4\uB9AC\uC9C0\uB294 \uC54A\uC558\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: "data.randomeventdata.data_event_\uAEBC\uC9C4_\uAE30\uB3C4.pages.0.narrative"
    lastText: "\uC131\uC9C1\uC790\uAC00 \uBB34\uB98E\uC744 \uB04C\uC5B4\uC548\uACE0
