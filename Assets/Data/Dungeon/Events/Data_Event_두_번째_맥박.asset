  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: "Data_Event_\uB450_\uBC88\uC9F8_\uB9E5\uBC15"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.symbiosis.displayname
    lastText: "\uB450 \uBC88\uC9F8 \uB9E5\uBC15"
  - propertyPath: narrative
    key: data.randomeventdata.symbiosis.narrative
    lastText: "\uAE38\uAC00\uC758 \uAE68\uC9C4 \uC57D\uC7AC \uD1B5\uC5D0\uC11C \uBFCC\uB9AC
      \uB3CB\uC740 \uC528\uC557\uC774 \uBCF4\uC778\uB2E4.\n\n\uD1B5\uC5D0 \uBD99\uC740
      \uCABD\uC9C0\uB294 \uC0DD\uBA85\uB825\uC744 \uBA39\uACE0 \uC219\uC8FC\uB97C
      \uAC15\uD654\uD558\uB294 \uC2DD\uBB3C\uC774\uB77C\uACE0 \uC124\uBA85\uD55C\uB2E4.
      \uBFCC\uB9AC\uB97C \uD0DC\uC6B4 \uC5F0\uAE30\uB294 \uAE30\uC5B5\uC744 \uD750\uB9AC\uAC8C
      \uD558\uACE0 \uAECD\uC9C8\uC740 \uC57D\uC7AC\uB85C \uC4F4\uB2E4\uACE0 \uD55C\uB2E4.\n\n\uC190\uC744
      \uAC00\uAE4C\uC774 \uB300\uC790 \uBFCC\uB9AC\uAC00 \uB0B4 \uC190\uBAA9\uC744
      \uD5A5\uD574 \uC6C0\uC9C1\uC778\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.symbiosis.options.0.title
    lastText: "\uBFCC\uB9AC\uB0B4\uB9B4 \uC790\uB9AC\uB97C \uC900\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.symbiosis.options.0.description
    lastText: "\uCD5C\uB300 \uCCB4\uB825 -12. \uACF5\uC0DD\uD558\uB294 \uC528\uC557:
      \uC77C\uBC18 \uBB34\uAE30 \uD53C\uD574 +25%, \uCC28\uC9C0 \uD53C\uD574 +20%."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.symbiosis.options.1.title
    lastText: "\uBFCC\uB9AC\uC640 \uD568\uAED8 \uBC84\uB987 \uD558\uB098\uB97C \uD0DC\uC6B4\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.symbiosis.options.1.description
    lastText: "\uBCF4\uC720 \uB2A5\uB825 \uD558\uB098 \uC81C\uAC70 \uD6C4 \uC0C8
      \uB2A5\uB825\uC744 \uC120\uD0DD\uD55C\uB2E4."
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.symbiosis.options.2.title
    lastText: "\uAECD\uC9C8\uC744 \uC57D\uC7AC\uB85C \uC4F4\uB2E4"
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.symbiosis.options.2.description
    lastText: "\uCCB4\uB825 10 \uD68C\uBCF5. \uC528\uC557\uC758 \uD798\uC740 \uB0A8\uAE34\uB2E4."
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.symbiosis.options.0.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.symbiosis.options.1.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: options.Array.data[2].resultText
    key: data.randomeventdata.symbiosis.options.2.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.symbiosis.pages.0.narrative
    lastText: "\uAE38\uAC00\uC758 \uAE68\uC9C4 \uC57D\uC7AC \uD1B5\uC5D0\uC11C \uBFCC\uB9AC
      \uB3CB\uC740 \uC528\uC557\uC774 \uBCF4\uC778\uB2E4.\n\n\uD1B5\uC5D0 \uBD99\uC740
      \uCABD\uC9C0\uB294 \uC0DD\uBA85\uB825\uC744 \uBA39\uACE0 \uC219\uC8FC\uB97C
      \uAC15\uD654\uD558\uB294 \uC2DD\uBB3C\uC774\uB77C\uACE0 \uC124\uBA85\uD55C\uB2E4.
      \uBFCC\uB9AC\uB97C \uD0DC\uC6B4 \uC5F0\uAE30\uB294 \uAE30\uC5B5\uC744 \uD750\uB9AC\uAC8C
      \uD558\uACE0 \uAECD\uC9C8\uC740 \uC57D\uC7AC\uB85C \uC4F4\uB2E4\uACE0 \uD55C\uB2E4.\n\n\uC190\uC744
      \uAC00\uAE4C\uC774 \uB300\uC790 \uBFCC\uB9AC\uAC00 \uB0B4 \uC190\uBAA9\uC744
      \uD5A5\uD574 \uC6C0\uC9C1\uC778\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.symbiosis.pages.0.options.0.title
    lastText: "\uBFCC\uB9AC\uB0B4\uB9B4 \uC790\uB9AC\uB97C \uC900\uB2E4"
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
    key: data.randomeventdata.symbiosis.pages.0.options.0.description
    lastText: "\uACF5\uC0DD\uD558\uB294 \uC528\uC557 \uD68D\uB4DD"
  - propertyPath: pages.Array.data[0].options.Array.data[0].resultText
    key: data.randomeventdata.symbiosis.pages.0.options.0.resulttext
    lastText: "\uBFCC\uB9AC\uAC00 \uD53C\uBD80\uB97C \uD30C\uACE0\uB4E4\uC5C8\uB2E4.
      \uC6B1\uC2E0\uAC70\uB9AC\uB294 \uD314\uC744 \uC6C0\uC9C1\uC774\uB2C8 \uC804\uBCF4\uB2E4
      \uD798\uC774 \uB4E4\uC5B4\uAC04\uB2E4. \uBE48 \uC57D\uC7AC \uD1B5\uB9CC \uB0A8\uC558\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].title
    key: data.randomeventdata.symbiosis.pages.0.options.1.title
    lastText: "\uBFCC\uB9AC\uC640 \uD568\uAED8 \uBC84\uB987 \uD558\uB098\uB97C \uD0DC\uC6B4\uB2E4"
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
    key: data.randomeventdata.symbiosis.pages.0.options.1.description
    lastText: "\uB2A5\uB825 \uD558\uB098 \uC81C\uAC70 \xB7 \uC0C8 \uB2A5\uB825 \uC120\uD0DD"
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: data.randomeventdata.symbiosis.pages.0.options.1.resulttext
    lastText: "\uBFCC\uB9AC\uB97C \uD0DC\uC6B4 \uC5F0\uAE30\uC640 \uD568\uAED8 \uC775\uC219\uD55C
      \uB3D9\uC791 \uD558\uB098\uAC00 \uD750\uB824\uC84C\uB2E4. \uD1B5\uC5D0 \uBD99\uC740
      \uAE30\uB85D\uC5D0\uC11C \uC0C8\uB85C\uC6B4 \uAE30\uC220\uC744 \uC775\uD788\uACE0
      \uC7AC\uB97C \uD138\uC5C8\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].title
    key: data.randomeventdata.symbiosis.pages.0.options.2.title
    lastText: "\uAECD\uC9C8\uC744 \uC57D\uC7AC\uB85C \uC4F4\uB2E4"
  - propertyPath: pages.Array.data[0].options.Array.data[2].description
    key: data.randomeventdata.symbiosis.pages.0.options.2.description
    lastText: "\uCCB4\uB825 +10"
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: data.randomeventdata.symbiosis.pages.0.options.2.resulttext
    lastText: "\uAECD\uC9C8\uC744 \uBC97\uACA8 \uC0C1\uCC98\uC5D0 \uBB38\uC9C8\uB800\uB2E4.
      \uB0A8\uC740 \uC528\uC557\uC740 \uB9D0\uB77C \uBD80\uC2A4\uB7EC\uC84C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[3].title
    key: data.randomeventdata.symbiosis.pages.0.options.3.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[3].description
    key: data.randomeventdata.symbiosis.pages.0.options.3.description
    lastText: 
