  m_Name: "Data_Event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.displayname"
    lastText: "\uB04A\uC5B4\uC9C4 \uD68C\uC218\uC120"
  - propertyPath: narrative
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.narrative"
    lastText: "\uD3BC\uCCD0\uC9C4 \uC1E0\uB36B\uC5D0\uC11C \uAC00\uB294 \uD0DC\uC5FD
      \uC18C\uB9AC\uAC00 \uB09C\uB2E4. \uB04A\uC5B4\uC9C4 \uC1E0\uC904 \uB05D\uC5D0\uB294
      \uD68C\uC218\uB300\uC758 \uB0A9 \uD45C\uC2DD\uC774 \uB9E4\uB2EC\uB824 \uC788\uB2E4.\n\n\uD131
      \uC0AC\uC774\uC5D0 \uCC22\uAE34 \uC7A5\uAC11 \uD55C \uC870\uAC01\uC774 \uB07C\uC5B4
      \uC788\uB2E4. \uC7A5\uCE58 \uC606\uC758 \uC815\uBE44 \uC8FC\uBA38\uB2C8\uB294
      \uC544\uC9C1 \uBB36\uC5EC \uC788\uB2E4.\n\n\uC774 \uAE38\uC744 \uC9C0\uD0A4\uB358
      \uC0AC\uB78C\uC740 \uBCF4\uC774\uC9C0 \uC54A\uB294\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.0.narrative"
    lastText: "\uD3BC\uCCD0\uC9C4 \uC1E0\uB36B\uC5D0\uC11C \uAC00\uB294 \uD0DC\uC5FD
      \uC18C\uB9AC\uAC00 \uB09C\uB2E4. \uB04A\uC5B4\uC9C4 \uC1E0\uC904 \uB05D\uC5D0\uB294
      \uD68C\uC218\uB300\uC758 \uB0A9 \uD45C\uC2DD\uC774 \uB9E4\uB2EC\uB824 \uC788\uB2E4.\n\n\uD131
      \uC0AC\uC774\uC5D0 \uCC22\uAE34 \uC7A5\uAC11 \uD55C \uC870\uAC01\uC774 \uB07C\uC5B4
      \uC788\uB2E4. \uC7A5\uCE58 \uC606\uC758 \uC815\uBE44 \uC8FC\uBA38\uB2C8\uB294
      \uC544\uC9C1 \uBB36\uC5EC \uC788\uB2E4.\n\n\uC774 \uAE38\uC744 \uC9C0\uD0A4\uB358
      \uC0AC\uB78C\uC740 \uBCF4\uC774\uC9C0 \uC54A\uB294\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.0.options.0.title"
    lastText: "\uBB34\uAE30 \uB05D\uC73C\uB85C \uAC78\uC1E0\uB97C \uB20C\uB7EC \uBCF8\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.0.options.0.description"
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[0].resultText
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.0.options.0.resulttext"
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[1].title
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.0.options.1.title"
    lastText: "\uC606\uC758 \uC815\uBE44 \uC8FC\uBA38\uB2C8\uB97C \uC0B4\uD540\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.0.options.1.description"
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.0.options.1.resulttext"
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[2].title
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.0.options.2.title"
    lastText: "\uAC74\uB4DC\uB9AC\uC9C0 \uC54A\uACE0 \uBB3C\uB7EC\uC120\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].description
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.0.options.2.description"
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.0.options.2.resulttext"
    lastText: "\uC1E0\uC904\uC744 \uBC1F\uC9C0 \uC54A\uB3C4\uB85D \uBE44\uCF1C \uC9C0\uB098\uAC14\uB2E4.
      \uB4F1 \uB4A4\uC5D0\uC11C \uD0DC\uC5FD \uC18C\uB9AC\uAC00 \uC774\uC5B4\uC9C4\uB2E4."
  - propertyPath: pages.Array.data[1].narrative
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.1.narrative"
    lastText: "\uBB34\uAE30 \uB05D\uC73C\uB85C \uD131\uC744 \uB20C\uB800\uB2E4. \uC1E0\uB0A0\uC774
      \uB9DE\uBB3C\uB9AC\uACE0, \uC7A0\uC2DC \uB4A4 \uB2E4\uC2DC \uBC8C\uC5B4\uC9C4\uB2E4.\n\n\uD798\uC744
      \uBAA8\uC73C\uB294 \uCABD\uACFC \uD480\uB9AC\uB294 \uCABD\uC774 \uBC88\uAC08\uC544
      \uBC14\uB010\uB2E4. \uAC78\uC1E0\uAC00 \uBE44\uB294 \uC9E7\uC740 \uD2C8\uC774
      \uC788\uB2E4. \uC6C0\uC9C1\uC784\uC744 \uC775\uD790 \uC218\uB3C4, \uD0DC\uC5FD\uC744
      \uBE7C\uB0BC \uC218\uB3C4 \uC788\uACA0\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].title
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.1.options.0.title"
    lastText: "\uD798\uC774 \uD480\uB9AC\uB294 \uAC04\uACA9\uC744 \uBAB8\uC5D0 \uC775\uD78C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].description
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.1.options.0.description"
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[0].resultText
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.1.options.0.resulttext"
    lastText: "\uC1E0\uD131\uC758 \uC6C0\uC9C1\uC784\uC5D0 \uB9DE\uCDB0 \uBC1C\uC744
      \uC62E\uACBC\uB2E4. \uD798\uC744 \uBAA8\uC73C\uB294 \uB3D9\uC548 \uC0DD\uAE30\uB294
      \uBE48\uD2C8\uC774 \uB208\uC5D0 \uB4E4\uC5B4\uC628\uB2E4. \uB9C8\uC9C0\uB9C9\uC73C\uB85C
      \uBB34\uAE30 \uB05D\uC744 \uB123\uC5B4 \uAC78\uC1E0\uB97C \uBD80\uB7EC\uB728\uB838\uB2E4.
      \uC1E0\uD131\uC740 \uBC8C\uC5B4\uC9C4 \uCC44 \uBA48\uCDC4\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].title
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.1.options.1.title"
    lastText: "\uD0DC\uC5FD \uC0C1\uC790\uB97C \uBE7C\uB0BC \uC900\uBE44\uB97C \uD55C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].description
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.1.options.1.description"
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[1].resultText
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.1.options.1.resulttext"
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[2].title
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.1.options.2.title"
    lastText: "\uAC74\uB4DC\uB9AC\uC9C0 \uC54A\uACE0 \uBB3C\uB7EC\uC120\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[2].description
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.1.options.2.description"
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[2].resultText
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.1.options.2.resulttext"
    lastText: "\uC1E0\uC904\uC744 \uBC1F\uC9C0 \uC54A\uB3C4\uB85D \uBE44\uCF1C \uC9C0\uB098\uAC14\uB2E4.
      \uB4F1 \uB4A4\uC5D0\uC11C \uD0DC\uC5FD \uC18C\uB9AC\uAC00 \uC774\uC5B4\uC9C4\uB2E4."
  - propertyPath: pages.Array.data[2].narrative
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.2.narrative"
    lastText: "\uCE7C\uB05D\uC744 \uB123\uC790 \uD0DC\uC5FD \uC0C1\uC790\uAC00 \uC870\uAE08
      \uB4E4\uB9B0\uB2E4. \uD558\uC9C0\uB9CC \uAC78\uC1E0\uB97C \uC7A1\uC744 \uC190\uC774
      \uD558\uB098 \uB354 \uD544\uC694\uD558\uB2E4.\n\n\uC190\uC744 \uB123\uC73C\uBA74
      \uB0A0\uC744 \uD53C\uD560 \uC218\uB294 \uC5C6\uC744 \uAC83\uC774\uB2E4. \uC7A5\uAC11\uC5D0
      \uB0A8\uC740 \uCC22\uAE40\uC774 \uC5BC\uB9C8\uB098 \uAE4A\uC740\uC9C0 \uC774\uC81C
      \uC54C \uAC83 \uAC19\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].title
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.2.options.0.title"
    lastText: "\uB0A0\uC744 \uAC10\uC218\uD558\uACE0 \uD0DC\uC5FD\uC744 \uBE7C\uB0B8\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].description
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.2.options.0.description"
    lastText: "\uCCB4\uB825 16 \uC9C0\uBD88 \xB7 \uBC18\uACA9 \uD0DC\uC5FD \uD68D\uB4DD"
  - propertyPath: pages.Array.data[2].options.Array.data[0].resultText
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.2.options.0.resulttext"
    lastText: "\uC1E0\uB0A0\uC774 \uC190\uC744 \uBB3C\uC5C8\uB2E4. \uC774\uB97C \uC545\uBB3C\uACE0
      \uD0DC\uC5FD \uC0C1\uC790\uB97C \uBF51\uC544\uB0C8\uB2E4. \uB0A0\uC744 \uC6C0\uC9C1\uC774\uB358
      \uD798\uC740 \uC791\uACE0 \uBB34\uAC70\uC6B4 \uC0C1\uC790 \uC18D\uC5D0 \uB0A8\uC544
      \uC788\uB2E4. \uBE48 \uB36B\uC740 \uBC8C\uC5B4\uC9C4 \uCC44 \uBA48\uCDC4\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[1].title
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.2.options.1.title"
    lastText: "\uAC74\uB4DC\uB9AC\uC9C0 \uC54A\uACE0 \uBB3C\uB7EC\uC120\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[1].description
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.2.options.1.description"
    lastText: 
  - propertyPath: pages.Array.data[2].options.Array.data[1].resultText
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.2.options.1.resulttext"
    lastText: "\uC1E0\uC904\uC744 \uBC1F\uC9C0 \uC54A\uB3C4\uB85D \uBE44\uCF1C \uC9C0\uB098\uAC14\uB2E4.
      \uB4F1 \uB4A4\uC5D0\uC11C \uD0DC\uC5FD \uC18C\uB9AC\uAC00 \uC774\uC5B4\uC9C4\uB2E4."
  - propertyPath: pages.Array.data[3].narrative
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.3.narrative"
    lastText: "\uC815\uBE44 \uC8FC\uBA38\uB2C8\uC758 \uC785\uAD6C\uAC00 \uBCF4\uC778\uB2E4.
      \uC791\uC740 \uB3D9\uC804\uB4E4\uC774 \uC1E0\uC904 \uACE0\uB9AC \uBC11\uC5D0
      \uAE54\uB824 \uC788\uB2E4.\n\n\uC1E0\uC904\uC744 \uBB34\uAE30 \uB05D\uC73C\uB85C
      \uB2F9\uAE30\uBA74 \uB36B\uC740 \uB2EB\uD788\uACA0\uC9C0\uB9CC, \uC8FC\uBA38\uB2C8\uB294
      \uAEBC\uB0BC \uC218 \uC788\uACA0\uB2E4."
  - propertyPath: pages.Array.data[3].options.Array.data[0].title
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.3.options.0.title"
    lastText: "\uC1E0\uC904\uC744 \uB2F9\uAE30\uACE0 \uC8FC\uBA38\uB2C8\uB97C \uAEBC\uB0B8\uB2E4."
  - propertyPath: pages.Array.data[3].options.Array.data[0].description
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.3.options.0.description"
    lastText: 
  - propertyPath: pages.Array.data[3].options.Array.data[0].resultText
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.3.options.0.resulttext"
    lastText: "\uBB34\uAE30 \uB05D\uC73C\uB85C \uD0DC\uC5FD \uC0C1\uC790\uB97C \uC5F4\uACE0
      \uAC78\uC1E0\uB97C \uBD80\uB7EC\uB728\uB838\uB2E4. \uD798\uC774 \uBE60\uC9C4
      \uC1E0\uD131\uC744 \uD655\uC778\uD55C \uB4A4 \uC8FC\uBA38\uB2C8\uB97C \uAEBC\uB0B4
      \uB3D9\uC804\uC744 \uC14C\uB2E4. \uBE48 \uC8FC\uBA38\uB2C8\uB97C \uB36B \uC606\uC5D0
      \uB0B4\uB824\uB193\uC558\uB2E4."
  - propertyPath: pages.Array.data[3].options.Array.data[1].title
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.3.options.1.title"
    lastText: "\uAC74\uB4DC\uB9AC\uC9C0 \uC54A\uACE0 \uBB3C\uB7EC\uC120\uB2E4."
  - propertyPath: pages.Array.data[3].options.Array.data[1].description
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.3.options.1.description"
    lastText: 
  - propertyPath: pages.Array.data[3].options.Array.data[1].resultText
    key: "data.randomeventdata.data_event_\uB04A\uC5B4\uC9C4_\uD68C\uC218\uC120.pages.3.options.1.resulttext"
    lastText: "\uC1E0\uC904\uC744 \uBC1F\uC9C0 \uC54A\uB3C4\uB85D \uBE44\uCF1C \uC9C0\uB098\uAC14\uB2E4.
      \uB4F1 \uB4A4\uC5D0\uC11C \uD0DC\uC5FD \uC18C\uB9AC\uAC00 \uC774\uC5B4\uC9C4\uB2E4."
  textOwnerGuid: 8a303279e738b2842bc1e276263f8913
  id: SalvageTrap
  displayName: "\uB04A\uC5B4\uC9C4 \uD68C\uC218\uC120"
  discovery: 1
  worldObject: {fileID: 11400000, guid: b9b44196f0993ca42b12396ca5985500, type: 2}
  encounterKind: 0
  authoringLore: "\uD68C\uC218\uB300\uAC00 \uC6B4\uBC18\uB85C\uC758 \uB4A4\uB97C
    \uB9C9\uC73C\uB824\uACE0 \uC124\uCE58\uD55C \uBC18\uBCF5 \uC791\uB3D9\uC2DD \uC1E0\uB36B.
    \uB04A\uC5B4\uC9C4 \uD68C\uC218\uC120\uACFC \uC815\uBE44\uC6A9 \uC8FC\uBA38\uB2C8\uAC00
    \uB0A8\uC558\uB2E4. \uC124\uCE58\uC790\uB294 \uBCF4\uC774\uC9C0 \uC54A\uC9C0\uB9CC
    \uB204\uAC00 \uC65C \uC774 \uBB3C\uAC74\uC744 \uAC00\uC838\uC654\uB294\uC9C0
    \uD615\uD0DC\uB85C \uC9D0\uC791\uD560 \uC218 \uC788\uB2E4. \uC7A5\uC18C \uC790\uCCB4\uC758
    \uD658\uC0C1/\uCC28\uC6D0\uC774\uB3D9\uC774 \uD544\uC694\uD558\uC9C0 \uC54A\uB2E4.
    \uC120\uD0DD\uC758 \uC6D0\uD615\uC740 \uAE30\uC874 Mirror\uC758 \uAE30\uC220
    \uAC15\uD654/\uCCB4\uB825 \uB300\uAC00\uC758 \uC720\uBB3C/\uC18C\uC561 \uACE8\uB4DC\uC774\uBA70
    \uD6A8\uACFC\uC640 \uBE44\uC6A9\uC740 \uBCF4\uC874\uD55C\uB2E4."
  roomLayout: 0
  roomInteriors:
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
  excludedFromRandomPool: 1
  narrative: "\uD3BC\uCCD0\uC9C4 \uC1E0\uB36B\uC5D0\uC11C \uAC00\uB294 \uD0DC\uC5FD
