    key: data.randomeventdata.mastertrial.pages.0.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].description
    key: data.randomeventdata.mastertrial.pages.0.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: data.randomeventdata.mastertrial.pages.0.options.2.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[1].narrative
    key: data.randomeventdata.mastertrial.pages.1.narrative
    lastText: "\u201C\uADF8 \uC774\uB984\uC744 \uC4F8 \uC790\uACA9\uC774 \uC788\uB294\uC9C0
      \uC99D\uBA85\uD558\uB77C.\u201D\n\n\uB3CC\uAC00\uBA74\uC5D0\uC11C \uBB35\uC9C1\uD55C
      \uB9C8\uB825\uC774 \uD758\uB7EC\uB098\uC628\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].title
    key: data.randomeventdata.mastertrial.pages.1.options.0.title
    lastText: "\uC2DC\uD5D8\uC744 \uBC1B\uB294\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].description
    key: data.randomeventdata.mastertrial.pages.1.options.0.description
    lastText: "\uC804\uD22C \xB7 \uC804\uC6A9 \uC720\uBB3C \uC120\uD0DD"
  - propertyPath: pages.Array.data[1].options.Array.data[0].resultText
    key: data.randomeventdata.mastertrial.pages.1.options.0.resulttext
    lastText: "\uB3CC\uAC00\uBA74\uC774 \uBD88\uB7EC\uB0B8 \uC2DC\uB828\uC744 \uC774\uACA8
      \uB0C8\uB2E4. \uAC00\uBA74\uC758 \uC785\uC5D0\uC11C \uB0B4 \uBAAB\uC758 \uBCF4\uC0C1\uC774
      \uB5A8\uC5B4\uC84C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].title
    key: data.randomeventdata.mastertrial.pages.1.options.1.title
    lastText: "\uC900\uBE44\uD560 \uBC29\uBC95\uC774 \uC5C6\uB294\uC9C0 \uBB3B\uB294\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].description
    key: data.randomeventdata.mastertrial.pages.1.options.1.description
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[1].resultText
    key: data.randomeventdata.mastertrial.pages.1.options.1.resulttext
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[2].title
    key: data.randomeventdata.mastertrial.pages.1.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[2].description
    key: data.randomeventdata.mastertrial.pages.1.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[2].resultText
    key: data.randomeventdata.mastertrial.pages.1.options.2.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[2].narrative
    key: data.randomeventdata.mastertrial.pages.2.narrative
    lastText: "\uB3CC\uAC00\uBA74\uC758 \uB4B7\uBA74\uC5D0 \uC624\uB798\uB41C \uAE30\uC220\uACFC
      \uD638\uD761\uBC95\uC774 \uC0C8\uACA8\uC838 \uC788\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].title
    key: data.randomeventdata.mastertrial.pages.2.options.0.title
    lastText: "\uAE30\uC220 \uD558\uB098\uB97C \uBC84\uB9AC\uACE0 \uBE44\uBB38\uC758
      \uAE30\uC220\uC744 \uC775\uD78C\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].description
    key: data.randomeventdata.mastertrial.pages.2.options.0.description
    lastText: "\uB2A5\uB825 \uD558\uB098 \uC81C\uAC70 \xB7 \uC0C8 \uB2A5\uB825 \uC120\uD0DD
      \xB7 \uC0C8 \uB2A5\uB825 \uC120\uD0DD"
  - propertyPath: pages.Array.data[2].options.Array.data[0].resultText
    key: data.randomeventdata.mastertrial.pages.2.options.0.resulttext
    lastText: "\uC775\uC219\uD55C \uB3D9\uC791 \uD558\uB098\uB97C \uBC84\uB9AC\uACE0
      \uB3CC\uAC00\uBA74\uC5D0 \uC0C8\uACA8\uC9C4 \uB450 \uAE30\uC220\uC744 \uBAB8\uC5D0
      \uC775\uD614\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[1].title
    key: data.randomeventdata.mastertrial.pages.2.options.1.title
    lastText: "\uD638\uD761\uBC95\uC744 \uC775\uD78C\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[1].description
    key: data.randomeventdata.mastertrial.pages.2.options.1.description
    lastText: "\uCD5C\uB300\xB7\uD604\uC7AC \uCCB4\uB825 +4"
  - propertyPath: pages.Array.data[2].options.Array.data[1].resultText
    key: data.randomeventdata.mastertrial.pages.2.options.1.resulttext
    lastText: "\uC0C8\uACA8\uC9C4 \uD638\uD761\uBC95\uC744 \uB530\uB77C \uC228\uC744
      \uACE8\uB790\uB2E4. \uAE34\uC7A5\uC744 \uB2A6\uCD94\uC790 \uBAB8\uC774 \uC870\uAE08
      \uD3B8\uD574\uC84C\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[2].title
