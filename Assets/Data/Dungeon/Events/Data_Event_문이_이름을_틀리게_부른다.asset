  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: data.randomeventdata.mastertrial.pages.0.options.2.resulttext
    lastText: "\uBB38\uC740 \uD2C0\uB9B0 \uC774\uB984\uC744 \uD55C \uBC88 \uB354
      \uBD88\uB800\uB2E4. \uAC78\uC74C\uC744 \uBA48\uCD94\uC9C0 \uC54A\uC558\uB2E4."
  - propertyPath: pages.Array.data[1].narrative
    key: data.randomeventdata.mastertrial.pages.1.narrative
    lastText: "\uADF8 \uC774\uB984\uC744 \uC4F8 \uC790\uACA9\uC774 \uC788\uB294\uC9C0
      \uC99D\uBA85\uD558\uB77C.\r\n\r\n\uBB38 \uC548\uCABD\uC5D0\uC11C \uBB34\uAC70\uC6B4
      \uBC1C\uC18C\uB9AC\uAC00 \uB2E4\uAC00\uC628\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].title
