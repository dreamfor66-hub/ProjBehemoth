    key: data.randomeventdata.mastertrial.pages.0.options.1.title
    lastText: "\uB3CC\uAC00\uBA74 \uB4B7\uBA74\uC758 \uAE00\uC744 \uC77D\uB294\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
