  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: Pilgrim
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.pilgrim.displayname
    lastText: "\uC9D0 \uD558\uB098\uB9CC \uBD80\uD0C1\uD558\uB124"
  - propertyPath: narrative
    key: data.randomeventdata.pilgrim.narrative
    lastText: "\uC791\uC740 \uC608\uBC30\uC2E4\uC5D0\uC11C \uB178\uC778\uC774 \uB3CC\uB4E4\uC744
      \uC8FC\uC6CC \uB2F4\uACE0 \uC788\uB2E4.\r\n\r\n\uB0B4\uAC00 \uAD74\uB7EC\uC628
      \uB3CC \uD558\uB098\uB97C \uAC74\uB124\uC790 \uB178\uC778\uC774 \uC790\uB8E8\uB97C
      \uBC8C\uB824 \uBCF4\uC778\uB2E4.\r\n\r\n\uB3CC\uB9C8\uB2E4 \uC0AC\uB78C\uC758
      \uC774\uB984\uC774 \uC0C8\uACA8\uC838 \uC788\uB2E4.\r\n\r\n\uC5EC\uAE30\uC11C
      \uC8FD\uC740 \uC774\uB4E4\uC774\uB124. \uC720\uC871\uB4E4\uC5D0\uAC8C \uC774\uAC83\uB9CC\uC774\uB77C\uB3C4
      \uC804\uD574 \uC8FC\uB824\uB294 \uCC38\uC774\uC57C.\r\n\r\n\uC790\uB8E8\uAC00
      \uBB34\uAC70\uC6CC \uC9D0\uAFBC\uC744 \uAD6C\uD588\uB294\uB370, \uC5EC\uBE44\uAC00
      \uBAA8\uC790\uB77C \uB3CC\uC544\uAC00\uB824\uB358 \uC911\uC774\uB77C\uACE0
      \uD55C\uB2E4.\r\n\r\n\uC131\uC758 \uC61B \uC6B4\uBC18\uC6A9 \uACC4\uB2E8\uC744
      \uCC3E\uC73C\uBA74 \uAE38\uC744 \uC904\uC77C \uC218 \uC788\uC9C0\uB9CC, \uC785\uAD6C\uB97C
      \uCC3E\uC9C0 \uBABB\uD588\uB2E4\uB294 \uBAA8\uC591\uC774\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.pilgrim.options.0.title
    lastText: "\uC5EC\uBE44\uB97C \uBCF4\uD0E0\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.pilgrim.options.0.description
    lastText: "25\uACE8\uB4DC \uC18C\uBAA8. \uC21C\uB840\uC790\uC758 \uC11C\uC57D
      \uD68D\uB4DD. \uAC00\uB4DC 3\uD68C\uB9C8\uB2E4 \uAC8C\uC774\uC9C0 +3. \uC778\uC5F0\uC744
      \uB0A8\uAE34\uB2E4."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.pilgrim.options.1.title
    lastText: "\uC0D8\uC758 \uC704\uCE58\uB97C \uC11C\uB85C \uB098\uB208\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.pilgrim.options.1.description
    lastText: "\uCCB4\uB825 12 \uD68C\uBCF5. \uC11C\uC57D\uC740 \uC5BB\uC9C0 \uC54A\uB294\uB2E4."
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.pilgrim.options.2.title
    lastText: "\uC598\uAC00 \uC9C0\uB984\uAE38\uC744 \uCC3E\uC744 \uAC70\uC57C"
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.pilgrim.options.2.description
    lastText: "\uAC15\uC544\uC9C0\uAC00 \uAE38\uC744 \uCC3E\uB294\uB2E4. \uC11C\uC57D
      \uD68D\uB4DD, \uCCB4\uB825 12 \uD68C\uBCF5, \uC778\uC5F0\uC744 \uB0A8\uAE34\uB2E4."
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.pilgrim.options.0.resulttext
    lastText: 
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.pilgrim.options.1.resulttext
    lastText: 
  - propertyPath: options.Array.data[2].resultText
    key: data.randomeventdata.pilgrim.options.2.resulttext
    lastText: 
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.pilgrim.pages.0.narrative
    lastText: "\uC791\uC740 \uC608\uBC30\uC2E4\uC5D0\uC11C \uB178\uC778\uC774 \uB3CC\uB4E4\uC744
      \uC8FC\uC6CC \uB2F4\uACE0 \uC788\uB2E4.\r\n\r\n\uB0B4\uAC00 \uAD74\uB7EC\uC628
      \uB3CC \uD558\uB098\uB97C \uAC74\uB124\uC790 \uB178\uC778\uC774 \uC790\uB8E8\uB97C
      \uBC8C\uB824 \uBCF4\uC778\uB2E4.\r\n\r\n\uB3CC\uB9C8\uB2E4 \uC0AC\uB78C\uC758
      \uC774\uB984\uC774 \uC0C8\uACA8\uC838 \uC788\uB2E4.\r\n\r\n\uC5EC\uAE30\uC11C
      \uC8FD\uC740 \uC774\uB4E4\uC774\uB124. \uC720\uC871\uB4E4\uC5D0\uAC8C \uC774\uAC83\uB9CC\uC774\uB77C\uB3C4
      \uC804\uD574 \uC8FC\uB824\uB294 \uCC38\uC774\uC57C.\r\n\r\n\uC790\uB8E8\uAC00
      \uBB34\uAC70\uC6CC \uC9D0\uAFBC\uC744 \uAD6C\uD588\uB294\uB370, \uC5EC\uBE44\uAC00
      \uBAA8\uC790\uB77C \uB3CC\uC544\uAC00\uB824\uB358 \uC911\uC774\uB77C\uACE0
      \uD55C\uB2E4.\r\n\r\n\uC131\uC758 \uC61B \uC6B4\uBC18\uC6A9 \uACC4\uB2E8\uC744
      \uCC3E\uC73C\uBA74 \uAE38\uC744 \uC904\uC77C \uC218 \uC788\uC9C0\uB9CC, \uC785\uAD6C\uB97C
      \uCC3E\uC9C0 \uBABB\uD588\uB2E4\uB294 \uBAA8\uC591\uC774\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.pilgrim.pages.0.options.0.title
    lastText: "\uC5EC\uBE44\uB97C \uBCF4\uD0E0\uB2E4"
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
    key: data.randomeventdata.pilgrim.pages.0.options.0.description
    lastText: "\uC21C\uB840\uC790\uC758 \uC11C\uC57D \uD68D\uB4DD"
  - propertyPath: pages.Array.data[0].options.Array.data[0].resultText
    key: data.randomeventdata.pilgrim.pages.0.options.0.resulttext
    lastText: "\uC7A5\uBE44\uB97C \uCC59\uAE30\uACE0 \uB2E4\uC2DC \uBCF5\uB3C4\uB85C
      \uB098\uC130\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].title
    key: data.randomeventdata.pilgrim.pages.0.options.1.title
    lastText: "\uC0D8\uC758 \uC704\uCE58\uB97C \uC11C\uB85C \uB098\uB208\uB2E4"
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
    key: data.randomeventdata.pilgrim.pages.0.options.1.description
    lastText: "\uCCB4\uB825 +12"
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: data.randomeventdata.pilgrim.pages.0.options.1.resulttext
    lastText: "\uC7A5\uBE44\uB97C \uCC59\uAE30\uACE0 \uB2E4\uC2DC \uBCF5\uB3C4\uB85C
      \uB098\uC130\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].title
    key: data.randomeventdata.pilgrim.pages.0.options.2.title
    lastText: "\uC598\uAC00 \uC9C0\uB984\uAE38\uC744 \uCC3E\uC744 \uAC70\uC57C"
  - propertyPath: pages.Array.data[0].options.Array.data[2].description
    key: data.randomeventdata.pilgrim.pages.0.options.2.description
    lastText: "\uC21C\uB840\uC790\uC758 \uC11C\uC57D \uD68D\uB4DD \xB7 \uCCB4\uB825
      +12"
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: data.randomeventdata.pilgrim.pages.0.options.2.resulttext
    lastText: "\uC7A5\uBE44\uB97C \uCC59\uAE30\uACE0 \uB2E4\uC2DC \uBCF5\uB3C4\uB85C
