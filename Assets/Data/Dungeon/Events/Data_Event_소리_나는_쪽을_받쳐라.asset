  m_Name: "Data_Event_\uC18C\uB9AC_\uB098\uB294_\uCABD\uC744_\uBC1B\uCCD0\uB77C"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.bell.displayname
    lastText: "\uC18C\uB9AC \uB098\uB294 \uCABD\uC744 \uBC1B\uCCD0\uB77C"
  - propertyPath: narrative
    key: data.randomeventdata.bell.narrative
    lastText: "\uC791\uC740 \uC885\uC774 \uC4F0\uB7EC\uC9C4 \uC6B4\uBC18 \uC218\uB808
      \uC544\uB798\uC5D0 \uB07C\uC5B4 \uC788\uB2E4. \uBC14\uD034\uAC00 \uD754\uB4E4\uB9B4
      \uB54C\uB9C8\uB2E4 \uB9D1\uC740 \uC18C\uB9AC\uAC00 \uB09C\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.bell.options.0.title
    lastText: "\uAC00\uC838\uC628 \uC720\uBB3C\uB85C \uBC1B\uCE5C\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.bell.options.0.description
    lastText: "\uACF5\uC6A9 \uC720\uBB3C \uD558\uB098 \uC120\uD0DD\uD574 \uC81C\uAC70.
      \uC218\uD638\uC758 \uC885: \uCD5C\uB300 \uAC00\uB4DC +10, \uC804\uD22C \uC2DC\uC791
      3\uCD08 \uCCB4\uB825 \uD53C\uD574 -20%."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.bell.options.1.title
    lastText: "\uC5B4\uAE68\uB85C \uB4E4\uC5B4 \uC62C\uB9B0\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.bell.options.1.description
    lastText: "\uCCB4\uB825 -20. \uC218\uD638\uC758 \uC885 \uD68D\uB4DD."
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.bell.options.2.title
    lastText: "\uAC00\uC7A5\uC790\uB9AC\uC758 \uCCAD\uB3D9\uB9CC \uB5BC\uC5B4 \uAC04\uB2E4"
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.bell.options.2.description
    lastText: "\uACE8\uB4DC +20. \uC885\uC740 \uAEBC\uB0B4\uC9C0 \uBABB\uD55C\uB2E4."
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.bell.options.0.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.bell.options.1.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: options.Array.data[2].resultText
    key: data.randomeventdata.bell.options.2.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.bell.pages.0.narrative
    lastText: "\uC791\uC740 \uC885\uC774 \uC4F0\uB7EC\uC9C4 \uC6B4\uBC18 \uC218\uB808
      \uC544\uB798\uC5D0 \uB07C\uC5B4 \uC788\uB2E4. \uBC14\uD034\uAC00 \uD754\uB4E4\uB9B4
      \uB54C\uB9C8\uB2E4 \uB9D1\uC740 \uC18C\uB9AC\uAC00 \uB09C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.bell.pages.0.options.0.title
    lastText: "\uC885\uC744 \uAEBC\uB0BC \uBC29\uBC95\uC744 \uC0B4\uD540\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
    key: data.randomeventdata.bell.pages.0.options.0.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[0].resultText
    key: data.randomeventdata.bell.pages.0.options.0.resulttext
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[1].title
    key: data.randomeventdata.bell.pages.0.options.1.title
    lastText: "\uBC14\uB2E5\uC758 \uCCAD\uB3D9 \uC870\uAC01\uB9CC \uCC59\uAE34\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
    key: data.randomeventdata.bell.pages.0.options.1.description
    lastText: "\uACE8\uB4DC +20"
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: data.randomeventdata.bell.pages.0.options.1.resulttext
    lastText: "\uBC14\uB2E5\uC5D0 \uD769\uC5B4\uC9C4 \uCCAD\uB3D9 \uC870\uAC01\uB9CC
      \uCC59\uACBC\uB2E4. \uC885\uC740 \uC218\uB808 \uC544\uB798\uC5D0 \uB0A8\uACA8
      \uB450\uC5C8\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].title
    key: data.randomeventdata.bell.pages.0.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[2].description
    key: data.randomeventdata.bell.pages.0.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[2].resultText
    key: data.randomeventdata.bell.pages.0.options.2.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[1].narrative
    key: data.randomeventdata.bell.pages.1.narrative
    lastText: "\uC218\uB808\uB97C \uC870\uAE08\uB9CC \uB4E4\uC5B4\uB3C4 \uC885\uC744
      \uBE84 \uC218 \uC788\uACA0\uB2E4. \uBC1B\uCE68\uC774 \uC5C6\uC73C\uBA74 \uB0B4
      \uC5B4\uAE68\uB85C \uBB34\uAC8C\uB97C \uBC84\uD168\uC57C \uD55C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].title
    key: data.randomeventdata.bell.pages.1.options.0.title
    lastText: "\uC5B4\uAE68\uB85C \uC218\uB808\uB97C \uB4E4\uC5B4 \uC62C\uB9B0\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].description
    key: data.randomeventdata.bell.pages.1.options.0.description
    lastText: "\uC218\uD638\uC758 \uC885 \uD68D\uB4DD"
  - propertyPath: pages.Array.data[1].options.Array.data[0].resultText
    key: data.randomeventdata.bell.pages.1.options.0.resulttext
    lastText: "\uC5B4\uAE68\uB85C \uC218\uB808\uB97C \uBC84\uD2F0\uBA70 \uC885\uC744
      \uAEBC\uB0C8\uB2E4. \uC9D0\uC744 \uCC59\uAE30\uACE0 \uC218\uB808\uB97C \uC870\uC2EC\uC2A4\uB808
      \uB0B4\uB824\uB193\uC558\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].title
    key: data.randomeventdata.bell.pages.1.options.1.title
    lastText: "\uC8FC\uBCC0\uC5D0\uC11C \uBC1B\uCE68\uC744 \uCC3E\uB294\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].description
    key: data.randomeventdata.bell.pages.1.options.1.description
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[1].resultText
    key: data.randomeventdata.bell.pages.1.options.1.resulttext
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[2].title
    key: data.randomeventdata.bell.pages.1.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[2].description
    key: data.randomeventdata.bell.pages.1.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[2].resultText
    key: data.randomeventdata.bell.pages.1.options.2.resulttext
    lastText: "\uB098\uB294 \uB0B4 \uAE38\uC744 \uACC4\uC18D \uAC00\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[2].narrative
    key: data.randomeventdata.bell.pages.2.narrative
    lastText: "\uBD80\uB7EC\uC9C4 \uB098\uBB47\uAC00\uC9C0\uB85C\uB294 \uBB34\uAC8C\uB97C
      \uBC84\uD2F0\uC9C0 \uBABB\uD55C\uB2E4. \uAC00\uC9C0\uACE0 \uC788\uB294 \uC720\uBB3C\uC774\uB77C\uBA74
      \uBC84\uD2F8 \uC218 \uC788\uACA0\uC9C0\uB9CC \uC218\uB808 \uC544\uB798\uC5D0
      \uB0A8\uACA8\uC57C \uD55C\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].title
    key: data.randomeventdata.bell.pages.2.options.0.title
    lastText: "\uC720\uBB3C \uD558\uB098\uB97C \uBC1B\uCE68\uC73C\uB85C \uC4F4\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[0].description
    key: data.randomeventdata.bell.pages.2.options.0.description
    lastText: "\uACF5\uC6A9 \uC720\uBB3C \uD558\uB098 \uC81C\uAC70 \xB7 \uC218\uD638\uC758
      \uC885 \uD68D\uB4DD"
  - propertyPath: pages.Array.data[2].options.Array.data[0].resultText
    key: data.randomeventdata.bell.pages.2.options.0.resulttext
    lastText: "\uBC1B\uCE68\uC73C\uB85C \uB123\uC740 \uC720\uBB3C\uC744 \uC218\uB808
      \uC544\uB798\uC5D0 \uB0A8\uAE30\uACE0 \uC885\uC744 \uAEBC\uB0C8\uB2E4. \uC218\uB808\uB97C
      \uB2E4\uC2DC \uAC74\uB4DC\uB9AC\uC9C0\uB294 \uC54A\uAE30\uB85C \uD588\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[1].title
    key: data.randomeventdata.bell.pages.2.options.1.title
    lastText: "\uCCAD\uB3D9 \uC870\uAC01\uB9CC \uCC59\uAE34\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[1].description
    key: data.randomeventdata.bell.pages.2.options.1.description
    lastText: "\uACE8\uB4DC +20"
  - propertyPath: pages.Array.data[2].options.Array.data[1].resultText
    key: data.randomeventdata.bell.pages.2.options.1.resulttext
    lastText: "\uBC14\uB2E5\uC5D0 \uD769\uC5B4\uC9C4 \uCCAD\uB3D9 \uC870\uAC01\uB9CC
      \uCC59\uACBC\uB2E4. \uC885\uC740 \uC218\uB808 \uC544\uB798\uC5D0 \uB0A8\uACA8
      \uB450\uC5C8\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[2].title
    key: data.randomeventdata.bell.pages.2.options.2.title
    lastText: "\uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[2].options.Array.data[2].description
    key: data.randomeventdata.bell.pages.2.options.2.description
    lastText: 
