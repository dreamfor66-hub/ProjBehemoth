  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.bell.displayname
    lastText: "\uC18C\uB9AC \uB098\uB294 \uCABD\uC744 \uBC1B\uCCD0\uB77C"
  - propertyPath: narrative
    key: data.randomeventdata.bell.narrative
    lastText: "\uBB34\uB108\uC9C4 \uC608\uBC30\uC2E4\uC5D0\uC11C \uC885\uC18C\uB9AC\uAC00
      \uB4E4\uB9B0\uB2E4.\r\n\r\n\uC791\uC740 \uC885\uC774 \uB3CC\uB85C \uB41C \uB4E4\uBCF4
      \uC544\uB798\uC5D0 \uB07C\uC5B4 \uC788\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.bell.options.0.title
    lastText: "\uAC00\uC838\uC628 \uC720\uBB3C\uB85C \uBC1B\uCE5C\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.bell.options.0.description
    lastText: "\uACF5\uC6A9 \uC720\uBB3C \uD558\uB098 \uC120\uD0DD\uD574 \uC81C\uAC70.
      \uC218\uD638\uC758 \uC885: \uCD5C\uB300 \uAC00\uB4DC +10, \uC804\uD22C \uC2DC\uC791
      3\uCD08 \uCCB4\uB825 \uD53C\uD574 -20%."
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.bell.options.1.title
    lastText: "\uC5B4\uAE68\uB85C \uB4E4\uC5B4 \uC62C\uB9B0\uB2E4"
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.bell.options.1.description
    lastText: "\uCCB4\uB825 -20. \uC218\uD638\uC758 \uC885 \uD68D\uB4DD."
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.bell.options.2.title
    lastText: "\uAC00\uC7A5\uC790\uB9AC\uC758 \uCCAD\uB3D9\uB9CC \uB5BC\uC5B4 \uAC04\uB2E4"
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.bell.options.2.description
    lastText: "\uACE8\uB4DC +20. \uC885\uC740 \uAEBC\uB0B4\uC9C0 \uBABB\uD55C\uB2E4."
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.bell.options.0.resulttext
    lastText: 
