      \uAFF0\uC5EC \uC788\uB2E4.\n\n\u201C\uD0D1\uC5D0\uC11C \uC548 \uB0B4\uB824\uC628
      \uC0AC\uB78C\uB4E4 \uAC81\uB2C8\uB2E4. \uBB3C\uAC74\uC740 \uC5EC\uAE30\uAE4C\uC9C0
      \uB370\uB824\uC654\uC73C\uB2C8 \uAC12\uC744 \uBC1B\uC544\uC57C\uC8E0.\u201D\n\n\uADF8\uAC00
      \uAE08\uB2C8 \uBAA8\uC591\uC758 \uC791\uC740 \uD328\uB97C \uB0B4\uBBFC\uB2E4.\n\n\u201C\uB3D9\uC804
      \uB0C4\uC0C8\uB97C \uC798 \uB9E1\uB294 \uBD80\uC801\uC785\uB2C8\uB2E4. \uC57D\uBCD1\uB3C4
      \uC0BD\uB2C8\uB2E4. \uB0B4\uB824\uC62C \uC0AC\uB78C\uC740 \uB9CE\uC740\uB370,
      \uB3CC\uC544\uAC08 \uC57D\uC740 \uB298 \uBAA8\uC790\uB77C\uAC70\uB4E0.\u201D"
