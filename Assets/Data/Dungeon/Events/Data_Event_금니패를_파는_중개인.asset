  worldObject: {fileID: 11400000, guid: 03e2e6c9efd7d1342a12e6662aca6e76, type: 2}
  encounterKind: 1
  authoringLore: "\uC0DD\uD658 \uCC44\uAD8C\uACFC \uC6D0\uC815\uB300 \uC720\uD488\uC744
    \uC911\uAC1C\uD558\uB294 \uD604\uC7A5 \uAE08\uC735\uC0C1. \uC131 \uBC14\uAE65\uBCF4\uB2E4
    \uC218\uC218\uB8CC\uAC00 \uB192\uC740 \uC704\uD5D8 \uC2DC\uC7A5\uC744 \uCC3E\uC544
    \uB4E4\uC5B4\uC654\uB2E4. \uAE08\uB2C8 \uBAA8\uC591\uC758 \uBD80\uC801\uACFC
    \uC804\uB2F9\uAE08\uC744 \uC2E4\uC81C \uBB3C\uD488\uC73C\uB85C \uAC70\uB798\uD55C\uB2E4.
    \uC774\uC720 \uC5C6\uC774 \uC0C1\uCC98 \uB0B4\uB294 \uB0B4\uAE30\uB294 \uD3D0\uAE30\uD558\uACE0,
    \uAC00\uC838\uC628 \uD68C\uBCF5 \uD3EC\uC158\uC744 \uD604\uAE08\uD654\uD560 \uC218
    \uC788\uAC8C \uD55C\uB2E4. \uD55C \uBC88 \uAC70\uB798\uD558\uBA74 \uB0A8\uC740
    \uC7AC\uACE0\uB97C \uB2EB\uACE0 \uACC4\uC0B0\uC5D0 \uBAB0\uB450\uD558\uBBC0\uB85C
    \uC7AC\uAC70\uB798\uAC00 \uC548 \uB418\uB294 \uC774\uC720\uAC00 \uB4DC\uB7EC\uB09C\uB2E4."
