  m_Script: {fileID: 11500000, guid: 1ed321eba234b304691035266cf67c31, type: 3}
  m_Name: "Data_Event_\uAE08\uB2C8\uD328\uB97C_\uD30C\uB294_\uC911\uAC1C\uC778"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.tooth.displayname
    lastText: "\uAE08\uB2C8\uD328\uB97C \uD30C\uB294 \uC911\uAC1C\uC778"
  - propertyPath: narrative
    key: data.randomeventdata.tooth.narrative
    lastText: "\uAE08\uB2C8\uB97C \uD55C \uC0AC\uB0B4\uAC00 \uC7A5\uBD80\uC758 \uC774\uB984
      \uC704\uC5D0 \uAE08\uC744 \uAE0B\uB294\uB2E4. \uC678\uD22C \uC548\uCABD\uC5D0\uB294
      \uD68C\uC218\uD45C\uC640 \uC791\uC740 \uC804\uB2F9\uD488\uB4E4\uC774 \uC2E4\uB85C
      \uAFF0\uC5EC \uC788\uB2E4.\n\n\u201C\uD0D1\uC5D0\uC11C \uC548 \uB0B4\uB824\uC628
      \uC0AC\uB78C\uB4E4 \uAC81\uB2C8\uB2E4. \uBB3C\uAC74\uC740 \uC5EC\uAE30\uAE4C\uC9C0
      \uB370\uB824\uC654\uC73C\uB2C8 \uAC12\uC744 \uBC1B\uC544\uC57C\uC8E0.\u201D\n\n\uADF8\uAC00
      \uAE08\uB2C8 \uBAA8\uC591\uC758 \uC791\uC740 \uD328\uB97C \uB0B4\uBBFC\uB2E4.\n\n\u201C\uB3D9\uC804
      \uB0C4\uC0C8\uB97C \uC798 \uB9E1\uB294 \uBD80\uC801\uC785\uB2C8\uB2E4. \uC57D\uBCD1\uB3C4
      \uC0BD\uB2C8\uB2E4. \uB0B4\uB824\uC62C \uC0AC\uB78C\uC740 \uB9CE\uC740\uB370,
      \uB3CC\uC544\uAC08 \uC57D\uC740 \uB298 \uBAA8\uC790\uB77C\uAC70\uB4E0.\u201D"
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.tooth.options.0.title
    lastText: "\uAE08\uB2C8 \uBAA8\uC591\uC758 \uBD80\uC801\uC744 \uC0B0\uB2E4."
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.tooth.options.0.description
    lastText: "\uAE08\uBE5B \uC774\uBE68 \uD68D\uB4DD"
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.tooth.options.1.title
    lastText: "\uD68C\uBCF5 \uD3EC\uC158 \uD55C \uBCD1\uC744 \uD310\uB2E4."
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.tooth.options.1.description
    lastText: "\uD68C\uBCF5 \uD3EC\uC158 1\uAC1C \uC18C\uBAA8 \xB7 \uACE8\uB4DC +35"
  - propertyPath: options.Array.data[2].title
    key: data.randomeventdata.tooth.options.2.title
    lastText: "\uC7A5\uBD80\uB97C \uC9D3\uB204\uB974\uACE0 \uC5EC\uBE44\uB97C \uB0B4\uB193\uAC8C
      \uD55C\uB2E4."
  - propertyPath: options.Array.data[2].description
    key: data.randomeventdata.tooth.options.2.description
    lastText: "\uACE8\uB4DC +20"
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.tooth.options.0.resulttext
    lastText: "\uB300\uAE08\uC744 \uAC74\uB124\uACE0 \uBD80\uC801\uC744 \uBC1B\uC558\uB2E4.
      \uC0AC\uB0B4\uB294 \uAC70\uB798\uC5D0 \uC4F4 \uC7A5\uBD80\uB97C \uB36E\uACE0
      \uC678\uD22C\uC758 \uC804\uB2F9\uD488\uC744 \uB2E4\uC2DC \uBB36\uC5C8\uB2E4.
      \u201C\uC624\uB298 \uB0B4\uB193\uC744 \uBB3C\uAC74\uC740 \uC774\uAC81\uB2C8\uB2E4.\u201D
      \uADF8\uB294 \uB0A8\uC740 \uC774\uB984\uC744 \uC138\uAE30 \uC2DC\uC791\uD588\uB2E4."
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.tooth.options.1.resulttext
    lastText: "\uBCD1\uB9C8\uAC1C\uB97C \uD655\uC778\uD55C \uC0AC\uB0B4\uAC00 \uB3D9\uC804\uC744
      \uC138\uC5B4 \uB0B4\uBC00\uC5C8\uB2E4. \uC57D\uBCD1\uC744 \uC678\uD22C \uAE4A\uC774
      \uB123\uACE0 \uC7A5\uBD80\uB97C \uB2EB\uB294\uB2E4. \u201C\uAC12\uC740 \uCE58\uB800\uC2B5\uB2C8\uB2E4.
      \uB354 \uD314 \uBB3C\uAC74\uC740 \uB2E4\uC74C\uC5D0 \uBCF4\uC8E0.\u201D"
  - propertyPath: options.Array.data[2].resultText
    key: data.randomeventdata.tooth.options.2.resulttext
    lastText: "\uC7A5\uBD80\uB97C \uC9D3\uB204\uB974\uACE0 \uBE48\uC190\uC744 \uB0B4\uBC00\uC5C8\uB2E4.
      \uC0AC\uB0B4\uAC00 \uD488\uC758 \uB3D9\uC804\uC744 \uBC00\uC5B4 \uB193\uB294\uB2E4.
      \uB098\uB294 \uB3C8\uC744 \uCC59\uACBC\uB2E4. \uAE08\uB2C8\uAC00 \uC7A0\uAE50
      \uB4DC\uB7EC\uB0AC\uB2E4\uAC00 \uC0AC\uB77C\uC84C\uB2E4. \u201C\uB2F9\uC2E0
      \uC774\uB984\uC740 \uAE30\uC5B5\uD558\uC8E0.\u201D"
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.tooth.pages.0.narrative
    lastText: "\uAE08\uB2C8\uB97C \uD55C \uC0AC\uB0B4\uAC00 \uC7A5\uBD80\uC758 \uC774\uB984
      \uC704\uC5D0 \uAE08\uC744 \uAE0B\uB294\uB2E4. \uC678\uD22C \uC548\uCABD\uC5D0\uB294
