  m_Name: "Data_Event_\uD68C\uC218\uD45C\uB97C_\uB2E8_\uAC1C"
  m_EditorClassIdentifier: 
  textKeys:
  - propertyPath: displayName
    key: data.randomeventdata.straydog.displayname
    lastText: "\uD68C\uC218\uD45C\uB97C \uB2E8 \uAC1C"
  - propertyPath: narrative
    key: data.randomeventdata.straydog.narrative
    lastText: "\uD070 \uD68C\uC0C9 \uAC1C\uAC00 \uC55E\uBC1C\uC744 \uBED7\uACE0 \uB204\uC6CC
      \uC788\uB2E4. \uBAA9\uC904\uC758 \uC9E7\uC740 \uC1E0\uC904\uC774 \uBD80\uB7EC\uC9C4
      \uACE0\uB9AC\uC5D0 \uAC78\uB824 \uC788\uB2E4. \uBAB8\uC744 \uC77C\uC73C\uD0A4\uB824
      \uD560 \uB54C\uB9C8\uB2E4 \uC624\uB978 \uC55E\uBC1C\uC774 \uAEBE\uC778\uB2E4.\n\n\uB0A1\uC740
      \uAC00\uC8FD \uBAA9\uC904\uC5D0\uB294 \uD68C\uC218\uB300\uC758 \uD45C\uC2DD\uC774
      \uB2EC\uB824 \uC788\uB2E4. \uAC1C\uB294 \uB0B4 \uC190\uC744 \uBCF4\uBA70 \uB0AE\uAC8C
      \uC73C\uB974\uB801\uAC70\uB9B0\uB2E4. \uB3C4\uB9DD\uAC08 \uAE38\uBD80\uD130
      \uC7AC\uB294 \uB208\uC774\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: data.randomeventdata.straydog.options.0.title
    lastText: "\uAC70\uB9AC\uB97C \uB450\uACE0 \uBAA9\uC904\uACFC \uB2E4\uCE5C \uBC1C\uC744
      \uC0B4\uD540\uB2E4."
  - propertyPath: options.Array.data[0].description
    key: data.randomeventdata.straydog.options.0.description
    lastText: 
  - propertyPath: options.Array.data[1].title
    key: data.randomeventdata.straydog.options.1.title
    lastText: "\uC1E0\uC904\uC744 \uAC74\uB4DC\uB9AC\uC9C0 \uC54A\uACE0 \uB5A0\uB09C\uB2E4."
  - propertyPath: options.Array.data[1].description
    key: data.randomeventdata.straydog.options.1.description
    lastText: 
  - propertyPath: options.Array.data[0].resultText
    key: data.randomeventdata.straydog.options.0.resulttext
    lastText: 
  - propertyPath: options.Array.data[1].resultText
    key: data.randomeventdata.straydog.options.1.resulttext
    lastText: "\uB354 \uB2E4\uAC00\uAC00\uC9C0 \uC54A\uACE0 \uAE38\uC744 \uBE44\uCF30\uB2E4.
      \uC544\uC9C1 \uACB0\uC815\uC744 \uB0B4\uB9AC\uC9C0\uB294 \uC54A\uC558\uB2E4."
  - propertyPath: pages.Array.data[0].narrative
    key: data.randomeventdata.straydog.pages.0.narrative
    lastText: "\uD070 \uD68C\uC0C9 \uAC1C\uAC00 \uC55E\uBC1C\uC744 \uBED7\uACE0 \uB204\uC6CC
      \uC788\uB2E4. \uBAA9\uC904\uC758 \uC9E7\uC740 \uC1E0\uC904\uC774 \uBD80\uB7EC\uC9C4
      \uACE0\uB9AC\uC5D0 \uAC78\uB824 \uC788\uB2E4. \uBAB8\uC744 \uC77C\uC73C\uD0A4\uB824
      \uD560 \uB54C\uB9C8\uB2E4 \uC624\uB978 \uC55E\uBC1C\uC774 \uAEBE\uC778\uB2E4.\n\n\uB0A1\uC740
      \uAC00\uC8FD \uBAA9\uC904\uC5D0\uB294 \uD68C\uC218\uB300\uC758 \uD45C\uC2DD\uC774
      \uB2EC\uB824 \uC788\uB2E4. \uAC1C\uB294 \uB0B4 \uC190\uC744 \uBCF4\uBA70 \uB0AE\uAC8C
      \uC73C\uB974\uB801\uAC70\uB9B0\uB2E4. \uB3C4\uB9DD\uAC08 \uAE38\uBD80\uD130
      \uC7AC\uB294 \uB208\uC774\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].title
    key: data.randomeventdata.straydog.pages.0.options.0.title
    lastText: "\uAC70\uB9AC\uB97C \uB450\uACE0 \uBAA9\uC904\uACFC \uB2E4\uCE5C \uBC1C\uC744
      \uC0B4\uD540\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[0].description
    key: data.randomeventdata.straydog.pages.0.options.0.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[0].resultText
    key: data.randomeventdata.straydog.pages.0.options.0.resulttext
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[1].title
    key: data.randomeventdata.straydog.pages.0.options.1.title
    lastText: "\uC1E0\uC904\uC744 \uAC74\uB4DC\uB9AC\uC9C0 \uC54A\uACE0 \uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[0].options.Array.data[1].description
    key: data.randomeventdata.straydog.pages.0.options.1.description
    lastText: 
  - propertyPath: pages.Array.data[0].options.Array.data[1].resultText
    key: data.randomeventdata.straydog.pages.0.options.1.resulttext
    lastText: "\uB354 \uB2E4\uAC00\uAC00\uC9C0 \uC54A\uACE0 \uAE38\uC744 \uBE44\uCF30\uB2E4.
      \uC544\uC9C1 \uACB0\uC815\uC744 \uB0B4\uB9AC\uC9C0\uB294 \uC54A\uC558\uB2E4."
  - propertyPath: pages.Array.data[1].narrative
    key: data.randomeventdata.straydog.pages.1.narrative
    lastText: "\uC1E0\uC904\uC740 \uBD80\uB7EC\uC9C4 \uACE0\uB9AC\uC5D0 \uAC78\uB824
      \uC788\uACE0, \uACE0\uB9AC \uBC11\uC758 \uD138\uC5D0\uB294 \uD53C\uAC00 \uAD73\uC5C8\uB2E4.
      \uC624\uB978 \uC55E\uBC1C\uC744 \uAC10\uC2FC \uBD95\uB300\uB3C4 \uAC80\uAC8C
      \uC816\uC5B4 \uC788\uB2E4.\n\n\uAC1C\uAC00 \uB0B4 \uC190\uACFC \uD1B5\uB85C\uB97C
      \uBC88\uAC08\uC544 \uBCF8\uB2E4. \uC190\uC744 \uB0AE\uCD94\uC790 \uC73C\uB974\uB801\uAC70\uB9BC\uC774
      \uC7A6\uC544\uB4E4\uC9C0\uB9CC, \uC904\uC744 \uB2F9\uAE30\uBA74 \uB2E4\uC2DC
      \uC774\uBE68\uC744 \uB4DC\uB7EC\uB0B8\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].title
    key: data.randomeventdata.straydog.pages.1.options.0.title
    lastText: "\uB9D0\uB9B0 \uACE0\uAE30\uB85C \uC8FC\uC758\uB97C \uB3CC\uB9AC\uACE0
      \uC1E0\uC904\uC744 \uD47C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[0].description
    key: data.randomeventdata.straydog.pages.1.options.0.description
    lastText: "\uACE0\uAE30 1\uAC1C \uC18C\uBAA8 \xB7 \uD68C\uC218\uACAC \uD569\uB958"
  - propertyPath: pages.Array.data[1].options.Array.data[0].resultText
    key: data.randomeventdata.straydog.pages.1.options.0.resulttext
    lastText: "\uACE0\uAE30\uB97C \uBA40\uCC0D\uC774 \uB193\uC790 \uAC1C\uAC00 \uC904\uC744
      \uB2A6\uCDC4\uB2E4. \uACE0\uB9AC\uB97C \uD480\uACE0 \uBB3C\uB7EC\uC130\uB2E4.
      \uBA39\uC774\uB97C \uC0BC\uD0A8 \uAC1C\uB294 \uCF54\uB97C \uBC14\uB2E5\uC5D0
      \uB304 \uCC44 \uB0B4 \uB4A4\uB97C \uB530\uB77C\uC654\uB2E4. \uC55E\uBC1C\uC744
      \uC808\uBA74\uC11C\uB3C4 \uB0B4\uAC00 \uBA48\uCD94\uBA74 \uBA3C\uC800 \uD1B5\uB85C\uB97C
      \uC0B4\uD3C8\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].title
    key: data.randomeventdata.straydog.pages.1.options.1.title
    lastText: "\uD3EC\uC158\uC73C\uB85C \uC0C1\uCC98\uB97C \uC53B\uACE0 \uC1E0\uC904\uC744
      \uD47C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[1].description
    key: data.randomeventdata.straydog.pages.1.options.1.description
    lastText: "\uD68C\uBCF5 \uD3EC\uC158 1\uAC1C \uC18C\uBAA8 \xB7 \uD68C\uC218\uACAC
      \uD569\uB958"
  - propertyPath: pages.Array.data[1].options.Array.data[1].resultText
    key: data.randomeventdata.straydog.pages.1.options.1.resulttext
    lastText: "\uBAA9\uC904\uC758 \uACE0\uB9AC\uB97C \uC7A1\uACE0 \uB2E4\uCE5C \uBC1C\uC5D0
      \uC57D\uC744 \uD758\uB838\uB2E4. \uAC1C\uB294 \uC774\uB97C \uB4DC\uB7EC\uB0C8\uC9C0\uB9CC
      \uBB3C\uC9C0 \uC54A\uC558\uB2E4. \uBD95\uB300\uB97C \uACE0\uCCD0 \uBB36\uACE0
      \uC1E0\uC904\uC744 \uD480\uC5C8\uB2E4. \uD55C\uB3D9\uC548 \uBA40\uB9AC \uC11C
      \uC788\uB358 \uAC1C\uAC00 \uB0B4 \uAC78\uC74C\uC5D0 \uB9DE\uCDB0 \uC0C1\uCC98
      \uB09C \uBC1C\uC744 \uB514\uB3A0\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[2].title
    key: data.randomeventdata.straydog.pages.1.options.2.title
    lastText: "\uB354 \uB2E4\uAC00\uAC00\uC9C0 \uC54A\uACE0 \uB5A0\uB09C\uB2E4."
  - propertyPath: pages.Array.data[1].options.Array.data[2].description
    key: data.randomeventdata.straydog.pages.1.options.2.description
    lastText: 
  - propertyPath: pages.Array.data[1].options.Array.data[2].resultText
    key: data.randomeventdata.straydog.pages.1.options.2.resulttext
    lastText: "\uB354 \uB2E4\uAC00\uAC00\uC9C0 \uC54A\uACE0 \uAE38\uC744 \uBE44\uCF30\uB2E4.
      \uC544\uC9C1 \uACB0\uC815\uC744 \uB0B4\uB9AC\uC9C0\uB294 \uC54A\uC558\uB2E4."
  textOwnerGuid: fa9f2abe524107b46a325db6b448a909
  id: StrayDog
  displayName: "\uD68C\uC218\uD45C\uB97C \uB2E8 \uAC1C"
  discovery: 1
  worldObject: {fileID: 11400000, guid: c9d93faa4f0cf8f4586b938836e0f291, type: 2}
  encounterKind: 2
  authoringLore: "\uD68C\uC218\uB300\uAC00 \uBB34\uB108\uC9C4 \uD1B5\uB85C\uC640
    \uC2DC\uC2E0\uC758 \uB0C4\uC0C8\uB97C \uCC3E\uB294 \uB370 \uC4F0\uB358 \uB2E4
    \uC790\uB780 \uCD94\uC801\uACAC. \uC870\uB828\uC0AC\uC758 \uD68C\uC218\uD45C\uAC00
    \uBAA9\uC904\uC5D0 \uB0A8\uC558\uB2E4. \uB3CC\uC544\uC624\uC9C0 \uC54A\uC740
    \uC870\uB828\uC0AC\uB97C \uAE30\uB2E4\uB9AC\uB2E4 \uB04A\uC5B4\uC9C4 \uC1E0\uC904\uC5D0
    \uAC78\uB838\uACE0 \uC624\uB978 \uC55E\uBC1C\uC744 \uB2E4\uCCE4\uB2E4. \uC21C\uC885\uC801\uC778
    \uC560\uC644\uB3D9\uBB3C\uC774 \uC544\uB2C8\uB77C \uBA39\uC774\uB97C \uBC1B\uC544\uB3C4
    \uBA3C\uC800 \uD1F4\uB85C\uB97C \uD655\uC778\uD558\uB294 \uC791\uC5C5\uACAC.
    \uAD6C\uC870 \uD6C4 \uD568\uAED8 \uACBD\uACC4\uD558\uBA70 \uC2F8\uC6B0\uB294
    \uC774\uC720\uB294 \uB0A8\uC740 \uC791\uC5C5 \uC2B5\uC131\uACFC \uC0C8 \uAE38\uC7A1\uC774\uB97C
    \uD0DD\uD55C \uD310\uB2E8\uC774\uB2E4."
