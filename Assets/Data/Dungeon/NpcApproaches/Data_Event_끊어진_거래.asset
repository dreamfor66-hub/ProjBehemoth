  - propertyPath: displayName
    key: "data.randomeventdata.data_eventresponse_\uD589\uC0C1\uAE30\uC2B5.displayname"
    lastText: "\uB04A\uC5B4\uC9C4 \uAC70\uB798"
  - propertyPath: narrative
    key: "data.randomeventdata.data_eventresponse_\uD589\uC0C1\uAE30\uC2B5.narrative"
    lastText: "\uD589\uC0C1\uC758 \uB4A4\uC5D0\uC11C \uC9D0\uC790\uB8E8\uB97C \uB09A\uC544\uCC48\uB2E4."
  - propertyPath: options.Array.data[0].title
    key: "data.randomeventdata.data_eventresponse_\uD589\uC0C1\uAE30\uC2B5.options.0.title"
    lastText: "\uAE30\uC2B5\uD55C\uB2E4"
  - propertyPath: options.Array.data[0].description
    key: "data.randomeventdata.data_eventresponse_\uD589\uC0C1\uAE30\uC2B5.options.0.description"
    lastText: "\uC9D0\uC790\uB8E8\uB97C \uB178\uB9B0\uB2E4. \uCCB4\uB825 \u22128
      \xB7 \uACE8\uB4DC +30 \xB7 \uC774 \uD589\uC0C1\uACFC \uAC70\uB798\uD560 \uC218
      \uC5C6\uAC8C \uB41C\uB2E4."
  - propertyPath: options.Array.data[0].resultText
    key: "data.randomeventdata.data_eventresponse_\uD589\uC0C1\uAE30\uC2B5.options.0.resulttext"
    lastText: "\uC790\uB8E8\uB97C \uC7A1\uC544\uB2F9\uAE30\uC790 \uD589\uC0C1\uC774
      \uBAB8\uC744 \uD2C0\uC5B4 \uC190\uBAA9 \uC548\uCABD\uC73C\uB85C \uC9E7\uC740
      \uCE7C\uC744 \uAE0B\uB294\uB2E4. \uC190\uC744 \uB193\uCE5C \uC0AC\uC774, \uADF8\uB294
      \uC9D0\uC744 \uB04C\uACE0 \uD1B5\uB85C \uB108\uBA38\uB85C \uB2EC\uC544\uB09C\uB2E4.\n\n\uBC14\uB2E5\uC5D0
      \uC3DF\uC544\uC9C4 \uB3D9\uC804 \uBA87 \uB2E2\uB9CC \uAC74\uC9C4\uB2E4."
  textOwnerGuid: e62230cd06fd7694a8f6fd5d06e409d3
  id: MerchantRearAmbush
  displayName: "\uB04A\uC5B4\uC9C4 \uAC70\uB798"
  discovery: 0
  worldObject: {fileID: 11400000, guid: d34079448194271409a4cda660b098a0, type: 2}
  encounterKind: 1
  authoringLore: "\uD1B5\uB85C\uC5D0\uC11C \uC0DD\uACC4\uB97C \uC787\uB294 \uD589\uC0C1\uC740
    \uC9D0\uC744 \uBE7C\uC557\uAE30\uAE30 \uC804\uC5D0 \uB3C4\uC8FC\uD55C\uB2E4.
    \uBAA8\uB4E0 \uD589\uC0C1\uC774 \uAD34\uBB3C\uC778 \uAC83\uC740 \uC544\uB2C8\uB2E4.
    \uD76C\uADC0 \uC704\uC7A5 \uAC1C\uCCB4\uB9CC \uBCC4\uB3C4 \uC2E4\uC81C \uC804\uD22C\uB85C
    \uC5F0\uACB0\uB41C\uB2E4."
